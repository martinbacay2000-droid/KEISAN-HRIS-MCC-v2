@{
    Layout = "~/Views/Shared/_LayoutFillow.cshtml";
    ViewData["Title"] = "Dashboard";
    var employeeNo = Context.Session.GetString("employeeNo");
    var userFullName = Context.Session.GetString("userFullName");
    var roleCode = Context.Session.GetString("roleCode");
    var isAdmin = roleCode == "RL-000000";
    var isHrOrAdmin = isAdmin || (!string.IsNullOrEmpty(roleCode) && roleCode.ToUpper().Contains("HR"));
}

<style>
    /* Welcome Card */
    .welcome-card {
        border-radius: 8px;
        overflow: hidden;
        margin-bottom: 2rem;
        margin-top: -35px;
    }

    .welcome-content-section {
        padding: 2rem 2.5rem;
        display: flex;
        flex-direction: column;
        justify-content: center;
        min-height: 160px;
    }

        .welcome-content-section h1 {
            font-size: 2rem;
            font-weight: 600;
            margin-bottom: 0.5rem;
        }

    .welcome-employee-info {
        font-size: 1.1rem;
        font-weight: 500;
        margin-bottom: 0.75rem;
    }

    .welcome-datetime {
        font-size: 0.95rem;
    }

    .welcome-image-section {
        padding: 0;
        display: flex;
        align-items: center;
        justify-content: center;
        min-height: 160px;
    }

        .welcome-image-section img {
            width: 100%;
            height: 160px;
            object-fit: cover;
            object-position: right top;
            margin-left: 350px;
        }

    /* Summary Cards Section */
    .summary-card {
        border-radius: 8px;
        padding: 1.25rem 1rem;
        text-align: center;
        transition: all 0.3s ease;
        height: 100%;
    }

        .summary-card:hover {
            transform: translateY(-2px);
        }

        .summary-card.pending {
            border-top: 4px solid #ffa500;
        }

        .summary-card.approved {
            border-top: 4px solid #28a745;
        }

        .summary-card.declined {
            border-top: 4px solid #dc3545;
        }

        .summary-card.cancelled {
            border-top: 4px solid #6c757d;
        }

    .summary-card-icon {
        font-size: 1.75rem;
        margin-bottom: 0.5rem;
    }

    .summary-card.pending .summary-card-icon {
        color: #ffa500;
    }

    .summary-card.approved .summary-card-icon {
        color: #28a745;
    }

    .summary-card.declined .summary-card-icon {
        color: #dc3545;
    }

    .summary-card.cancelled .summary-card-icon {
        color: #6c757d;
    }

    .summary-card-number {
        font-size: 2rem;
        font-weight: 700;
        margin-bottom: 0.15rem;
        line-height: 1;
    }

    .summary-card.pending .summary-card-number {
        color: #ffa500;
    }

    .summary-card.approved .summary-card-number {
        color: #28a745;
    }

    .summary-card.declined .summary-card-number {
        color: #dc3545;
    }

    .summary-card.cancelled .summary-card-number {
        color: #6c757d;
    }

    .summary-card-label {
        font-size: 0.9rem;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 0.5px;
    }

    .summary-card-subtitle {
        font-size: 0.75rem;
        margin-top: 0.25rem;
    }

    /* Chart Cards */
    .chart-card {
        border-radius: 8px;
        transition: all 0.3s ease;
        border: none;
        margin-bottom: 1.5rem;
        height: 100%;
    }

        .chart-card:hover {
            transform: translateY(-2px);
        }

    .chart-card-header {
        padding: 1rem 1.25rem;
        border-radius: 8px 8px 0 0;
    }

    .chart-card-title {
        font-weight: 600;
        display: flex;
        align-items: center;
        margin-bottom: 0;
        font-size: 0.95rem;
    }

        .chart-card-title i {
            margin-right: 0.5rem;
        }

    .chart-card-body {
        padding: 1.25rem;
    }

    .chart-canvas-wrapper {
        position: relative;
        width: 100%;
        height: 220px;
    }

        .chart-canvas-wrapper canvas {
            max-height: 220px;
        }

    /* Employee Count Card */
    .employee-count-card {
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        border-radius: 8px;
        box-shadow: 0 2px 8px rgba(102, 126, 234, 0.3);
        color: white;
        padding: 1.5rem;
        text-align: center;
        height: 100%;
        transition: all 0.3s ease;
        display: flex;
        flex-direction: column;
        justify-content: center;
    }

        .employee-count-card:hover {
            box-shadow: 0 4px 15px rgba(102, 126, 234, 0.4);
            transform: translateY(-2px);
        }

        .employee-count-card i {
            font-size: 2.5rem;
            margin-bottom: 0.75rem;
            opacity: 0.9;
        }

        .employee-count-card h2 {
            font-size: 2.5rem;
            font-weight: 700;
            margin-bottom: 0.5rem;
        }

        .employee-count-card p {
            font-size: 0.9rem;
            opacity: 0.9;
            margin: 0;
        }

    /* Employee Schedule Section */
    .schedule-section {
        border-radius: 8px;
        margin-bottom: 2rem;
        height: 100%;
        display: flex;
        flex-direction: column;
    }

        .schedule-section .card-body {
            padding: 1.25rem;
            display: flex;
            flex-direction: column;
            min-height: 280px;
        }

    .schedule-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        margin-bottom: 1rem;
        padding-bottom: 0.75rem;
        border-bottom: 1px solid rgba(0, 0, 0, 0.1);
        flex-shrink: 0;
    }

    .schedule-title {
        display: flex;
        align-items: center;
    }

        .schedule-title i {
            color: #3498db;
            font-size: 1.1rem;
            margin-right: 0.5rem;
        }

        .schedule-title h5 {
            margin: 0;
            font-size: 1rem;
            font-weight: 600;
        }

    .schedule-effectivity {
        font-size: 0.8rem;
        font-weight: 500;
        color: #6c757d;
    }

    #scheduleList {
        overflow-y: auto;
        flex: 1;
        max-height: 200px;
    }

    .schedule-item {
        border-left: 4px solid #3498db;
        border-radius: 6px;
        padding: 0.75rem 1rem;
        margin-bottom: 0.65rem;
        transition: all 0.3s ease;
        display: flex;
        justify-content: space-between;
        align-items: center;
        background: rgba(52, 152, 219, 0.05);
    }

        .schedule-item:hover {
            transform: translateX(3px);
            background: rgba(52, 152, 219, 0.1);
        }

        .schedule-item:last-child {
            margin-bottom: 0;
        }

    .schedule-day {
        font-weight: 600;
        font-size: 0.9rem;
        min-width: 90px;
    }

    .schedule-time {
        font-size: 0.85rem;
        display: flex;
        align-items: center;
        gap: 0.5rem;
        color: #495057;
    }

        .schedule-time i {
            font-size: 0.8rem;
            color: #3498db;
        }

    .no-schedule {
        text-align: center;
        padding: 2rem 1rem;
        display: flex;
        flex-direction: column;
        justify-content: center;
        align-items: center;
        flex: 1;
    }

        .no-schedule i {
            font-size: 3rem;
            margin-bottom: 1rem;
            opacity: 0.2;
            color: #6c757d;
        }

        .no-schedule p {
            margin: 0;
            font-size: 0.9rem;
            color: #6c757d;
        }

    /* Announcements Section */
    .announcements-section {
        border-radius: 8px;
        margin-bottom: 2rem;
        height: 100%;
        display: flex;
        flex-direction: column;
    }

    .announcements-section .card-body {
        padding: 1.25rem;
        display: flex;
        flex-direction: column;
        min-height: 280px;
    }

    .announcements-header {
        display: flex;
        align-items: center;
        margin-bottom: 1rem;
        padding-bottom: 0.75rem;
        border-bottom: 1px solid rgba(0, 0, 0, 0.1);
        flex-shrink: 0;
    }

    .announcements-header i {
        color: #f39c12;
        font-size: 1.1rem;
        margin-right: 0.5rem;
    }

    .announcements-header h5 {
        margin: 0;
        font-size: 1rem;
        font-weight: 600;
    }

    #announcementsList {
        overflow-y: auto;
        flex: 1;
        max-height: 200px;
    }

    .announcement-card {
        border-left: 4px solid #f39c12;
        border-radius: 6px;
        padding: 1rem;
        margin-bottom: 0.875rem;
        transition: all 0.3s ease;
        background: rgba(243, 156, 18, 0.05);
    }

    .announcement-card:hover {
        transform: translateX(3px);
        background: rgba(243, 156, 18, 0.1);
    }

    .announcement-card:last-child {
        margin-bottom: 0;
    }

    .announcement-title {
        font-size: 0.95rem;
        font-weight: 600;
        margin-bottom: 0.5rem;
        word-wrap: break-word;
        color: #2c3e50;
    }

    .announcement-content {
        font-size: 0.85rem;
        line-height: 1.6;
        margin-bottom: 0.75rem;
        word-wrap: break-word;
        color: #495057;
    }

    .announcement-meta {
        display: flex;
        justify-content: space-between;
        align-items: center;
        font-size: 0.75rem;
        color: #6c757d;
        flex-wrap: wrap;
        gap: 0.5rem;
        padding-top: 0.5rem;
        border-top: 1px solid rgba(0, 0, 0, 0.05);
    }

    .announcement-date {
        display: flex;
        align-items: center;
        gap: 0.35rem;
    }

    .announcement-date i {
        color: #f39c12;
    }

    .announcement-author {
        display: flex;
        align-items: center;
        gap: 0.35rem;
    }

    .announcement-author i {
        color: #f39c12;
    }

    .no-announcements {
        text-align: center;
        padding: 2rem 1rem;
        display: flex;
        flex-direction: column;
        justify-content: center;
        align-items: center;
        flex: 1;
    }

    .no-announcements i {
        font-size: 3rem;
        margin-bottom: 1rem;
        opacity: 0.2;
        color: #6c757d;
    }

    .no-announcements p {
        margin: 0;
        font-size: 0.9rem;
        color: #6c757d;
    }

    .loading-spinner {
        text-align: center;
        padding: 2rem;
    }

    /* Responsive */
    @@media (max-width: 1199px) {
        .chart-canvas-wrapper {
            height: 200px;
        }

        .chart-canvas-wrapper canvas {
            max-height: 200px;
        }
    }

    @@media (max-width: 991px) {
        .welcome-image-section {
            display: none !important;
        }

        .chart-canvas-wrapper {
            height: 220px;
        }

            .chart-canvas-wrapper canvas {
                max-height: 220px;
            }
    }

    @@media (max-width: 767px) {
        .summary-card {
            padding: 1rem 0.75rem;
        }

        .summary-card-icon {
            font-size: 1.5rem;
        }

        .summary-card-number {
            font-size: 1.75rem;
        }

        .summary-card-label {
            font-size: 0.85rem;
        }

        .summary-card-subtitle {
            font-size: 0.7rem;
        }

        .chart-canvas-wrapper {
            height: 200px;
        }

            .chart-canvas-wrapper canvas {
                max-height: 200px;
            }

        .employee-count-card h2 {
            font-size: 2rem;
        }

        .employee-count-card i {
            font-size: 2rem;
        }

        .schedule-item {
            flex-direction: column;
            align-items: flex-start;
            gap: 0.4rem;
        }

        .schedule-day {
            min-width: auto;
        }
    }

    @@media (max-width: 576px) {
        .summary-card-number {
            font-size: 1.5rem;
        }

        .summary-card-icon {
            font-size: 1.25rem;
        }

        .chart-canvas-wrapper {
            height: 180px;
        }

        .chart-canvas-wrapper canvas {
            max-height: 180px;
        }
    }

    /* Commendation Card */
    .commendation-section {
        border-radius: 8px;
        margin-bottom: 2rem;
        height: 100%;
        display: flex;
        flex-direction: column;
    }

    .commendation-section .card-body {
        padding: 1.25rem;
        display: flex;
        flex-direction: column;
        min-height: 280px;
    }

    .commendation-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        margin-bottom: 1rem;
        padding-bottom: 0.75rem;
        border-bottom: 1px solid rgba(184, 134, 11, 0.2);
        flex-shrink: 0;
    }

    .commendation-title {
        display: flex;
        align-items: center;
    }

    .commendation-title i {
        color: #b8860b;
        font-size: 1.1rem;
        margin-right: 0.5rem;
    }

    .commendation-title h5 {
        margin: 0;
        font-size: 1rem;
        font-weight: 600;
        color: #b8860b;
    }

    .commendation-count-badge {
        background: linear-gradient(135deg, #b8860b, #ffd700);
        color: white;
        font-size: 0.75rem;
        font-weight: 700;
        padding: 0.2rem 0.6rem;
        border-radius: 12px;
        min-width: 24px;
        text-align: center;
        box-shadow: 0 2px 6px rgba(184, 134, 11, 0.4);
    }

    #commendationList {
        overflow-y: auto;
        flex: 1;
        max-height: 220px;
    }

    .commendation-item {
        border-left: 4px solid #b8860b;
        border-radius: 6px;
        padding: 0.75rem 1rem;
        margin-bottom: 0.65rem;
        transition: all 0.3s ease;
        background: linear-gradient(135deg, rgba(255, 215, 0, 0.07), rgba(184, 134, 11, 0.05));
        border-top: 1px solid rgba(255, 215, 0, 0.2);
        border-right: 1px solid rgba(255, 215, 0, 0.1);
        border-bottom: 1px solid rgba(255, 215, 0, 0.1);
    }

    .commendation-item:hover {
        transform: translateX(3px);
        background: linear-gradient(135deg, rgba(255, 215, 0, 0.15), rgba(184, 134, 11, 0.1));
        box-shadow: 0 2px 8px rgba(184, 134, 11, 0.15);
    }

    .commendation-item:last-child {
        margin-bottom: 0;
    }

    .commendation-type-badge {
        display: inline-flex;
        align-items: center;
        gap: 0.3rem;
        background: linear-gradient(135deg, #b8860b, #ffd700);
        color: white;
        font-size: 0.7rem;
        font-weight: 700;
        padding: 0.2rem 0.6rem;
        border-radius: 10px;
        margin-bottom: 0.4rem;
        text-transform: uppercase;
        letter-spacing: 0.3px;
        box-shadow: 0 2px 5px rgba(184, 134, 11, 0.3);
    }

    .commendation-activity {
        font-size: 0.875rem;
        font-weight: 600;
        color: #7a5800;
        margin-bottom: 0.3rem;
        line-height: 1.3;
    }

    .commendation-meta {
        display: flex;
        justify-content: space-between;
        font-size: 0.75rem;
        color: #9a7d3a;
        flex-wrap: wrap;
        gap: 0.25rem;
    }

    .commendation-meta i {
        color: #b8860b;
        margin-right: 0.2rem;
    }

    .no-commendations {
        text-align: center;
        padding: 2rem 1rem;
        display: flex;
        flex-direction: column;
        justify-content: center;
        align-items: center;
        flex: 1;
    }

    .no-commendations i {
        font-size: 3rem;
        margin-bottom: 1rem;
        opacity: 0.25;
        color: #b8860b;
    }

    .no-commendations p {
        margin: 0;
        font-size: 0.9rem;
        color: #9a7d3a;
    }

    .commendation-section.card {
        border-top: 4px solid #b8860b;
        box-shadow: 0 2px 8px rgba(184, 134, 11, 0.1);
    }

    @@keyframes memoSlideIn {
        from

    {
        opacity: 0;
        transform: translateY(32px) scale(0.97);
    }

    to {
        opacity: 1;
        transform: translateY(0) scale(1);
    }

    }

    #memoNotifOverlay {
        display: none;
    }

    #memoNotifOverlay.active {
        display: flex !important;
    }

    /* Add these CSS variable overrides for dark mode */
    [data-theme-version="dark"] .announcement-title {
        color: #e0e0e0 !important;
    }

    [data-theme-version="dark"] .announcement-content {
        color: #b0b0b0 !important;
    }

    [data-theme-version="dark"] .announcement-meta {
        color: #888 !important;
    }

    [data-theme-version="dark"] .announcement-card {
        background: rgba(243, 156, 18, 0.08) !important;
    }

    [data-theme-version="dark"] .schedule-day {
        color: #e0e0e0 !important;
    }

    [data-theme-version="dark"] .schedule-time {
        color: #b0b0b0 !important;
    }

    [data-theme-version="dark"] .schedule-item {
        background: rgba(52, 152, 219, 0.08) !important;
    }

    [data-theme-version="dark"] .commendation-activity {
        color: #ffd700 !important;
    }

    [data-theme-version="dark"] .commendation-meta {
        color: #c9a84c !important;
    }

    [data-theme-version="dark"] .commendation-item {
        background: linear-gradient(135deg, rgba(255, 215, 0, 0.1), rgba(184, 134, 11, 0.08)) !important;
    }

    [data-theme-version="dark"] .commendation-title h5 {
        color: #ffffff !important;
    }
</style>

<div class="container-fluid">
    <!-- Welcome Card - UPDATED with card class -->
    <div class="welcome-card card">
        <div class="row g-0">
            <div class="col-lg-4 col-md-5 col-12">
                <div class="welcome-content-section">
                    <h1>Welcome@(isAdmin ? ", Admin" : "")!</h1>
                    <div class="welcome-employee-info">
                        @employeeNo - @userFullName
                    </div>
                    <div class="welcome-datetime">
                        <span id="currentDateTime"></span>
                    </div>
                </div>
            </div>
            <div class="col-lg-8 col-md-7 d-none d-md-block">
                <div class="welcome-image-section">
                    <img src="~/Fillow/images/logo-entrance-light.jpg" alt="Logo Hotel Entrance">
                </div>
            </div>
        </div>
    </div>

    <!-- Summary Cards -->
    <div class="row mb-3">
        <div class="col-12">
            <div class="row g-3" id="summaryCardsContainer">
                <div class="col-12 text-center">
                    <div class="loading-spinner">
                        <i class="fas fa-spinner fa-spin fa-2x"></i>
                        <p class="mt-2">Loading statistics...</p>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- First Row: Schedule + Announcements + Commendations -->
    <div class="row mb-3">
        <!-- MY SCHEDULE - changed col-xl-6 to col-xl-4 -->
        <div class="col-xl-4 col-lg-6 col-12 mb-3 mb-xl-0">
            <div class="schedule-section card">
                <div class="card-body">
                    <div class="schedule-header">
                        <div class="schedule-title">
                            <i class="fas fa-calendar-alt"></i>
                            <h5>My Schedule</h5>
                        </div>
                        <div class="schedule-effectivity" id="scheduleEffectivity"></div>
                    </div>
                    <div id="scheduleList">
                        <div class="loading-spinner">
                            <i class="fas fa-spinner fa-spin"></i>
                            <p>Loading schedule...</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- ANNOUNCEMENTS - changed col-xl-6 to col-xl-4 -->
        <div class="col-xl-4 col-lg-6 col-12 mb-3 mb-xl-0">
            <div class="announcements-section card">
                <div class="card-body">
                    <div class="announcements-header">
                        <i class="fas fa-bullhorn"></i>
                        <h5>Announcements</h5>
                    </div>
                    <div id="announcementsList">
                        <div class="loading-spinner">
                            <i class="fas fa-spinner fa-spin"></i>
                            <p>Loading announcements...</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- MY COMMENDATIONS - new card -->
        <div class="col-xl-4 col-lg-6 col-12">
            <div class="commendation-section card">
                <div class="card-body">
                    <div class="commendation-header">
                        <div class="commendation-title">
                            <i class="fas fa-award"></i>
                            <h5>My Commendations</h5>
                        </div>
                        <span class="commendation-count-badge" id="commendationCount">0</span>
                    </div>
                    <div id="commendationList">
                        <div class="loading-spinner">
                            <i class="fas fa-spinner fa-spin"></i>
                            <p>Loading commendations...</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

@if (isHrOrAdmin)
{
        <!-- Second Row: Total Employees + Position Chart -->
        <div class="row mb-3">
            <div class="col-xl-3 col-lg-4 col-md-6 col-12 mb-3 mb-xl-0">
                <div class="employee-count-card">
                    <i class="fas fa-users"></i>
                    <h2 id="totalEmployeesCount">0</h2>
                    <p>Total Active Employees</p>
                </div>
            </div>

            <div class="col-xl-9 col-lg-8 col-md-6 col-12">
                <div class="chart-card card">
                    <div class="chart-card-header card-header">
                        <h5 class="chart-card-title">
                            <i class="fas fa-briefcase text-primary"></i>
                            Employees by Position
                        </h5>
                    </div>
                    <div class="chart-card-body card-body">
                        <div class="chart-canvas-wrapper">
                            <canvas id="positionChart"></canvas>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Third Row: 3 Pie/Doughnut Charts -->
        <div class="row mb-3">
            <div class="col-xl-4 col-lg-4 col-md-6 col-12">
                <div class="chart-card card">
                    <div class="chart-card-header card-header">
                        <h5 class="chart-card-title">
                            <i class="fas fa-user-tag text-success"></i>
                            Employment Status
                        </h5>
                    </div>
                    <div class="chart-card-body card-body">
                        <div class="chart-canvas-wrapper">
                            <canvas id="employmentStatusChart"></canvas>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-xl-4 col-lg-4 col-md-6 col-12">
                <div class="chart-card card">
                    <div class="chart-card-header card-header">
                        <h5 class="chart-card-title">
                            <i class="fas fa-medal text-warning"></i>
                            Employees by Rank
                        </h5>
                    </div>
                    <div class="chart-card-body card-body">
                        <div class="chart-canvas-wrapper">
                            <canvas id="rankChart"></canvas>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-xl-4 col-lg-4 col-md-12 col-12">
                <div class="chart-card card">
                    <div class="chart-card-header card-header">
                        <h5 class="chart-card-title">
                            <i class="fas fa-building text-info"></i>
                            Employees by Department
                        </h5>
                    </div>
                    <div class="chart-card-body card-body">
                        <div class="chart-canvas-wrapper">
                            <canvas id="departmentChart"></canvas>
                        </div>
                    </div>
                </div>
            </div>
        </div>
}

