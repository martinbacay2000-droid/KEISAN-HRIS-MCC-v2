@section Fillow_script {
    <script>
        const isAdmin = @(isAdmin ? "true" : "false");
        const isHrOrAdmin = @(isHrOrAdmin ? "true" : "false");

        let positionChart, rankChart, employmentStatusChart, departmentChart;

        const chartColors = {
            primary: ['#3498db', '#2ecc71', '#e74c3c', '#f39c12', '#9b59b6', '#1abc9c', '#34495e', '#e67e22', '#95a5a6', '#16a085'],
            success: ['#28a745', '#20c997', '#17a2b8', '#6f42c1', '#fd7e14'],
            warm: ['#ff6b6b', '#feca57', '#48dbfb', '#ff9ff3', '#54a0ff', '#ee5a6f', '#c8d6e5', '#01a3a4']
        };

        // Function to update welcome image based on theme
        function updateWelcomeImage() {
            const isDarkMode = $('body').attr('data-theme-version') === 'dark';
            const $welcomeImage = $('.welcome-image-section img');

            if ($welcomeImage.length) {
                $welcomeImage.attr('src', isDarkMode
                    ? '/Fillow/images/logo-entrance-night.jpg'
                    : '/Fillow/images/logo-entrance-light.jpg'
                );
            }
        }

        // Watch for theme attribute changes using MutationObserver (wrapped in jQuery ready)
        $(document).ready(function() {
            // Set initial image
            updateWelcomeImage();

            // Create observer to watch body data-theme-version attribute
            const observer = new MutationObserver(function(mutations) {
                mutations.forEach(function(mutation) {
                    if (mutation.attributeName === 'data-theme-version') {
                        updateWelcomeImage();
                    }
                });
            });

            // Start observing
            observer.observe(document.body, {
                attributes: true,
                attributeFilter: ['data-theme-version']
            });
        });

        function updateDateTime() {
            const now = new Date();
            const monthNames = ["January", "February", "March", "April", "May", "June",
                "July", "August", "September", "October", "November", "December"];
            const month = monthNames[now.getMonth()];
            const day = now.getDate();
            const year = now.getFullYear();
            let hours = now.getHours();
            const minutes = String(now.getMinutes()).padStart(2, '0');
            const ampm = hours >= 12 ? 'PM' : 'AM';
            hours = hours % 12;
            hours = hours ? hours : 12;
            const formattedDate = `${month} ${day}, ${year} at ${hours}:${minutes} ${ampm}`;
            document.getElementById('currentDateTime').textContent = formattedDate;
        }

        function loadDashboardSummary() {
            fetch('/Dashboard/GetDashboardCounts')
                .then(response => response.json())
                .then(result => {
                    if (result.success && result.data) {
                        renderSummaryCards(result.data);
                    } else {
                        showError('Unable to load statistics');
                    }
                })
                .catch(error => {
                    console.error('Error loading dashboard:', error);
                    showError('Error loading dashboard data');
                });
        }

        function renderSummaryCards(data) {
            let totalPending = 0;
            let totalApproved = 0;
            let totalDeclined = 0;
            let totalCancelled = 0;

            Object.keys(data).forEach(key => {
                totalPending += data[key].pending;
                totalApproved += data[key].approved;
                totalDeclined += data[key].declined;
                totalCancelled += data[key].cancelled;
            });

            const container = document.getElementById('summaryCardsContainer');

            const cards = [
                {
                    status: 'pending',
                    icon: 'fa-clock',
                    count: totalPending,
                    label: 'Pending',
                    subtitle: isAdmin ? 'Awaiting your approval' : 'Awaiting approval'
                },
                {
                    status: 'approved',
                    icon: 'fa-check-circle',
                    count: totalApproved,
                    label: 'Approved',
                    subtitle: 'Successfully approved'
                },
                {
                    status: 'declined',
                    icon: 'fa-times-circle',
                    count: totalDeclined,
                    label: 'Declined',
                    subtitle: 'Not approved'
                },
                {
                    status: 'cancelled',
                    icon: 'fa-ban',
                    count: totalCancelled,
                    label: 'Cancelled',
                    subtitle: 'Cancelled requests'
                }
            ];

            let html = '';
            cards.forEach(card => {
                html += `
                    <div class="col-6 col-sm-3">
                        <div class="summary-card card ${card.status}">
                            <div class="summary-card-icon">
                                <i class="fas ${card.icon}"></i>
                            </div>
                            <div class="summary-card-number">${card.count}</div>
                            <div class="summary-card-label">${card.label}</div>
                            <div class="summary-card-subtitle">${card.subtitle}</div>
                        </div>
                    </div>
                `;
            });

            container.innerHTML = html;
        }

        function showError(message) {
            document.getElementById('summaryCardsContainer').innerHTML = `
                <div class="col-12">
                    <div class="alert alert-danger text-center">
                        <i class="fas fa-exclamation-triangle fa-2x mb-2"></i>
                        <p class="mb-0">${message}</p>
                    </div>
                </div>
            `;
        }

        function loadEmployeeStatistics() {
            fetch('/Dashboard/GetEmployeeStatistics')
                .then(response => response.json())
                .then(result => {
                    if (result.success && result.data) {
                        document.getElementById('totalEmployeesCount').textContent =
                            result.data.totalEmployees.toLocaleString();

                        renderPositionChart(result.data.employeesByPosition);
                        renderRankChart(result.data.employeesByRank);
                        renderEmploymentStatusChart(result.data.employeesByEmploymentStatus);
                        renderDepartmentChart(result.data.employeesByDepartment);
                    } else {
                        console.error('Error loading statistics:', result.message);
                    }
                })
                .catch(error => {
                    console.error('Error fetching employee statistics:', error);
                });
        }

        function renderPositionChart(data) {
            const ctx = document.getElementById('positionChart');
            if (!ctx) return;

            if (positionChart) {
                positionChart.destroy();
            }

            positionChart = new Chart(ctx, {
                type: 'bar',
                data: {
                    labels: data.map(item => item.name),
                    datasets: [{
                        label: 'Employees',
                        data: data.map(item => item.value),
                        backgroundColor: chartColors.primary,
                        borderWidth: 0,
                        borderRadius: 4
                    }]
                },
                options: {
                    indexAxis: 'y',
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: {
                        legend: { display: false },
                        tooltip: {
                            backgroundColor: 'rgba(0, 0, 0, 0.8)',
                            padding: 12,
                            callbacks: {
                                label: (context) => 'Employees: ' + context.parsed.x
                            }
                        }
                    },
                    scales: {
                        x: {
                            beginAtZero: true,
                            ticks: { precision: 0, font: { size: 10 } },
                            grid: { display: true, drawBorder: false }
                        },
                        y: {
                            grid: { display: false },
                            ticks: { font: { size: 10 } }
                        }
                    }
                }
            });
        }

        function renderRankChart(data) {
            const container = document.getElementById('rankChart').parentElement;
            if (!container) return;

            const sortedData = [...data].sort((a, b) => b.value - a.value);
            const total = sortedData.reduce((sum, item) => sum + item.value, 0);

            let html = '<div style="max-height: 220px; overflow-y: auto; overflow-x: hidden; padding: 0.5rem 0.5rem 0.5rem 0;">';

            const colors = ['#ff6b6b', '#feca57', '#48dbfb', '#ff9ff3', '#54a0ff', '#ee5a6f', '#c8d6e5'];

            sortedData.forEach((item, index) => {
                const percentage = ((item.value / total) * 100).toFixed(1);
                const barWidth = percentage;

                html += `
                    <div style="margin-bottom: 1rem;">
                        <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.35rem;">
                            <span style="font-size: 0.85rem; font-weight: 600;">${escapeHtml(item.name)}</span>
                            <span style="font-size: 0.85rem; font-weight: 700; color: ${colors[index % colors.length]};">${item.value}</span>
                        </div>
                        <div style="background: var(--bs-gray-300); border-radius: 10px; height: 22px; overflow: hidden; position: relative;">
                            <div style="background: linear-gradient(90deg, ${colors[index % colors.length]}, ${colors[index % colors.length]}dd); height: 100%; width: ${barWidth}%; border-radius: 10px; transition: width 0.6s ease; display: flex; align-items: center; justify-content: flex-end; padding-right: 0.5rem;">
                                <span style="color: white; font-size: 0.72rem; font-weight: 600;">${percentage}%</span>
                            </div>
                        </div>
                    </div>
                `;
            });

            html += '</div>';
            container.innerHTML = html;
        }

        function renderEmploymentStatusChart(data) {
            const ctx = document.getElementById('employmentStatusChart');
            if (!ctx) return;

            if (employmentStatusChart) {
                employmentStatusChart.destroy();
            }

            employmentStatusChart = new Chart(ctx, {
                type: 'bar',
                data: {
                    labels: data.map(item => item.name),
                    datasets: [{
                        label: 'Employees',
                        data: data.map(item => item.value),
                        backgroundColor: ['#28a745', '#20c997', '#17a2b8'],
                        borderWidth: 0,
                        borderRadius: 6
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: {
                        legend: { display: false },
                        tooltip: {
                            backgroundColor: 'rgba(0, 0, 0, 0.8)',
                            padding: 12,
                            callbacks: {
                                label: function(context) {
                                    const label = context.label || '';
                                    const value = context.parsed.y || 0;
                                    const total = context.dataset.data.reduce((a, b) => a + b, 0);
                                    const percentage = ((value / total) * 100).toFixed(1);
                                    return `${label}: ${value} (${percentage}%)`;
                                }
                            }
                        }
                    },
                    scales: {
                        y: {
                            beginAtZero: true,
                            ticks: {
                                precision: 0,
                                font: { size: 10 }
                            },
                            grid: {
                                display: true,
                                drawBorder: false
                            }
                        },
                        x: {
                            grid: { display: false },
                            ticks: { font: { size: 10 } }
                        }
                    }
                }
            });
        }

        function renderDepartmentChart(data) {
            const container = document.getElementById('departmentChart').parentElement;
            if (!container) return;

            const sortedData = [...data].sort((a, b) => b.value - a.value);
            const total = sortedData.reduce((sum, item) => sum + item.value, 0);
            const maxValue = Math.max(...sortedData.map(item => item.value));

            let html = '<div style="max-height: 220px; overflow-y: auto; overflow-x: hidden; padding: 0.5rem 0.5rem 0.5rem 0;">';

            const colors = chartColors.primary;

            sortedData.forEach((item, index) => {
                const percentage = ((item.value / total) * 100).toFixed(1);

                html += `
                    <div style="display: flex; align-items: center; margin-bottom: 0.85rem; gap: 0.75rem;">
                        <div style="flex: 0 0 115px; text-align: right;">
                            <div style="font-size: 0.78rem; font-weight: 600; line-height: 1.2;">${escapeHtml(item.name)}</div>
                        </div>
                        <div style="flex: 1; display: flex; align-items: center; gap: 0.5rem;">
                            <div style="flex: 1; background: var(--bs-gray-200); border-radius: 6px; height: 28px; position: relative; overflow: hidden;">
                                <div style="background: ${colors[index % colors.length]}; height: 100%; width: ${(item.value / maxValue) * 100}%; border-radius: 6px; transition: width 0.6s ease; display: flex; align-items: center; padding: 0 0.5rem;">
                                    <div style="display: flex; align-items: center; gap: 0.5rem; width: 100%;">
                                        <div style="background: white; border-radius: 50%; width: 18px; height: 18px; display: flex; align-items: center; justify-content: center; font-size: 0.65rem; font-weight: 700; color: ${colors[index % colors.length]}; flex-shrink: 0;">
                                            ${item.value}
                                        </div>
                                        <span style="color: white; font-size: 0.72rem; font-weight: 600; white-space: nowrap;">${percentage}%</span>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                `;
            });

            html += '</div>';
            container.innerHTML = html;
        }

        function loadEmployeeSchedule() {
            fetch('/Dashboard/GetEmployeeSchedule')
                .then(response => response.json())
                .then(result => {
                    const container = document.getElementById('scheduleList');
                    const effectivityDiv = document.getElementById('scheduleEffectivity');

                    console.log('Schedule Response:', result);

                    if (result.success && result.data && result.data.length > 0) {
                        const dates = [...new Set(result.data.map(s => s.effectivityDate))];

                        if (dates.length === 1) {
                            effectivityDiv.textContent = `Effective: ${dates[0]}`;
                        } else {
                            effectivityDiv.textContent = `Effective: Multiple schedules`;
                        }

                        let html = '';

                        const dayOrder = {
                            'Monday': 1, 'Tuesday': 2, 'Wednesday': 3, 'Thursday': 4,
                            'Friday': 5, 'Saturday': 6, 'Sunday': 7
                        };

                        const sortedSchedules = result.data.sort((a, b) => {
                            return (dayOrder[a.weekdayName] || 999) - (dayOrder[b.weekdayName] || 999);
                        });

                        sortedSchedules.forEach(schedule => {
                            const timeIn = schedule.timeIn || 'Rest Day';
                            const timeOut = schedule.timeOut || '';
                            const timeDisplay = timeOut ? `${timeIn} - ${timeOut}` : timeIn;

                            html += `
                                <div class="schedule-item">
                                    <div class="schedule-day">${escapeHtml(schedule.weekdayName)}</div>
                                    <div class="schedule-time">
                                        <i class="far fa-clock"></i>
                                        ${escapeHtml(timeDisplay)}
                                    </div>
                                </div>
                            `;
                        });

                        container.innerHTML = html;
                    } else {
                        effectivityDiv.textContent = '';
                        container.innerHTML = `
                            <div class="no-schedule">
                                <i class="fas fa-calendar-times"></i>
                                <p>No schedule assigned yet.</p>
                            </div>
                        `;
                    }
                })
                .catch(error => {
                    console.error('Error loading schedule:', error);
                    document.getElementById('scheduleList').innerHTML = `
                        <div class="no-schedule">
                            <i class="fas fa-exclamation-triangle"></i>
                            <p>Unable to load schedule.</p>
                        </div>
                    `;
                    document.getElementById('scheduleEffectivity').textContent = '';
                });
        }

        function loadAnnouncements() {
            fetch('/AnnouncementList/GetActiveAnnouncements')
                .then(response => response.json())
                .then(result => {
                    const container = document.getElementById('announcementsList');

                    if (result.success && result.data && result.data.length > 0) {
                        let html = '';
                        result.data.forEach(announcement => {
                            const dateAdded = formatDate(announcement.dtAdded);
                            const dateRange = formatDateRange(announcement.dateStart, announcement.dateEnd);

                            html += `
                                <div class="announcement-card">
                                    <div class="announcement-title">${escapeHtml(announcement.announcementTitle)}</div>
                                    <div class="announcement-content">${escapeHtml(announcement.announcement)}</div>
                                    <div class="announcement-meta">
                                        <span class="announcement-date">
                                            <i class="far fa-calendar"></i>
                                            ${dateRange}
                                        </span>
                                        <span class="announcement-author">
                                            <i class="far fa-user"></i>
                                            Posted by ${escapeHtml(announcement.addedByUserName || announcement.addedByUser)} on ${dateAdded}
                                        </span>
                                    </div>
                                </div>
                            `;
                        });
                        container.innerHTML = html;
                    } else {
                        container.innerHTML = `
                            <div class="no-announcements">
                                <i class="fas fa-bullhorn"></i>
                                <p>No active announcements at this time.</p>
                            </div>
                        `;
                    }
                })
                .catch(error => {
                    console.error('Error loading announcements:', error);
                    document.getElementById('announcementsList').innerHTML = `
                        <div class="no-announcements">
                            <i class="fas fa-exclamation-triangle"></i>
                            <p>Unable to load announcements.</p>
                        </div>
                    `;
                });
        }

                function loadMyCommendations() {
            fetch('/Dashboard/GetMyCommendations')
                .then(response => response.json())
                .then(result => {
                    const container = document.getElementById('commendationList');
                    const countBadge = document.getElementById('commendationCount');

                    if (result.success && result.data && result.data.length > 0) {
                        countBadge.textContent = result.data.length;

                        let html = '';
                        result.data.forEach(c => {
                            html += `
                                <div class="commendation-item">
                                    <div class="commendation-type-badge">
                                        <i class="fas fa-star"></i> ${escapeHtml(c.commendationType || 'Commendation')}
                                    </div>
                                    <div class="commendation-activity">${escapeHtml(c.activity || '')}</div>
                                    <div class="commendation-meta">
                                        <span><i class="far fa-calendar"></i> ${escapeHtml(c.dateissued || '')}</span>
                                        <span><i class="far fa-user"></i> ${escapeHtml(c.issuedBy || '')}</span>
                                    </div>
                                </div>
                            `;
                        });

                        container.innerHTML = html;
                    } else {
                        countBadge.textContent = '0';
                        container.innerHTML = `
                            <div class="no-commendations">
                                <i class="fas fa-award"></i>
                                <p>No commendations yet.</p>
                            </div>
                        `;
