                })
                .catch(error => {
                    console.error('Error loading commendations:', error);
                    document.getElementById('commendationList').innerHTML = `
                        <div class="no-commendations">
                            <i class="fas fa-exclamation-triangle"></i>
                            <p>Unable to load commendations.</p>
                        </div>
                    `;
                });
        }

        function formatDate(dateString) {
            if (!dateString) return 'N/A';
            const date = new Date(dateString);
            const monthNames = ["Jan", "Feb", "Mar", "Apr", "May", "Jun",
                "Jul", "Aug", "Sep", "Oct", "Nov", "Dec"];
            return `${monthNames[date.getMonth()]} ${date.getDate()}, ${date.getFullYear()}`;
        }

        function formatDateRange(startDate, endDate) {
            if (!startDate && !endDate) return 'Ongoing';
            if (!startDate) return `Until ${formatDate(endDate)}`;
            if (!endDate) return `From ${formatDate(startDate)}`;
            return `${formatDate(startDate)} - ${formatDate(endDate)}`;
        }

        // ── MEMO NOTIFICATION MANAGER ────────────────────────────────────────
        const memoNotif = (() => {
            let memos   = [];
            let current = 0;

            function escHtml(str) {
                if (!str) return '';
                const d = document.createElement('div');
                d.textContent = str;
                return d.innerHTML;
            }

            function render(index) {
                const m = memos[index];
                if (!m) return;

                document.getElementById('memoNotifTitle').textContent   = m.title    || '(No Title)';
                document.getElementById('memoNotifSeries').textContent  = m.seriesNo || '—';
                document.getElementById('memoNotifDate').textContent    = m.effectivityDateFormatted || '—';
                document.getElementById('memoNotifIssuedDate').textContent = m.dateAdded || '—';

                const remarksWrap = document.getElementById('memoNotifRemarksWrap');
                if (m.remarks && m.remarks.trim()) {
                    document.getElementById('memoNotifRemarks').textContent = m.remarks;
                    remarksWrap.style.display = 'block';
                } else {
                    remarksWrap.style.display = 'none';
                }

                const pager   = document.getElementById('memoNotifPager');
                const navBtns = document.getElementById('memoNotifNavBtns');
                const navPh   = document.getElementById('memoNotifNavPlaceholder');
                if (memos.length > 1) {
                    pager.textContent     = `${index + 1} / ${memos.length}`;
                    pager.style.display   = 'block';
                    navBtns.style.display = 'flex';
                    navPh.style.display   = 'none';
                } else {
                    pager.style.display   = 'none';
                    navBtns.style.display = 'none';
                    navPh.style.display   = 'block';
                }
            }

            function show() {
                if (!memos.length) return;
                current = 0;
                render(current);
                document.getElementById('memoNotifOverlay').classList.add('active');
            }

            function hide() {
                document.getElementById('memoNotifOverlay').classList.remove('active');
            }

            return {
                init(data) {
                    memos   = data || [];
                    current = 0;
                    if (memos.length) show();
                },

                prev() {
                    if (current > 0) { current--; render(current); }
                },

                next() {
                    if (current < memos.length - 1) { current++; render(current); }
                },

                closeLater() {
                    hide();
                },

                receive() {
                    const m   = memos[current];
                    const btn = document.getElementById('btnMemoNotifReceived');
                    btn.disabled = true;
                    btn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Processing...';

                    fetch('/Dashboard/MarkMemoReceived', {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/x-www-form-urlencoded',
                            'X-Requested-With': 'XMLHttpRequest'
                        },
                        body: `notificationId=${m.notificationId}`
                    })
                    .then(r => r.json())
                    .then(() => {
                        memos.splice(current, 1);
                        populateMemoDetail(m);
                        hide();
                        const detailModal = new bootstrap.Modal(
                            document.getElementById('memoNotifDetailModal'));
                        detailModal.show();

                        document.getElementById('memoNotifDetailModal')
                            .addEventListener('hidden.bs.modal', function onHide() {
                                this.removeEventListener('hidden.bs.modal', onHide);
                                if (memos.length > 0) {
                                    current = 0;
                                    render(current);
                                    document.getElementById('memoNotifOverlay').classList.add('active');
                                    const b = document.getElementById('btnMemoNotifReceived');
                                    b.disabled = false;
                                    b.innerHTML = '<i class="fas fa-check-circle"></i> Mark as Received';
                                }
                            }, { once: true });
                    })
                    .catch(() => {
                        btn.disabled = false;
                        btn.innerHTML = '<i class="fas fa-check-circle"></i> Mark as Received';
                    });
                }
            };
        })();

        function populateMemoDetail(m) {
            document.getElementById('memoDetailModalTitle').textContent = m.title || 'Memo';
            document.getElementById('memoDetailSeriesNo').textContent   = m.seriesNo || '—';
            document.getElementById('memoDetailEffDate').textContent    = m.effectivityDateFormatted || '—';
            document.getElementById('memoDetailTitle').textContent      = m.title || '—';
            document.getElementById('memoDetailCreatedBy').textContent  = m.createdBy || '—';

            const remarksWrap = document.getElementById('memoDetailRemarksWrap');
            if (m.remarks && m.remarks.trim()) {
                document.getElementById('memoDetailRemarks').textContent = m.remarks;
                remarksWrap.style.display = 'block';
            } else {
                remarksWrap.style.display = 'none';
            }

            const attContainer = document.getElementById('memoDetailAttachments');
            attContainer.innerHTML = '<small class="text-muted"><i class="fas fa-spinner fa-spin me-1"></i>Loading attachments...</small>';

            fetch(`/Dashboard/GetMemoAttachments?memoId=${m.memoId}`)
                .then(r => r.json())
                .then(data => {
                    attContainer.innerHTML = '';
                    if (data && data.length > 0) {
                        const label = document.createElement('div');
                        label.className = 'fw-semibold text-muted mb-2';
                        label.style.cssText = 'font-size:0.78rem; text-transform:uppercase; letter-spacing:0.5px;';
                        label.textContent = 'Attachments';
                        attContainer.appendChild(label);

                        data.forEach(att => {
                            const fileName = att.attachmentPath.split('/').pop();
                            const item = document.createElement('div');
                            item.className = 'attachment-item';
                            item.innerHTML = `
                                <i class="fas fa-file"></i>
                                <a href="${att.attachmentPath}" target="_blank">${fileName}</a>
                                <small class="text-muted ms-auto">
                                    ${new Date(att.dtAdded).toLocaleDateString()}
                                </small>`;
                            attContainer.appendChild(item);
                        });
                    } else {
                        attContainer.innerHTML = '<small class="text-muted">No attachments.</small>';
                    }
                })
                .catch(() => {
                    attContainer.innerHTML = '<small class="text-muted">Could not load attachments.</small>';
                });
        }

        function loadPendingMemoNotifications() {
            fetch('/Dashboard/GetPendingMemoNotifications')
                .then(r => r.json())
                .then(res => {
                    if (res.success && res.data && res.data.length > 0) {
                        memoNotif.init(res.data);
                    }
                })
                .catch(err => console.warn('Memo notifications error:', err));
        }

        function escapeHtml(text) {
            if (!text) return '';
            const div = document.createElement('div');
            div.textContent = text;
            return div.innerHTML;
        }

        document.addEventListener('DOMContentLoaded', function() {
            updateDateTime();
            setInterval(updateDateTime, 1000);
            loadDashboardSummary();
            if (isHrOrAdmin) {
                loadEmployeeStatistics();
            }
            loadEmployeeSchedule();
            loadAnnouncements();
            loadMyCommendations();
            loadPendingMemoNotifications();
        });
    </script>
}
