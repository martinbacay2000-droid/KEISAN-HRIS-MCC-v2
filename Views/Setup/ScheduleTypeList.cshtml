@{
    Layout = "~/Views/Shared/_LayoutFillow.cshtml";
    ViewData["Title"] = "Schedule Type List";
}

<div class="col-12">
    <div class="card">
        <div class="card-header">
            <div class="row" style="width:100%;">
                <h4 class="card-title">Schedule Type List</h4>
                <br> <br> <br>

                <div class="row" style="margin-left:0px;width:100%;">
                    <div class="col-md-3">
                        <div class="form-group">
                            <h5>Record Status</h5>
                            <select name="filterRecordStatus" id="filterRecordStatus" class="form-control">
                                <option value="active" selected>ACTIVE</option>
                                <option value="inactive">INACTIVE</option>
                            </select>
                        </div>
                    </div>
                    <div class="col-md-6">
                    </div>
                    <div class="col-md-3 d-flex justify-content-end align-items-end">
                        <div class="form-group">
                            <button type="button" class="btn btn-primary" id="btnAddScheduleType">
                                <i class="fa fa-plus"></i> New Schedule Type
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="card-body">
            <div class="table-responsive">
                <table id="scheduleTypeTable" class="display" style="min-width: 845px">
                    <thead>
                        <tr>
                            <th>Action</th>
                            <th>Schedule Type Code</th>
                            <th>Schedule Type Name</th>
                        </tr>
                    </thead>
                </table>
            </div>
        </div>

        <!-- Modal for Add -->
        <div class="modal fade" id="addScheduleTypeModal" tabindex="-1" aria-hidden="true">
            <div class="modal-dialog">
                <div class="modal-content">
                    <div class="modal-header">
                        <h5 class="modal-title">Schedule Type Form</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                    </div>
                    <div class="modal-body">
                        <form id="addScheduleTypeForm">
                            <div class="mb-3">
                                <label for="addScheduleTypeCode" class="form-label">Schedule Type Code <span class="text-danger">*</span></label>
                                <input type="text" class="form-control alphanum" id="addScheduleTypeCode" name="scheduleTypeCode" required maxlength="50">
                                <div class="invalid-feedback">
                                    Please provide a valid schedule type code.
                                </div>
                            </div>

                            <div class="mb-3">
                                <label for="addScheduleTypeName" class="form-label">Schedule Type Name <span class="text-danger">*</span></label>
                                <input type="text" class="form-control" id="addScheduleTypeName" name="scheduleTypeName" required maxlength="50">
                                <div class="invalid-feedback">
                                    Please provide a valid schedule type name.
                                </div>
                            </div>
                        </form>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-primary" id="btnSaveNewScheduleType">Save</button>
                    </div>
                </div>
            </div>
        </div>

        <!-- Modal for View/Edit -->
        <div class="modal fade" id="viewScheduleTypeModal" tabindex="-1" aria-hidden="true">
            <div class="modal-dialog">
                <div class="modal-content">
                    <div class="modal-header">
                        <h5 class="modal-title" id="viewModalTitle">View Schedule Type Form</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                    </div>
                    <div class="modal-body">
                        <form id="viewScheduleTypeForm">
                            <input type="hidden" id="viewScheduleTypeId" name="id">

                            <div class="mb-3">
                                <label for="viewScheduleTypeCode" class="form-label">Schedule Type Code <span class="text-danger edit-required d-none">*</span></label>
                                <input type="text" class="form-control alphanum" id="viewScheduleTypeCode" name="scheduleTypeCode" readonly maxlength="50">
                                <div class="invalid-feedback">
                                    Please provide a valid schedule type code.
                                </div>
                            </div>

                            <div class="mb-3">
                                <label for="viewScheduleTypeName" class="form-label">Schedule Type Name <span class="text-danger edit-required d-none">*</span></label>
                                <input type="text" class="form-control" id="viewScheduleTypeName" name="scheduleTypeName" readonly maxlength="50">
                                <div class="invalid-feedback">
                                    Please provide a valid schedule type name.
                                </div>
                            </div>
                        </form>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-primary" id="btnEditScheduleType">
                            <i class="fas fa-edit"></i> Edit
                        </button>
                        <button type="button" class="btn btn-success d-none" id="btnSaveScheduleType">Save</button>
                        <button type="button" class="btn btn-danger d-none" id="btnCancelEdit">Cancel</button>
                    </div>
                </div>
            </div>
        </div>

    </div>
</div>

@section Fillow_style
{
    <style>
        .table-responsive {
            border-radius: 0.375rem;
        }

        #scheduleTypeTable_wrapper .dataTables_length,
        #scheduleTypeTable_wrapper .dataTables_filter {
            margin-bottom: 1rem;
        }

        #scheduleTypeTable_wrapper .dataTables_info,
        #scheduleTypeTable_wrapper .dataTables_paginate {
            margin-top: 1rem;
        }

        .btn-sm {
            padding: 0.25rem 0.5rem;
            font-size: 0.875rem;
        }

        .modal-content {
            border-radius: 0.5rem;
            box-shadow: 0 0.5rem 1rem rgba(0, 0, 0, 0.15);
        }

        .form-control:focus,
        .form-select:focus {
            border-color: #0d6efd;
            box-shadow: 0 0 0 0.2rem rgba(13, 110, 253, 0.25);
        }

        .invalid-feedback {
            display: none;
        }

        .form-control.is-invalid,
        .form-select.is-invalid {
            border-color: #dc3545;
        }

            .form-control.is-invalid ~ .invalid-feedback,
            .form-select.is-invalid ~ .invalid-feedback {
                display: block;
            }

        .form-control[readonly] {
            background-color: #f8f9fa;
            border-color: #dee2e6;
        }

        .form-select[disabled] {
            background-color: #f8f9fa;
            border-color: #dee2e6;
        }

        .edit-mode .form-control[readonly] {
            background-color: #ffffff;
            border-color: #ced4da;
        }

        .edit-mode .form-select[disabled] {
            background-color: #ffffff;
            border-color: #ced4da;
        }

        .swal2-popup {
            border-radius: 15px !important;
            padding: 2rem !important;
        }

        .swal2-icon.swal2-error {
            border-color: #f27474 !important;
            color: #f27474 !important;
        }

            .swal2-icon.swal2-error .swal2-x-mark {
                display: none !important;
            }

            .swal2-icon.swal2-error::before {
                content: "\f2ed" !important;
                font-family: "Font Awesome 5 Free" !important;
                font-weight: 900 !important;
                font-size: 2.5rem !important;
                color: #f27474 !important;
                display: block !important;
            }

        .swal2-title {
            font-size: 1.875rem !important;
            font-weight: 600 !important;
            color: #545454 !important;
            margin: 1rem 0 0.5rem 0 !important;
        }

        .swal2-html-container {
            font-size: 1rem !important;
            color: #737373 !important;
            margin: 0 0 2rem 0 !important;
        }

        .swal2-actions {
            gap: 0.5rem !important;
        }

        .swal2-confirm {
            background-color: #7c3aed !important;
            border-color: #7c3aed !important;
            color: white !important;
            font-weight: 500 !important;
            padding: 0.75rem 2rem !important;
            border-radius: 8px !important;
            font-size: 0.875rem !important;
        }

        .swal2-cancel {
            background-color: #6b7280 !important;
            border-color: #6b7280 !important;
            color: white !important;
            font-weight: 500 !important;
            padding: 0.75rem 2rem !important;
            border-radius: 8px !important;
            font-size: 0.875rem !important;
        }

        .swal2-confirm:hover {
            background-color: #6d28d9 !important;
            border-color: #6d28d9 !important;
        }

        .swal2-cancel:hover {
            background-color: #4b5563 !important;
            border-color: #4b5563 !important;
        }

        .btn-success.shadow-sm:hover {
            background-color: #1e7e34;
            border-color: #1c7430;
        }

        .card-header {
            border-bottom: none !important;
        }

        #filterRecordStatus {
            width: 100%;
        }
    </style>
}

@section Fillow_script
{
    <script>
        $(document).ready(function () {

            MODULE = 'SscheduletyeplistM';
            access = ROLE_ACCESS?.[MODULE];

            if (access != 'READWRITE' && access != 'FULL') {
                $('#btnAddScheduleType').hide();
                $('#btnEditScheduleType').hide();
            }

            toastr.options = {
                positionClass: "toast-top-right",
                timeOut: 5000,
                closeButton: true,
                debug: false,
                newestOnTop: true,
                progressBar: true,
                preventDuplicates: true,
                onclick: null,
                showDuration: "300",
                hideDuration: "1000",
                extendedTimeOut: "1000",
                showEasing: "swing",
                hideEasing: "linear",
                showMethod: "fadeIn",
                hideMethod: "fadeOut",
                tapToDismiss: false
            };

            let isViewingDeleted = false;

            $('#filterRecordStatus').select2({
                selectOnClose: true,
                minimumResultsForSearch: Infinity
            });

            $('#filterRecordStatus').on('change', function () {
                isViewingDeleted = $(this).val() === 'inactive';
                updateTableView();
            });

            var table = $('#scheduleTypeTable').DataTable({
                processing: true,
                serverSide: false,
                ajax: {
                    url: "/ScheduleTypeList/GetScheduleTypeList",
                    type: "GET",
                    datatype: "json",
                    error: function(xhr, error, code) {
                        console.log('Error loading data:', error);
                        showNotification('Error loading schedule type data. Please refresh the page.', 'error');
                    }
                },
                columns: [
                    {
                        data: "id",
                        width: "20%",
                        orderable: false,
                        render: function (data) {
                            if (isViewingDeleted) {
                                return `
                                    <div class="d-flex gap-1">
                                        <button type="button" class="btn btn-sm btn-success shadow-sm restoreScheduleType" data-id="${data}" title="Restore">
                                            <i class="fas fa-undo"></i>
                                        </button>
                                    </div>`;
                            } else {
                                return `
                                    <div class="d-flex gap-1">
                                        <button type="button" class="btn btn-sm btn-primary shadow-sm viewScheduleType" data-id="${data}" title="View">
                                            <i class="fas fa-eye"></i>
                                        </button>
                                        <button type="button" class="btn btn-sm btn-danger shadow-sm deleteScheduleType" data-id="${data}" title="Delete">
                                            <i class="fa fa-trash"></i>
                                        </button>
                                    </div>`;
                            }
                        }
                    },
                    {
                        data: "scheduleTypeCode",
                        width: "25%"
                    },
                    {
                        data: "scheduleTypeName",
                        width: "55%"
                    }
                ],
                order: [],
                pageLength: 25,
                lengthMenu: [[10, 25, 50, 100, -1], [10, 25, 50, 100, "All"]],
                language: {
                    processing: "Loading...",
                    emptyTable: "No schedule types found",
                    zeroRecords: "No matching schedule types found",
                    paginate: {
                        next: '<i class="fa fa-angle-double-right" aria-hidden="true"></i>',
                        previous: '<i class="fa fa-angle-double-left" aria-hidden="true"></i>'
                    }
                }
            });

            $('#btnAddScheduleType').click(function () {
                resetAddForm();
                $('#addScheduleTypeModal').modal('show');

                $('#addScheduleTypeModal').on('shown.bs.modal', function () {
                    $('#addScheduleTypeCode').focus();
                });
            });

            $(document).on('click', '.viewScheduleType', function (e) {
                e.preventDefault();
                var id = $(this).data('id');
                var $btn = $(this);

                $btn.prop('disabled', true);
                $btn.html('<i class="fas fa-spinner fa-spin"></i>');

                $.get('/ScheduleTypeList/GetScheduleType', { id: id }, function (data) {
                    if (data) {
                        resetViewForm();
                        setViewMode();

                        $('#viewScheduleTypeId').val(data.id);
                        $('#viewScheduleTypeCode').val(data.scheduleTypeCode);
                        $('#viewScheduleTypeName').val(data.scheduleTypeName);

                        $('#viewScheduleTypeModal').modal('show');
                    } else {
                        showNotification('Unable to load schedule type data', 'error');
                    }
                }).fail(function(xhr, status, error) {
                    console.log('Error loading schedule type:', error);
                    showNotification('Unable to load schedule type data', 'error');
                }).always(function() {
                    $btn.prop('disabled', false);
                    $btn.html('<i class="fas fa-eye"></i>');
                });
            });

            $('#btnEditScheduleType').click(function () {
                setEditMode();
                $('#viewScheduleTypeCode').focus();
            });

            $('#btnCancelEdit').click(function () {
                var id = $('#viewScheduleTypeId').val();
                $.get('/ScheduleTypeList/GetScheduleType', { id: id }, function (data) {
                    if (data) {
                        $('#viewScheduleTypeCode').val(data.scheduleTypeCode);
                        $('#viewScheduleTypeName').val(data.scheduleTypeName);
                        setViewMode();
                        clearValidation('#viewScheduleTypeForm');
                    }
                });
            });

            $('#btnSaveScheduleType').click(function () {
                clearValidation('#viewScheduleTypeForm');

                if (!validateViewForm()) {
                    return;
                }

                var formData = {
                    id: parseInt($('#viewScheduleTypeId').val()),
                    scheduleTypeCode: $('#viewScheduleTypeCode').val().trim(),
                    scheduleTypeName: $('#viewScheduleTypeName').val().trim()
                };

                var $saveBtn = $('#btnSaveScheduleType');
                $saveBtn.prop('disabled', true).html('<i class="fas fa-spinner fa-spin"></i> Saving...');

                $.post('/ScheduleTypeList/UpdateScheduleType', formData, function (response) {
                    if (response.success) {
                        setViewMode();
                        table.ajax.reload(null, false);
                        showNotification(response.message, 'success');
                    } else {
                        showNotification(response.message, 'error');
                    }
                }).fail(function(xhr, status, error) {
                    console.log('Error saving schedule type:', error);
                    showNotification('Unable to save schedule type. Please try again.', 'error');
                }).always(function() {
                    $saveBtn.prop('disabled', false).html('Save');
                });
            });

            $('#btnSaveNewScheduleType').click(function () {
                clearValidation('#addScheduleTypeForm');

                if (!validateAddForm()) {
                    return;
                }

                var formData = {
                    scheduleTypeCode: $('#addScheduleTypeCode').val().trim(),
                    scheduleTypeName: $('#addScheduleTypeName').val().trim()
                };

                var $saveBtn = $('#btnSaveNewScheduleType');
                $saveBtn.prop('disabled', true).html('<i class="fas fa-spinner fa-spin"></i> Saving...');

                $.post('/ScheduleTypeList/AddScheduleType', formData, function (response) {
                    if (response.success) {
                        $('#addScheduleTypeModal').modal('hide');
                        table.ajax.reload(null, false);
                        showNotification(response.message, 'success');
                    } else {
                        showNotification(response.message, 'error');
                    }
                }).fail(function(xhr, status, error) {
                    console.log('Error saving schedule type:', error);
                    showNotification('Unable to save schedule type. Please try again.', 'error');
                }).always(function() {
                    $saveBtn.prop('disabled', false).html('Save');
                });
            });

            $(document).on('click', '.deleteScheduleType', function (e) {
                e.preventDefault();
                deleteWithReason({
                    title: 'InactiveSchedule Type',
                    text: 'Are you sure you want to inactive this schedule type?',
                    url: '/ScheduleTypeList/DeleteScheduleType',
                    id: $(this).data('id'),
                    button: $(this),
                    table: table
                });
            });

            $(document).on('click', '.restoreScheduleType', function (e) {
                e.preventDefault();
                var id = $(this).data('id');
                var $btn = $(this);

                Swal.fire({
                    title: 'Restore Record',
                    text: 'Are you sure you want to restore this schedule type?',
                    icon: 'question',
                    showCancelButton: true,
                    confirmButtonText: 'Yes, Restore',
                    cancelButtonText: 'Cancel',
                    confirmButtonColor: '#28a745',
                    cancelButtonColor: '#6c757d',
                    reverseButtons: false,
                    allowOutsideClick: false,
                    allowEscapeKey: false
                }).then((result) => {
                    if (result.isConfirmed) {
                        $btn.prop('disabled', true);
                        $btn.html('<i class="fas fa-spinner fa-spin"></i>');

                        $.post('/ScheduleTypeList/RestoreScheduleType', { id: id }, function (response) {
                            if (response.success) {
                                table.ajax.reload(null, false);
                                showNotification(response.message, 'success');
                            } else {
                                showNotification(response.message, 'error');
                            }
                        }).fail(function(xhr, status, error) {
                            console.log('Error restoring schedule type:', error);
                            showNotification('Unable to restore schedule type. Please try again.', 'error');
                        }).always(function() {
                            $btn.prop('disabled', false);
                            $btn.html('<i class="fas fa-undo"></i>');
                        });
                    }
                });
            });

            $('#addScheduleTypeModal').on('hidden.bs.modal', function () {
                resetAddForm();
            });

            $('#viewScheduleTypeModal').on('hidden.bs.modal', function () {
                resetViewForm();
                setViewMode();
            });

            $('#addScheduleTypeForm').on('keypress', function(e) {
                if (e.which === 13) {
                    e.preventDefault();
                    $('#btnSaveNewScheduleType').click();
                }
            });

            $('#viewScheduleTypeForm').on('keypress', function(e) {
                if (e.which === 13 && $('#viewScheduleTypeModal .modal-body').hasClass('edit-mode')) {
                    e.preventDefault();
                    $('#btnSaveScheduleType').click();
                }
            });

            function updateTableView() {
                if (isViewingDeleted) {
                    table.ajax.url('/ScheduleTypeList/GetDeletedScheduleTypeList').load();
                    $('#btnAddScheduleType').hide();
                } else {
                    table.ajax.url('/ScheduleTypeList/GetScheduleTypeList').load();
                    $('#btnAddScheduleType').show();
                }
            }

            function resetAddForm() {
                $('#addScheduleTypeForm')[0].reset();
                clearValidation('#addScheduleTypeForm');
                $('#btnSaveNewScheduleType').prop('disabled', false).html('Save');
            }

            function resetViewForm() {
                $('#viewScheduleTypeForm')[0].reset();
                clearValidation('#viewScheduleTypeForm');
                $('#btnSaveScheduleType').prop('disabled', false).html('Save');
            }

            function setViewMode() {
                $('#viewModalTitle').text('View Schedule Type');
                $('#viewScheduleTypeModal .modal-body').removeClass('edit-mode');

                $('#viewScheduleTypeCode').prop('readonly', true);
                $('#viewScheduleTypeName').prop('readonly', true);

                $('.edit-required').addClass('d-none');

                $('#btnEditScheduleType').removeClass('d-none');
                $('#btnSaveScheduleType').addClass('d-none');
                $('#btnCancelEdit').addClass('d-none');

                clearValidation('#viewScheduleTypeForm');
            }

            function setEditMode() {
                $('#viewModalTitle').text('Edit Schedule Type');
                $('#viewScheduleTypeModal .modal-body').addClass('edit-mode');

                $('#viewScheduleTypeCode').prop('readonly', false);
                $('#viewScheduleTypeName').prop('readonly', false);

                $('.edit-required').removeClass('d-none');

                $('#btnEditScheduleType').addClass('d-none');
                $('#btnSaveScheduleType').removeClass('d-none');
                $('#btnCancelEdit').removeClass('d-none');
            }

            function clearValidation(formSelector) {
                $(formSelector + ' .form-control, ' + formSelector + ' .form-select').removeClass('is-invalid');
                $(formSelector + ' .invalid-feedback').hide();
            }

            function validateAddForm() {
                var isValid = true;

                var scheduleTypeCode = $('#addScheduleTypeCode').val().trim();
                if (!scheduleTypeCode) {
                    $('#addScheduleTypeCode').addClass('is-invalid');
                    isValid = false;
                }

                var scheduleTypeName = $('#addScheduleTypeName').val().trim();
                if (!scheduleTypeName) {
                    $('#addScheduleTypeName').addClass('is-invalid');
                    isValid = false;
                }

                return isValid;
            }

            function validateViewForm() {
                var isValid = true;

                var scheduleTypeCode = $('#viewScheduleTypeCode').val().trim();
                if (!scheduleTypeCode) {
                    $('#viewScheduleTypeCode').addClass('is-invalid');
                    isValid = false;
                }

                var scheduleTypeName = $('#viewScheduleTypeName').val().trim();
                if (!scheduleTypeName) {
                    $('#viewScheduleTypeName').addClass('is-invalid');
                    isValid = false;
                }

                return isValid;
            }

            function showNotification(message, type) {
                if (type === 'success') {
                    toastr.success(message, "Success");
                } else if (type === 'error') {
                    toastr.error(message, "Error");
                } else if (type === 'warning') {
                    toastr.warning(message, "Warning");
                } else if (type === 'info') {
                    toastr.info(message, "Information");
                } else {
                    toastr.info(message, "Notification");
                }
            }

            $('#addScheduleTypeCode, #addScheduleTypeName').on('input', function() {
                $(this).removeClass('is-invalid');
            });

            $('#viewScheduleTypeCode, #viewScheduleTypeName').on('input', function() {
                $(this).removeClass('is-invalid');
            });
        });
    </script>
}