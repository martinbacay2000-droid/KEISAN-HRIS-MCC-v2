@{
    Layout = "~/Views/Shared/_LayoutFillow.cshtml";
    ViewData["Title"] = "Leave List";
}

<div class="col-12">
    <div class="card">
        <div class="card-header">
            <div class="row" style="width:100%;">
                <h4 class="card-title">Leave List</h4>
                <br> <br> <br>

                <div class="row" style="margin-left:0px;width:100%;">
                    <div class="col-md-3">
                        <div class="form-group">
                            <h5>Record Status</h5>
                            <select name="filterRecordStatus" id="filterRecordStatus" class="form-control">
                                <option value="active" selected>ACTIVE</option>
                                <option value="inactive">INACTIVE</option>
                            </select>
                        </div>
                    </div>
                    <div class="col-md-6">
                    </div>
                    <div class="col-md-3 d-flex justify-content-end align-items-end">
                        <div class="form-group">
                            <button type="button" class="btn btn-primary" id="btnAddLeave">
                                <i class="fa fa-plus"></i> New Leave
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="card-body">
            <div class="table-responsive">
                <table id="leaveTable" class="display" style="min-width: 845px">
                    <thead>
                        <tr>
                            <th>Action</th>
                            <th>Leave Code</th>
                            <th>Leave Name</th>
                            <th>Leave Credits</th>
                        </tr>
                    </thead>
                </table>
            </div>
        </div>

        <!-- Modal for Add -->
        <div class="modal fade" id="addLeaveModal" tabindex="-1" aria-hidden="true">
            <div class="modal-dialog">
                <div class="modal-content">
                    <div class="modal-header">
                        <h5 class="modal-title">Leave Form</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                    </div>
                    <div class="modal-body">
                        <form id="addLeaveForm">
                            <div class="mb-3">
                                <label for="addLeaveCode" class="form-label">Leave Code <span class="text-danger">*</span></label>
                                <input type="text" class="form-control alphanum" id="addLeaveCode" name="leaveCode" required maxlength="50">
                                <div class="invalid-feedback">
                                    Please provide a valid leave code.
                                </div>
                            </div>

                            <div class="mb-3">
                                <label for="addLeaveName" class="form-label">Leave Name <span class="text-danger">*</span></label>
                                <input type="text" class="form-control" id="addLeaveName" name="leaveName" required maxlength="255">
                                <div class="invalid-feedback">
                                    Please provide a valid leave name.
                                </div>
                            </div>

                            <div class="mb-3">
                                <label for="addLeaveCredits" class="form-label">Leave Credits <span class="text-danger">*</span></label>
                                <input type="number" class="form-control" id="addLeaveCredits" name="leaveCredits" required step="0.1" min="0" max="999.9">
                                <div class="invalid-feedback">
                                    Please provide valid leave credits.
                                </div>
                            </div>
                        </form>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-primary" id="btnSaveNewLeave">Save</button>
                    </div>
                </div>
            </div>
        </div>

        <!-- Modal for View/Edit -->
        <div class="modal fade" id="viewLeaveModal" tabindex="-1" aria-hidden="true">
            <div class="modal-dialog">
                <div class="modal-content">
                    <div class="modal-header">
                        <h5 class="modal-title" id="viewModalTitle">View Leave Form</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                    </div>
                    <div class="modal-body">
                        <form id="viewLeaveForm">
                            <input type="hidden" id="viewLeaveId" name="id">

                            <div class="mb-3">
                                <label for="viewLeaveCode" class="form-label">Leave Code <span class="text-danger edit-required d-none">*</span></label>
                                <input type="text" class="form-control alphanum" id="viewLeaveCode" name="leaveCode" readonly maxlength="50">
                                <div class="invalid-feedback">
                                    Please provide a valid leave code.
                                </div>
                            </div>

                            <div class="mb-3">
                                <label for="viewLeaveName" class="form-label">Leave Name <span class="text-danger edit-required d-none">*</span></label>
                                <input type="text" class="form-control" id="viewLeaveName" name="leaveName" readonly maxlength="255">
                                <div class="invalid-feedback">
                                    Please provide a valid leave name.
                                </div>
                            </div>

                            <div class="mb-3">
                                <label for="viewLeaveCredits" class="form-label">Leave Credits <span class="text-danger edit-required d-none">*</span></label>
                                <input type="number" class="form-control" id="viewLeaveCredits" name="leaveCredits" readonly step="0.1" min="0" max="999.9">
                                <div class="invalid-feedback">
                                    Please provide valid leave credits.
                                </div>
                            </div>
                        </form>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-primary" id="btnEditLeave">
                            <i class="fas fa-edit"></i> Edit
                        </button>
                        <button type="button" class="btn btn-success d-none" id="btnSaveLeave">Save</button>
                        <button type="button" class="btn btn-danger d-none" id="btnCancelEdit">Cancel</button>
                    </div>
                </div>
            </div>
        </div>

    </div>
</div>

@section Fillow_style
{

    <style>
        .table-responsive {
            border-radius: 0.375rem;
        }

        #leaveTable_wrapper .dataTables_length,
        #leaveTable_wrapper .dataTables_filter {
            margin-bottom: 1rem;
        }

        #leaveTable_wrapper .dataTables_info,
        #leaveTable_wrapper .dataTables_paginate {
            margin-top: 1rem;
        }

        .btn-sm {
            padding: 0.25rem 0.5rem;
            font-size: 0.875rem;
        }

        .modal-content {
            border-radius: 0.5rem;
            box-shadow: 0 0.5rem 1rem rgba(0, 0, 0, 0.15);
        }

        .form-control:focus,
        .form-select:focus {
            border-color: #0d6efd;
            box-shadow: 0 0 0 0.2rem rgba(13, 110, 253, 0.25);
        }

        .invalid-feedback {
            display: none;
        }

        .form-control.is-invalid,
        .form-select.is-invalid {
            border-color: #dc3545;
        }

            .form-control.is-invalid ~ .invalid-feedback,
            .form-select.is-invalid ~ .invalid-feedback {
                display: block;
            }

        /* Readonly/disabled field styling */
        .form-control[readonly] {
            background-color: #f8f9fa;
            border-color: #dee2e6;
        }

        .form-select[disabled] {
            background-color: #f8f9fa;
            border-color: #dee2e6;
        }

        /* Edit mode styling */
        .edit-mode .form-control[readonly] {
            background-color: #ffffff;
            border-color: #ced4da;
        }

        .edit-mode .form-select[disabled] {
            background-color: #ffffff;
            border-color: #ced4da;
        }

        /* Custom SweetAlert2 styling */
        .swal2-popup {
            border-radius: 15px !important;
            padding: 2rem !important;
        }

        .swal2-icon.swal2-error {
            border-color: #f27474 !important;
            color: #f27474 !important;
        }

            .swal2-icon.swal2-error .swal2-x-mark {
                display: none !important;
            }

            .swal2-icon.swal2-error::before {
                content: "\f2ed" !important;
                font-family: "Font Awesome 5 Free" !important;
                font-weight: 900 !important;
                font-size: 2.5rem !important;
                color: #f27474 !important;
                display: block !important;
            }

        .swal2-title {
            font-size: 1.875rem !important;
            font-weight: 600 !important;
            color: #545454 !important;
            margin: 1rem 0 0.5rem 0 !important;
        }

        .swal2-html-container {
            font-size: 1rem !important;
            color: #737373 !important;
            margin: 0 0 2rem 0 !important;
        }

        .swal2-actions {
            gap: 0.5rem !important;
        }

        .swal2-confirm {
            background-color: #7c3aed !important;
            border-color: #7c3aed !important;
            color: white !important;
            font-weight: 500 !important;
            padding: 0.75rem 2rem !important;
            border-radius: 8px !important;
            font-size: 0.875rem !important;
        }

        .swal2-cancel {
            background-color: #6b7280 !important;
            border-color: #6b7280 !important;
            color: white !important;
            font-weight: 500 !important;
            padding: 0.75rem 2rem !important;
            border-radius: 8px !important;
            font-size: 0.875rem !important;
        }

        .swal2-confirm:hover {
            background-color: #6d28d9 !important;
            border-color: #6d28d9 !important;
        }

        .swal2-cancel:hover {
            background-color: #4b5563 !important;
            border-color: #4b5563 !important;
        }

        /* Restore button styling */
        .btn-success.shadow-sm:hover {
            background-color: #1e7e34;
            border-color: #1c7430;
        }

        .card-header {
            border-bottom: none !important;
        }

        #filterRecordStatus {
            width: 100%;
        }
    </style>
}

@section Fillow_script
{

    <script>
        $(document).ready(function () {

            MODULE = 'SleaveM';
            access = ROLE_ACCESS?.[MODULE];

            if (access != 'READWRITE' && access != 'FULL') {
                $('#btnAddLeave').hide();
                $('#btnEditLeave').hide();
            }

            // Initialize toastr options
            toastr.options = {
                positionClass: "toast-top-right",
                timeOut: 5000,
                closeButton: true,
                debug: false,
                newestOnTop: true,
                progressBar: true,
                preventDuplicates: true,
                onclick: null,
                showDuration: "300",
                hideDuration: "1000",
                extendedTimeOut: "1000",
                showEasing: "swing",
                hideEasing: "linear",
                showMethod: "fadeIn",
                hideMethod: "fadeOut",
                tapToDismiss: false
            };

            // View state management
            let isViewingDeleted = false;

            // Initialize Select2 for the filter
            $('#filterRecordStatus').select2({
                selectOnClose: true,
                minimumResultsForSearch: Infinity
            });

            // Handle filter change
            $('#filterRecordStatus').on('change', function () {
                isViewingDeleted = $(this).val() === 'inactive';
                updateTableView();
            });

            var table = $('#leaveTable').DataTable({
                processing: true,
                serverSide: false,
                ajax: {
                    url: "/LeaveList/GetLeaveList",
                    type: "GET",
                    datatype: "json",
                    error: function(xhr, error, code) {
                        console.log('Error loading data:', error);
                        showNotification('Error loading leave data. Please refresh the page.', 'error');
                    }
                },
                columns: [
                    {
                        data: "id",
                        width: "20%",
                        orderable: false,
                        render: function (data) {
                            if (isViewingDeleted) {
                                return `
                                    <div class="d-flex gap-1">
                                        <button type="button" class="btn btn-sm btn-success shadow-sm restoreLeave" data-id="${data}" title="Restore">
                                            <i class="fas fa-undo"></i>
                                        </button>
                                    </div>`;
                            } else {
                                return `
                                    <div class="d-flex gap-1">
                                        <button type="button" class="btn btn-sm btn-primary shadow-sm viewLeave" data-id="${data}" title="View">
                                            <i class="fas fa-eye"></i>
                                        </button>
                                        <button type="button" class="btn btn-sm btn-danger shadow-sm deleteLeave" data-id="${data}" title="Delete">
                                            <i class="fa fa-trash"></i>
                                        </button>
                                    </div>`;
                            }
                        }
                    },
                    {
                        data: "leaveCode",
                        width: "20%"
                    },
                    {
                        data: "leaveName",
                        width: "40%"
                    },
                    {
                        data: "leaveCredits",
                        width: "20%",
                        render: function(data) {
                            return data ? parseFloat(data).toFixed(1) : '-';
                        }
                    }
                ],
                order: [],
                pageLength: 25,
                lengthMenu: [[10, 25, 50, 100, -1], [10, 25, 50, 100, "All"]],
                language: {
                    processing: "Loading...",
                    emptyTable: "No leaves found",
                    zeroRecords: "No matching leaves found",
                    paginate: {
                        next: '<i class="fa fa-angle-double-right" aria-hidden="true"></i>',
                        previous: '<i class="fa fa-angle-double-left" aria-hidden="true"></i>'
                    }
                }
            });

            // Add New Leave
            $('#btnAddLeave').click(function () {
                resetAddForm();
                $('#addLeaveModal').modal('show');

                // Focus on first input after modal is shown
                $('#addLeaveModal').on('shown.bs.modal', function () {
                    $('#addLeaveCode').focus();
                });
            });

            // View Leave
            $(document).on('click', '.viewLeave', function (e) {
                e.preventDefault();
                var id = $(this).data('id');
                var $btn = $(this);

                // Disable button and show loading
                $btn.prop('disabled', true);
                $btn.html('<i class="fas fa-spinner fa-spin"></i>');

                $.get('/LeaveList/GetLeave', { id: id }, function (data) {
                    if (data) {
                        resetViewForm();
                        setViewMode();

                        $('#viewLeaveId').val(data.id);
                        $('#viewLeaveCode').val(data.leaveCode);
                        $('#viewLeaveName').val(data.leaveName);
                        $('#viewLeaveCredits').val(data.leaveCredits ? parseFloat(data.leaveCredits).toFixed(1) : '');

                        $('#viewLeaveModal').modal('show');
                    } else {
                        showNotification('Unable to load leave data', 'error');
                    }
                }).fail(function(xhr, status, error) {
                    console.log('Error loading leave:', error);
                    showNotification('Unable to load leave data', 'error');
                }).always(function() {
                    // Re-enable button
                    $btn.prop('disabled', false);
                    $btn.html('<i class="fas fa-eye"></i>');
                });
            });

            // Edit button in view modal
            $('#btnEditLeave').click(function () {
                setEditMode();
                $('#viewLeaveCode').focus();
            });

            // Cancel edit button
            $('#btnCancelEdit').click(function () {
                // Reload the original data
                var id = $('#viewLeaveId').val();
                $.get('/LeaveList/GetLeave', { id: id }, function (data) {
                    if (data) {
                        $('#viewLeaveCode').val(data.leaveCode);
                        $('#viewLeaveName').val(data.leaveName);
                        $('#viewLeaveCredits').val(data.leaveCredits ? parseFloat(data.leaveCredits).toFixed(1) : '');
                        setViewMode();
                        clearValidation('#viewLeaveForm');
                    }
                });
            });

            // Save Leave (from view/edit modal)
            $('#btnSaveLeave').click(function () {
                // Clear previous validation states
                clearValidation('#viewLeaveForm');

                // Validate form
                if (!validateViewForm()) {
                    return;
                }

                var formData = {
                    id: parseInt($('#viewLeaveId').val()),
                    leaveCode: $('#viewLeaveCode').val().trim(),
                    leaveName: $('#viewLeaveName').val().trim(),
                    leaveCredits: parseFloat($('#viewLeaveCredits').val()) || 0
                };

                // Disable the save button to prevent double submission
                var $saveBtn = $('#btnSaveLeave');
                $saveBtn.prop('disabled', true).html('<i class="fas fa-spinner fa-spin"></i> Saving...');

                $.post('/LeaveList/UpdateLeave', formData, function (response) {
                    if (response.success) {
                        setViewMode();
                        table.ajax.reload(null, false); // Keep current page
                        showNotification(response.message, 'success');
                    } else {
                        showNotification(response.message, 'error');
                    }
                }).fail(function(xhr, status, error) {
                    console.log('Error saving leave:', error);
                    showNotification('Unable to save leave. Please try again.', 'error');
                }).always(function() {
                    // Re-enable the save button
                    $saveBtn.prop('disabled', false).html('Save');
                });
            });

            // Save New Leave (from add modal)
            $('#btnSaveNewLeave').click(function () {
                // Clear previous validation states
                clearValidation('#addLeaveForm');

                // Validate form
                if (!validateAddForm()) {
                    return;
                }

                var formData = {
                    leaveCode: $('#addLeaveCode').val().trim(),
                    leaveName: $('#addLeaveName').val().trim(),
                    leaveCredits: parseFloat($('#addLeaveCredits').val()) || 0
                };

                // Disable the save button to prevent double submission
                var $saveBtn = $('#btnSaveNewLeave');
                $saveBtn.prop('disabled', true).html('<i class="fas fa-spinner fa-spin"></i> Saving...');

                $.post('/LeaveList/AddLeave', formData, function (response) {
                    if (response.success) {
                        $('#addLeaveModal').modal('hide');
                        table.ajax.reload(null, false); // Keep current page
                        showNotification(response.message, 'success');
                    } else {
                        showNotification(response.message, 'error');
                    }
                }).fail(function(xhr, status, error) {
                    console.log('Error saving leave:', error);
                    showNotification('Unable to save leave. Please try again.', 'error');
                }).always(function() {
                    // Re-enable the save button
                    $saveBtn.prop('disabled', false).html('Save');
                });
            });

            // Delete Leave with reason - REUSABLE ALREADY IN THE GLOBAL
            $(document).on('click', '.deleteLeave', function (e) {
                e.preventDefault();
                deleteWithReason({
                    title: 'Inactive Leave',
                    text: 'Are you sure you want to inactive this leave?',
                    url: '/LeaveList/DeleteLeave',
                    id: $(this).data('id'),
                    button: $(this),
                    table: table
                });
            });

            // Restore Leave with SweetAlert2
            $(document).on('click', '.restoreLeave', function (e) {
                e.preventDefault();
                var id = $(this).data('id');
                var $btn = $(this);

                Swal.fire({
                    title: 'Restore Record',
                    text: 'Are you sure you want to restore this leave?',
                    icon: 'question',
                    showCancelButton: true,
                    confirmButtonText: 'Yes, Restore',
                    cancelButtonText: 'Cancel',
                    confirmButtonColor: '#28a745',
                    cancelButtonColor: '#6c757d',
                    reverseButtons: false,
                    allowOutsideClick: false,
                    allowEscapeKey: false
                }).then((result) => {
                    if (result.isConfirmed) {
                        // Disable button and show loading
                        $btn.prop('disabled', true);
                        $btn.html('<i class="fas fa-spinner fa-spin"></i>');

                        $.post('/LeaveList/RestoreLeave', { id: id }, function (response) {
                            if (response.success) {
                                table.ajax.reload(null, false); // Keep current page
                                showNotification(response.message, 'success');
                            } else {
                                showNotification(response.message, 'error');
                            }
                        }).fail(function(xhr, status, error) {
                            console.log('Error restoring leave:', error);
                            showNotification('Unable to restore leave. Please try again.', 'error');
                        }).always(function() {
                            // Re-enable button
                            $btn.prop('disabled', false);
                            $btn.html('<i class="fas fa-undo"></i>');
                        });
                    }
                });
            });

            // Reset forms when modals are hidden
            $('#addLeaveModal').on('hidden.bs.modal', function () {
                resetAddForm();
            });

            $('#viewLeaveModal').on('hidden.bs.modal', function () {
                resetViewForm();
                setViewMode();
            });

            // Enter key handling for forms
            $('#addLeaveForm').on('keypress', function(e) {
                if (e.which === 13) { // Enter key
                    e.preventDefault();
                    $('#btnSaveNewLeave').click();
                }
            });

            $('#viewLeaveForm').on('keypress', function(e) {
                if (e.which === 13 && $('#viewLeaveModal .modal-body').hasClass('edit-mode')) { // Enter key in edit mode
                    e.preventDefault();
                    $('#btnSaveLeave').click();
                }
            });

            // Helper Functions
            function updateTableView() {
                if (isViewingDeleted) {
                    // Update for deleted records view
                    table.ajax.url('/LeaveList/GetDeletedLeaveList').load();
                    $('#btnAddLeave').hide();
                } else {
                    // Update for active records view
                    table.ajax.url('/LeaveList/GetLeaveList').load();
                    $('#btnAddLeave').show();
                }
            }

            function resetAddForm() {
                $('#addLeaveForm')[0].reset();
                clearValidation('#addLeaveForm');
                $('#btnSaveNewLeave').prop('disabled', false).html('Save');
            }

            function resetViewForm() {
                $('#viewLeaveForm')[0].reset();
                clearValidation('#viewLeaveForm');
                $('#btnSaveLeave').prop('disabled', false).html('Save');
            }

            function setViewMode() {
                $('#viewModalTitle').text('View Leave');
                $('#viewLeaveModal .modal-body').removeClass('edit-mode');

                // Make fields readonly/disabled
                $('#viewLeaveCode').prop('readonly', true);
                $('#viewLeaveName').prop('readonly', true);
                $('#viewLeaveCredits').prop('readonly', true);

                // Hide required asterisks
                $('.edit-required').addClass('d-none');

                // Show/hide buttons
                $('#btnEditLeave').removeClass('d-none');
                $('#btnSaveLeave').addClass('d-none');
                $('#btnCancelEdit').addClass('d-none');

                clearValidation('#viewLeaveForm');
            }

            function setEditMode() {
                $('#viewModalTitle').text('Edit Leave');
                $('#viewLeaveModal .modal-body').addClass('edit-mode');

                // Make fields editable
                $('#viewLeaveCode').prop('readonly', false);
                $('#viewLeaveName').prop('readonly', false);
                $('#viewLeaveCredits').prop('readonly', false);

                // Show required asterisks
                $('.edit-required').removeClass('d-none');

                // Show/hide buttons
                $('#btnEditLeave').addClass('d-none');
                $('#btnSaveLeave').removeClass('d-none');
                $('#btnCancelEdit').removeClass('d-none');
            }

            function clearValidation(formSelector) {
                $(formSelector + ' .form-control, ' + formSelector + ' .form-select').removeClass('is-invalid');
                $(formSelector + ' .invalid-feedback').hide();
            }

            function validateAddForm() {
                var isValid = true;

                // Validate leave code
                var leaveCode = $('#addLeaveCode').val().trim();
                if (!leaveCode) {
                    $('#addLeaveCode').addClass('is-invalid');
                    isValid = false;
                }

                // Validate leave name
                var leaveName = $('#addLeaveName').val().trim();
                if (!leaveName) {
                    $('#addLeaveName').addClass('is-invalid');
                    isValid = false;
                }

                // Validate leave credits
                var leaveCredits = $('#addLeaveCredits').val();
                if (leaveCredits === '' || leaveCredits === null || parseFloat(leaveCredits) < 0) {
                    $('#addLeaveCredits').addClass('is-invalid');
                    isValid = false;
                }

                return isValid;
            }

            function validateViewForm() {
                var isValid = true;

                // Validate leave code
                var leaveCode = $('#viewLeaveCode').val().trim();
                if (!leaveCode) {
                    $('#viewLeaveCode').addClass('is-invalid');
                    isValid = false;
                }

                // Validate leave name
                var leaveName = $('#viewLeaveName').val().trim();
                if (!leaveName) {
                    $('#viewLeaveName').addClass('is-invalid');
                    isValid = false;
                }

                // Validate leave credits
                var leaveCredits = $('#viewLeaveCredits').val();
                if (leaveCredits === '' || leaveCredits === null || parseFloat(leaveCredits) < 0) {
                    $('#viewLeaveCredits').addClass('is-invalid');
                    isValid = false;
                }

                return isValid;
            }

            // Updated notification function using toastr
            function showNotification(message, type) {
                if (type === 'success') {
                    toastr.success(message, "Success");
                } else if (type === 'error') {
                    toastr.error(message, "Error");
                } else if (type === 'warning') {
                    toastr.warning(message, "Warning");
                } else if (type === 'info') {
                    toastr.info(message, "Information");
                } else {
                    toastr.info(message, "Notification");
                }
            }

            // Remove validation classes when user starts typing (Add form)
            $('#addLeaveCode, #addLeaveName, #addLeaveCredits').on('input', function() {
                $(this).removeClass('is-invalid');
            });

            // Remove validation classes when user starts typing (View/Edit form)
            $('#viewLeaveCode, #viewLeaveName, #viewLeaveCredits').on('input', function() {
                $(this).removeClass('is-invalid');
            });
        });
    </script>
}