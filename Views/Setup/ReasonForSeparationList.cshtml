@{
    Layout = "~/Views/Shared/_LayoutFillow.cshtml";
    ViewData["Title"] = "Reason For Separation List";
}

<div class="col-12">
    <div class="card">
        <div class="card-header">
            <div class="row" style="width:100%;">
                <h4 class="card-title">Reason For Separation List</h4>
                <br> <br> <br>

                <div class="row" style="margin-left:0px;width:100%;">
                    <div class="col-md-3">
                        <div class="form-group">
                            <h5>Record Status</h5>
                            <select name="filterRecordStatus" id="filterRecordStatus" class="form-control">
                                <option value="active" selected>ACTIVE</option>
                                <option value="inactive">INACTIVE</option>
                            </select>
                        </div>
                    </div>
                    <div class="col-md-6">
                    </div>
                    <div class="col-md-3 d-flex justify-content-end align-items-end">
                        <div class="form-group">
                            <button type="button" class="btn btn-primary" id="btnAddReasonForSeparation">
                                <i class="fa fa-plus"></i> New Reason For Separation
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="card-body">
            <div class="table-responsive">
                <table id="reasonForSeparationTable" class="display" style="min-width: 845px">
                    <thead>
                        <tr>
                            <th>Action</th>
                            <th>Reason For Separation Code</th>
                            <th>Reason For Separation Name</th>
                        </tr>
                    </thead>
                </table>
            </div>
        </div>

        <!-- Modal for Add -->
        <div class="modal fade" id="addReasonForSeparationModal" tabindex="-1" aria-hidden="true">
            <div class="modal-dialog">
                <div class="modal-content">
                    <div class="modal-header">
                        <h5 class="modal-title">Reason For Separation Form</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                    </div>
                    <div class="modal-body">
                        <form id="addReasonForSeparationForm">
                            <div class="mb-3">
                                <label for="addReason4TerminationCode" class="form-label">Reason For Separation Code <span class="text-danger">*</span></label>
                                <input type="text" class="form-control alphanum" id="addReason4TerminationCode" name="reason4TerminationCode" required maxlength="50">
                                <div class="invalid-feedback">
                                    Please provide a valid reason for separation code.
                                </div>
                            </div>

                            <div class="mb-3">
                                <label for="addReason4TerminationName" class="form-label">Reason For Separation Name <span class="text-danger">*</span></label>
                                <input type="text" class="form-control" id="addReason4TerminationName" name="reason4TerminationName" required maxlength="255">
                                <div class="invalid-feedback">
                                    Please provide a valid reason for separation name.
                                </div>
                            </div>
                        </form>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-primary" id="btnSaveNewReasonForSeparation">Save</button>
                    </div>
                </div>
            </div>
        </div>

        <!-- Modal for View/Edit -->
        <div class="modal fade" id="viewReasonForSeparationModal" tabindex="-1" aria-hidden="true">
            <div class="modal-dialog">
                <div class="modal-content">
                    <div class="modal-header">
                        <h5 class="modal-title" id="viewModalTitle">View Reason For Separation Form</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                    </div>
                    <div class="modal-body">
                        <form id="viewReasonForSeparationForm">
                            <input type="hidden" id="viewReasonForSeparationId" name="id">

                            <div class="mb-3">
                                <label for="viewReason4TerminationCode" class="form-label">Reason For Separation Code <span class="text-danger edit-required d-none">*</span></label>
                                <input type="text" class="form-control alphanum" id="viewReason4TerminationCode" name="reason4TerminationCode" readonly maxlength="50">
                                <div class="invalid-feedback">
                                    Please provide a valid reason for separation code.
                                </div>
                            </div>

                            <div class="mb-3">
                                <label for="viewReason4TerminationName" class="form-label">Reason For Separation Name <span class="text-danger edit-required d-none">*</span></label>
                                <input type="text" class="form-control" id="viewReason4TerminationName" name="reason4TerminationName" readonly maxlength="255">
                                <div class="invalid-feedback">
                                    Please provide a valid reason for separation name.
                                </div>
                            </div>
                        </form>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-primary" id="btnEditReasonForSeparation">
                            <i class="fas fa-edit"></i> Edit
                        </button>
                        <button type="button" class="btn btn-success d-none" id="btnSaveReasonForSeparation">Save</button>
                        <button type="button" class="btn btn-danger d-none" id="btnCancelEdit">Cancel</button>
                    </div>
                </div>
            </div>
        </div>

    </div>
</div>

@section Fillow_style
{

    <style>
        .table-responsive {
            border-radius: 0.375rem;
        }

        #reasonForSeparationTable_wrapper .dataTables_length,
        #reasonForSeparationTable_wrapper .dataTables_filter {
            margin-bottom: 1rem;
        }

        #reasonForSeparationTable_wrapper .dataTables_info,
        #reasonForSeparationTable_wrapper .dataTables_paginate {
            margin-top: 1rem;
        }

        .btn-sm {
            padding: 0.25rem 0.5rem;
            font-size: 0.875rem;
        }

        .modal-content {
            border-radius: 0.5rem;
            box-shadow: 0 0.5rem 1rem rgba(0, 0, 0, 0.15);
        }

        .form-control:focus,
        .form-select:focus {
            border-color: #0d6efd;
            box-shadow: 0 0 0 0.2rem rgba(13, 110, 253, 0.25);
        }

        .invalid-feedback {
            display: none;
        }

        .form-control.is-invalid,
        .form-select.is-invalid {
            border-color: #dc3545;
        }

            .form-control.is-invalid ~ .invalid-feedback,
            .form-select.is-invalid ~ .invalid-feedback {
                display: block;
            }

        /* Readonly/disabled field styling */
        .form-control[readonly] {
            background-color: #f8f9fa;
            border-color: #dee2e6;
        }

        .form-select[disabled] {
            background-color: #f8f9fa;
            border-color: #dee2e6;
        }

        /* Edit mode styling */
        .edit-mode .form-control[readonly] {
            background-color: #ffffff;
            border-color: #ced4da;
        }

        .edit-mode .form-select[disabled] {
            background-color: #ffffff;
            border-color: #ced4da;
        }

        /* Custom SweetAlert2 styling */
        .swal2-popup {
            border-radius: 15px !important;
            padding: 2rem !important;
        }

        .swal2-icon.swal2-error {
            border-color: #f27474 !important;
            color: #f27474 !important;
        }

            .swal2-icon.swal2-error .swal2-x-mark {
                display: none !important;
            }

            .swal2-icon.swal2-error::before {
                content: "\f2ed" !important;
                font-family: "Font Awesome 5 Free" !important;
                font-weight: 900 !important;
                font-size: 2.5rem !important;
                color: #f27474 !important;
                display: block !important;
            }

        .swal2-title {
            font-size: 1.875rem !important;
            font-weight: 600 !important;
            color: #545454 !important;
            margin: 1rem 0 0.5rem 0 !important;
        }

        .swal2-html-container {
            font-size: 1rem !important;
            color: #737373 !important;
            margin: 0 0 2rem 0 !important;
        }

        .swal2-actions {
            gap: 0.5rem !important;
        }

        .swal2-confirm {
            background-color: #7c3aed !important;
            border-color: #7c3aed !important;
            color: white !important;
            font-weight: 500 !important;
            padding: 0.75rem 2rem !important;
            border-radius: 8px !important;
            font-size: 0.875rem !important;
        }

        .swal2-cancel {
            background-color: #6b7280 !important;
            border-color: #6b7280 !important;
            color: white !important;
            font-weight: 500 !important;
            padding: 0.75rem 2rem !important;
            border-radius: 8px !important;
            font-size: 0.875rem !important;
        }

        .swal2-confirm:hover {
            background-color: #6d28d9 !important;
            border-color: #6d28d9 !important;
        }

        .swal2-cancel:hover {
            background-color: #4b5563 !important;
            border-color: #4b5563 !important;
        }

        /* Restore button styling */
        .btn-success.shadow-sm:hover {
            background-color: #1e7e34;
            border-color: #1c7430;
        }

        .card-header {
            border-bottom: none !important;
        }

        #filterRecordStatus {
            width: 100%;
        }
    </style>
}

@section Fillow_script
{

    <script>
        $(document).ready(function () {

            MODULE = 'Sreason4terminationM';
            access = ROLE_ACCESS?.[MODULE];

            if (access != 'READWRITE' && access != 'FULL') {
                $('#btnAddReasonForSeparation').hide();
                $('#btnEditReasonForSeparation').hide();
            }

            // Initialize toastr options
            toastr.options = {
                positionClass: "toast-top-right",
                timeOut: 5000,
                closeButton: true,
                debug: false,
                newestOnTop: true,
                progressBar: true,
                preventDuplicates: true,
                onclick: null,
                showDuration: "300",
                hideDuration: "1000",
                extendedTimeOut: "1000",
                showEasing: "swing",
                hideEasing: "linear",
                showMethod: "fadeIn",
                hideMethod: "fadeOut",
                tapToDismiss: false
            };

            // View state management
            let isViewingDeleted = false;

            // Initialize Select2 for the filter
            $('#filterRecordStatus').select2({
                selectOnClose: true,
                minimumResultsForSearch: Infinity
            });

            // Handle filter change
            $('#filterRecordStatus').on('change', function () {
                isViewingDeleted = $(this).val() === 'inactive';
                updateTableView();
            });

            var table = $('#reasonForSeparationTable').DataTable({
                processing: true,
                serverSide: false,
                ajax: {
                    url: "/ReasonForSeparationList/GetReasonForSeparationList",
                    type: "GET",
                    datatype: "json",
                    error: function(xhr, error, code) {
                        console.log('Error loading data:', error);
                        showNotification('Error loading reason for separation data. Please refresh the page.', 'error');
                    }
                },
                columns: [
                    {
                        data: "id",
                        width: "20%",
                        orderable: false,
                        render: function (data) {
                            if (isViewingDeleted) {
                                return `
                                    <div class="d-flex gap-1">
                                        <button type="button" class="btn btn-sm btn-success shadow-sm restoreReasonForSeparation" data-id="${data}" title="Restore">
                                            <i class="fas fa-undo"></i>
                                        </button>
                                    </div>`;
                            } else {
                                return `
                                    <div class="d-flex gap-1">
                                        <button type="button" class="btn btn-sm btn-primary shadow-sm viewReasonForSeparation" data-id="${data}" title="View">
                                            <i class="fas fa-eye"></i>
                                        </button>
                                        <button type="button" class="btn btn-sm btn-danger shadow-sm deleteReasonForSeparation" data-id="${data}" title="Delete">
                                            <i class="fa fa-trash"></i>
                                        </button>
                                    </div>`;
                            }
                        }
                    },
                    {
                        data: "reason4TerminationCode",
                        width: "25%"
                    },
                    {
                        data: "reason4TerminationName",
                        width: "55%"
                    }                  
                ],
                order: [],
                pageLength: 25,
                lengthMenu: [[10, 25, 50, 100, -1], [10, 25, 50, 100, "All"]],
                language: {
                    processing: "Loading...",
                    emptyTable: "No reasons for separation found",
                    zeroRecords: "No matching reasons for separation found",
                    paginate: {
                        next: '<i class="fa fa-angle-double-right" aria-hidden="true"></i>',
                        previous: '<i class="fa fa-angle-double-left" aria-hidden="true"></i>'
                    }
                }
            });

            // Add New Reason For Separation
            $('#btnAddReasonForSeparation').click(function () {
                resetAddForm();
                $('#addReasonForSeparationModal').modal('show');

                // Focus on first input after modal is shown
                $('#addReasonForSeparationModal').on('shown.bs.modal', function () {
                    $('#addReason4TerminationCode').focus();
                });
            });

            // View Reason For Separation
            $(document).on('click', '.viewReasonForSeparation', function (e) {
                e.preventDefault();
                var id = $(this).data('id');
                var $btn = $(this);

                // Disable button and show loading
                $btn.prop('disabled', true);
                $btn.html('<i class="fas fa-spinner fa-spin"></i>');

                $.get('/ReasonForSeparationList/GetReasonForSeparation', { id: id }, function (data) {
                    if (data) {
                        resetViewForm();
                        setViewMode();

                        $('#viewReasonForSeparationId').val(data.id);
                        $('#viewReason4TerminationCode').val(data.reason4TerminationCode);
                        $('#viewReason4TerminationName').val(data.reason4TerminationName);

                        $('#viewReasonForSeparationModal').modal('show');
                    } else {
                        showNotification('Unable to load reason for separation data', 'error');
                    }
                }).fail(function(xhr, status, error) {
                    console.log('Error loading reason for separation:', error);
                    showNotification('Unable to load reason for separation data', 'error');
                }).always(function() {
                    // Re-enable button
                    $btn.prop('disabled', false);
                    $btn.html('<i class="fas fa-eye"></i>');
                });
            });

            // Edit button in view modal
            $('#btnEditReasonForSeparation').click(function () {
                setEditMode();
                $('#viewReason4TerminationCode').focus();
            });

            // Cancel edit button
            $('#btnCancelEdit').click(function () {
                // Reload the original data
                var id = $('#viewReasonForSeparationId').val();
                $.get('/ReasonForSeparationList/GetReasonForSeparation', { id: id }, function (data) {
                    if (data) {
                        $('#viewReason4TerminationCode').val(data.reason4TerminationCode);
                        $('#viewReason4TerminationName').val(data.reason4TerminationName);
                        setViewMode();
                        clearValidation('#viewReasonForSeparationForm');
                    }
                });
            });

            // Save Reason For Separation (from view/edit modal)
            $('#btnSaveReasonForSeparation').click(function () {
                // Clear previous validation states
                clearValidation('#viewReasonForSeparationForm');

                // Validate form
                if (!validateViewForm()) {
                    return;
                }

                var formData = {
                    id: parseInt($('#viewReasonForSeparationId').val()),
                    reason4TerminationCode: $('#viewReason4TerminationCode').val().trim(),
                    reason4TerminationName: $('#viewReason4TerminationName').val().trim()
                };

                // Disable the save button to prevent double submission
                var $saveBtn = $('#btnSaveReasonForSeparation');
                $saveBtn.prop('disabled', true).html('<i class="fas fa-spinner fa-spin"></i> Saving...');

                $.post('/ReasonForSeparationList/UpdateReasonForSeparation', formData, function (response) {
                    if (response.success) {
                        setViewMode();
                        table.ajax.reload(null, false); // Keep current page
                        showNotification(response.message, 'success');
                    } else {
                        showNotification(response.message, 'error');
                    }
                }).fail(function(xhr, status, error) {
                    console.log('Error saving reason for separation:', error);
                    showNotification('Unable to save reason for separation. Please try again.', 'error');
                }).always(function() {
                    // Re-enable the save button
                    $saveBtn.prop('disabled', false).html('Save');
                });
            });

            // Save New Reason For Separation (from add modal)
            $('#btnSaveNewReasonForSeparation').click(function () {
                // Clear previous validation states
                clearValidation('#addReasonForSeparationForm');

                // Validate form
                if (!validateAddForm()) {
                    return;
                }

                var formData = {
                    reason4TerminationCode: $('#addReason4TerminationCode').val().trim(),
                    reason4TerminationName: $('#addReason4TerminationName').val().trim()
                };

                // Disable the save button to prevent double submission
                var $saveBtn = $('#btnSaveNewReasonForSeparation');
                $saveBtn.prop('disabled', true).html('<i class="fas fa-spinner fa-spin"></i> Saving...');

                $.post('/ReasonForSeparationList/AddReasonForSeparation', formData, function (response) {
                    if (response.success) {
                        $('#addReasonForSeparationModal').modal('hide');
                        table.ajax.reload(null, false); // Keep current page
                        showNotification(response.message, 'success');
                    } else {
                        showNotification(response.message, 'error');
                    }
                }).fail(function(xhr, status, error) {
                    console.log('Error saving reason for separation:', error);
                    showNotification('Unable to save reason for separation. Please try again.', 'error');
                }).always(function() {
                    // Re-enable the save button
                    $saveBtn.prop('disabled', false).html('Save');
                });
            });

            // Delete Reason For Separation with reason - Using global reusable function
            $(document).on('click', '.deleteReasonForSeparation', function (e) {
                e.preventDefault();
                deleteWithReason({
                    title: 'Inactive Reason For Separation',
                    text: 'Are you sure you want to inactive this reason for separation?',
                    url: '/ReasonForSeparationList/DeleteReasonForSeparation',
                    id: $(this).data('id'),
                    button: $(this),
                    table: table
                });
            });

            // Restore Reason For Separation with SweetAlert2
            $(document).on('click', '.restoreReasonForSeparation', function (e) {
                e.preventDefault();
                var id = $(this).data('id');
                var $btn = $(this);

                Swal.fire({
                    title: 'Restore Record',
                    text: 'Are you sure you want to restore this reason for separation?',
                    icon: 'question',
                    showCancelButton: true,
                    confirmButtonText: 'Yes, Restore',
                    cancelButtonText: 'Cancel',
                    confirmButtonColor: '#28a745',
                    cancelButtonColor: '#6c757d',
                    reverseButtons: false,
                    allowOutsideClick: false,
                    allowEscapeKey: false
                }).then((result) => {
                    if (result.isConfirmed) {
                        // Disable button and show loading
                        $btn.prop('disabled', true);
                        $btn.html('<i class="fas fa-spinner fa-spin"></i>');

                        $.post('/ReasonForSeparationList/RestoreReasonForSeparation', { id: id }, function (response) {
                            if (response.success) {
                                table.ajax.reload(null, false); // Keep current page
                                showNotification(response.message, 'success');
                            } else {
                                showNotification(response.message, 'error');
                            }
                        }).fail(function(xhr, status, error) {
                            console.log('Error restoring reason for separation:', error);
                            showNotification('Unable to restore reason for separation. Please try again.', 'error');
                        }).always(function() {
                            // Re-enable button
                            $btn.prop('disabled', false);
                            $btn.html('<i class="fas fa-undo"></i>');
                        });
                    }
                });
            });

            // Reset forms when modals are hidden
            $('#addReasonForSeparationModal').on('hidden.bs.modal', function () {
                resetAddForm();
            });

            $('#viewReasonForSeparationModal').on('hidden.bs.modal', function () {
                resetViewForm();
                setViewMode();
            });

            // Enter key handling for forms
            $('#addReasonForSeparationForm').on('keypress', function(e) {
                if (e.which === 13) { // Enter key
                    e.preventDefault();
                    $('#btnSaveNewReasonForSeparation').click();
                }
            });

            $('#viewReasonForSeparationForm').on('keypress', function(e) {
                if (e.which === 13 && $('#viewReasonForSeparationModal .modal-body').hasClass('edit-mode')) { // Enter key in edit mode
                    e.preventDefault();
                    $('#btnSaveReasonForSeparation').click();
                }
            });

            // Helper Functions
            function updateTableView() {
                if (isViewingDeleted) {
                    // Update for deleted records view
                    table.ajax.url('/ReasonForSeparationList/GetDeletedReasonForSeparation').load();
                    $('#btnAddReasonForSeparation').hide();
                } else {
                    // Update for active records view
                    table.ajax.url('/ReasonForSeparationList/GetReasonForSeparationList').load();
                    $('#btnAddReasonForSeparation').show();
                }
            }

            function resetAddForm() {
                $('#addReasonForSeparationForm')[0].reset();
                clearValidation('#addReasonForSeparationForm');
                $('#btnSaveNewReasonForSeparation').prop('disabled', false).html('Save');
            }

            function resetViewForm() {
                $('#viewReasonForSeparationForm')[0].reset();
                clearValidation('#viewReasonForSeparationForm');
                $('#btnSaveReasonForSeparation').prop('disabled', false).html('Save');
            }

            function setViewMode() {
                $('#viewModalTitle').text('View Reason For Separation');
                $('#viewReasonForSeparationModal .modal-body').removeClass('edit-mode');

                // Make fields readonly/disabled
                $('#viewReason4TerminationCode').prop('readonly', true);
                $('#viewReason4TerminationName').prop('readonly', true);

                // Hide required asterisks
                $('.edit-required').addClass('d-none');

                // Show/hide buttons
                $('#btnEditReasonForSeparation').removeClass('d-none');
                $('#btnSaveReasonForSeparation').addClass('d-none');
                $('#btnCancelEdit').addClass('d-none');

                clearValidation('#viewReasonForSeparationForm');
            }

            function setEditMode() {
                $('#viewModalTitle').text('Edit Reason For Separation');
                $('#viewReasonForSeparationModal .modal-body').addClass('edit-mode');

                // Make fields editable
                $('#viewReason4TerminationCode').prop('readonly', false);
                $('#viewReason4TerminationName').prop('readonly', false);

                // Show required asterisks
                $('.edit-required').removeClass('d-none');

                // Show/hide buttons
                $('#btnEditReasonForSeparation').addClass('d-none');
                $('#btnSaveReasonForSeparation').removeClass('d-none');
                $('#btnCancelEdit').removeClass('d-none');
            }

            function clearValidation(formSelector) {
                $(formSelector + ' .form-control, ' + formSelector + ' .form-select').removeClass('is-invalid');
                $(formSelector + ' .invalid-feedback').hide();
            }

            function validateAddForm() {
                var isValid = true;

                // Validate reason code
                var reason4TerminationCode = $('#addReason4TerminationCode').val().trim();
                if (!reason4TerminationCode) {
                    $('#addReason4TerminationCode').addClass('is-invalid');
                    isValid = false;
                }

                // Validate reason name
                var reason4TerminationName = $('#addReason4TerminationName').val().trim();
                if (!reason4TerminationName) {
                    $('#addReason4TerminationName').addClass('is-invalid');
                    isValid = false;
                }

                return isValid;
            }

            function validateViewForm() {
                var isValid = true;

                // Validate reason code
                var reason4TerminationCode = $('#viewReason4TerminationCode').val().trim();
                if (!reason4TerminationCode) {
                    $('#viewReason4TerminationCode').addClass('is-invalid');
                    isValid = false;
                }

                // Validate reason name
                var reason4TerminationName = $('#viewReason4TerminationName').val().trim();
                if (!reason4TerminationName) {
                    $('#viewReason4TerminationName').addClass('is-invalid');
                    isValid = false;
                }

                return isValid;
            }

            // Updated notification function using toastr
            function showNotification(message, type) {
                if (type === 'success') {
                    toastr.success(message, "Success");
                } else if (type === 'error') {
                    toastr.error(message, "Error");
                } else if (type === 'warning') {
                    toastr.warning(message, "Warning");
                } else if (type === 'info') {
                    toastr.info(message, "Information");
                } else {
                    toastr.info(message, "Notification");
                }
            }

            // Remove validation classes when user starts typing (Add form)
            $('#addReason4TerminationCode, #addReason4TerminationName').on('input', function() {
                $(this).removeClass('is-invalid');
            });

            // Remove validation classes when user starts typing (View/Edit form)
            $('#viewReason4TerminationCode, #viewReason4TerminationName').on('input', function() {
                $(this).removeClass('is-invalid');
            });
        });
    </script>
}