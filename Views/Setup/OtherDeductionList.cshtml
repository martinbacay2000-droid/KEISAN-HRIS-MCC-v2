@{
    Layout = "~/Views/Shared/_LayoutFillow.cshtml";
    ViewData["Title"] = "Other Deduction List";
}

<div class="col-12">
    <div class="card">
        <div class="card-header">
            <div class="row" style="width:100%;">
                <h4 class="card-title">Other Deduction List</h4>
                <br> <br> <br>

                <div class="row" style="margin-left:0px;width:100%;">
                    <div class="col-md-3">
                        <div class="form-group">
                            <h5>Record Status</h5>
                            <select name="filterRecordStatus" id="filterRecordStatus" class="form-control">
                                <option value="active" selected>ACTIVE</option>
                                <option value="inactive">INACTIVE</option>
                            </select>
                        </div>
                    </div>
                    <div class="col-md-6">
                    </div>
                    <div class="col-md-3 d-flex justify-content-end align-items-end">
                        <div class="form-group">
                            <button type="button" class="btn btn-primary" id="btnAddOtherDeduction">
                                <i class="fa fa-plus"></i> New Other Deduction
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="card-body">
            <div class="table-responsive">
                <table id="otherDeductionTable" class="display" style="min-width: 845px">
                    <thead>
                        <tr>
                            <th>Action</th>
                            <th>Other Deduction Code</th>
                            <th>Other Deduction Name</th>
                        </tr>
                    </thead>
                </table>
            </div>
        </div>

        <!-- Modal for Add -->
        <div class="modal fade" id="addOtherDeductionModal" tabindex="-1" aria-hidden="true">
            <div class="modal-dialog">
                <div class="modal-content">
                    <div class="modal-header">
                        <h5 class="modal-title">Add Other Deduction List Form</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                    </div>
                    <div class="modal-body">
                        <form id="addOtherDeductionForm">
                            <div class="mb-3">
                                <label for="addOtherDeductionCode" class="form-label">Other Deduction Code <span class="text-danger">*</span></label>
                                <input type="text" class="form-control alphanum" id="addOtherDeductionCode" name="otherDeductionCode" required maxlength="50">
                                <div class="invalid-feedback">
                                    Please provide a valid other deduction code.
                                </div>
                            </div>

                            <div class="mb-3">
                                <label for="addOtherDeductionName" class="form-label">Other Deduction Name <span class="text-danger">*</span></label>
                                <input type="text" class="form-control" id="addOtherDeductionName" name="otherDeductionName" required maxlength="255">
                                <div class="invalid-feedback">
                                    Please provide a valid other deduction name.
                                </div>
                            </div>

                            <div class="mb-3">
                                <label for="addIsTaxable" class="form-label">Taxable <span class="text-danger">*</span></label>
                                <select class="form-select" id="addIsTaxable" name="isTaxable" style="width:100%" required>
                                    <option value="">Select...</option>
                                    <option value="true">Yes</option>
                                    <option value="false">No</option>
                                </select>
                                <div class="invalid-feedback">
                                    Please select if the other deduction is taxable.
                                </div>
                            </div>
                        </form>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-primary" id="btnSaveNewOtherDeduction">Save</button>
                    </div>
                </div>
            </div>
        </div>

        <!-- Modal for View/Edit -->
        <div class="modal fade" id="viewOtherDeductionModal" tabindex="-1" aria-hidden="true">
            <div class="modal-dialog">
                <div class="modal-content">
                    <div class="modal-header">
                        <h5 class="modal-title" id="viewModalTitle">Other Deduction List Form</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                    </div>
                    <div class="modal-body">
                        <form id="viewOtherDeductionForm">
                            <input type="hidden" id="viewOtherDeductionId" name="id">

                            <div class="mb-3">
                                <label for="viewOtherDeductionCode" class="form-label">Other Deduction Code <span class="text-danger edit-required d-none">*</span></label>
                                <input type="text" class="form-control alphanum" id="viewOtherDeductionCode" name="otherDeductionCode" readonly maxlength="50">
                                <div class="invalid-feedback">
                                    Please provide a valid other deduction code.
                                </div>
                            </div>

                            <div class="mb-3">
                                <label for="viewOtherDeductionName" class="form-label">Other Deduction Name <span class="text-danger edit-required d-none">*</span></label>
                                <input type="text" class="form-control" id="viewOtherDeductionName" name="otherDeductionName" readonly maxlength="255">
                                <div class="invalid-feedback">
                                    Please provide a valid other deduction name.
                                </div>
                            </div>

                            <div class="mb-3">
                                <label for="viewIsTaxable" class="form-label">Taxable <span class="text-danger edit-required d-none">*</span></label>
                                <select class="form-select" id="viewIsTaxable" name="isTaxable" style="width:100%" disabled>
                                    <option value="">Select...</option>
                                    <option value="true">Yes</option>
                                    <option value="false">No</option>
                                </select>
                                <div class="invalid-feedback">
                                    Please select if the other deduction is taxable.
                                </div>
                            </div>
                        </form>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-primary" id="btnEditOtherDeduction">
                            <i class="fas fa-edit"></i> Edit
                        </button>
                        <button type="button" class="btn btn-success d-none" id="btnSaveOtherDeduction">Save</button>
                        <button type="button" class="btn btn-danger d-none" id="btnCancelEdit">Cancel</button>
                    </div>
                </div>
            </div>
        </div>

    </div>
</div>

@section Fillow_style
{

    <style>
        .table-responsive {
            border-radius: 0.375rem;
        }

        #otherDeductionTable_wrapper .dataTables_length,
        #otherDeductionTable_wrapper .dataTables_filter {
            margin-bottom: 1rem;
        }

        #otherDeductionTable_wrapper .dataTables_info,
        #otherDeductionTable_wrapper .dataTables_paginate {
            margin-top: 1rem;
        }

        .btn-sm {
            padding: 0.25rem 0.5rem;
            font-size: 0.875rem;
        }

        .modal-content {
            border-radius: 0.5rem;
            box-shadow: 0 0.5rem 1rem rgba(0, 0, 0, 0.15);
        }

        .form-control:focus,
        .form-select:focus {
            border-color: #0d6efd;
            box-shadow: 0 0 0 0.2rem rgba(13, 110, 253, 0.25);
        }

        .invalid-feedback {
            display: none;
        }

        .form-control.is-invalid,
        .form-select.is-invalid {
            border-color: #dc3545;
        }

            .form-control.is-invalid ~ .invalid-feedback,
            .form-select.is-invalid ~ .invalid-feedback {
                display: block;
            }

        /* Readonly/disabled field styling */
        .form-control[readonly] {
            background-color: #f8f9fa;
            border-color: #dee2e6;
        }

        .form-select[disabled] {
            background-color: #f8f9fa;
            border-color: #dee2e6;
        }

        /* Edit mode styling */
        .edit-mode .form-control[readonly] {
            background-color: #ffffff;
            border-color: #ced4da;
        }

        .edit-mode .form-select[disabled] {
            background-color: #ffffff;
            border-color: #ced4da;
        }

        /* Select2 styling adjustments */
        .select2-container .select2-selection--single {
            height: 38px;
            border: 1px solid #ced4da;
            border-radius: 0.375rem;
        }

        .select2-container--default .select2-selection--single .select2-selection__rendered {
            line-height: 36px;
            padding-left: 12px;
        }

        .select2-container--default .select2-selection--single .select2-selection__arrow {
            height: 36px;
        }

        .select2-container--default.select2-container--focus .select2-selection--single {
            border-color: #0d6efd;
            box-shadow: 0 0 0 0.2rem rgba(13, 110, 253, 0.25);
        }

        .select2-container--default .select2-selection--single.select2-selection--disabled {
            background-color: #f8f9fa;
            border-color: #dee2e6;
        }

        /* Select2 validation styling */
        .is-invalid + .select2-container .select2-selection--single {
            border-color: #dc3545;
        }

        /* Custom SweetAlert2 styling to match your image */
        .swal2-popup {
            border-radius: 15px !important;
            padding: 2rem !important;
        }

        .swal2-icon.swal2-error {
            border-color: #f27474 !important;
            color: #f27474 !important;
        }

            .swal2-icon.swal2-error .swal2-x-mark {
                display: none !important;
            }

            .swal2-icon.swal2-error::before {
                content: "\f2ed" !important;
                font-family: "Font Awesome 5 Free" !important;
                font-weight: 900 !important;
                font-size: 2.5rem !important;
                color: #f27474 !important;
                display: block !important;
            }

        .swal2-title {
            font-size: 1.875rem !important;
            font-weight: 600 !important;
            color: #545454 !important;
            margin: 1rem 0 0.5rem 0 !important;
        }

        .swal2-html-container {
            font-size: 1rem !important;
            color: #737373 !important;
            margin: 0 0 2rem 0 !important;
        }

        .swal2-actions {
            gap: 0.5rem !important;
        }

        .swal2-confirm {
            background-color: #7c3aed !important;
            border-color: #7c3aed !important;
            color: white !important;
            font-weight: 500 !important;
            padding: 0.75rem 2rem !important;
            border-radius: 8px !important;
            font-size: 0.875rem !important;
        }

        .swal2-cancel {
            background-color: #6b7280 !important;
            border-color: #6b7280 !important;
            color: white !important;
            font-weight: 500 !important;
            padding: 0.75rem 2rem !important;
            border-radius: 8px !important;
            font-size: 0.875rem !important;
        }

        .swal2-confirm:hover {
            background-color: #6d28d9 !important;
            border-color: #6d28d9 !important;
        }

        .swal2-cancel:hover {
            background-color: #4b5563 !important;
            border-color: #4b5563 !important;
        }

        /* Toggle view button styling */
        #btnToggleView {
            transition: all 0.3s ease;
        }

            #btnToggleView:hover {
                transform: translateY(-1px);
            }

        /* Badge styling */
        .badge {
            font-size: 0.75rem;
            padding: 0.35em 0.65em;
        }

        /* Restore button styling */
        .btn-success.shadow-sm:hover {
            background-color: #1e7e34;
            border-color: #1c7430;
        }

        .card-header {
            border-bottom: none !important;
        }

        #filterRecordStatus {
            width: 100%;
        }
    </style>
}

@section Fillow_script
{

    <script>
        $(document).ready(function () {

            MODULE = 'SotherdeductionM';
            access = ROLE_ACCESS?.[MODULE];

            if (access != 'READWRITE' && access != 'FULL') {
                $('#btnAddOtherDeduction').hide();
                $('#btnEditOtherDeduction').hide();
            }

            // Initialize toastr options
            toastr.options = {
                positionClass: "toast-top-right",
                timeOut: 5000,
                closeButton: true,
                debug: false,
                newestOnTop: true,
                progressBar: true,
                preventDuplicates: true,
                onclick: null,
                showDuration: "300",
                hideDuration: "1000",
                extendedTimeOut: "1000",
                showEasing: "swing",
                hideEasing: "linear",
                showMethod: "fadeIn",
                hideMethod: "fadeOut",
                tapToDismiss: false
            };

            // View state management
            let isViewingDeleted = false;

            // Initialize Select2 dropdowns
            initializeSelect2();

            // Initialize Select2 for the filter
            $('#filterRecordStatus').select2({
                selectOnClose: true,
                minimumResultsForSearch: Infinity
            });

            // Handle filter change
            $('#filterRecordStatus').on('change', function () {
                isViewingDeleted = $(this).val() === 'inactive';
                updateTableView();
            });

            var table = $('#otherDeductionTable').DataTable({
                processing: true,
                serverSide: false,
                ajax: {
                    url: "/OtherDeductionList/GetOtherDeductionList",
                    type: "GET",
                    datatype: "json",
                    error: function(xhr, error, code) {
                        console.log('Error loading data:', error);
                        showNotification('Error loading other deduction data. Please refresh the page.', 'error');
                    }
                },
                columns: [
                    {
                        data: "id",
                        width: "20%",
                        orderable: false,
                        render: function (data) {
                            if (isViewingDeleted) {
                                return `
                                    <div class="d-flex gap-1">
                                        <button type="button" class="btn btn-sm btn-success shadow-sm restoreOtherDeduction" data-id="${data}" title="Restore">
                                            <i class="fas fa-undo"></i>
                                        </button>
                                    </div>`;
                            } else {
                                return `
                                    <div class="d-flex gap-1">
                                        <button type="button" class="btn btn-sm btn-primary shadow-sm viewOtherDeduction" data-id="${data}" title="View">
                                            <i class="fas fa-eye"></i>
                                        </button>
                                        <button type="button" class="btn btn-sm btn-danger shadow-sm deleteOtherDeduction" data-id="${data}" title="Delete">
                                            <i class="fa fa-trash"></i>
                                        </button>
                                    </div>`;
                            }
                        }
                    },
                    {
                        data: "otherDeductionCode",
                        width: "25%"
                    },
                    {
                        data: "otherDeductionName",
                        width: "55%"
                    },                    
                ],
                order: [],
                pageLength: 25,
                lengthMenu: [[10, 25, 50, 100, -1], [10, 25, 50, 100, "All"]],
                language: {
                    processing: "Loading...",
                    emptyTable: "No other deductions found",
                    zeroRecords: "No matching other deductions found",
                    paginate: {
                        next: '<i class="fa fa-angle-double-right" aria-hidden="true"></i>',
                        previous: '<i class="fa fa-angle-double-left" aria-hidden="true"></i>'
                    }
                }
            });

            // Add New Other Deduction
            $('#btnAddOtherDeduction').click(function () {
                resetAddForm();
                $('#addOtherDeductionModal').modal('show');

                // Focus on first input after modal is shown
                $('#addOtherDeductionModal').on('shown.bs.modal', function () {
                    $('#addOtherDeductionCode').focus();
                });
            });

            // View Other Deduction
            $(document).on('click', '.viewOtherDeduction', function (e) {
                e.preventDefault();
                var id = $(this).data('id');
                var $btn = $(this);

                // Disable button and show loading
                $btn.prop('disabled', true);
                $btn.html('<i class="fas fa-spinner fa-spin"></i>');

                $.get('/OtherDeductionList/GetOtherDeduction', { id: id }, function (data) {
                    if (data) {
                        resetViewForm();
                        setViewMode();

                        $('#viewOtherDeductionId').val(data.id);
                        $('#viewOtherDeductionCode').val(data.otherDeductionCode);
                        $('#viewOtherDeductionName').val(data.otherDeductionName);

                        // Set Select2 value for view modal
                        $('#viewIsTaxable').val(data.isTaxable.toString()).trigger('change');

                        $('#viewOtherDeductionModal').modal('show');
                    } else {
                        showNotification('Unable to load other deduction data', 'error');
                    }
                }).fail(function(xhr, status, error) {
                    console.log('Error loading other deduction:', error);
                    showNotification('Unable to load other deduction data', 'error');
                }).always(function() {
                    // Re-enable button
                    $btn.prop('disabled', false);
                    $btn.html('<i class="fas fa-eye"></i>');
                });
            });

            // Edit button in view modal
            $('#btnEditOtherDeduction').click(function () {
                setEditMode();
                $('#viewOtherDeductionCode').focus();
            });

            // Cancel edit button
            $('#btnCancelEdit').click(function () {
                // Reload the original data
                var id = $('#viewOtherDeductionId').val();
                $.get('/OtherDeductionList/GetOtherDeduction', { id: id }, function (data) {
                    if (data) {
                        $('#viewOtherDeductionCode').val(data.otherDeductionCode);
                        $('#viewOtherDeductionName').val(data.otherDeductionName);
                        $('#viewIsTaxable').val(data.isTaxable.toString()).trigger('change');
                        setViewMode();
                        clearValidation('#viewOtherDeductionForm');
                    }
                });
            });

            // Save Other Deduction (from view/edit modal)
            $('#btnSaveOtherDeduction').click(function () {
                // Clear previous validation states
                clearValidation('#viewOtherDeductionForm');

                // Validate form
                if (!validateViewForm()) {
                    return;
                }

                var formData = {
                    id: parseInt($('#viewOtherDeductionId').val()),
                    otherDeductionCode: $('#viewOtherDeductionCode').val().trim(),
                    otherDeductionName: $('#viewOtherDeductionName').val().trim(),
                    isTaxable: $('#viewIsTaxable').val() === 'true'
                };

                // Disable the save button to prevent double submission
                var $saveBtn = $('#btnSaveOtherDeduction');
                $saveBtn.prop('disabled', true).html('<i class="fas fa-spinner fa-spin"></i> Saving...');

                $.post('/OtherDeductionList/UpdateOtherDeduction', formData, function (response) {
                    if (response.success) {
                        setViewMode();
                        table.ajax.reload(null, false); // Keep current page
                        showNotification(response.message, 'success');
                    } else {
                        showNotification(response.message, 'error');
                    }
                }).fail(function(xhr, status, error) {
                    console.log('Error saving other deduction:', error);
                    showNotification('Unable to save other deduction. Please try again.', 'error');
                }).always(function() {
                    // Re-enable the save button
                    $saveBtn.prop('disabled', false).html('Save');
                });
            });

            // Save New Other Deduction (from add modal)
            $('#btnSaveNewOtherDeduction').click(function () {
                // Clear previous validation states
                clearValidation('#addOtherDeductionForm');

                // Validate form
                if (!validateAddForm()) {
                    return;
                }

                var formData = {
                    otherDeductionCode: $('#addOtherDeductionCode').val().trim(),
                    otherDeductionName: $('#addOtherDeductionName').val().trim(),
                    isTaxable: $('#addIsTaxable').val() === 'true'
                };

                // Disable the save button to prevent double submission
                var $saveBtn = $('#btnSaveNewOtherDeduction');
                $saveBtn.prop('disabled', true).html('<i class="fas fa-spinner fa-spin"></i> Saving...');

                $.post('/OtherDeductionList/AddOtherDeduction', formData, function (response) {
                    if (response.success) {
                        $('#addOtherDeductionModal').modal('hide');
                        table.ajax.reload(null, false); // Keep current page
                        showNotification(response.message, 'success');
                    } else {
                        showNotification(response.message, 'error');
                    }
                }).fail(function(xhr, status, error) {
                    console.log('Error saving other deduction:', error);
                    showNotification('Unable to save other deduction. Please try again.', 'error');
                }).always(function() {
                    // Re-enable the save button
                    $saveBtn.prop('disabled', false).html('Save');
                });
            });

            // Delete Other Deduction with reason - REUSABLE ALREADY IN THE GLOBAL
            $(document).on('click', '.deleteOtherDeduction', function (e) {
                e.preventDefault();
                deleteWithReason({
                    title: 'Inactive Other Deduction',
                    text: 'Are you sure you want to inactive this other deduction?',
                    url: '/OtherDeductionList/DeleteOtherDeduction',
                    id: $(this).data('id'),
                    button: $(this),
                    table: table
                });
            });

            // Reset forms when modals are hidden
            $('#addOtherDeductionModal').on('hidden.bs.modal', function () {
                resetAddForm();
            });

            $('#viewOtherDeductionModal').on('hidden.bs.modal', function () {
                resetViewForm();
                setViewMode();
            });

            // Enter key handling for forms
            $('#addOtherDeductionForm').on('keypress', function(e) {
                if (e.which === 13) { // Enter key
                    e.preventDefault();
                    $('#btnSaveNewOtherDeduction').click();
                }
            });

            $('#viewOtherDeductionForm').on('keypress', function(e) {
                if (e.which === 13 && $('#viewOtherDeductionModal .modal-body').hasClass('edit-mode')) { // Enter key in edit mode
                    e.preventDefault();
                    $('#btnSaveOtherDeduction').click();
                }
            });

            // Helper Functions
            function initializeSelect2() {
                // Initialize Select2 for Add modal
                $('#addIsTaxable').select2({
                    placeholder: "Select Taxable Option",
                    allowClear: true,
                    dropdownParent: $('#addOtherDeductionModal'),
                    minimumResultsForSearch: Infinity // Hide search box for simple dropdown
                });

                // Initialize Select2 for View/Edit modal
                $('#viewIsTaxable').select2({
                    placeholder: "Select Taxable Option",
                    allowClear: true,
                    dropdownParent: $('#viewOtherDeductionModal'),
                    minimumResultsForSearch: Infinity // Hide search box for simple dropdown
                });
            }

            function updateTableView() {
                if (isViewingDeleted) {
                    // Update for deleted records view
                    table.ajax.url('/OtherDeductionList/GetDeletedOtherDeductionList').load();
                    $('#btnAddOtherDeduction').hide();
                } else {
                    // Update for active records view
                    table.ajax.url('/OtherDeductionList/GetOtherDeductionList').load();
                    $('#btnAddOtherDeduction').show();
                }
            }

            function resetAddForm() {
                $('#addOtherDeductionForm')[0].reset();
                $('#addIsTaxable').val(null).trigger('change'); // Reset Select2
                clearValidation('#addOtherDeductionForm');
                $('#btnSaveNewOtherDeduction').prop('disabled', false).html('Save');
            }

            function resetViewForm() {
                $('#viewOtherDeductionForm')[0].reset();
                $('#viewIsTaxable').val(null).trigger('change'); // Reset Select2
                clearValidation('#viewOtherDeductionForm');
                $('#btnSaveOtherDeduction').prop('disabled', false).html('Save');
            }

            function setViewMode() {
                $('#viewModalTitle').text('View Other Deduction');
                $('#viewOtherDeductionModal .modal-body').removeClass('edit-mode');

                // Make fields readonly/disabled
                $('#viewOtherDeductionCode').prop('readonly', true);
                $('#viewOtherDeductionName').prop('readonly', true);
                $('#viewIsTaxable').prop('disabled', true);

                // Hide required asterisks
                $('.edit-required').addClass('d-none');

                // Show/hide buttons
                $('#btnEditOtherDeduction').removeClass('d-none');
                $('#btnSaveOtherDeduction').addClass('d-none');
                $('#btnCancelEdit').addClass('d-none');

                clearValidation('#viewOtherDeductionForm');
            }

            function setEditMode() {
                $('#viewModalTitle').text('Edit Other Deduction');
                $('#viewOtherDeductionModal .modal-body').addClass('edit-mode');

                // Make fields editable
                $('#viewOtherDeductionCode').prop('readonly', false);
                $('#viewOtherDeductionName').prop('readonly', false);
                $('#viewIsTaxable').prop('disabled', false);

                // Show required asterisks
                $('.edit-required').removeClass('d-none');

                // Show/hide buttons
                $('#btnEditOtherDeduction').addClass('d-none');
                $('#btnSaveOtherDeduction').removeClass('d-none');
                $('#btnCancelEdit').removeClass('d-none');
            }

            function clearValidation(formSelector) {
                $(formSelector + ' .form-control, ' + formSelector + ' .form-select').removeClass('is-invalid');
                $(formSelector + ' .invalid-feedback').hide();
            }

            function validateAddForm() {
                var isValid = true;

                // Validate other deduction code
                var otherDeductionCode = $('#addOtherDeductionCode').val().trim();
                if (!otherDeductionCode) {
                    $('#addOtherDeductionCode').addClass('is-invalid');
                    isValid = false;
                }

                // Validate other deduction name
                var otherDeductionName = $('#addOtherDeductionName').val().trim();
                if (!otherDeductionName) {
                    $('#addOtherDeductionName').addClass('is-invalid');
                    isValid = false;
                }

                // Validate taxable selection
                var isTaxable = $('#addIsTaxable').val();
                if (!isTaxable) {
                    $('#addIsTaxable').addClass('is-invalid');
                    isValid = false;
                }

                return isValid;
            }

            function validateViewForm() {
                var isValid = true;

                // Validate other deduction code
                var otherDeductionCode = $('#viewOtherDeductionCode').val().trim();
                if (!otherDeductionCode) {
                    $('#viewOtherDeductionCode').addClass('is-invalid');
                    isValid = false;
                }

                // Validate other deduction name
                var otherDeductionName = $('#viewOtherDeductionName').val().trim();
                if (!otherDeductionName) {
                    $('#viewOtherDeductionName').addClass('is-invalid');
                    isValid = false;
                }

                // Validate taxable selection
                var isTaxable = $('#viewIsTaxable').val();
                if (!isTaxable) {
                    $('#viewIsTaxable').addClass('is-invalid');
                    isValid = false;
                }

                return isValid;
            }

            // Updated notification function using toastr
            function showNotification(message, type) {
                if (type === 'success') {
                    toastr.success(message, "Success");
                } else if (type === 'error') {
                    toastr.error(message, "Error");
                } else if (type === 'warning') {
                    toastr.warning(message, "Warning");
                } else if (type === 'info') {
                    toastr.info(message, "Information");
                } else {
                    toastr.info(message, "Notification");
                }
            }

            // Remove validation classes when user starts typing (Add form)
            $('#addOtherDeductionCode, #addOtherDeductionName').on('input', function() {
                $(this).removeClass('is-invalid');
            });

            $('#addIsTaxable').on('change', function() {
                $(this).removeClass('is-invalid');
            });

            // Remove validation classes when user starts typing (View/Edit form)
            $('#viewOtherDeductionCode, #viewOtherDeductionName').on('input', function() {
                $(this).removeClass('is-invalid');
            });

            $('#viewIsTaxable').on('change', function() {
                $(this).removeClass('is-invalid');
            });

            // Restore Other Deduction with SweetAlert2
            $(document).on('click', '.restoreOtherDeduction', function (e) {
                e.preventDefault();
                var id = $(this).data('id');
                var $btn = $(this);

                Swal.fire({
                    title: 'Restore Record',
                    text: 'Are you sure you want to restore this other deduction?',
                    icon: 'question',
                    showCancelButton: true,
                    confirmButtonText: 'Yes, Restore',
                    cancelButtonText: 'Cancel',
                    confirmButtonColor: '#28a745',
                    cancelButtonColor: '#6c757d',
                    reverseButtons: false,
                    allowOutsideClick: false,
                    allowEscapeKey: false
                }).then((result) => {
                    if (result.isConfirmed) {
                        // Disable button and show loading
                        $btn.prop('disabled', true);
                        $btn.html('<i class="fas fa-spinner fa-spin"></i>');

                        $.post('/OtherDeductionList/RestoreOtherDeduction', { id: id }, function (response) {
                            if (response.success) {
                                table.ajax.reload(null, false); // Keep current page
                                showNotification(response.message, 'success');
                            } else {
                                showNotification(response.message, 'error');
                            }
                        }).fail(function(xhr, status, error) {
                            console.log('Error restoring other deduction:', error);
                            showNotification('Unable to restore other deduction. Please try again.', 'error');
                        }).always(function() {
                            // Re-enable button
                            $btn.prop('disabled', false);
                            $btn.html('<i class="fas fa-undo"></i>');
                        });
                    }
                });
            });
        });
    </script>
}