@{
    Layout = "~/Views/Shared/_LayoutFillow.cshtml";
    ViewData["Title"] = "Adjustment List";
}

<div class="col-12">
    <div class="card">
        <div class="card-header">
            <div class="row" style="width:100%;">
                <h4 class="card-title">Adjustment List</h4>
                <br> <br> <br>

                <div class="row" style="margin-left:0px;width:100%;">
                    <div class="col-md-3">
                        <div class="form-group">
                            <h5>Record Status</h5>
                            <select name="filterRecordStatus" id="filterRecordStatus" class="form-control">
                                <option value="active" selected>ACTIVE</option>
                                <option value="inactive">INACTIVE</option>
                            </select>
                        </div>
                    </div>
                    <div class="col-md-6">
                    </div>
                    <div class="col-md-3 d-flex justify-content-end align-items-end">
                        <div class="form-group">
                            <button type="button" class="btn btn-primary" id="btnAddAdjustment">
                                <i class="fa fa-plus"></i> New Adjustment
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="card-body">
            <div class="table-responsive">
                <table id="adjustmentTable" class="display" style="min-width: 845px">
                    <thead>
                        <tr>
                            <th>Action</th>
                            <th>Adjustment Code</th>
                            <th>Adjustment Name</th>                            
                        </tr>
                    </thead>
                </table>
            </div>
        </div>

        <!-- Modal for Add -->
        <div class="modal fade" id="addAdjustmentModal" tabindex="-1" aria-hidden="true">
            <div class="modal-dialog">
                <div class="modal-content">
                    <div class="modal-header">
                        <h5 class="modal-title">Add Adjustment List Form</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                    </div>
                    <div class="modal-body">
                        <form id="addAdjustmentForm">
                            <div class="mb-3">
                                <label for="addAdjustmentCode" class="form-label">Adjustment Code <span class="text-danger">*</span></label>
                                <input type="text" class="form-control alphanum" id="addAdjustmentCode" name="adjustmentCode" required maxlength="50">
                                <div class="invalid-feedback">
                                    Please provide a valid adjustment code.
                                </div>
                            </div>

                            <div class="mb-3">
                                <label for="addAdjustmentName" class="form-label">Adjustment Name <span class="text-danger">*</span></label>
                                <input type="text" class="form-control" id="addAdjustmentName" name="adjustmentName" required maxlength="255">
                                <div class="invalid-feedback">
                                    Please provide a valid adjustment name.
                                </div>
                            </div>

                            <div class="mb-3">
                                <label for="addIsTaxable" class="form-label">Taxable <span class="text-danger">*</span></label>
                                <select class="form-select" id="addIsTaxable" name="isTaxable" style="width:100%" required>
                                    <option value="">Select...</option>
                                    <option value="true">Yes</option>
                                    <option value="false">No</option>
                                </select>
                                <div class="invalid-feedback">
                                    Please select if the adjustment is taxable.
                                </div>
                            </div>
                        </form>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-primary" id="btnSaveNewAdjustment">Save</button>
                    </div>
                </div>
            </div>
        </div>

        <!-- Modal for View/Edit -->
        <div class="modal fade" id="viewAdjustmentModal" tabindex="-1" aria-hidden="true">
            <div class="modal-dialog">
                <div class="modal-content">
                    <div class="modal-header">
                        <h5 class="modal-title" id="viewModalTitle">Adjustment List Form</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                    </div>
                    <div class="modal-body">
                        <form id="viewAdjustmentForm">
                            <input type="hidden" id="viewAdjustmentId" name="id">

                            <div class="mb-3">
                                <label for="viewAdjustmentCode" class="form-label">Adjustment Code <span class="text-danger edit-required d-none">*</span></label>
                                <input type="text" class="form-control alphanum" id="viewAdjustmentCode" name="adjustmentCode" readonly maxlength="50">
                                <div class="invalid-feedback">
                                    Please provide a valid adjustment code.
                                </div>
                            </div>

                            <div class="mb-3">
                                <label for="viewAdjustmentName" class="form-label">Adjustment Name <span class="text-danger edit-required d-none">*</span></label>
                                <input type="text" class="form-control" id="viewAdjustmentName" name="adjustmentName" readonly maxlength="255">
                                <div class="invalid-feedback">
                                    Please provide a valid adjustment name.
                                </div>
                            </div>

                            <div class="mb-3">
                                <label for="viewIsTaxable" class="form-label">Taxable <span class="text-danger edit-required d-none">*</span></label>
                                <select class="form-select" id="viewIsTaxable" name="isTaxable" style="width:100%" disabled>
                                    <option value="">Select...</option>
                                    <option value="true">Yes</option>
                                    <option value="false">No</option>
                                </select>
                                <div class="invalid-feedback">
                                    Please select if the adjustment is taxable.
                                </div>
                            </div>
                        </form>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-primary" id="btnEditAdjustment">
                            <i class="fas fa-edit"></i> Edit
                        </button>
                        <button type="button" class="btn btn-success d-none" id="btnSaveAdjustment">Save</button>
                        <button type="button" class="btn btn-danger d-none" id="btnCancelEdit">Cancel</button>
                    </div>
                </div>
            </div>
        </div>

    </div>
</div>

@section Fillow_style
{

    <style>
        .table-responsive {
            border-radius: 0.375rem;
        }

        #adjustmentTable_wrapper .dataTables_length,
        #adjustmentTable_wrapper .dataTables_filter {
            margin-bottom: 1rem;
        }

        #adjustmentTable_wrapper .dataTables_info,
        #adjustmentTable_wrapper .dataTables_paginate {
            margin-top: 1rem;
        }

        .btn-sm {
            padding: 0.25rem 0.5rem;
            font-size: 0.875rem;
        }

        .modal-content {
            border-radius: 0.5rem;
            box-shadow: 0 0.5rem 1rem rgba(0, 0, 0, 0.15);
        }

        .form-control:focus,
        .form-select:focus {
            border-color: #0d6efd;
            box-shadow: 0 0 0 0.2rem rgba(13, 110, 253, 0.25);
        }

        .invalid-feedback {
            display: none;
        }

        .form-control.is-invalid,
        .form-select.is-invalid {
            border-color: #dc3545;
        }

        .form-control.is-invalid ~ .invalid-feedback,
        .form-select.is-invalid ~ .invalid-feedback {
            display: block;
        }

        /* Readonly/disabled field styling */
        .form-control[readonly] {
            background-color: #f8f9fa;
            border-color: #dee2e6;
        }

        .form-select[disabled] {
            background-color: #f8f9fa;
            border-color: #dee2e6;
        }

        /* Edit mode styling */
        .edit-mode .form-control[readonly] {
            background-color: #ffffff;
            border-color: #ced4da;
        }

        .edit-mode .form-select[disabled] {
            background-color: #ffffff;
            border-color: #ced4da;
        }

        /* Select2 styling adjustments */
        .select2-container .select2-selection--single {
            height: 38px;
            border: 1px solid #ced4da;
            border-radius: 0.375rem;
        }

        .select2-container--default .select2-selection--single .select2-selection__rendered {
            line-height: 36px;
            padding-left: 12px;
        }

        .select2-container--default .select2-selection--single .select2-selection__arrow {
            height: 36px;
        }

        .select2-container--default.select2-container--focus .select2-selection--single {
            border-color: #0d6efd;
            box-shadow: 0 0 0 0.2rem rgba(13, 110, 253, 0.25);
        }

        .select2-container--default .select2-selection--single.select2-selection--disabled {
            background-color: #f8f9fa;
            border-color: #dee2e6;
        }

        /* Select2 validation styling */
        .is-invalid + .select2-container .select2-selection--single {
            border-color: #dc3545;
        }

        /* Custom SweetAlert2 styling to match your image */
        .swal2-popup {
            border-radius: 15px !important;
            padding: 2rem !important;
        }

        .swal2-icon.swal2-error {
            border-color: #f27474 !important;
            color: #f27474 !important;
        }

        .swal2-icon.swal2-error .swal2-x-mark {
            display: none !important;
        }

        .swal2-icon.swal2-error::before {
            content: "\f2ed" !important;
            font-family: "Font Awesome 5 Free" !important;
            font-weight: 900 !important;
            font-size: 2.5rem !important;
            color: #f27474 !important;
            display: block !important;
        }

        .swal2-title {
            font-size: 1.875rem !important;
            font-weight: 600 !important;
            color: #545454 !important;
            margin: 1rem 0 0.5rem 0 !important;
        }

        .swal2-html-container {
            font-size: 1rem !important;
            color: #737373 !important;
            margin: 0 0 2rem 0 !important;
        }

        .swal2-actions {
            gap: 0.5rem !important;
        }

        .swal2-confirm {
            background-color: #7c3aed !important;
            border-color: #7c3aed !important;
            color: white !important;
            font-weight: 500 !important;
            padding: 0.75rem 2rem !important;
            border-radius: 8px !important;
            font-size: 0.875rem !important;
        }

        .swal2-cancel {
            background-color: #6b7280 !important;
            border-color: #6b7280 !important;
            color: white !important;
            font-weight: 500 !important;
            padding: 0.75rem 2rem !important;
            border-radius: 8px !important;
            font-size: 0.875rem !important;
        }

        .swal2-confirm:hover {
            background-color: #6d28d9 !important;
            border-color: #6d28d9 !important;
        }

        .swal2-cancel:hover {
            background-color: #4b5563 !important;
            border-color: #4b5563 !important;
        }

        /* Toggle view button styling */
        #btnToggleView {
            transition: all 0.3s ease;
        }

        #btnToggleView:hover {
            transform: translateY(-1px);
        }

        /* Badge styling */
        .badge {
            font-size: 0.75rem;
            padding: 0.35em 0.65em;
        }

        /* Restore button styling */
        .btn-success.shadow-sm:hover {
            background-color: #1e7e34;
            border-color: #1c7430;
        }

        .card-header {
            border-bottom: none !important;
        }

        #filterRecordStatus {
            width: 100%;
        }
    </style>
}

@section Fillow_script
{

    <script>
        $(document).ready(function () {

            MODULE = 'SadjustmentM';
            access = ROLE_ACCESS?.[MODULE];

            if (access != 'READWRITE' && access != 'FULL') {
                $('#btnAddAdjustment').hide();
                $('#btnEditAdjustment').hide();
            }

            // Initialize toastr options
            toastr.options = {
                positionClass: "toast-top-right",
                timeOut: 5000,
                closeButton: true,
                debug: false,
                newestOnTop: true,
                progressBar: true,
                preventDuplicates: true,
                onclick: null,
                showDuration: "300",
                hideDuration: "1000",
                extendedTimeOut: "1000",
                showEasing: "swing",
                hideEasing: "linear",
                showMethod: "fadeIn",
                hideMethod: "fadeOut",
                tapToDismiss: false
            };

            // View state management
            let isViewingDeleted = false;

            // Initialize Select2 dropdowns
            initializeSelect2();

            // Initialize Select2 for the filter
            $('#filterRecordStatus').select2({
                selectOnClose: true,
                minimumResultsForSearch: Infinity
            });

            // Handle filter change
            $('#filterRecordStatus').on('change', function () {
                isViewingDeleted = $(this).val() === 'inactive';
                updateTableView();
            });

            var table = $('#adjustmentTable').DataTable({
                processing: true,
                serverSide: false,
                ajax: {
                    url: "/AdjustmentList/GetAdjustmentList",
                    type: "GET",
                    datatype: "json",
                    error: function(xhr, error, code) {
                        console.log('Error loading data:', error);
                        showNotification('Error loading adjustment data. Please refresh the page.', 'error');
                    }
                },
                columns: [
                    {
                        data: "id",
                        width: "20%",
                        orderable: false,
                        render: function (data) {
                            if (isViewingDeleted) {
                                return `
                                    <div class="d-flex gap-1">
                                        <button type="button" class="btn btn-sm btn-success shadow-sm restoreAdjustment" data-id="${data}" title="Restore">
                                            <i class="fas fa-undo"></i>
                                        </button>
                                    </div>`;
                            } else {
                                return `
                                    <div class="d-flex gap-1">
                                        <button type="button" class="btn btn-sm btn-primary shadow-sm viewAdjustment" data-id="${data}" title="View">
                                            <i class="fas fa-eye"></i>
                                        </button>
                                        <button type="button" class="btn btn-sm btn-danger shadow-sm deleteAdjustment" data-id="${data}" title="Delete">
                                            <i class="fa fa-trash"></i>
                                        </button>
                                    </div>`;
                            }
                        }
                    },
                    {
                        data: "adjustmentCode",
                        width: "25%"
                    },
                    {
                        data: "adjustmentName",
                        width: "55%"
                    }             
                ],
                order: [],
                pageLength: 25,
                lengthMenu: [[10, 25, 50, 100, -1], [10, 25, 50, 100, "All"]],
                language: {
                    processing: "Loading...",
                    emptyTable: "No adjustments found",
                    zeroRecords: "No matching adjustments found",
                    paginate: {
                        next: '<i class="fa fa-angle-double-right" aria-hidden="true"></i>',
                        previous: '<i class="fa fa-angle-double-left" aria-hidden="true"></i>'
                    }
                }
            });

            // Add New Adjustment
            $('#btnAddAdjustment').click(function () {
                resetAddForm();
                $('#addAdjustmentModal').modal('show');

                // Focus on first input after modal is shown
                $('#addAdjustmentModal').on('shown.bs.modal', function () {
                    $('#addAdjustmentCode').focus();
                });
            });

            // View Adjustment
            $(document).on('click', '.viewAdjustment', function (e) {
                e.preventDefault();
                var id = $(this).data('id');
                var $btn = $(this);

                // Disable button and show loading
                $btn.prop('disabled', true);
                $btn.html('<i class="fas fa-spinner fa-spin"></i>');

                $.get('/AdjustmentList/GetAdjustment', { id: id }, function (data) {
                    if (data) {
                        resetViewForm();
                        setViewMode();

                        $('#viewAdjustmentId').val(data.id);
                        $('#viewAdjustmentCode').val(data.adjustmentCode);
                        $('#viewAdjustmentName').val(data.adjustmentName);

                        // Set Select2 value for view modal
                        $('#viewIsTaxable').val(data.isTaxable.toString()).trigger('change');

                        $('#viewAdjustmentModal').modal('show');
                    } else {
                        showNotification('Unable to load adjustment data', 'error');
                    }
                }).fail(function(xhr, status, error) {
                    console.log('Error loading adjustment:', error);
                    showNotification('Unable to load adjustment data', 'error');
                }).always(function() {
                    // Re-enable button
                    $btn.prop('disabled', false);
                    $btn.html('<i class="fas fa-eye"></i>');
                });
            });

            // Edit button in view modal
            $('#btnEditAdjustment').click(function () {
                setEditMode();
                $('#viewAdjustmentCode').focus();
            });

            // Cancel edit button
            $('#btnCancelEdit').click(function () {
                // Reload the original data
                var id = $('#viewAdjustmentId').val();
                $.get('/AdjustmentList/GetAdjustment', { id: id }, function (data) {
                    if (data) {
                        $('#viewAdjustmentCode').val(data.adjustmentCode);
                        $('#viewAdjustmentName').val(data.adjustmentName);
                        $('#viewIsTaxable').val(data.isTaxable.toString()).trigger('change');
                        setViewMode();
                        clearValidation('#viewAdjustmentForm');
                    }
                });
            });

            // Save Adjustment (from view/edit modal)
            $('#btnSaveAdjustment').click(function () {
                // Clear previous validation states
                clearValidation('#viewAdjustmentForm');

                // Validate form
                if (!validateViewForm()) {
                    return;
                }

                var formData = {
                    id: parseInt($('#viewAdjustmentId').val()),
                    adjustmentCode: $('#viewAdjustmentCode').val().trim(),
                    adjustmentName: $('#viewAdjustmentName').val().trim(),
                    isTaxable: $('#viewIsTaxable').val() === 'true'
                };

                // Disable the save button to prevent double submission
                var $saveBtn = $('#btnSaveAdjustment');
                $saveBtn.prop('disabled', true).html('<i class="fas fa-spinner fa-spin"></i> Saving...');

                $.post('/AdjustmentList/UpdateAdjustment', formData, function (response) {
                    if (response.success) {
                        setViewMode();
                        table.ajax.reload(null, false); // Keep current page
                        showNotification(response.message, 'success');
                    } else {
                        showNotification(response.message, 'error');
                    }
                }).fail(function(xhr, status, error) {
                    console.log('Error saving adjustment:', error);
                    showNotification('Unable to save adjustment. Please try again.', 'error');
                }).always(function() {
                    // Re-enable the save button
                    $saveBtn.prop('disabled', false).html('Save');
                });
            });

            // Save New Adjustment (from add modal)
            $('#btnSaveNewAdjustment').click(function () {
                // Clear previous validation states
                clearValidation('#addAdjustmentForm');

                // Validate form
                if (!validateAddForm()) {
                    return;
                }

                var formData = {
                    adjustmentCode: $('#addAdjustmentCode').val().trim(),
                    adjustmentName: $('#addAdjustmentName').val().trim(),
                    isTaxable: $('#addIsTaxable').val() === 'true'
                };

                // Disable the save button to prevent double submission
                var $saveBtn = $('#btnSaveNewAdjustment');
                $saveBtn.prop('disabled', true).html('<i class="fas fa-spinner fa-spin"></i> Saving...');

                $.post('/AdjustmentList/AddAdjustment', formData, function (response) {
                    if (response.success) {
                        $('#addAdjustmentModal').modal('hide');
                        table.ajax.reload(null, false); // Keep current page
                        showNotification(response.message, 'success');
                    } else {
                        showNotification(response.message, 'error');
                    }
                }).fail(function(xhr, status, error) {
                    console.log('Error saving adjustment:', error);
                    showNotification('Unable to save adjustment. Please try again.', 'error');
                }).always(function() {
                    // Re-enable the save button
                    $saveBtn.prop('disabled', false).html('Save');
                });
            });

            // Delete Adjustment with reason - REUSABLE ALREADY IN THE GLOBAL
            $(document).on('click', '.deleteAdjustment', function (e) {
                e.preventDefault();
                deleteWithReason({
                    title: 'Inactive Adjustment',
                    text: 'Are you sure you want to inactive this adjustment?',
                    url: '/AdjustmentList/DeleteAdjustment',
                    id: $(this).data('id'),
                    button: $(this),
                    table: table
                });
            });

            // Reset forms when modals are hidden
            $('#addAdjustmentModal').on('hidden.bs.modal', function () {
                resetAddForm();
            });

            $('#viewAdjustmentModal').on('hidden.bs.modal', function () {
                resetViewForm();
                setViewMode();
            });

            // Enter key handling for forms
            $('#addAdjustmentForm').on('keypress', function(e) {
                if (e.which === 13) { // Enter key
                    e.preventDefault();
                    $('#btnSaveNewAdjustment').click();
                }
            });

            $('#viewAdjustmentForm').on('keypress', function(e) {
                if (e.which === 13 && $('#viewAdjustmentModal .modal-body').hasClass('edit-mode')) { // Enter key in edit mode
                    e.preventDefault();
                    $('#btnSaveAdjustment').click();
                }
            });

            // Helper Functions
            function initializeSelect2() {
                // Initialize Select2 for Add modal
                $('#addIsTaxable').select2({
                    placeholder: "Select Taxable Option",
                    allowClear: true,
                    dropdownParent: $('#addAdjustmentModal'),
                    minimumResultsForSearch: Infinity // Hide search box for simple dropdown
                });

                // Initialize Select2 for View/Edit modal
                $('#viewIsTaxable').select2({
                    placeholder: "Select Taxable Option",
                    allowClear: true,
                    dropdownParent: $('#viewAdjustmentModal'),
                    minimumResultsForSearch: Infinity // Hide search box for simple dropdown
                });
            }

            function updateTableView() {
                if (isViewingDeleted) {
                    // Update for deleted records view
                    table.ajax.url('/AdjustmentList/GetDeletedAdjustmentList').load();
                    $('#btnAddAdjustment').hide();
                } else {
                    // Update for active records view
                    table.ajax.url('/AdjustmentList/GetAdjustmentList').load();
                    $('#btnAddAdjustment').show();
                }
            }

            function resetAddForm() {
                $('#addAdjustmentForm')[0].reset();
                $('#addIsTaxable').val(null).trigger('change'); // Reset Select2
                clearValidation('#addAdjustmentForm');
                $('#btnSaveNewAdjustment').prop('disabled', false).html('Save');
            }

            function resetViewForm() {
                $('#viewAdjustmentForm')[0].reset();
                $('#viewIsTaxable').val(null).trigger('change'); // Reset Select2
                clearValidation('#viewAdjustmentForm');
                $('#btnSaveAdjustment').prop('disabled', false).html('Save');
            }

            function setViewMode() {
                $('#viewModalTitle').text('View Adjustment');
                $('#viewAdjustmentModal .modal-body').removeClass('edit-mode');

                // Make fields readonly/disabled
                $('#viewAdjustmentCode').prop('readonly', true);
                $('#viewAdjustmentName').prop('readonly', true);
                $('#viewIsTaxable').prop('disabled', true);

                // Hide required asterisks
                $('.edit-required').addClass('d-none');

                // Show/hide buttons
                $('#btnEditAdjustment').removeClass('d-none');
                $('#btnSaveAdjustment').addClass('d-none');
                $('#btnCancelEdit').addClass('d-none');

                clearValidation('#viewAdjustmentForm');
            }

            function setEditMode() {
                $('#viewModalTitle').text('Edit Adjustment');
                $('#viewAdjustmentModal .modal-body').addClass('edit-mode');

                // Make fields editable
                $('#viewAdjustmentCode').prop('readonly', false);
                $('#viewAdjustmentName').prop('readonly', false);
                $('#viewIsTaxable').prop('disabled', false);

                // Show required asterisks
                $('.edit-required').removeClass('d-none');

                // Show/hide buttons
                $('#btnEditAdjustment').addClass('d-none');
                $('#btnSaveAdjustment').removeClass('d-none');
                $('#btnCancelEdit').removeClass('d-none');
            }

            function clearValidation(formSelector) {
                $(formSelector + ' .form-control, ' + formSelector + ' .form-select').removeClass('is-invalid');
                $(formSelector + ' .invalid-feedback').hide();
            }

            function validateAddForm() {
                var isValid = true;

                // Validate adjustment code
                var adjustmentCode = $('#addAdjustmentCode').val().trim();
                if (!adjustmentCode) {
                    $('#addAdjustmentCode').addClass('is-invalid');
                    isValid = false;
                }

                // Validate adjustment name
                var adjustmentName = $('#addAdjustmentName').val().trim();
                if (!adjustmentName) {
                    $('#addAdjustmentName').addClass('is-invalid');
                    isValid = false;
                }

                // Validate taxable selection
                var isTaxable = $('#addIsTaxable').val();
                if (!isTaxable) {
                    $('#addIsTaxable').addClass('is-invalid');
                    isValid = false;
                }

                return isValid;
            }

            function validateViewForm() {
                var isValid = true;

                // Validate adjustment code
                var adjustmentCode = $('#viewAdjustmentCode').val().trim();
                if (!adjustmentCode) {
                    $('#viewAdjustmentCode').addClass('is-invalid');
                    isValid = false;
                }

                // Validate adjustment name
                var adjustmentName = $('#viewAdjustmentName').val().trim();
                if (!adjustmentName) {
                    $('#viewAdjustmentName').addClass('is-invalid');
                    isValid = false;
                }

                // Validate taxable selection
                var isTaxable = $('#viewIsTaxable').val();
                if (!isTaxable) {
                    $('#viewIsTaxable').addClass('is-invalid');
                    isValid = false;
                }

                return isValid;
            }

            // Updated notification function using toastr
            function showNotification(message, type) {
                if (type === 'success') {
                    toastr.success(message, "Success");
                } else if (type === 'error') {
                    toastr.error(message, "Error");
                } else if (type === 'warning') {
                    toastr.warning(message, "Warning");
                } else if (type === 'info') {
                    toastr.info(message, "Information");
                } else {
                    toastr.info(message, "Notification");
                }
            }

            // Remove validation classes when user starts typing (Add form)
            $('#addAdjustmentCode, #addAdjustmentName').on('input', function() {
                $(this).removeClass('is-invalid');
            });

            $('#addIsTaxable').on('change', function() {
                $(this).removeClass('is-invalid');
            });

            // Remove validation classes when user starts typing (View/Edit form)
            $('#viewAdjustmentCode, #viewAdjustmentName').on('input', function() {
                $(this).removeClass('is-invalid');
            });

            $('#viewIsTaxable').on('change', function() {
                $(this).removeClass('is-invalid');
            });

            // Restore Adjustment with SweetAlert2
            $(document).on('click', '.restoreAdjustment', function (e) {
                e.preventDefault();
                var id = $(this).data('id');
                var $btn = $(this);

                Swal.fire({
                    title: 'Restore Record',
                    text: 'Are you sure you want to restore this adjustment?',
                    icon: 'question',
                    showCancelButton: true,
                    confirmButtonText: 'Yes, Restore',
                    cancelButtonText: 'Cancel',
                    confirmButtonColor: '#28a745',
                    cancelButtonColor: '#6c757d',
                    reverseButtons: false,
                    allowOutsideClick: false,
                    allowEscapeKey: false
                }).then((result) => {
                    if (result.isConfirmed) {
                        // Disable button and show loading
                        $btn.prop('disabled', true);
                        $btn.html('<i class="fas fa-spinner fa-spin"></i>');

                        $.post('/AdjustmentList/RestoreAdjustment', { id: id }, function (response) {
                            if (response.success) {
                                table.ajax.reload(null, false); // Keep current page
                                showNotification(response.message, 'success');
                            } else {
                                showNotification(response.message, 'error');
                            }
                        }).fail(function(xhr, status, error) {
                            console.log('Error restoring adjustment:', error);
                            showNotification('Unable to restore adjustment. Please try again.', 'error');
                        }).always(function() {
                            // Re-enable button
                            $btn.prop('disabled', false);
                            $btn.html('<i class="fas fa-undo"></i>');
                        });
                    }
                });
            });
        });
    </script>
}
