@{
    Layout = "~/Views/Shared/_LayoutFillow.cshtml";
    ViewData["Title"] = "Bank List";
}

<div class="col-12">
    <div class="card">
        <div class="card-header">
            <div class="row" style="width:100%;">
                <h4 class="card-title">Bank List</h4>
                <br> <br> <br>

                <div class="row" style="margin-left:0px;width:100%;">
                    <div class="col-md-3">
                        <div class="form-group">
                            <h5>Record Status</h5>
                            <select name="filterRecordStatus" id="filterRecordStatus" class="form-control">
                                <option value="active" selected>ACTIVE</option>
                                <option value="inactive">INACTIVE</option>
                            </select>
                        </div>
                    </div>
                    <div class="col-md-6">
                    </div>
                    <div class="col-md-3 d-flex justify-content-end align-items-end">
                        <div class="form-group">
                            <button type="button" class="btn btn-primary" id="btnAddBank">
                                <i class="fa fa-plus"></i> New Bank
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="card-body">
            <div class="table-responsive">
                <table id="bankTable" class="display" style="min-width: 845px">
                    <thead>
                        <tr>
                            <th>Action</th>
                            <th>Bank Code</th>
                            <th>Bank Name</th>                           
                        </tr>
                    </thead>
                </table>
            </div>
        </div>

        <!-- Modal for Add -->
        <div class="modal fade" id="addBankModal" tabindex="-1" aria-hidden="true">
            <div class="modal-dialog">
                <div class="modal-content">
                    <div class="modal-header">
                        <h5 class="modal-title">Bank List Form</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                    </div>
                    <div class="modal-body">
                        <form id="addBankForm">
                            <div class="mb-3">
                                <label for="addBankCode" class="form-label">Bank Code <span class="text-danger">*</span></label>
                                <input type="text" class="form-control alphanum" id="addBankCode" name="bankCode" required maxlength="50">
                                <div class="invalid-feedback">
                                    Please provide a valid bank code.
                                </div>
                            </div>

                            <div class="mb-3">
                                <label for="addBankName" class="form-label">Bank Name <span class="text-danger">*</span></label>
                                <input type="text" class="form-control" id="addBankName" name="bankName" required maxlength="50">
                                <div class="invalid-feedback">
                                    Please provide a valid bank name.
                                </div>
                            </div>
                        </form>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-primary" id="btnSaveNewBank">Save</button>
                    </div>
                </div>
            </div>
        </div>

        <!-- Modal for View/Edit -->
        <div class="modal fade" id="viewBankModal" tabindex="-1" aria-hidden="true">
            <div class="modal-dialog">
                <div class="modal-content">
                    <div class="modal-header">
                        <h5 class="modal-title" id="viewModalTitle">View Bank List Form</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                    </div>
                    <div class="modal-body">
                        <form id="viewBankForm">
                            <input type="hidden" id="viewBankId" name="id">

                            <div class="mb-3">
                                <label for="viewBankCode" class="form-label">Bank Code <span class="text-danger edit-required d-none">*</span></label>
                                <input type="text" class="form-control alphanum" id="viewBankCode" name="bankCode" readonly maxlength="50">
                                <div class="invalid-feedback">
                                    Please provide a valid bank code.
                                </div>
                            </div>

                            <div class="mb-3">
                                <label for="viewBankName" class="form-label">Bank Name <span class="text-danger edit-required d-none">*</span></label>
                                <input type="text" class="form-control" id="viewBankName" name="bankName" readonly maxlength="50">
                                <div class="invalid-feedback">
                                    Please provide a valid bank name.
                                </div>
                            </div>
                        </form>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-primary" id="btnEditBank">
                            <i class="fas fa-edit"></i> Edit
                        </button>
                        <button type="button" class="btn btn-success d-none" id="btnSaveBank">Save</button>
                        <button type="button" class="btn btn-danger d-none" id="btnCancelEdit">Cancel</button>
                    </div>
                </div>
            </div>
        </div>

    </div>
</div>

@section Fillow_style
{

    <style>
        .table-responsive {
            border-radius: 0.375rem;
        }

        #bankTable_wrapper .dataTables_length,
        #bankTable_wrapper .dataTables_filter {
            margin-bottom: 1rem;
        }

        #bankTable_wrapper .dataTables_info,
        #bankTable_wrapper .dataTables_paginate {
            margin-top: 1rem;
        }

        .btn-sm {
            padding: 0.25rem 0.5rem;
            font-size: 0.875rem;
        }

        .modal-content {
            border-radius: 0.5rem;
            box-shadow: 0 0.5rem 1rem rgba(0, 0, 0, 0.15);
        }

        .form-control:focus,
        .form-select:focus {
            border-color: #0d6efd;
            box-shadow: 0 0 0 0.2rem rgba(13, 110, 253, 0.25);
        }

        .invalid-feedback {
            display: none;
        }

        .form-control.is-invalid,
        .form-select.is-invalid {
            border-color: #dc3545;
        }

        .form-control.is-invalid ~ .invalid-feedback,
        .form-select.is-invalid ~ .invalid-feedback {
            display: block;
        }

        /* Readonly/disabled field styling */
        .form-control[readonly] {
            background-color: #f8f9fa;
            border-color: #dee2e6;
        }

        .form-select[disabled] {
            background-color: #f8f9fa;
            border-color: #dee2e6;
        }

        /* Edit mode styling */
        .edit-mode .form-control[readonly] {
            background-color: #ffffff;
            border-color: #ced4da;
        }

        .edit-mode .form-select[disabled] {
            background-color: #ffffff;
            border-color: #ced4da;
        }

        /* Custom SweetAlert2 styling */
        .swal2-popup {
            border-radius: 15px !important;
            padding: 2rem !important;
        }

        .swal2-icon.swal2-error {
            border-color: #f27474 !important;
            color: #f27474 !important;
        }

        .swal2-icon.swal2-error .swal2-x-mark {
            display: none !important;
        }

        .swal2-icon.swal2-error::before {
            content: "\f2ed" !important;
            font-family: "Font Awesome 5 Free" !important;
            font-weight: 900 !important;
            font-size: 2.5rem !important;
            color: #f27474 !important;
            display: block !important;
        }

        .swal2-title {
            font-size: 1.875rem !important;
            font-weight: 600 !important;
            color: #545454 !important;
            margin: 1rem 0 0.5rem 0 !important;
        }

        .swal2-html-container {
            font-size: 1rem !important;
            color: #737373 !important;
            margin: 0 0 2rem 0 !important;
        }

        .swal2-actions {
            gap: 0.5rem !important;
        }

        .swal2-confirm {
            background-color: #7c3aed !important;
            border-color: #7c3aed !important;
            color: white !important;
            font-weight: 500 !important;
            padding: 0.75rem 2rem !important;
            border-radius: 8px !important;
            font-size: 0.875rem !important;
        }

        .swal2-cancel {
            background-color: #6b7280 !important;
            border-color: #6b7280 !important;
            color: white !important;
            font-weight: 500 !important;
            padding: 0.75rem 2rem !important;
            border-radius: 8px !important;
            font-size: 0.875rem !important;
        }

        .swal2-confirm:hover {
            background-color: #6d28d9 !important;
            border-color: #6d28d9 !important;
        }

        .swal2-cancel:hover {
            background-color: #4b5563 !important;
            border-color: #4b5563 !important;
        }

        /* Restore button styling */
        .btn-success.shadow-sm:hover {
            background-color: #1e7e34;
            border-color: #1c7430;
        }

        .card-header {
            border-bottom: none !important;
        }

        #filterRecordStatus {
            width: 100%;
        }
    </style>
}

@section Fillow_script
{

    <script>
        $(document).ready(function () {

            MODULE = 'SbankM';
            access = ROLE_ACCESS?.[MODULE];

            if (access != 'READWRITE' && access != 'FULL') {
                $('#btnAddBank').hide();
                $('#btnEditBank').hide();
            }

            // Initialize toastr options
            toastr.options = {
                positionClass: "toast-top-right",
                timeOut: 5000,
                closeButton: true,
                debug: false,
                newestOnTop: true,
                progressBar: true,
                preventDuplicates: true,
                onclick: null,
                showDuration: "300",
                hideDuration: "1000",
                extendedTimeOut: "1000",
                showEasing: "swing",
                hideEasing: "linear",
                showMethod: "fadeIn",
                hideMethod: "fadeOut",
                tapToDismiss: false
            };

            // View state management
            let isViewingDeleted = false;

            // Initialize Select2 for the filter
            $('#filterRecordStatus').select2({
                selectOnClose: true,
                minimumResultsForSearch: Infinity
            });

            // Handle filter change
            $('#filterRecordStatus').on('change', function () {
                isViewingDeleted = $(this).val() === 'inactive';
                updateTableView();
            });

            var table = $('#bankTable').DataTable({
                processing: true,
                serverSide: false,
                ajax: {
                    url: "/BankList/GetBankList",
                    type: "GET",
                    datatype: "json",
                    error: function(xhr, error, code) {
                        console.log('Error loading data:', error);
                        showNotification('Error loading bank data. Please refresh the page.', 'error');
                    }
                },
                columns: [
                    {
                        data: "id",
                        width: "20%",
                        orderable: false,
                        render: function (data) {
                            if (isViewingDeleted) {
                                return `
                                    <div class="d-flex gap-1">
                                        <button type="button" class="btn btn-sm btn-success shadow-sm restoreBank" data-id="${data}" title="Restore">
                                            <i class="fas fa-undo"></i>
                                        </button>
                                    </div>`;
                            } else {
                                return `
                                    <div class="d-flex gap-1">
                                        <button type="button" class="btn btn-sm btn-primary shadow-sm viewBank" data-id="${data}" title="View">
                                            <i class="fas fa-eye"></i>
                                        </button>
                                        <button type="button" class="btn btn-sm btn-danger shadow-sm deleteBank" data-id="${data}" title="Delete">
                                            <i class="fa fa-trash"></i>
                                        </button>
                                    </div>`;
                            }
                        }
                    },
                    {
                        data: "bankCode",
                        width: "25%"
                    },
                    {
                        data: "bankName",
                        width: "55%"
                    }                   
                ],
                order: [],
                pageLength: 25,
                lengthMenu: [[10, 25, 50, 100, -1], [10, 25, 50, 100, "All"]],
                language: {
                    processing: "Loading...",
                    emptyTable: "No banks found",
                    zeroRecords: "No matching banks found",
                    paginate: {
                        next: '<i class="fa fa-angle-double-right" aria-hidden="true"></i>',
                        previous: '<i class="fa fa-angle-double-left" aria-hidden="true"></i>'
                    }
                }
            });

            // Add New Bank
            $('#btnAddBank').click(function () {
                resetAddForm();
                $('#addBankModal').modal('show');

                // Focus on first input after modal is shown
                $('#addBankModal').on('shown.bs.modal', function () {
                    $('#addBankCode').focus();
                });
            });

            // View Bank
            $(document).on('click', '.viewBank', function (e) {
                e.preventDefault();
                var id = $(this).data('id');
                var $btn = $(this);

                // Disable button and show loading
                $btn.prop('disabled', true);
                $btn.html('<i class="fas fa-spinner fa-spin"></i>');

                $.get('/BankList/GetBank', { id: id }, function (data) {
                    if (data) {
                        resetViewForm();
                        setViewMode();

                        $('#viewBankId').val(data.id);
                        $('#viewBankCode').val(data.bankCode);
                        $('#viewBankName').val(data.bankName);

                        $('#viewBankModal').modal('show');
                    } else {
                        showNotification('Unable to load bank data', 'error');
                    }
                }).fail(function(xhr, status, error) {
                    console.log('Error loading bank:', error);
                    showNotification('Unable to load bank data', 'error');
                }).always(function() {
                    // Re-enable button
                    $btn.prop('disabled', false);
                    $btn.html('<i class="fas fa-eye"></i>');
                });
            });

            // Edit button in view modal
            $('#btnEditBank').click(function () {
                setEditMode();
                $('#viewBankCode').focus();
            });

            // Cancel edit button
            $('#btnCancelEdit').click(function () {
                // Reload the original data
                var id = $('#viewBankId').val();
                $.get('/BankList/GetBank', { id: id }, function (data) {
                    if (data) {
                        $('#viewBankCode').val(data.bankCode);
                        $('#viewBankName').val(data.bankName);
                        setViewMode();
                        clearValidation('#viewBankForm');
                    }
                });
            });

            // Save Bank (from view/edit modal)
            $('#btnSaveBank').click(function () {
                // Clear previous validation states
                clearValidation('#viewBankForm');

                // Validate form
                if (!validateViewForm()) {
                    return;
                }

                var formData = {
                    id: parseInt($('#viewBankId').val()),
                    bankCode: $('#viewBankCode').val().trim(),
                    bankName: $('#viewBankName').val().trim()
                };

                // Disable the save button to prevent double submission
                var $saveBtn = $('#btnSaveBank');
                $saveBtn.prop('disabled', true).html('<i class="fas fa-spinner fa-spin"></i> Saving...');

                $.post('/BankList/UpdateBank', formData, function (response) {
                    if (response.success) {
                        setViewMode();
                        table.ajax.reload(null, false); // Keep current page
                        showNotification(response.message, 'success');
                    } else {
                        showNotification(response.message, 'error');
                    }
                }).fail(function(xhr, status, error) {
                    console.log('Error saving bank:', error);
                    showNotification('Unable to save bank. Please try again.', 'error');
                }).always(function() {
                    // Re-enable the save button
                    $saveBtn.prop('disabled', false).html('Save');
                });
            });

            // Save New Bank (from add modal)
            $('#btnSaveNewBank').click(function () {
                // Clear previous validation states
                clearValidation('#addBankForm');

                // Validate form
                if (!validateAddForm()) {
                    return;
                }

                var formData = {
                    bankCode: $('#addBankCode').val().trim(),
                    bankName: $('#addBankName').val().trim()
                };

                // Disable the save button to prevent double submission
                var $saveBtn = $('#btnSaveNewBank');
                $saveBtn.prop('disabled', true).html('<i class="fas fa-spinner fa-spin"></i> Saving...');

                $.post('/BankList/AddBank', formData, function (response) {
                    if (response.success) {
                        $('#addBankModal').modal('hide');
                        table.ajax.reload(null, false); // Keep current page
                        showNotification(response.message, 'success');
                    } else {
                        showNotification(response.message, 'error');
                    }
                }).fail(function(xhr, status, error) {
                    console.log('Error saving bank:', error);
                    showNotification('Unable to save bank. Please try again.', 'error');
                }).always(function() {
                    // Re-enable the save button
                    $saveBtn.prop('disabled', false).html('Save');
                });
            });

            // Delete Bank with reason - REUSABLE ALREADY IN THE GLOBAL
            $(document).on('click', '.deleteBank', function (e) {
                e.preventDefault();
                deleteWithReason({
                    title: 'Inactive Bank',
                    text: 'Are you sure you want to inactive this bank?',
                    url: '/BankList/DeleteBank',
                    id: $(this).data('id'),
                    button: $(this),
                    table: table
                });
            });

            // Restore Bank with SweetAlert2
            $(document).on('click', '.restoreBank', function (e) {
                e.preventDefault();
                var id = $(this).data('id');
                var $btn = $(this);

                Swal.fire({
                    title: 'Restore Record',
                    text: 'Are you sure you want to restore this bank?',
                    icon: 'question',
                    showCancelButton: true,
                    confirmButtonText: 'Yes, Restore',
                    cancelButtonText: 'Cancel',
                    confirmButtonColor: '#28a745',
                    cancelButtonColor: '#6c757d',
                    reverseButtons: false,
                    allowOutsideClick: false,
                    allowEscapeKey: false
                }).then((result) => {
                    if (result.isConfirmed) {
                        // Disable button and show loading
                        $btn.prop('disabled', true);
                        $btn.html('<i class="fas fa-spinner fa-spin"></i>');

                        $.post('/BankList/RestoreBank', { id: id }, function (response) {
                            if (response.success) {
                                table.ajax.reload(null, false); // Keep current page
                                showNotification(response.message, 'success');
                            } else {
                                showNotification(response.message, 'error');
                            }
                        }).fail(function(xhr, status, error) {
                            console.log('Error restoring bank:', error);
                            showNotification('Unable to restore bank. Please try again.', 'error');
                        }).always(function() {
                            // Re-enable button
                            $btn.prop('disabled', false);
                            $btn.html('<i class="fas fa-undo"></i>');
                        });
                    }
                });
            });

            // Reset forms when modals are hidden
            $('#addBankModal').on('hidden.bs.modal', function () {
                resetAddForm();
            });

            $('#viewBankModal').on('hidden.bs.modal', function () {
                resetViewForm();
                setViewMode();
            });

            // Enter key handling for forms
            $('#addBankForm').on('keypress', function(e) {
                if (e.which === 13) { // Enter key
                    e.preventDefault();
                    $('#btnSaveNewBank').click();
                }
            });

            $('#viewBankForm').on('keypress', function(e) {
                if (e.which === 13 && $('#viewBankModal .modal-body').hasClass('edit-mode')) { // Enter key in edit mode
                    e.preventDefault();
                    $('#btnSaveBank').click();
                }
            });

            // Helper Functions
            function updateTableView() {
                if (isViewingDeleted) {
                    // Update for deleted records view
                    table.ajax.url('/BankList/GetDeletedBankList').load();
                    $('#btnAddBank').hide();
                } else {
                    // Update for active records view
                    table.ajax.url('/BankList/GetBankList').load();
                    $('#btnAddBank').show();
                }
            }

            function resetAddForm() {
                $('#addBankForm')[0].reset();
                clearValidation('#addBankForm');
                $('#btnSaveNewBank').prop('disabled', false).html('Save');
            }

            function resetViewForm() {
                $('#viewBankForm')[0].reset();
                clearValidation('#viewBankForm');
                $('#btnSaveBank').prop('disabled', false).html('Save');
            }

            function setViewMode() {
                $('#viewModalTitle').text('View Bank');
                $('#viewBankModal .modal-body').removeClass('edit-mode');

                // Make fields readonly/disabled
                $('#viewBankCode').prop('readonly', true);
                $('#viewBankName').prop('readonly', true);

                // Hide required asterisks
                $('.edit-required').addClass('d-none');

                // Show/hide buttons
                $('#btnEditBank').removeClass('d-none');
                $('#btnSaveBank').addClass('d-none');
                $('#btnCancelEdit').addClass('d-none');

                clearValidation('#viewBankForm');
            }

            function setEditMode() {
                $('#viewModalTitle').text('Edit Bank');
                $('#viewBankModal .modal-body').addClass('edit-mode');

                // Make fields editable
                $('#viewBankCode').prop('readonly', false);
                $('#viewBankName').prop('readonly', false);

                // Show required asterisks
                $('.edit-required').removeClass('d-none');

                // Show/hide buttons
                $('#btnEditBank').addClass('d-none');
                $('#btnSaveBank').removeClass('d-none');
                $('#btnCancelEdit').removeClass('d-none');
            }

            function clearValidation(formSelector) {
                $(formSelector + ' .form-control, ' + formSelector + ' .form-select').removeClass('is-invalid');
                $(formSelector + ' .invalid-feedback').hide();
            }

            function validateAddForm() {
                var isValid = true;

                // Validate bank code
                var bankCode = $('#addBankCode').val().trim();
                if (!bankCode) {
                    $('#addBankCode').addClass('is-invalid');
                    isValid = false;
                }

                // Validate bank name
                var bankName = $('#addBankName').val().trim();
                if (!bankName) {
                    $('#addBankName').addClass('is-invalid');
                    isValid = false;
                }

                return isValid;
            }

            function validateViewForm() {
                var isValid = true;

                // Validate bank code
                var bankCode = $('#viewBankCode').val().trim();
                if (!bankCode) {
                    $('#viewBankCode').addClass('is-invalid');
                    isValid = false;
                }

                // Validate bank name
                var bankName = $('#viewBankName').val().trim();
                if (!bankName) {
                    $('#viewBankName').addClass('is-invalid');
                    isValid = false;
                }

                return isValid;
            }

            // Updated notification function using toastr
            function showNotification(message, type) {
                if (type === 'success') {
                    toastr.success(message, "Success");
                } else if (type === 'error') {
                    toastr.error(message, "Error");
                } else if (type === 'warning') {
                    toastr.warning(message, "Warning");
                } else if (type === 'info') {
                    toastr.info(message, "Information");
                } else {
                    toastr.info(message, "Notification");
                }
            }

            // Remove validation classes when user starts typing (Add form)
            $('#addBankCode, #addBankName').on('input', function() {
                $(this).removeClass('is-invalid');
            });

            // Remove validation classes when user starts typing (View/Edit form)
            $('#viewBankCode, #viewBankName').on('input', function() {
                $(this).removeClass('is-invalid');
            });
        });
    </script>
}