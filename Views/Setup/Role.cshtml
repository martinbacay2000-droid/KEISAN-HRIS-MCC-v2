        function viewRole(roleCode) {
            $('#viewRoleTitle').text(roleCode + ' - Module Access');
            $('#viewRoleBody').html('<tr><td colspan="3" class="text-center">Loading...</td></tr>');
            $('#viewSearchInput').val('');
            $('#viewFilterAccess').val('');

            $.get('/Role/GetRoleAccess', { roleCode: roleCode }, function (data) {
                allModulesData = data;
                renderViewModules(data);
                $('#viewRoleModal').modal('show');
            });
        }

        function renderViewModules(data) {
            // Original: populate the hidden tbody (keeps data-* attributes intact for filterViewModules)
            let rows = '';
            data.forEach(x => {
                rows += `
                    <tr class="module-view-row"
                        data-module-name="${x.moduleName.toLowerCase()}"
                        data-module-type="${x.moduleType.toLowerCase()}"
                        data-access-level="${x.accessLevel}"
                        data-module-code="${x.moduleCode}">
                        <td>${x.moduleName}</td>
                        <td>${x.moduleType}</td>
                        <td>${x.accessLevel}</td>
                    </tr>
                `;
            });
            $('#viewRoleBody').html(rows);

            // NEW: build the visual tree from the same data
            buildViewTree(data);
        }

        function filterViewModules() {
            const searchTerm = $('#viewSearchInput').val().toLowerCase();
            const filterAccess = $('#viewFilterAccess').val();
            let visibleCount = 0;

            // Update hidden rows (original logic — untouched)
            $('.module-view-row').each(function() {
                const $row = $(this);
                const moduleName = $row.data('module-name');
                const moduleType = $row.data('module-type');
                const accessLevel = $row.data('access-level');

                const matchesSearch = moduleName.includes(searchTerm) || moduleType.includes(searchTerm);
                const matchesFilter = !filterAccess || accessLevel === filterAccess;

                if (matchesSearch && matchesFilter) {
                    $row.show();
                    visibleCount++;
                } else {
                    $row.hide();
                }
            });

            // Also filter the visual tree
            filterTreeVisual('viewRoleTree', searchTerm, filterAccess);

            $('#viewNoResults').toggleClass('d-none', visibleCount > 0);
        }

        function badge(level) {
            if (level === 'FULL') return 'bg-primary';
            if (level === 'READWRITE') return 'bg-success';
            if (level === 'EDIT') return 'bg-warning text-dark';
            if (level === 'READ') return 'bg-info';
            return 'bg-danger';
        }

        function formatAccessLevel(level) {
            const labels = {
                'NO_ACCESS': 'No Access',
                'READ': 'Read Only',
                'EDIT': 'Edit Only',
                'READWRITE': 'Read / Write / Create',
                'FULL': 'Full Access'
            };
            return labels[level] || level;
        }

        function openRoleAccess(roleCode) {
            $('#editRoleCode').val(roleCode);
            $('#editRoleTitle').text(roleCode + ' - Edit Module Access');
            $('#editRoleBody').html('<tr><td colspan="3" class="text-center">Loading...</td></tr>');
            $('#editSearchInput').val('');
            $('#editFilterAccess').val('');

            $.get('/Role/GetRoleAccess', { roleCode }, function (data) {
                allModulesData = data;
                renderEditModules(data);
                $('#editRoleModal').modal('show');
            });
        }

        function renderEditModules(data) {
            // Original: populate the hidden tbody with .accessLevel selects
            // saveRoleAccess() reads from these — this MUST stay identical to original
            let rows = '';
            data.forEach(x => {
                rows += `
                    <tr class="module-row"
                        data-module-name="${x.moduleName.toLowerCase()}"
                        data-module-type="${x.moduleType.toLowerCase()}"
                        data-access-level="${x.accessLevel}">
                        <td>${x.moduleName}</td>
                        <td><span class="badge bg-primary">${x.moduleType}</span></td>
                        <td>
                            <select class="form-control form-control-sm accessLevel"
                                    data-module="${x.moduleCode}">
                                <option value="NO_ACCESS" ${x.accessLevel === 'NO_ACCESS' ? 'selected' : ''}>No Access</option>
                                <option value="READ" ${x.accessLevel === 'READ' ? 'selected' : ''}>Read Only</option>
                                <option value="EDIT" ${x.accessLevel === 'EDIT' ? 'selected' : ''}>Edit Only</option>
                                <option value="READWRITE" ${x.accessLevel === 'READWRITE' ? 'selected' : ''}>Read / Write / Create</option>
                                <option value="FULL" ${x.accessLevel === 'FULL' ? 'selected' : ''}>Full Access</option>
                            </select>
                        </td>
                    </tr>
                `;
            });
            $('#editRoleBody').html(rows);

            // NEW: build the visual tree from the same data
            buildEditTree(data);
        }

        function filterEditModules() {
            const searchTerm = $('#editSearchInput').val().toLowerCase();
            const filterAccess = $('#editFilterAccess').val();
            let visibleCount = 0;

            // Original logic — reads from hidden tbody rows (untouched)
            $('.module-row').each(function() {
                const $row = $(this);
                const moduleName = $row.data('module-name');
                const moduleType = $row.data('module-type');
                const accessLevel = $row.find('.accessLevel').val();

                const matchesSearch = moduleName.includes(searchTerm) || moduleType.includes(searchTerm);
                const matchesFilter = !filterAccess || accessLevel === filterAccess;

                if (matchesSearch && matchesFilter) {
                    $row.removeClass('filtered-out').show();
                    visibleCount++;
                } else {
                    $row.addClass('filtered-out').hide();
                }
            });

            // Also filter the visual tree
            filterTreeVisual('editRoleTree', searchTerm, filterAccess);

            $('#editNoResults').toggleClass('d-none', visibleCount > 0);
        }

        // saveRoleAccess reads from hidden tbody .accessLevel selects — completely unchanged
        function saveRoleAccess() {
            const roleCode = $('#editRoleCode').val();
            const items = [];

            $('.accessLevel').each(function () {
                items.push({
                    moduleCode: $(this).data('module'),
                    accessLevel: $(this).val()
                });
            });

            $.ajax({
                url: '/Role/SaveRoleAccess',
                type: 'POST',
                contentType: 'application/json',
                data: JSON.stringify({
                    roleCode: roleCode,
                    items: items
                }),
                success: function (response) {
                    if (response.success) {
                        showNotification(response.message, "success");
                        $('#editRoleModal').modal('hide');
                    } else {
                        showNotification(response.message, "error");
                    }
                },
                error: function() {
                    showNotification("Failed to save module access", "error");
                }
            });
        }

        function openDataScope(roleCode) {
            $('#dataScopeRoleCode').val(roleCode);
            $('#editDataScopeTitle').text(roleCode + ' - Data Access Configuration');

            $.get('/Role/GetRoleDataScope', { roleCode }, function (data) {
                $('#scopeType').val(data.scopeType || 'OWN_ONLY');

                initializeDataScopeSelects();

                toggleDataScopeSections(data.scopeType || 'OWN_ONLY');

                if (data.allowedRanks) {
                    const ranks = data.allowedRanks.split(',');
                    $('#allowedRanks').val(ranks).trigger('change');
                }
                if (data.allowedBranches) {
                    const branches = data.allowedBranches.split(',');
                    $('#allowedBranches').val(branches).trigger('change');
                }
                if (data.allowedDepartments) {
                    const departments = data.allowedDepartments.split(',');
                    $('#allowedDepartments').val(departments).trigger('change');
                }
                if (data.allowedPositions) {
                    const positions = data.allowedPositions.split(',');
                    $('#allowedPositions').val(positions).trigger('change');
                }
                if (data.allowedEmploymentStatuses) {
                    const statuses = data.allowedEmploymentStatuses.split(',');
                    $('#allowedEmploymentStatuses').val(statuses).trigger('change');
                }

                $('#editDataScopeModal').modal('show');
            });
        }

        function initializeDataScopeSelects() {
            $('#allowedRanks').select2({
                dropdownParent: $('#editDataScopeModal'),
                placeholder: "Select ranks",
                allowClear: true,
                ajax: {
                    url: '/Setup/GetEmployeeRank',
                    dataType: 'json',
                    processResults: data => ({
                        results: data.map(item => ({ id: item.rankCode, text: item.rankName }))
                    })
                }
            });
            $('#allowedBranches').select2({
                dropdownParent: $('#editDataScopeModal'),
                placeholder: "Select branches",
                allowClear: true,
                ajax: {
                    url: '/Setup/GetEmployeeBranch',
                    dataType: 'json',
                    processResults: data => ({
                        results: data.map(item => ({ id: item.branchCode, text: item.branchName }))
                    })
                }
            });
            $('#allowedDepartments').select2({
                dropdownParent: $('#editDataScopeModal'),
                placeholder: "Select departments",
                allowClear: true,
                ajax: {
                    url: '/Setup/GetEmployeeDepartment',
                    dataType: 'json',
                    processResults: data => ({
                        results: data.map(item => ({ id: item.departmentCode, text: item.departmentName }))
                    })
                }
            });
            $('#allowedPositions').select2({
                dropdownParent: $('#editDataScopeModal'),
                placeholder: "Select positions",
                allowClear: true,
                ajax: {
                    url: '/Setup/GetEmployeePositions',
                    dataType: 'json',
                    processResults: data => ({
                        results: data.map(item => ({ id: item.positionCode, text: item.positionName }))
                    })
                }
            });
            $('#allowedEmploymentStatuses').select2({
                dropdownParent: $('#editDataScopeModal'),
                placeholder: "Select employment statuses",
                allowClear: true,
                ajax: {
                    url: '/Setup/GetEmploymentStatuses',
                    dataType: 'json',
                    processResults: data => ({
                        results: data.map(item => ({ id: item.employmentStatusCode, text: item.employmentStatusName }))
                    })
                }
            });
        }

        $('#scopeType').on('change', function () {
            toggleDataScopeSections($(this).val());
        });

        function toggleDataScopeSections(scopeType) {
            $('#rankFilterSection, #branchFilterSection, #departmentFilterSection, #positionFilterSection, #employmentStatusFilterSection').hide();
            $('#assignedEmployeeInfo').hide();

            switch (scopeType) {
                case 'OWN_AND_ASSIGNED': $('#assignedEmployeeInfo').show(); break;
                case 'RANK_FILTER':      $('#rankFilterSection').show(); break;
                case 'BRANCH':           $('#branchFilterSection').show(); break;
                case 'DEPARTMENT':       $('#departmentFilterSection').show(); break;
                case 'POSITION_FILTER':  $('#positionFilterSection').show(); break;
                case 'EMPLOYMENT_STATUS':$('#employmentStatusFilterSection').show(); break;
                case 'CUSTOM':
                    $('#rankFilterSection, #branchFilterSection, #departmentFilterSection, #positionFilterSection, #employmentStatusFilterSection').show();
                    break;
            }
        }

        function saveDataScope() {
            const roleCode = $('#dataScopeRoleCode').val();
            const scopeType = $('#scopeType').val();

            const allowedRanks = $('#allowedRanks').val() || [];
            const allowedBranches = $('#allowedBranches').val() || [];
            const allowedDepartments = $('#allowedDepartments').val() || [];
            const allowedPositions = $('#allowedPositions').val() || [];
            const allowedEmploymentStatuses = $('#allowedEmploymentStatuses').val() || [];

            $.ajax({
                url: '/Role/SaveRoleDataScope',
                type: 'POST',
                contentType: 'application/json',
                data: JSON.stringify({
                    roleCode, scopeType,
                    allowedRanks, allowedBranches, allowedDepartments,
                    allowedPositions, allowedEmploymentStatuses
                }),
                success: function (response) {
                    if (response.success) {
                        showNotification(response.message, "success");
                        $('#editDataScopeModal').modal('hide');
                        $('#roleTable').DataTable().ajax.reload(null, false);
                    } else {
                        showNotification(response.message, "error");
                    }
                },
                error: function () { showNotification("Failed to save data access", "error"); }
            });
        }

        function openHideEmployees(roleCode) {
            $('#hideEmployeesRoleCode').val(roleCode);
            $('#hideEmployeesTitle').text(roleCode + ' - Hide Employees');

            $('#hiddenEmployees').select2({
                dropdownParent: $('#hideEmployeesModal'),
                placeholder: "Select employees to hide",
                allowClear: true,
                ajax: {
                    url: '/Role/GetEmployeesForHiding',
                    dataType: 'json',
                    delay: 250,
                    data: function(params) {
                        return { search: params.term || '', roleCode: roleCode };
                    },
                    processResults: data => data
                }
            });

            $.get('/Role/GetRoleHiddenEmployees', { roleCode }, function (response) {
                if (response.success && response.hiddenEmployees) {
                    const hiddenList = response.hiddenEmployees.split(',').filter(x => x.trim());
                    $('#hiddenEmployees').val(hiddenList).trigger('change');
                }
                $('#hideEmployeesModal').modal('show');
            });
        }

        function saveHiddenEmployees() {
            const roleCode = $('#hideEmployeesRoleCode').val();
            const hiddenEmployees = $('#hiddenEmployees').val() || [];

            $.ajax({
                url: '/Role/SaveRoleHiddenEmployees',
                type: 'POST',
                contentType: 'application/json',
                data: JSON.stringify({ roleCode, hiddenEmployees }),
                success: function (response) {
                    if (response.success) {
                        showNotification(response.message, "success");
                        $('#hideEmployeesModal').modal('hide');
                    } else {
                        showNotification(response.message, "error");
                    }
                },
                error: function () { showNotification("Failed to save hidden employees", "error"); }
            });
        }

        function openAddRole() {
            $('#roleCode').val('');
            $('#roleName').val('');
            clearValidation('#addRoleForm');
            $('#addRoleModal').modal('show');
        }

        $('#btnAddRole').click(openAddRole);

        function saveRole() {
            const roleCode = $('#roleCode').val().trim();
            const roleName = $('#roleName').val().trim();

            if (!validateForm('#addRoleForm', ['roleCode', 'roleName'])) {
                return;
            }

            const $btn = $('.btn-success[onclick="saveRole()"]');
            toggleButtonLoading($btn, true, 'Saving...');

            $.ajax({
                url: '/Role/InsertRole',
                type: 'POST',
                data: { roleCode, roleName },
                success: function (response) {
                    if (response.success) {
                        showNotification(response.message, "success");
                        $('#addRoleModal').modal('hide');
                        $('#roleTable').DataTable().ajax.reload();
                    } else {
                        showNotification(response.message, "error");
                    }
                },
                error: function() { showNotification("Failed to create role", "error"); },
                complete: function() { toggleButtonLoading($btn, false); }
            });
        }

        function deleteRoleAccess(roleCode) {
            Swal.fire({
                title: 'Delete Role?',
                text: `This will permanently delete the role and all its permissions.`,
                icon: 'warning',
                showCancelButton: true,
                confirmButtonText: 'Yes, delete',
                cancelButtonText: 'Cancel',
                confirmButtonColor: '#dc3545',
                cancelButtonColor: '#6c757d',
                reverseButtons: false
            }).then((result) => {
                if (!result.isConfirmed) return;

                $.ajax({
                    url: '/Role/DeleteRole',
                    type: 'POST',
                    data: { roleCode },
                    success: function (res) {
                        if (res.success) {
                            showNotification(res.message, "success");
                            $('#roleTable').DataTable().ajax.reload();
                        } else {
                            showNotification(res.message, "error");
                        }
                    },
                    error: function () { showNotification("Server error while deleting role", "error"); }
                });
            });
        }

        function validateForm(formSelector, fields) {
            clearValidation(formSelector);
            let isValid = true;
            fields.forEach(field => {
                if (!$(`#${field}`).val()) {
                    $(`#${field}`).addClass('is-invalid');
                    isValid = false;
                }
            });
            return isValid;
        }

        function clearValidation(formSelector) {
            $(`${formSelector} .form-control, ${formSelector} .form-select`).removeClass('is-invalid');
        }

        function toggleButtonLoading($btn, loading, text = '') {
            if (loading) {
                if (!$btn.data('original-html')) $btn.data('original-html', $btn.html());
                const icon = text ? '<i class="fas fa-spinner fa-spin"></i> ' : '<i class="fas fa-spinner fa-spin"></i>';
                $btn.prop('disabled', true).html(icon + text);
            } else {
                const originalHtml = $btn.data('original-html') || 'Save';
                $btn.prop('disabled', false).html(originalHtml).removeData('original-html');
            }
        }

        function showNotification(message, type) {
            const types = { success: 'Success', error: 'Error', warning: 'Warning', info: 'Information' };
            toastr[type](message, types[type] || 'Notification');
        }

        $('#addRoleModal').on('hidden.bs.modal', function() {
            $('#addRoleForm')[0].reset();
            clearValidation('#addRoleForm');
        });

