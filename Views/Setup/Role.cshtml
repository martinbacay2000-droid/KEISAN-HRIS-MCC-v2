            $('#viewSearchInput').on('keyup', function() {
                filterViewModules();
            });

            $('#viewFilterAccess').on('change', function() {
                filterViewModules();
            });

            $('#editSearchInput').on('keyup', function() {
                filterEditModules();
            });

            $('#editFilterAccess').on('change', function() {
                filterEditModules();
            });

            $('#clearSearch').on('click', function() {
                $('#editSearchInput').val('');
                $('#editFilterAccess').val('');
