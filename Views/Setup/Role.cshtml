@{
    Layout = "~/Views/Shared/_LayoutFillow.cshtml";
    ViewData["Title"] = "Role Management";
}

<div class="col-12">
    <div class="card">
        <div class="card-header">
            <div class="row" style="width:100%;">
                <h4 class="card-title">Role Management</h4>
                <br> <br> <br>

                <div class="row" style="margin-left:0px;width:100%;">
                    <div class="col-md-9"></div>
                    <div class="col-md-3 d-flex justify-content-end align-items-end">
                        <div class="form-group">
                            <button type="button" class="btn btn-primary" id="btnAddRole">
                                <i class="fa fa-plus"></i> New Role
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-striped table-hover" id="roleTable">
                    <thead>
                        <tr>
                            <th width="15%">Action</th>
                            <th width="15%">Role Code</th>
                            <th width="35%">Role Name</th>
                            <th width="35%">Data Scope</th>
                        </tr>
                    </thead>
                </table>
            </div>
        </div>

        <!-- View Role Modal -->
        <div class="modal fade" id="viewRoleModal" tabindex="-1" aria-hidden="true">
            <div class="modal-dialog modal-xl">
                <div class="modal-content">
                    <div class="modal-header">
                        <h5 class="modal-title" id="viewRoleTitle"></h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                    </div>
                    <div class="modal-body">
                        <div class="row mb-3">
                            <div class="col-md-6">
                                <div class="input-group">
                                    <span class="input-group-text">
                                        <i class="fa fa-search"></i>
                                    </span>
                                    <input type="text" class="form-control" id="viewSearchInput" placeholder="Search modules...">
                                </div>
                            </div>
                            <div class="col-md-6">
                                <select class="form-control" id="viewFilterAccess">
                                    <option value="">All Access Levels</option>
                                    <option value="FULL">Full Access</option>
                                    <option value="READWRITE">Read / Write / Create</option>
                                    <option value="EDIT">Edit Only</option>
                                    <option value="READ">Read Only</option>
                                    <option value="NO_ACCESS">No Access</option>
                                </select>
                            </div>
                        </div>

                        <!-- Tree container wraps the original tbody so original JS still targets #viewRoleBody -->
                        <div class="tree-scroll-container">
                            <table class="tree-hidden-table">
                                <tbody id="viewRoleBody"></tbody>
                            </table>
                            <!-- The visual tree is rendered here by renderViewModules -->
                            <div id="viewRoleTree"></div>
                        </div>

                        <div id="viewNoResults" class="alert alert-info d-none mt-3">
                            <i class="fa fa-info-circle"></i> No modules found matching your search criteria.
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Edit Module Access Modal -->
        <div class="modal fade" id="editRoleModal" tabindex="-1" aria-hidden="true">
            <div class="modal-dialog modal-xl">
                <div class="modal-content">
                    <div class="modal-header">
                        <h5 class="modal-title" id="editRoleTitle"></h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                    </div>
                    <div class="modal-body">
                        <input type="hidden" id="editRoleCode" />

                        <div class="row mb-3">
                            <div class="col-md-5">
                                <div class="input-group">
                                    <span class="input-group-text bg-primary text-white">
                                        <i class="fa fa-search"></i>
                                    </span>
                                    <input type="text" class="form-control" id="editSearchInput" placeholder="Search by module name or type...">
                                </div>
                            </div>
                            <div class="col-md-4">
                                <select class="form-control" id="editFilterAccess">
                                    <option value="">Filter by Access Level</option>
                                    <option value="FULL">Full Access</option>
                                    <option value="READWRITE">Read / Write / Create</option>
                                    <option value="EDIT">Edit Only</option>
                                    <option value="READ">Read Only</option>
                                    <option value="NO_ACCESS">No Access</option>
                                </select>
                            </div>
                            <div class="col-md-3 d-flex gap-1">
                                <button class="btn btn-sm btn-outline-primary flex-fill" id="expandAllBtn">
                                    <i class="fa fa-expand-alt"></i> Expand All
                                </button>
                                <button class="btn btn-sm btn-outline-info flex-fill" id="collapseAllBtn">
                                    <i class="fa fa-compress-alt"></i> Collapse All
                                </button>
                            </div>
                        </div>

                        <!-- Tree container wraps the original tbody so original JS still targets #editRoleBody -->
                        <div class="tree-scroll-container">
                            <table class="tree-hidden-table">
                                <tbody id="editRoleBody"></tbody>
                            </table>
                            <!-- The visual tree is rendered here by renderEditModules -->
                            <div id="editRoleTree"></div>
                        </div>

                        <div id="editNoResults" class="alert alert-info d-none mt-3">
                            <i class="fa fa-info-circle"></i> No modules found matching your search criteria.
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button class="btn btn-success w-100" onclick="saveRoleAccess()">
                            <i class="fa fa-save"></i> Update Module Access
                        </button>
                    </div>
                </div>
            </div>
        </div>

        <!-- EDIT DATA SCOPE MODAL -->
        <div class="modal fade" id="editDataScopeModal" tabindex="-1" aria-hidden="true">
            <div class="modal-dialog modal-lg">
                <div class="modal-content">
                    <div class="modal-header">
                        <h5 class="modal-title" id="editDataScopeTitle"></h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                    </div>
                    <div class="modal-body">
                        <input type="hidden" id="dataScopeRoleCode" />

                        <div class="mb-3">
                            <label class="form-label fw-bold">Data Access Scope <span class="text-danger">*</span></label>
                            <select class="form-control" id="scopeType">
                                <option value="OWN_ONLY">Own Record Only</option>
                                <option value="OWN_AND_ASSIGNED">Own Record + Assigned Employees (Approver)</option>
                                <option value="DEPARTMENT">Own Department</option>
                                <option value="BRANCH">Specific Branch(es)</option>
                                <option value="RANK_FILTER">Specific Rank(s)</option>
                                <option value="POSITION_FILTER">Specific Position(s)</option>
                                <option value="EMPLOYMENT_STATUS">Specific Employment Status(es)</option>
                                <option value="CUSTOM">Custom (Multiple Filters)</option>
                                <option value="ALL">All Employees</option>
                            </select>
                            <small class="text-muted">This controls which employee records this role can view</small>
                        </div>

                        <div id="assignedEmployeeInfo" class="alert alert-primary mt-2" style="display:none;">
                            <i class="fa fa-info-circle"></i>
                            <strong>Own Record + Assigned Employees:</strong>
                            Users with this role will see their own record <strong>plus</strong> any employees
                            they are configured to approve in the <strong>Employee Approver</strong> module.
                            No additional configuration is needed here — assignments are managed
                            per-employee in the approver settings.
                        </div>

                        <div id="rankFilterSection" class="mb-3" style="display:none;">
                            <label class="form-label fw-bold">Allowed Ranks</label>
                            <select class="form-control" id="allowedRanks" multiple></select>
                            <small class="text-muted">Select which ranks this role can view</small>
                        </div>

                        <div id="branchFilterSection" class="mb-3" style="display:none;">
                            <label class="form-label fw-bold">Allowed Branches</label>
                            <select class="form-control" id="allowedBranches" multiple></select>
                            <small class="text-muted">Select which branches this role can view</small>
                        </div>

                        <div id="departmentFilterSection" class="mb-3" style="display:none;">
                            <label class="form-label fw-bold">Allowed Departments</label>
                            <select class="form-control" id="allowedDepartments" multiple></select>
                            <small class="text-muted">Select which departments this role can view</small>
                        </div>

                        <div id="positionFilterSection" class="mb-3" style="display:none;">
                            <label class="form-label fw-bold">Allowed Positions</label>
                            <select class="form-control" id="allowedPositions" multiple></select>
                            <small class="text-muted">Select which positions this role can view</small>
                        </div>

                        <div id="employmentStatusFilterSection" class="mb-3" style="display:none;">
                            <label class="form-label fw-bold">Allowed Employment Statuses</label>
                            <select class="form-control" id="allowedEmploymentStatuses" multiple></select>
                            <small class="text-muted">Select which employment statuses this role can view</small>
                        </div>

                    </div>
                    <div class="modal-footer">
                        <button class="btn btn-success w-100" onclick="saveDataScope()">
                            <i class="fa fa-save"></i> Update Data Access
                        </button>
                    </div>
                </div>
            </div>
        </div>

        <!-- HIDE EMPLOYEES MODAL -->
        <div class="modal fade" id="hideEmployeesModal" tabindex="-1" aria-hidden="true">
            <div class="modal-dialog modal-lg">
                <div class="modal-content">
                    <div class="modal-header">
                        <h5 class="modal-title" id="hideEmployeesTitle"></h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                    </div>
                    <div class="modal-body">
                        <input type="hidden" id="hideEmployeesRoleCode" />

                        <div class="alert alert-primary">
                            <i class="fa fa-info-circle"></i>
                            <strong>Note:</strong> Hidden employees will be completely invisible to users with this role, regardless of other data scope settings.
                        </div>

                        <div class="mb-3">
                            <label class="form-label fw-bold">Select Employees to Hide</label>
                            <select class="form-control" id="hiddenEmployees" multiple></select>
                            <small class="text-muted">Select one or more employees that should be hidden from this role</small>
                        </div>

                    </div>
                    <div class="modal-footer">
                        <button class="btn btn-success w-100" onclick="saveHiddenEmployees()">
                            <i class="fa fa-save"></i> Update Hidden Employees
                        </button>
                    </div>
                </div>
            </div>
        </div>

        <!-- Add Role Modal -->
        <div class="modal fade" id="addRoleModal" tabindex="-1" aria-hidden="true">
            <div class="modal-dialog modal-lg">
                <div class="modal-content">
                    <div class="modal-header">
                        <h5 class="modal-title">New Role</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                    </div>
                    <div class="modal-body">
                        <form id="addRoleForm">
                            <div class="row g-3">
                                <div class="col-md-6">
                                    <label class="form-label">Role Code <span class="text-danger">*</span></label>
                                    <input type="text" class="form-control" id="roleCode" placeholder="e.g., HR-001" required>
                                    <div class="invalid-feedback">Please provide a role code.</div>
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label">Role Name <span class="text-danger">*</span></label>
                                    <input type="text" class="form-control" id="roleName" placeholder="e.g., HR Manager" required>
                                    <div class="invalid-feedback">Please provide a role name.</div>
                                </div>
                            </div>
                        </form>
                    </div>
                    <div class="modal-footer">
                        <button class="btn btn-success w-100" onclick="saveRole()">
                            <i class="fa fa-save"></i> Save
                        </button>
                    </div>
                </div>
            </div>
        </div>

    </div>
</div>

@section Fillow_style
{
    <style>
        /* ── DataTable ── */
        .table-responsive {
            border-radius: 0.375rem;
        }

        #roleTable_wrapper .dataTables_length, #roleTable_wrapper .dataTables_filter {
            margin-bottom: 1rem;
        }

        #roleTable_wrapper .dataTables_info, #roleTable_wrapper .dataTables_paginate {
            margin-top: 1rem;
        }

        /* ── Shared modal ── */
        .modal-content {
            border-radius: 0.5rem;
            box-shadow: 0 0.5rem 1rem rgba(0,0,0,.15);
        }

        .modal-xl .modal-body {
            padding: 1.5rem;
        }

        .form-control:focus, .form-select:focus {
            border-color: #0d6efd;
            box-shadow: 0 0 0 .2rem rgba(13,110,253,.25);
        }

        .form-control[readonly] {
            background-color: #f8f9fa;
            border-color: #dee2e6;
        }

        .invalid-feedback {
            display: none;
        }

        .form-control.is-invalid, .form-select.is-invalid {
            border-color: #dc3545;
        }

            .form-control.is-invalid ~ .invalid-feedback, .form-select.is-invalid ~ .invalid-feedback {
                display: block;
            }

        /* ── Select2 ── */
        .select2-container {
            width: 100% !important;
        }

            .select2-container .select2-selection--single,
            .select2-container .select2-selection--multiple {
                height: auto;
                min-height: 38px;
                border: 1px solid #ced4da;
                border-radius: 0.375rem;
            }

        .select2-container--default .select2-selection--single .select2-selection__rendered {
            line-height: 36px;
            padding-left: 12px;
        }

        .select2-container--default .select2-selection--single .select2-selection__arrow {
            height: 36px;
        }

        .select2-container--default.select2-container--focus .select2-selection--single,
        .select2-container--default.select2-container--focus .select2-selection--multiple {
            border-color: #0d6efd;
            box-shadow: 0 0 0 .2rem rgba(13,110,253,.25);
        }

        .is-invalid + .select2-container .select2-selection--single,
        .is-invalid + .select2-container .select2-selection--multiple {
            border-color: #dc3545;
        }

        /* ── Original accessLevel select (still used by saveRoleAccess) ── */
        .accessLevel {
            cursor: pointer;
        }

            .accessLevel:hover {
                border-color: #0d6efd;
            }

        /* ── Card header ── */
        .card-header {
            border-bottom: none !important;
        }

        /* ── Input group ── */
        .input-group-text {
            background-color: #f8f9fa;
            border-color: #ced4da;
        }

        /* ── Hidden table: original tbody stays in DOM for JS compatibility ── */
        .tree-hidden-table {
            display: none !important;
        }

        /* ── Tree scroll container ── */
        .tree-scroll-container {
            border: 1px solid #dee2e6;
            border-radius: 0.5rem;
            overflow: hidden;
            max-height: 520px;
            overflow-y: auto;
        }

        /* ── Level 1: Group header ── */
        .tg-group {
            border-bottom: 1px solid #cbd5e1;
        }

            .tg-group:last-child {
                border-bottom: none;
            }

        .tg-group-header {
            display: flex;
            align-items: center;
            gap: 8px;
            padding: 9px 12px;
            background: linear-gradient(135deg, #1e3a5f, #2d5a8e);
            color: #fff;
            position: sticky;
            top: 0;
            z-index: 5;
        }

        /* Dedicated toggle button — the ONLY clickable element that collapses */
        .tg-toggle {
            flex-shrink: 0;
            background: rgba(255,255,255,0.15);
            border: 1px solid rgba(255,255,255,0.25);
            border-radius: 4px;
            color: #fff;
            width: 24px;
            height: 24px;
            padding: 0;
            cursor: pointer;
            display: flex;
            align-items: center;
            justify-content: center;
        }

            .tg-toggle:focus {
                outline: none;
            }

            .tg-toggle:hover {
                background: rgba(255,255,255,0.28);
            }

            .tg-toggle i {
                font-size: 0.68rem;
                transition: transform 0.2s ease;
            }

            .tg-toggle.is-collapsed i {
                transform: rotate(-90deg);
            }

        /* Parent-level toggle (lighter row style) */
        .tg-parent-toggle {
            flex-shrink: 0;
            background: rgba(0,0,0,0.06);
            border: 1px solid rgba(0,0,0,0.12);
            border-radius: 4px;
            color: #374151;
            width: 22px;
            height: 22px;
            padding: 0;
            cursor: pointer;
            display: flex;
            align-items: center;
            justify-content: center;
        }

            .tg-parent-toggle:focus {
                outline: none;
            }

            .tg-parent-toggle:hover {
                background: rgba(0,0,0,0.12);
            }

            .tg-parent-toggle i {
                font-size: 0.65rem;
                transition: transform 0.2s ease;
            }

            .tg-parent-toggle.is-collapsed i {
                transform: rotate(-90deg);
            }

        .tg-group-icon {
            opacity: 0.8;
            flex-shrink: 0;
            font-size: 0.85rem;
        }

        .tg-group-label {
            font-weight: 700;
            font-size: 0.875rem;
            flex: 1;
        }

        .tg-group-code {
            font-size: 0.68rem;
            font-family: monospace;
            opacity: 0.55;
        }

        /* ── Level 2: Parent module row (has sub-children) ── */
        .tg-parent-row {
            display: flex;
            align-items: center;
            gap: 8px;
            padding: 7px 12px 7px 32px;
            background: #eef2f7;
            border-bottom: 1px solid #dde3ec;
        }

        .tg-parent-label {
            font-weight: 600;
            font-size: 0.82rem;
            color: #374151;
            flex: 1;
        }

        .tg-parent-code {
            font-size: 0.67rem;
            color: #9ca3af;
            font-family: monospace;
        }

        /* ── Level 2: Standalone child (no sub-children) ── */
        .tg-child-row {
            display: flex;
            align-items: center;
            gap: 8px;
            padding: 6px 12px 6px 32px;
            background: #fff;
            border-bottom: 1px solid #f0f0f0;
        }

            .tg-child-row:last-child {
                border-bottom: none;
            }

            .tg-child-row:hover {
                background: #f8f9ff;
            }

        /* ── Level 3: Sub-child ── */
        .tg-sub-row {
            display: flex;
            align-items: center;
            gap: 8px;
            padding: 6px 12px 6px 54px;
            background: #fff;
            border-bottom: 1px solid #f3f4f6;
        }

            .tg-sub-row:last-child {
                border-bottom: none;
            }

            .tg-sub-row:hover {
                background: #f8f9ff;
            }

        .tg-row-label {
            font-size: 0.81rem;
            color: #4b5563;
            flex: 1;
        }

        .tg-row-code {
            font-size: 0.67rem;
            color: #c0c0c0;
            font-family: monospace;
        }

        /* Collapsible body */
        .tg-body {
            overflow: hidden;
        }

        /* ── Access badge (view mode) ── */
        .tg-badge {
            display: inline-block;
            font-size: 0.7rem;
            padding: 0.25rem 0.6rem;
            border-radius: 20px;
            font-weight: 600;
            white-space: nowrap;
            min-width: 120px;
            text-align: center;
        }

        .tg-badge-full {
            background: #3b82f6;
            color: #fff;
        }

        .tg-badge-readwrite {
            background: #10b981;
            color: #fff;
        }

        .tg-badge-edit {
            background: #f59e0b;
            color: #fff;
        }

        .tg-badge-read {
            background: #06b6d4;
            color: #fff;
        }

        .tg-badge-noaccess {
            background: #ef4444;
            color: #fff;
        }

        /* ── Access select (edit mode) — same .accessLevel class as original ── */
        .tg-access-select {
            font-size: 0.78rem;
            padding: 3px 6px;
            border-radius: 6px;
            border: 1px solid #ced4da;
            min-width: 160px;
            cursor: pointer;
        }

            .tg-access-select:focus {
                border-color: #0d6efd;
                outline: none;
                box-shadow: 0 0 0 2px rgba(13,110,253,.2);
            }

        /* ── Hidden rows when filtering ── */
        .tg-row-hidden {
            display: none !important;
        }

        /* SweetAlert2 */
        .swal2-popup {
            border-radius: 15px !important;
            padding: 2rem !important;
        }

        .swal2-title {
            font-size: 1.875rem !important;
            font-weight: 600 !important;
            color: #545454 !important;
            margin: 1rem 0 0.5rem 0 !important;
        }

        .swal2-html-container {
            font-size: 1rem !important;
            color: #737373 !important;
            margin: 0 0 2rem 0 !important;
        }

        .swal2-actions {
            gap: 0.5rem !important;
        }

        .swal2-confirm {
            background-color: #7c3aed !important;
            border-color: #7c3aed !important;
            color: white !important;
            font-weight: 500 !important;
            padding: 0.75rem 2rem !important;
            border-radius: 8px !important;
            font-size: 0.875rem !important;
        }

        .swal2-cancel {
            background-color: #6b7280 !important;
            border-color: #6b7280 !important;
            color: white !important;
            font-weight: 500 !important;
            padding: 0.75rem 2rem !important;
            border-radius: 8px !important;
            font-size: 0.875rem !important;
        }

        .swal2-confirm:hover {
            background-color: #6d28d9 !important;
            border-color: #6d28d9 !important;
        }

        .swal2-cancel:hover {
            background-color: #4b5563 !important;
            border-color: #4b5563 !important;
        }
    </style>
}

@section Fillow_script
{
    <script>
        // ================================================================
        //  ORIGINAL CODE — COMPLETELY UNTOUCHED
        //  DO NOT MODIFY ANYTHING IN THIS BLOCK
        // ================================================================

        let allModulesData = [];

        $(document).ready(function () {

            MODULE = 'SroleM';
            access = ROLE_ACCESS?.[MODULE];

            const config = {
                toastr: {
                    positionClass: "toast-top-right",
                    timeOut: 5000,
                    closeButton: true,
                    progressBar: true,
                    preventDuplicates: true
                }
            };

            toastr.options = config.toastr;

            if (access != 'READWRITE' && access != 'FULL') {
                $('#btnAddRole').hide();
            }

            const roleTable = $('#roleTable').DataTable({
                responsive: true,
                processing: true,
                ajax: {
                    url: "/Role/GetRolelist",
                    type: "GET",
                    dataType: "json",
                    error: () => showNotification('Error loading data. Please refresh the page.', 'error')
                },
                columns: [
                    {
                        data: null,
                        orderable: false,
                        searchable: false,
                        render: function (data, type, row) {
                            let viewBtn = `<button class="btn btn-primary btn-sm shadow-sm view-role-btn"
                                            data-role-code="${row.roleCode}" title="View Details">
                                                <i class="fa fa-info-circle"></i>
                                            </button>`;

                            let editBtn = '';
                            let dataScopeBtn = '';
                            let hideEmployeesBtn = '';
                            let deleteBtn = '';

                            if (access === 'READWRITE' || access === 'FULL') {
                                editBtn = `<button class="btn btn-primary btn-sm shadow-sm edit-role-access-btn"
                                            data-role-code="${row.roleCode}" title="Module Access">
                                                <i class="fa fa-list"></i>
                                            </button>`;

                                dataScopeBtn = `<button class="btn btn-primary btn-sm shadow-sm edit-data-scope-btn"
                                            data-role-code="${row.roleCode}" title="Data Access">
                                                <i class="fa fa-database"></i>
                                            </button>`;

                                hideEmployeesBtn = `<button class="btn btn-primary btn-sm shadow-sm hide-employees-btn"
                                            data-role-code="${row.roleCode}" title="Hide Employees">
                                                <i class="fa fa-user-slash"></i>
                                            </button>`;
                            }

                            if (access === 'FULL' && row.roleCode !== 'RL-000000') {
                                deleteBtn = `<button class="btn btn-danger btn-sm shadow-sm delete-role-btn"
                                            data-role-code="${row.roleCode}">
                                        <i class="fa fa-trash"></i>
                                </button>`;
                            }

                            return `<div class="d-flex gap-1 justify-content-center">
