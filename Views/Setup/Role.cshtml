                    { label: 'Commendation',               moduleCode: 'ScommendationM' },
                    { label: 'Department List',            moduleCode: 'SdepartmentM' },
                    { label: 'Employment Status List',     moduleCode: 'SemploymentstatusM' },
                    { label: 'Holiday List',               moduleCode: 'SholidayM' },
                    { label: 'Location List',              moduleCode: 'SlocationListM' },
                    { label: 'Leave List',                 moduleCode: 'SleaveM' },
                    { label: 'Loan List',                  moduleCode: 'SloanM' },
                    { label: 'Other Deduction List',       moduleCode: 'SotherdeductionM' },
                    { label: 'Position List',              moduleCode: 'SpositionM' },
                    { label: 'Project List',               moduleCode: 'SprojectM' },
                    { label: 'Rank List',                  moduleCode: 'SrankM' },
                    { label: 'Reason for Separation List', moduleCode: 'Sreason4terminationM' },
                    { label: 'Schedule Type List',         moduleCode: 'SscheduletyeplistM' },
                    { label: 'Unit List',                  moduleCode: 'SunitListM' },
                    { label: 'User List',                  moduleCode: 'SuserM' },
                    { label: 'User Role',                  moduleCode: 'SroleM' },
                ]
            },
            {
                label: 'Announcement', moduleCode: 'AAnnouncementM', icon: 'fa-bullhorn',
                children: [{ label: 'Announcement', moduleCode: 'AAnnouncementM' }]
            },
            {
                label: 'Uploader', moduleCode: 'UUploaderM', icon: 'fa-upload',
                children: [
                    { label: 'Adjustment',        moduleCode: 'UadjustmentUploader' },
                    { label: 'Employee Schedule', moduleCode: 'UScheduleUploader' },
                    { label: 'Leave',             moduleCode: 'UleaveUploader' },
                    { label: 'Loans',             moduleCode: 'FSLoansM' },
                ]
            },
            {
                label: 'Audit Trail', moduleCode: 'Aaudittrail', icon: 'fa-history',
                children: [{ label: 'Audit Trail', moduleCode: 'Aaudittrail' }]
            },
        ];

        // Build access map from API data
        function buildAccessMap(data) {
            const map = {};
            data.forEach(x => { map[x.moduleCode] = x.accessLevel || 'NO_ACCESS'; });
            return map;
        }

        // Access badge for view tree
        const BADGE_MAP = {
            FULL:      ['tg-badge-full',      'Full Access'],
            READWRITE: ['tg-badge-readwrite', 'Read / Write / Create'],
            EDIT:      ['tg-badge-edit',      'Edit Only'],
            READ:      ['tg-badge-read',      'Read Only'],
            NO_ACCESS: ['tg-badge-noaccess',  'No Access'],
        };
        function tgBadge(level) {
            const [cls, lbl] = BADGE_MAP[level] || BADGE_MAP.NO_ACCESS;
            return `<span class="tg-badge ${cls}" data-access="${level}">${lbl}</span>`;
        }

        // Access select for edit tree — visual only, syncs with hidden select on change
        function tgSelect(moduleCode, currentLevel) {
            let opts = '';
            Object.entries(BADGE_MAP).forEach(([val, [, lbl]]) => {
                opts += `<option value="${val}"${currentLevel === val ? ' selected' : ''}>${lbl}</option>`;
            });
            // data-for links this visual select back to the hidden .accessLevel select
            return `<select class="tg-access-select" data-for="${moduleCode}">${opts}</select>`;
        }

        // Toggle button HTML
        function tgToggleBtn(targetId, isGroup) {
            const cls = isGroup ? 'tg-toggle' : 'tg-parent-toggle';
            return `<button type="button" class="${cls} is-collapsed" data-target="${targetId}" aria-label="Toggle">
                        <i class="fa fa-chevron-down"></i>
                    </button>`;
        }

        // Build the visual tree HTML from flat API data
        function buildVisualTree(data, isEdit) {
            const accessMap = buildAccessMap(data);
            const parts = [];

            MODULE_HIERARCHY.forEach((group, gi) => {
                const groupAccess  = accessMap[group.moduleCode] || 'NO_ACCESS';
                const groupControl = isEdit ? tgSelect(group.moduleCode, groupAccess) : tgBadge(groupAccess);
                const bodyId       = `tg-grp-${gi}`;

                let bodyHtml = '';
                (group.children || []).forEach((child, ci) => {
                    if (child.children && child.children.length) {
                        const parentAccess  = accessMap[child.moduleCode] || 'NO_ACCESS';
                        const parentControl = isEdit ? tgSelect(child.moduleCode, parentAccess) : tgBadge(parentAccess);
                        const parentBodyId  = `tg-par-${gi}-${ci}`;

                        let subHtml = '';
                        child.children.forEach(sub => {
                            const subAccess  = accessMap[sub.moduleCode] || 'NO_ACCESS';
                            const subControl = isEdit ? tgSelect(sub.moduleCode, subAccess) : tgBadge(subAccess);
                            subHtml += `
                                <div class="tg-sub-row tg-leaf"
                                     data-label="${sub.label.toLowerCase()}"
                                     data-code="${sub.moduleCode.toLowerCase()}"
                                     data-access="${subAccess}">
                                    <span class="tg-row-label">${sub.label}</span>
                                    <span class="tg-row-code">${sub.moduleCode}</span>
                                    <div style="margin-left:auto;">${subControl}</div>
                                </div>`;
                        });

                        bodyHtml += `
                            <div class="tg-parent-row tg-leaf"
                                 data-label="${child.label.toLowerCase()}"
                                 data-code="${child.moduleCode.toLowerCase()}"
                                 data-access="${parentAccess}">
                                ${tgToggleBtn(parentBodyId, false)}
                                <span class="tg-parent-label">${child.label}</span>
                                <span class="tg-parent-code">${child.moduleCode}</span>
                                <div style="margin-left:auto;">${parentControl}</div>
                            </div>
                            <div class="tg-body" id="${parentBodyId}" style="display:none;">${subHtml}</div>`;
                    } else {
                        const childAccess  = accessMap[child.moduleCode] || 'NO_ACCESS';
                        const childControl = isEdit ? tgSelect(child.moduleCode, childAccess) : tgBadge(childAccess);
                        bodyHtml += `
                            <div class="tg-child-row tg-leaf"
                                 data-label="${child.label.toLowerCase()}"
                                 data-code="${child.moduleCode.toLowerCase()}"
                                 data-access="${childAccess}">
                                <span class="tg-row-label">${child.label}</span>
                                <span class="tg-row-code">${child.moduleCode}</span>
                                <div style="margin-left:auto;">${childControl}</div>
                            </div>`;
                    }
                });

                parts.push(`
                    <div class="tg-group" data-group="${gi}">
                        <div class="tg-group-header">
                            ${tgToggleBtn(bodyId, true)}
                            <i class="fa ${group.icon || 'fa-folder'} tg-group-icon"></i>
                            <span class="tg-group-label">${group.label}</span>
                            <span class="tg-group-code">${group.moduleCode}</span>
                            <div style="margin-left:auto;">${groupControl}</div>
                        </div>
                        <div class="tg-body" id="${bodyId}" style="display:none;">${bodyHtml}</div>
                    </div>`);
            });

            return parts.join('');
        }

        function buildViewTree(data) {
            $('#viewRoleTree').html(buildVisualTree(data, false));
        }

        function buildEditTree(data) {
            $('#editRoleTree').html(buildVisualTree(data, true));
        }

        // Toggle handler — dedicated buttons only, uses data-target
        $(document).on('click', '.tg-toggle, .tg-parent-toggle', function (e) {
            e.stopPropagation();
            const $btn   = $(this);
            const $body  = $('#' + $btn.data('target'));

            if ($body.is(':visible')) {
                $body.slideUp(180);
                $btn.addClass('is-collapsed');
            } else {
                $body.slideDown(180);
                $btn.removeClass('is-collapsed');
            }
        });

        // When a visual select changes → sync to the corresponding hidden .accessLevel select
        // This keeps saveRoleAccess() reading the correct value
        $(document).on('change', '.tg-access-select', function () {
            const moduleCode = $(this).data('for');
            const newVal     = $(this).val();

            // Sync to hidden tbody select
            $('#editRoleBody').find(`.accessLevel[data-module="${moduleCode}"]`).val(newVal);

            // Update data-access on the row for filter compatibility
            $(this).closest('.tg-leaf').attr('data-access', newVal);
        });

        // Filter the visual tree (called from filterViewModules / filterEditModules)
        function filterTreeVisual(treeId, searchTerm, filterAccess) {
            const $tree = $('#' + treeId);

            $tree.find('.tg-group').each(function () {
                let groupVisible = false;

                $(this).find('.tg-leaf').each(function () {
                    const label  = $(this).data('label') || '';
                    const code   = $(this).data('code')  || '';
                    const access = $(this).data('access') || '';

                    const matchSearch = !searchTerm || label.includes(searchTerm) || code.includes(searchTerm);
                    const matchFilter = !filterAccess || access === filterAccess;

                    if (matchSearch && matchFilter) {
                        $(this).removeClass('tg-row-hidden');
                        groupVisible = true;
                    } else {
                        $(this).addClass('tg-row-hidden');
                    }
                });

                if (groupVisible) {
                    $(this).show();
                    if (searchTerm || filterAccess) {
                        // Auto-expand so results are visible
                        $(this).find('.tg-body').show();
                        $(this).find('.tg-toggle, .tg-parent-toggle').removeClass('is-collapsed');
                    }
                } else {
                    $(this).hide();
                }
            });
        }

        // Expand / Collapse All buttons (edit modal only)
        $('#expandAllBtn').on('click', function () {
            $('#editRoleTree').find('.tg-body').slideDown(150);
            $('#editRoleTree').find('.tg-toggle, .tg-parent-toggle').removeClass('is-collapsed');
        });

        $('#collapseAllBtn').on('click', function () {
            $('#editRoleTree').find('.tg-body').slideUp(150);
            $('#editRoleTree').find('.tg-toggle, .tg-parent-toggle').addClass('is-collapsed');
        });

    </script>
}
    