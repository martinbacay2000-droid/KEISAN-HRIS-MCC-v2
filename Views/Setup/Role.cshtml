            $(document).on('click', '.edit-data-scope-btn', function() {
                openDataScope($(this).data('role-code'));
            });

            $(document).on('click', '.hide-employees-btn', function() {
                openHideEmployees($(this).data('role-code'));
            });

            $(document).on('click', '.delete-role-btn', function() {
                deleteRoleAccess($(this).data('role-code'));
