@{
    Layout = "~/Views/Shared/_LayoutFillow.cshtml";
    ViewData["Title"] = "Branch List";
}

<div class="col-12">
    <div class="card">
        <div class="card-header">
            <div class="row" style="width:100%;">
                <h4 class="card-title">Branch List</h4>
                <br> <br> <br>

                <div class="row" style="margin-left:0px;width:100%;">
                    <div class="col-md-3">
                        <div class="form-group">
                            <h5>Record Status</h5>
                            <select name="filterRecordStatus" id="filterRecordStatus" class="form-control">
                                <option value="active" selected>ACTIVE</option>
                                <option value="inactive">INACTIVE</option>
                            </select>
                        </div>
                    </div>
                    <div class="col-md-6">
                    </div>
                    <div class="col-md-3 d-flex justify-content-end align-items-end">
                        <div class="form-group">
                            <button type="button" class="btn btn-primary" id="btnAddBranch">
                                <i class="fa fa-plus"></i> New Branch
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="card-body">
            <div class="table-responsive">
                <table id="branchTable" class="display" style="min-width: 845px">
                    <thead>
                        <tr>
                            <th>Action</th>
                            <th>Branch Code</th>
                            <th>Branch Name</th>                          
                        </tr>
                    </thead>
                </table>
            </div>
        </div>

        <!-- Modal for Add -->
        <div class="modal fade" id="addBranchModal" tabindex="-1" aria-hidden="true">
            <div class="modal-dialog">
                <div class="modal-content">
                    <div class="modal-header">
                        <h5 class="modal-title">Branch Form</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                    </div>
                    <div class="modal-body">
                        <form id="addBranchForm">
                            <div class="mb-3">
                                <label for="addBranchCode" class="form-label">Branch Code <span class="text-danger">*</span></label>
                                <input type="text" class="form-control alphanum" id="addBranchCode" name="branchCode" required maxlength="50">
                                <div class="invalid-feedback">
                                    Please provide a valid branch code.
                                </div>
                            </div>

                            <div class="mb-3">
                                <label for="addBranchName" class="form-label">Branch Name <span class="text-danger">*</span></label>
                                <input type="text" class="form-control" id="addBranchName" name="branchName" required maxlength="255">
                                <div class="invalid-feedback">
                                    Please provide a valid branch name.
                                </div>
                            </div>
                        </form>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-primary" id="btnSaveNewBranch">Save</button>
                    </div>
                </div>
            </div>
        </div>

        <!-- Modal for View/Edit -->
        <div class="modal fade" id="viewBranchModal" tabindex="-1" aria-hidden="true">
            <div class="modal-dialog">
                <div class="modal-content">
                    <div class="modal-header">
                        <h5 class="modal-title" id="viewModalTitle">View Branch Form</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                    </div>
                    <div class="modal-body">
                        <form id="viewBranchForm">
                            <input type="hidden" id="viewBranchId" name="id">

                            <div class="mb-3">
                                <label for="viewBranchCode" class="form-label">Branch Code <span class="text-danger edit-required d-none">*</span></label>
                                <input type="text" class="form-control alphanum" id="viewBranchCode" name="branchCode" readonly maxlength="50">
                                <div class="invalid-feedback">
                                    Please provide a valid branch code.
                                </div>
                            </div>

                            <div class="mb-3">
                                <label for="viewBranchName" class="form-label">Branch Name <span class="text-danger edit-required d-none">*</span></label>
                                <input type="text" class="form-control" id="viewBranchName" name="branchName" readonly maxlength="255">
                                <div class="invalid-feedback">
                                    Please provide a valid branch name.
                                </div>
                            </div>
                        </form>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-primary" id="btnEditBranch">
                            <i class="fas fa-edit"></i> Edit
                        </button>
                        <button type="button" class="btn btn-success d-none" id="btnSaveBranch">Save</button>
                        <button type="button" class="btn btn-danger d-none" id="btnCancelEdit">Cancel</button>
                    </div>
                </div>
            </div>
        </div>

    </div>
</div>

@section Fillow_style
{

    <style>
        .table-responsive {
            border-radius: 0.375rem;
        }

        #branchTable_wrapper .dataTables_length,
        #branchTable_wrapper .dataTables_filter {
            margin-bottom: 1rem;
        }

        #branchTable_wrapper .dataTables_info,
        #branchTable_wrapper .dataTables_paginate {
            margin-top: 1rem;
        }

        .btn-sm {
            padding: 0.25rem 0.5rem;
            font-size: 0.875rem;
        }

        .modal-content {
            border-radius: 0.5rem;
            box-shadow: 0 0.5rem 1rem rgba(0, 0, 0, 0.15);
        }

        .form-control:focus,
        .form-select:focus {
            border-color: #0d6efd;
            box-shadow: 0 0 0 0.2rem rgba(13, 110, 253, 0.25);
        }

        .invalid-feedback {
            display: none;
        }

        .form-control.is-invalid,
        .form-select.is-invalid {
            border-color: #dc3545;
        }

            .form-control.is-invalid ~ .invalid-feedback,
            .form-select.is-invalid ~ .invalid-feedback {
                display: block;
            }

        /* Readonly/disabled field styling */
        .form-control[readonly] {
            background-color: #f8f9fa;
            border-color: #dee2e6;
        }

        .form-select[disabled] {
            background-color: #f8f9fa;
            border-color: #dee2e6;
        }

        /* Edit mode styling */
        .edit-mode .form-control[readonly] {
            background-color: #ffffff;
            border-color: #ced4da;
        }

        .edit-mode .form-select[disabled] {
            background-color: #ffffff;
            border-color: #ced4da;
        }

        /* Custom SweetAlert2 styling */
        .swal2-popup {
            border-radius: 15px !important;
            padding: 2rem !important;
        }

        .swal2-icon.swal2-error {
            border-color: #f27474 !important;
            color: #f27474 !important;
        }

            .swal2-icon.swal2-error .swal2-x-mark {
                display: none !important;
            }

            .swal2-icon.swal2-error::before {
                content: "\f2ed" !important;
                font-family: "Font Awesome 5 Free" !important;
                font-weight: 900 !important;
                font-size: 2.5rem !important;
                color: #f27474 !important;
                display: block !important;
            }

        .swal2-title {
            font-size: 1.875rem !important;
            font-weight: 600 !important;
            color: #545454 !important;
            margin: 1rem 0 0.5rem 0 !important;
        }

        .swal2-html-container {
            font-size: 1rem !important;
            color: #737373 !important;
            margin: 0 0 2rem 0 !important;
        }

        .swal2-actions {
            gap: 0.5rem !important;
        }

        .swal2-confirm {
            background-color: #7c3aed !important;
            border-color: #7c3aed !important;
            color: white !important;
            font-weight: 500 !important;
            padding: 0.75rem 2rem !important;
            border-radius: 8px !important;
            font-size: 0.875rem !important;
        }

        .swal2-cancel {
            background-color: #6b7280 !important;
            border-color: #6b7280 !important;
            color: white !important;
            font-weight: 500 !important;
            padding: 0.75rem 2rem !important;
            border-radius: 8px !important;
            font-size: 0.875rem !important;
        }

        .swal2-confirm:hover {
            background-color: #6d28d9 !important;
            border-color: #6d28d9 !important;
        }

        .swal2-cancel:hover {
            background-color: #4b5563 !important;
            border-color: #4b5563 !important;
        }

        /* Restore button styling */
        .btn-success.shadow-sm:hover {
            background-color: #1e7e34;
            border-color: #1c7430;
        }

        .card-header {
            border-bottom: none !important;
        }

        #filterRecordStatus {
            width: 100%;
        }
    </style>
}

@section Fillow_script
{

    <script>
        $(document).ready(function () {

            MODULE = 'SbranchM';
            access = ROLE_ACCESS?.[MODULE];

            if (access != 'READWRITE' && access != 'FULL') {
                $('#btnAddBranch').hide();
                $('#btnEditBranch').hide();
            }

            // Initialize toastr options
            toastr.options = {
                positionClass: "toast-top-right",
                timeOut: 5000,
                closeButton: true,
                debug: false,
                newestOnTop: true,
                progressBar: true,
                preventDuplicates: true,
                onclick: null,
                showDuration: "300",
                hideDuration: "1000",
                extendedTimeOut: "1000",
                showEasing: "swing",
                hideEasing: "linear",
                showMethod: "fadeIn",
                hideMethod: "fadeOut",
                tapToDismiss: false
            };

            // View state management
            let isViewingDeleted = false;

            // Initialize Select2 for the filter
            $('#filterRecordStatus').select2({
                selectOnClose: true,
                minimumResultsForSearch: Infinity
            });

            // Handle filter change
            $('#filterRecordStatus').on('change', function () {
                isViewingDeleted = $(this).val() === 'inactive';
                updateTableView();
            });

            var table = $('#branchTable').DataTable({
                processing: true,
                serverSide: false,
                ajax: {
                    url: "/BranchList/GetBranchList",
                    type: "GET",
                    datatype: "json",
                    error: function(xhr, error, code) {
                        console.log('Error loading data:', error);
                        showNotification('Error loading branch data. Please refresh the page.', 'error');
                    }
                },
                columns: [
                    {
                        data: "id",
                        width: "20%",
                        orderable: false,
                        render: function (data) {
                            if (isViewingDeleted) {
                                return `
                                    <div class="d-flex gap-1">
                                        <button type="button" class="btn btn-sm btn-success shadow-sm restoreBranch" data-id="${data}" title="Restore">
                                            <i class="fas fa-undo"></i>
                                        </button>
                                    </div>`;
                            } else {
                                return `
                                    <div class="d-flex gap-1">
                                        <button type="button" class="btn btn-sm btn-primary shadow-sm viewBranch" data-id="${data}" title="View">
                                            <i class="fas fa-eye"></i>
                                        </button>
                                        <button type="button" class="btn btn-sm btn-danger shadow-sm deleteBranch" data-id="${data}" title="Delete">
                                            <i class="fa fa-trash"></i>
                                        </button>
                                    </div>`;
                            }
                        }
                    },
                    {
                        data: "branchCode",
                        width: "25%"
                    },
                    {
                        data: "branchName",
                        width: "55%"
                    }                    
                ],
                order: [],
                pageLength: 25,
                lengthMenu: [[10, 25, 50, 100, -1], [10, 25, 50, 100, "All"]],
                language: {
                    processing: "Loading...",
                    emptyTable: "No branches found",
                    zeroRecords: "No matching branches found",
                    paginate: {
                        next: '<i class="fa fa-angle-double-right" aria-hidden="true"></i>',
                        previous: '<i class="fa fa-angle-double-left" aria-hidden="true"></i>'
                    }
                }
            });

            // Add New Branch
            $('#btnAddBranch').click(function () {
                resetAddForm();
                $('#addBranchModal').modal('show');

                // Focus on first input after modal is shown
                $('#addBranchModal').on('shown.bs.modal', function () {
                    $('#addBranchCode').focus();
                });
            });

            // View Branch
            $(document).on('click', '.viewBranch', function (e) {
                e.preventDefault();
                var id = $(this).data('id');
                var $btn = $(this);

                // Disable button and show loading
                $btn.prop('disabled', true);
                $btn.html('<i class="fas fa-spinner fa-spin"></i>');

                $.get('/BranchList/GetBranch', { id: id }, function (data) {
                    if (data) {
                        resetViewForm();
                        setViewMode();

                        $('#viewBranchId').val(data.id);
                        $('#viewBranchCode').val(data.branchCode);
                        $('#viewBranchName').val(data.branchName);

                        $('#viewBranchModal').modal('show');
                    } else {
                        showNotification('Unable to load branch data', 'error');
                    }
                }).fail(function(xhr, status, error) {
                    console.log('Error loading branch:', error);
                    showNotification('Unable to load branch data', 'error');
                }).always(function() {
                    // Re-enable button
                    $btn.prop('disabled', false);
                    $btn.html('<i class="fas fa-eye"></i>');
                });
            });

            // Edit button in view modal
            $('#btnEditBranch').click(function () {
                setEditMode();
                $('#viewBranchCode').focus();
            });

            // Cancel edit button
            $('#btnCancelEdit').click(function () {
                // Reload the original data
                var id = $('#viewBranchId').val();
                $.get('/BranchList/GetBranch', { id: id }, function (data) {
                    if (data) {
                        $('#viewBranchCode').val(data.branchCode);
                        $('#viewBranchName').val(data.branchName);
                        setViewMode();
                        clearValidation('#viewBranchForm');
                    }
                });
            });

            // Save Branch (from view/edit modal)
            $('#btnSaveBranch').click(function () {
                // Clear previous validation states
                clearValidation('#viewBranchForm');

                // Validate form
                if (!validateViewForm()) {
                    return;
                }

                var formData = {
                    id: parseInt($('#viewBranchId').val()),
                    branchCode: $('#viewBranchCode').val().trim(),
                    branchName: $('#viewBranchName').val().trim()
                };

                // Disable the save button to prevent double submission
                var $saveBtn = $('#btnSaveBranch');
                $saveBtn.prop('disabled', true).html('<i class="fas fa-spinner fa-spin"></i> Saving...');

                $.post('/BranchList/UpdateBranch', formData, function (response) {
                    if (response.success) {
                        setViewMode();
                        table.ajax.reload(null, false); // Keep current page
                        showNotification(response.message, 'success');
                    } else {
                        showNotification(response.message, 'error');
                    }
                }).fail(function(xhr, status, error) {
                    console.log('Error saving branch:', error);
                    showNotification('Unable to save branch. Please try again.', 'error');
                }).always(function() {
                    // Re-enable the save button
                    $saveBtn.prop('disabled', false).html('Save');
                });
            });

            // Save New Branch (from add modal)
            $('#btnSaveNewBranch').click(function () {
                // Clear previous validation states
                clearValidation('#addBranchForm');

                // Validate form
                if (!validateAddForm()) {
                    return;
                }

                var formData = {
                    branchCode: $('#addBranchCode').val().trim(),
                    branchName: $('#addBranchName').val().trim()
                };

                // Disable the save button to prevent double submission
                var $saveBtn = $('#btnSaveNewBranch');
                $saveBtn.prop('disabled', true).html('<i class="fas fa-spinner fa-spin"></i> Saving...');

                $.post('/BranchList/AddBranch', formData, function (response) {
                    if (response.success) {
                        $('#addBranchModal').modal('hide');
                        table.ajax.reload(null, false); // Keep current page
                        showNotification(response.message, 'success');
                    } else {
                        showNotification(response.message, 'error');
                    }
                }).fail(function(xhr, status, error) {
                    console.log('Error saving branch:', error);
                    showNotification('Unable to save branch. Please try again.', 'error');
                }).always(function() {
                    // Re-enable the save button
                    $saveBtn.prop('disabled', false).html('Save');
                });
            });

            // Delete Branch with reason - REUSABLE ALREADY IN THE GLOBAL
            $(document).on('click', '.deleteBranch', function (e) {
                e.preventDefault();
                deleteWithReason({
                    title: 'Inactive Branch',
                    text: 'Are you sure you want to inactive this branch?',
                    url: '/BranchList/DeleteBranch',
                    id: $(this).data('id'),
                    button: $(this),
                    table: table
                });
            });

            // Restore Branch with SweetAlert2
            $(document).on('click', '.restoreBranch', function (e) {
                e.preventDefault();
                var id = $(this).data('id');
                var $btn = $(this);

                Swal.fire({
                    title: 'Restore Record',
                    text: 'Are you sure you want to restore this branch?',
                    icon: 'question',
                    showCancelButton: true,
                    confirmButtonText: 'Yes, Restore',
                    cancelButtonText: 'Cancel',
                    confirmButtonColor: '#28a745',
                    cancelButtonColor: '#6c757d',
                    reverseButtons: false,
                    allowOutsideClick: false,
                    allowEscapeKey: false
                }).then((result) => {
                    if (result.isConfirmed) {
                        // Disable button and show loading
                        $btn.prop('disabled', true);
                        $btn.html('<i class="fas fa-spinner fa-spin"></i>');

                        $.post('/BranchList/RestoreBranch', { id: id }, function (response) {
                            if (response.success) {
                                table.ajax.reload(null, false); // Keep current page
                                showNotification(response.message, 'success');
                            } else {
                                showNotification(response.message, 'error');
                            }
                        }).fail(function(xhr, status, error) {
                            console.log('Error restoring branch:', error);
                            showNotification('Unable to restore branch. Please try again.', 'error');
                        }).always(function() {
                            // Re-enable button
                            $btn.prop('disabled', false);
                            $btn.html('<i class="fas fa-undo"></i>');
                        });
                    }
                });
            });

            // Reset forms when modals are hidden
            $('#addBranchModal').on('hidden.bs.modal', function () {
                resetAddForm();
            });

            $('#viewBranchModal').on('hidden.bs.modal', function () {
                resetViewForm();
                setViewMode();
            });

            // Enter key handling for forms
            $('#addBranchForm').on('keypress', function(e) {
                if (e.which === 13) { // Enter key
                    e.preventDefault();
                    $('#btnSaveNewBranch').click();
                }
            });

            $('#viewBranchForm').on('keypress', function(e) {
                if (e.which === 13 && $('#viewBranchModal .modal-body').hasClass('edit-mode')) { // Enter key in edit mode
                    e.preventDefault();
                    $('#btnSaveBranch').click();
                }
            });

            // Helper Functions
            function updateTableView() {
                if (isViewingDeleted) {
                    // Update for deleted records view
                    table.ajax.url('/BranchList/GetDeletedBranch').load();
                    $('#btnAddBranch').hide();
                } else {
                    // Update for active records view
                    table.ajax.url('/BranchList/GetBranchList').load();
                    $('#btnAddBranch').show();
                }
            }

            function resetAddForm() {
                $('#addBranchForm')[0].reset();
                clearValidation('#addBranchForm');
                $('#btnSaveNewBranch').prop('disabled', false).html('Save');
            }

            function resetViewForm() {
                $('#viewBranchForm')[0].reset();
                clearValidation('#viewBranchForm');
                $('#btnSaveBranch').prop('disabled', false).html('Save');
            }

            function setViewMode() {
                $('#viewModalTitle').text('View Branch');
                $('#viewBranchModal .modal-body').removeClass('edit-mode');

                // Make fields readonly/disabled
                $('#viewBranchCode').prop('readonly', true);
                $('#viewBranchName').prop('readonly', true);

                // Hide required asterisks
                $('.edit-required').addClass('d-none');

                // Show/hide buttons
                $('#btnEditBranch').removeClass('d-none');
                $('#btnSaveBranch').addClass('d-none');
                $('#btnCancelEdit').addClass('d-none');

                clearValidation('#viewBranchForm');
            }

            function setEditMode() {
                $('#viewModalTitle').text('Edit Branch');
                $('#viewBranchModal .modal-body').addClass('edit-mode');

                // Make fields editable
                $('#viewBranchCode').prop('readonly', false);
                $('#viewBranchName').prop('readonly', false);

                // Show required asterisks
                $('.edit-required').removeClass('d-none');

                // Show/hide buttons
                $('#btnEditBranch').addClass('d-none');
                $('#btnSaveBranch').removeClass('d-none');
                $('#btnCancelEdit').removeClass('d-none');
            }

            function clearValidation(formSelector) {
                $(formSelector + ' .form-control, ' + formSelector + ' .form-select').removeClass('is-invalid');
                $(formSelector + ' .invalid-feedback').hide();
            }

            function validateAddForm() {
                var isValid = true;

                // Validate branch code
                var branchCode = $('#addBranchCode').val().trim();
                if (!branchCode) {
                    $('#addBranchCode').addClass('is-invalid');
                    isValid = false;
                }

                // Validate branch name
                var branchName = $('#addBranchName').val().trim();
                if (!branchName) {
                    $('#addBranchName').addClass('is-invalid');
                    isValid = false;
                }

                return isValid;
            }

            function validateViewForm() {
                var isValid = true;

                // Validate branch code
                var branchCode = $('#viewBranchCode').val().trim();
                if (!branchCode) {
                    $('#viewBranchCode').addClass('is-invalid');
                    isValid = false;
                }

                // Validate branch name
                var branchName = $('#viewBranchName').val().trim();
                if (!branchName) {
                    $('#viewBranchName').addClass('is-invalid');
                    isValid = false;
                }

                return isValid;
            }

            // Updated notification function using toastr
            function showNotification(message, type) {
                if (type === 'success') {
                    toastr.success(message, "Success");
                } else if (type === 'error') {
                    toastr.error(message, "Error");
                } else if (type === 'warning') {
                    toastr.warning(message, "Warning");
                } else if (type === 'info') {
                    toastr.info(message, "Information");
                } else {
                    toastr.info(message, "Notification");
                }
            }

            // Remove validation classes when user starts typing (Add form)
            $('#addBranchCode, #addBranchName').on('input', function() {
                $(this).removeClass('is-invalid');
            });

            // Remove validation classes when user starts typing (View/Edit form)
            $('#viewBranchCode, #viewBranchName').on('input', function() {
                $(this).removeClass('is-invalid');
            });
        });
    </script>
}