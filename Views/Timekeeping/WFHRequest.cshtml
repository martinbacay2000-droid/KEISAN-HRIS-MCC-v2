@{
    Layout = "~/Views/Shared/_LayoutFillow.cshtml";
    ViewData["Title"] = "Work From Home Request";
}

<div class="col-12">
    <div class="card">
        <div class="card-header">
            <div class="row" style="width:100%;">
                <h4 class="card-title">Work From Home Request</h4>
                <br> <br> <br>

                <div class="row date-range" style="margin-left:0px;width:100%;">
                    <div class="col-md-3">
                        <div class="form-group">
                            <h5>Select Status</h5>
                            <select name="filterStatusName" id="filterStatusName" class="form-control">
                                <option value="All">ALL</option>
                                <option value="Pending">Pending</option>
                                <option value="Approved">Approved</option>
                                <option value="Cancelled">Cancelled</option>
                                <option value="Declined">Declined</option>
                                <option value="Processed">Processed</option>
                            </select>
                        </div>
                    </div>
                    <div class="col-md-3 ">
                        <label>Date From </label>
                        <div class="input-hasicon">
                            <input name="dateFrom" id="dateFrom" class="form-control formInput date-from" placeholder="mm/dd/yyyy">
                            <div class="icon"><i class="far fa-calendar"></i></div>
                        </div>
                    </div>
                    <div class="col-md-3">
                        <label>Date To </label>
                        <div class="input-hasicon">
                            <input name="dateTo" id="dateTo" class="form-control formInput date-to" placeholder="mm/dd/yyyy">
                            <div class="icon"><i class="far fa-calendar"></i></div>
                        </div>
                    </div>
                </div>

                <div class="row align-items-end mt-2" style="margin-left:0px;width:100%;">
                    <div class="col-md-3">
                        <div class="form-group">
                            <h5>Branch</h5>
                            <select name="branch" id="filterBranch" class="form-control"></select>
                        </div>
                    </div>
                    <div class="col-md-3">
                        <div class="form-group">
                            <h5>Department</h5>
                            <select name="department" id="filterDepartment" class="form-control"></select>
                        </div>
                    </div>
                    <div class="col-md-6 d-flex justify-content-end">
                        <div class="form-group me-2">
                            <button type="button" class="btn btn-warning" id="btnExportToExcel">
                                <i class="fas fa-file-excel"></i> Export to Excel
                            </button>
                        </div>
                        <div class="form-group">
                            <button type="button" class="btn btn-primary" id="btnAddWFHRequest">
                                <i class="fa fa-plus"></i> New WFH Request
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="card-body">
            <div class="table-responsive">
                <table id="wfhRequestTable" class="display" style="min-width: 845px">
                    <thead>
                        <tr>
                            <th>Action</th>
                            <th>Control</th>
                            <th>Employee Name</th>
                            <th>WFH In</th>
                            <th>WFH Out</th>
                            <th>Schedule Request</th>
                            <th>Reason</th>
                            <th>Date Requested</th>
                            <th>Status</th>
                            <th>Requested By</th>
                        </tr>
                    </thead>
                </table>
            </div>
        </div>

        <!-- Modal for Add -->
        <div class="modal fade" id="addWFHRequestModal" tabindex="-1" aria-hidden="true">
            <div class="modal-dialog modal-lg">
                <div class="modal-content">
                    <div class="modal-header">
                        <h5 class="modal-title">Add Work From Home Request</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                    </div>
                    <div class="modal-body">
                        <form id="addWFHRequestForm">
                            <div class="row">
                                <div class="col-md-12 mb-3">
                                    <label for="addEmployeeName" class="form-label">Employee Name <span class="text-danger">*</span></label>
                                    <select class="form-select" id="addEmployeeName" name="employeeNo" style="width:100%" required>
                                        <option value="">Select Employee...</option>
                                    </select>
                                    <div class="invalid-feedback">Please select an employee.</div>
                                </div>
                            </div>

                            <div class="row date-range">
                                <div class="col-md-6 mb-3">
                                    <label>WFH Date In <span class="text-danger">*</span></label>
                                    <div class="input-hasicon">
                                        <input name="addDateIn" id="addDateIn" class="form-control formInput date-from" placeholder="mm/dd/yyyy" required>
                                        <div class="icon"><i class="far fa-calendar"></i></div>
                                    </div>
                                    <div class="invalid-feedback">Please select WFH date in.</div>
                                </div>
                                <div class="col-md-6 mb-3">
                                    <label>WFH Date Out <span class="text-danger">*</span></label>
                                    <div class="input-hasicon">
                                        <input name="addDateOut" id="addDateOut" class="form-control formInput date-to" placeholder="mm/dd/yyyy" required>
                                        <div class="icon"><i class="far fa-calendar"></i></div>
                                    </div>
                                    <div class="invalid-feedback">Please select WFH date out.</div>
                                </div>
                            </div>

                            <div class="row">
                                <div class="col-md-6 mb-3">
                                    <label for="addTimeIn" class="form-label">Time In <span class="text-danger">*</span></label>
                                    <input type="time" class="form-control" id="addTimeIn" name="wfhTimeIn" required>
                                    <div class="invalid-feedback">Please select time in.</div>
                                </div>
                                <div class="col-md-6 mb-3">
                                    <label for="addTimeOut" class="form-label">Time Out <span class="text-danger">*</span></label>
                                    <input type="time" class="form-control" id="addTimeOut" name="wfhTimeOut" required>
                                    <div class="invalid-feedback">Please select time out.</div>
                                </div>
                            </div>

                            <div class="row">
                                <div class="col-md-12 mb-3">
                                    <label for="addReason" class="form-label">Reason <span class="text-danger">*</span></label>
                                    <textarea class="form-control" id="addReason" name="wfhReason" rows="3" required maxlength="500" placeholder="Enter reason for work from home request..."></textarea>
                                    <small class="text-muted">Example: Remote work due to health concerns / Family emergency</small>
                                    <div class="invalid-feedback">Please provide the reason details.</div>
                                </div>
                            </div>

                            <div class="mb-3">
                                <label for="addRemarks" class="form-label">Remarks</label>
                                <textarea class="form-control" id="addRemarks" name="remarks" rows="2" maxlength="1000"></textarea>
                            </div>
                        </form>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-primary" id="btnSaveNewWFHRequest">Save</button>
                    </div>
                </div>
            </div>
        </div>

        <!-- Modal for View/Edit -->
        <div class="modal fade" id="viewWFHRequestModal" tabindex="-1" aria-hidden="true">
            <div class="modal-dialog modal-lg">
                <div class="modal-content">
                    <div class="modal-header">
                        <h5 class="modal-title" id="viewModalTitle">View Work From Home Request</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                    </div>
                    <div class="modal-body">
                        <form id="viewWFHRequestForm">
                            <input type="hidden" id="viewWFHRequestId" name="id">
                            <input type="hidden" id="viewWFHRequestStatus" name="statusName">

                            <div class="row">
                                <div class="col-md-12 mb-3">
                                    <label for="viewEmployeeName" class="form-label">Employee Name <span class="text-danger edit-required d-none">*</span></label>
                                    <select class="form-select" id="viewEmployeeName" name="employeeNo" style="width:100%" disabled>
                                        <option value="">Select Employee...</option>
                                    </select>
                                    <div class="invalid-feedback">Please select an employee.</div>
                                </div>
                            </div>

                            <div class="row date-range">
                                <div class="col-md-6 mb-3">
                                    <label>WFH Date In <span class="text-danger edit-required d-none">*</span></label>
                                    <div class="input-hasicon">
                                        <input name="viewDateIn" id="viewDateIn" class="form-control formInput date-from" placeholder="mm/dd/yyyy" readonly>
                                        <div class="icon"><i class="far fa-calendar"></i></div>
                                    </div>
                                    <div class="invalid-feedback">Please select WFH date in.</div>
                                </div>
                                <div class="col-md-6 mb-3">
                                    <label>WFH Date Out <span class="text-danger edit-required d-none">*</span></label>
                                    <div class="input-hasicon">
                                        <input name="viewDateOut" id="viewDateOut" class="form-control formInput date-to" placeholder="mm/dd/yyyy" readonly>
                                        <div class="icon"><i class="far fa-calendar"></i></div>
                                    </div>
                                    <div class="invalid-feedback">Please select WFH date out.</div>
                                </div>
                            </div>

                            <div class="row">
                                <div class="col-md-6 mb-3">
                                    <label for="viewTimeIn" class="form-label">Time In <span class="text-danger edit-required d-none">*</span></label>
                                    <input type="time" class="form-control" id="viewTimeIn" name="wfhTimeIn" readonly>
                                    <div class="invalid-feedback">Please select time in.</div>
                                </div>
                                <div class="col-md-6 mb-3">
                                    <label for="viewTimeOut" class="form-label">Time Out <span class="text-danger edit-required d-none">*</span></label>
                                    <input type="time" class="form-control" id="viewTimeOut" name="wfhTimeOut" readonly>
                                    <div class="invalid-feedback">Please select time out.</div>
                                </div>
                            </div>

                            <div class="row">
                                <div class="col-md-12 mb-3">
                                    <label for="viewReason" class="form-label">Reason <span class="text-danger edit-required d-none">*</span></label>
                                    <textarea class="form-control" id="viewReason" name="wfhReason" rows="3" readonly maxlength="500"></textarea>
                                    <div class="invalid-feedback">Please provide the reason details.</div>
                                </div>
                            </div>

                            <div class="mb-3">
                                <label for="viewRemarks" class="form-label">Remarks</label>
                                <textarea class="form-control" id="viewRemarks" name="remarks" rows="2" maxlength="1000" readonly></textarea>
                            </div>
                            <!-- Approval Progress Tracker -->
                            <div id="approvalProgress" class="mt-3 d-none">
                                <hr>
                                <h6 class="text-muted mb-2"><i class="fas fa-tasks me-1"></i> Approval Progress</h6>
                                <div id="approvalSteps" class="d-flex flex-wrap gap-2"></div>
                            </div>
                        </form>
                    </div>
                    <div class="modal-footer d-flex justify-content-between">
                        <div>
                            <button type="button" class="btn btn-secondary btn-custom d-none" id="btnCancelWFHRequest">
                                <i class="fas fa-ban"></i> Cancel Request
                            </button>
                        </div>
                        <div>
                            <button type="button" class="btn btn-success d-none" id="btnApproveWFHRequest">
                                <i class="fas fa-check"></i> Approve
                            </button>
                            <button type="button" class="btn btn-primary d-none" id="btnEditWFHRequest">
                                <i class="fas fa-edit"></i> Edit
                            </button>
                            <button type="button" class="btn btn-success d-none" id="btnSaveWFHRequest">Save</button>
                            <button type="button" class="btn btn-danger d-none" id="btnCancelEdit">Cancel</button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Fillow_style
{
    <style>
        .table-responsive {
            border-radius: 0.375rem;
        }

        #wfhRequestTable_wrapper .dataTables_length, #wfhRequestTable_wrapper .dataTables_filter {
            margin-bottom: 1rem;
        }

        #wfhRequestTable_wrapper .dataTables_info, #wfhRequestTable_wrapper .dataTables_paginate {
            margin-top: 1rem;
        }

        .btn-sm {
            padding: 0.25rem 0.5rem;
            font-size: 0.875rem;
        }

        .modal-content {
            border-radius: 0.5rem;
            box-shadow: 0 0.5rem 1rem rgba(0, 0, 0, 0.15);
        }

        .form-control:focus, .form-select:focus {
            border-color: #0d6efd;
            box-shadow: 0 0 0 0.2rem rgba(13, 110, 253, 0.25);
        }

        .form-control[readonly], .form-select[disabled] {
            background-color: #f8f9fa;
            border-color: #dee2e6;
        }

        .edit-mode .form-control[readonly], .edit-mode .form-select[disabled] {
            background-color: #ffffff;
            border-color: #ced4da;
        }

        .invalid-feedback {
            display: none;
        }

        .form-control.is-invalid, .form-select.is-invalid {
            border-color: #dc3545;
        }

            .form-control.is-invalid ~ .invalid-feedback, .form-select.is-invalid ~ .invalid-feedback {
                display: block;
            }

        .is-invalid + .select2-container .select2-selection--single {
            border-color: #dc3545;
        }

        .select2-container .select2-selection--single {
            height: 38px;
            border: 1px solid #ced4da;
            border-radius: 0.375rem;
        }

        .select2-container--default .select2-selection--single .select2-selection__rendered {
            line-height: 36px;
            padding-left: 12px;
        }

        .select2-container--default .select2-selection--single .select2-selection__arrow {
            height: 36px;
        }

        .select2-container--default.select2-container--focus .select2-selection--single {
            border-color: #0d6efd;
            box-shadow: 0 0 0 0.2rem rgba(13, 110, 253, 0.25);
        }

        .select2-container--default .select2-selection--single.select2-selection--disabled {
            background-color: #f8f9fa;
            border-color: #dee2e6;
        }

        /* ADD THESE SWEETALERT2 STYLES TO MATCH OB REQUEST */
        .swal2-popup {
            border-radius: 15px !important;
            padding: 2rem !important;
        }

        .swal2-icon.swal2-error {
            border-color: #f27474 !important;
            color: #f27474 !important;
        }

            .swal2-icon.swal2-error .swal2-x-mark {
                display: none !important;
            }

            .swal2-icon.swal2-error::before {
                content: "\f2ed" !important;
                font-family: "Font Awesome 5 Free" !important;
                font-weight: 900 !important;
                font-size: 2.5rem !important;
                color: #f27474 !important;
                display: block !important;
            }

        .swal2-title {
            font-size: 1.875rem !important;
            font-weight: 600 !important;
            color: #545454 !important;
            margin: 1rem 0 0.5rem 0 !important;
        }

        .swal2-html-container {
            font-size: 1rem !important;
            color: #737373 !important;
            margin: 0 0 2rem 0 !important;
        }

        .swal2-actions {
            gap: 0.5rem !important;
        }

        .swal2-confirm {
            background-color: #7c3aed !important;
            border-color: #7c3aed !important;
            color: white !important;
            font-weight: 500 !important;
            padding: 0.75rem 2rem !important;
            border-radius: 8px !important;
            font-size: 0.875rem !important;
        }

        .swal2-cancel {
            background-color: #6b7280 !important;
            border-color: #6b7280 !important;
            color: white !important;
            font-weight: 500 !important;
            padding: 0.75rem 2rem !important;
            border-radius: 8px !important;
            font-size: 0.875rem !important;
        }

        .swal2-confirm:hover {
            background-color: #6d28d9 !important;
            border-color: #6d28d9 !important;
        }

        .swal2-cancel:hover {
            background-color: #4b5563 !important;
            border-color: #4b5563 !important;
        }

        .status-badge {
            display: inline-block;
            padding: 0.35rem 0.65rem;
            font-size: 0.75rem;
            font-weight: 600;
            line-height: 1;
            text-align: center;
            white-space: nowrap;
            vertical-align: baseline;
            border-radius: 0.25rem;
        }

        .status-pending {
            background-color: #ffc107;
            color: #000;
        }

        .status-approved {
            background-color: #28a745;
            color: #fff;
        }

        .status-declined {
            background-color: #dc3545;
            color: #fff;
        }

        .status-cancelled {
            background-color: #6c757d;
            color: #fff;
        }

        .status-processed {
            background-color: #17a2b8;
            color: #fff;
        }

        .card-header {
            border-bottom: none !important;
        }

        #btnCancelWFHRequest {
            background-color: #6c757d !important;
            border-color: #6c757d !important;
            color: white !important;
        }

            #btnCancelWFHRequest:hover {
                background-color: #5a6268 !important;
                border-color: #545b62 !important;
            }

        .status-partial {
            background-color: #fd7e14;
            color: #fff;
        }
    </style>
}

@section Fillow_script
{
    <script>
        $(document).ready(function () {
            // CONFIGURATION
            MODULE = 'RworkOnOffM';
            access = ROLE_ACCESS?.[MODULE];

            // LOAD PERMISSIONS FROM SERVER
            let canEditEmployee = false;
            let currentEmployeeData = null;
            let isApprover = false;

            // Load permissions on page load
            $.get('/WFHRequest/GetCurrentEmployee', function(data) {
                canEditEmployee = data.canEditEmployee;
                currentEmployeeData = data.currentEmployee;
                isApprover = data.isApprover;
            });

            if (access != 'READWRITE' && access != 'FULL') {
                $('#btnAddWFHRequest').hide();
                $('#btnEditWFHRequest').hide();
                $('#btnApproveWFHRequest').hide();
            }

            const config = {
                toastr: { positionClass: "toast-top-right", timeOut: 5000, closeButton: true, progressBar: true, preventDuplicates: true },
                endpoints: {
                    list: "/WFHRequest/GetWFHRequestList",
                    get: "/WFHRequest/GetWFHRequest",
                    employees: "/WFHRequest/GetEmployeeList",
                    add: "/WFHRequest/AddWFHRequest",
                    update: "/WFHRequest/UpdateWFHRequest",
                    approve: "/WFHRequest/ApproveWFHRequest",
                    decline: "/WFHRequest/DeclineWFHRequest",
                    cancel: "/WFHRequest/CancelWFHRequest"
                }
            };

            toastr.options = config.toastr;
            let isInitialLoad = true;

            // INITIALIZATION
            // Earliest allowed date = today minus 3 calendar days
            var minWFHDate = (access === 'FULL') ? null : new Date();
            if (minWFHDate) minWFHDate.setDate(minWFHDate.getDate() - 3);     

            $('#dateFrom, #dateTo').datepicker({
                format: 'mm/dd/yyyy',
                autoclose: true,
                todayHighlight: true
            });

            $('#addDateIn, #addDateOut, #viewDateIn, #viewDateOut').datepicker({
                format: 'mm/dd/yyyy',
                autoclose: true,
                todayHighlight: true,
                startDate: minWFHDate
            });

            $('#addTimeIn, #addTimeOut, #viewTimeIn, #viewTimeOut').prop('disabled', false).prop('readonly', false);
            $('#filterStatusName').val('Pending');
            initializeSelect2();
            initializeFilterSelect2();

            // DATATABLE CONFIGURATION
            const table = $('#wfhRequestTable').DataTable({
                processing: true,
                serverSide: false,
                ajax: {
                    url: config.endpoints.list,
                    type: "GET",
                    data: d => ({
                        status: isInitialLoad ? 'Default' : $('#filterStatusName').val(),
                        branch: $('#filterBranch').val(),
                        department: $('#filterDepartment').val(),
                        dateFrom: $('#dateFrom').val(),
                        dateTo: $('#dateTo').val()
                    }),
                    dataSrc: function(json) { isInitialLoad = false; return json.data; },
                    error: () => showNotification('Error loading data. Please refresh the page.', 'error')
                },
                columns: [
                    {
                        data: null,
                        width: "12%",
                        orderable: false,
                        render: (data, type, row) => {
                            let viewBtn = '';
                            let declineBtn = '';
                            if (access === 'READ' || access === 'READWRITE' || access === 'FULL') {
                                viewBtn = `<button class="btn btn-sm btn-primary shadow-sm viewWFHRequest" data-id="${row.id}" title="View">
                                    <i class="fas fa-eye"></i>
                                </button>`;
                            }
                            const displayStatus = computeDisplayStatus(row);
                            if (['Pending', 'Partially Approved', 'Approved'].includes(displayStatus) && row.employeeNo !== sessemployeeNo && (access === 'FULL' || isApprover)) {
                                declineBtn = `<button class="btn btn-sm btn-danger shadow-sm declineWFHRequest" data-id="${row.id}" title="Decline"><i class="fas fa-times"></i></button>`;
                            }
                            return `<div class="d-flex gap-1">${viewBtn}${declineBtn}</div>`;
                        }
                    },
                    {
                        data: null,
                        width: "5%",
                        orderable: false,
                        render: function(data, type, row) {
                            return `<button class="btn btn-sm btn-warning shadow-sm printWFHRequest"
                                            data-id="${row.id}"
                                            title="Print PDF">
                                        <i class="fas fa-print"></i>
                                    </button>`;
                        }
                    },
                    // Employee Name column
                    { data: "employeeName", width: "15%", render: data => data || '' },
                    // WFH In column
                    {
                        data: null,
                        width: "12%",
                        render: (data, type, row) => {
                            const dateIn = row.displayDateIn || '';
                            const timeIn = row.displayTimeIn ? convertTo12Hour(row.displayTimeIn) : '';
                            return `${dateIn} ${timeIn}`;
                        }
                    },
                    // WFH Out column
                    {
                        data: null,
                        width: "12%",
                        render: (data, type, row) => {
                            const dateOut = row.displayDateOut || '';
                            const timeOut = row.displayTimeOut ? convertTo12Hour(row.displayTimeOut) : '';
                            return `${dateOut} ${timeOut}`;
                        }
                    },
                    // Schedule Request column
                    {
                        data: null,
                        width: "12%",
                        render: (data, type, row) => {
                            if (!row.displayDateIn || !row.displayDateOut) return '';
                            return `${row.displayDateIn} - ${row.displayDateOut}`;
                        }
                    },
                    // Reason column with truncation
                    { data: "wfhReason", width: "15%", render: data => !data ? '' : (data.length > 80 ? data.substring(0, 80) + '...' : data) },
                    // Date Requested column
                    {
                        data: "dtAdded",
                        width: "10%",
                        render: data => data ? new Date(data).toLocaleDateString() : ''
                    },
                    // Status column
                    {
                        data: null,
                        width: "8%",
                        render: function(data, type, row) {
                            const displayStatus = computeDisplayStatus(row);
                            const statusMap = {
                                'Approved':           'status-approved',
                                'Declined':           'status-declined',
                                'Cancelled':          'status-cancelled',
                                'Processed':          'status-processed',
                                'Partially Approved': 'status-partial'
                            };
                            const statusClass = statusMap[displayStatus] || 'status-pending';
                            return `<span class="status-badge ${statusClass}">${displayStatus}</span>`;
                        }
                    },
                    // Requested By column
                    { data: "requestedByUser", width: "10%", render: data => data || '' }
                ],
                order: [[7, 'desc']],
                pageLength: 25,
                lengthMenu: [[10, 25, 50, 100, -1], [10, 25, 50, 100, "All"]],
                language: {
                    processing: "Loading...",
                    emptyTable: "No WFH requests found",
                    zeroRecords: "No matching WFH requests found",
                    paginate: { next: '<i class="fa fa-angle-double-right"></i>', previous: '<i class="fa fa-angle-double-left"></i>' }
                }
            });

            // EVENT HANDLERS - FILTERS
            $('#filterStatusName, #filterBranch, #filterDepartment, #dateFrom, #dateTo').on('change', () => table.ajax.reload(null, false));

            $('#addTimeIn, #addTimeOut').on('focus', function() {
                $(this).prop('disabled', false).prop('readonly', false);
            });

            $('#viewTimeIn, #viewTimeOut').on('focus', function() {
                if ($('#viewWFHRequestModal .modal-body').hasClass('edit-mode')) {
                    $(this).prop('disabled', false).prop('readonly', false);
                }
            });

            // HELPER FUNCTIONS - DATE CONVERSION
            function toISODate(mmddyyyy) {
                if (!mmddyyyy) return '';
                const [m, d, y] = mmddyyyy.split('/');
                return `${y}-${m.padStart(2, '0')}-${d.padStart(2, '0')}`;
            }

            function convertTo12Hour(time24) {
                if (!time24) return '';
                const [hours, minutes] = time24.split(':');
                let hour = parseInt(hours);
                const ampm = hour >= 12 ? 'PM' : 'AM';
                hour = hour % 12;
                hour = hour ? hour : 12;
                return `${hour}:${minutes} ${ampm}`;
            }

            function computeDisplayStatus(row) {
                const l4 = row.statusLevel4 || row.statusName;
                const l3 = row.statusLevel3;
                const l2 = row.statusLevel2;
                const l1 = row.statusLevel1;

                if (l4 === 'Approved')  return 'Approved';
                if (l4 === 'Declined')  return 'Declined';
                if (l4 === 'Cancelled') return 'Cancelled';
                if (l4 === 'Processed') return 'Processed';

                if (l3 === 'Declined' || l2 === 'Declined' || l1 === 'Declined') return 'Declined';
                if (l3 === 'Approved' || l2 === 'Approved' || l1 === 'Approved') return 'Partially Approved';

                return 'Pending';
            }

            // EVENT HANDLERS - ADD MODAL
            $('#btnAddWFHRequest').click(() => {
                resetAddForm();

                if (canEditEmployee) {
                    // FULL access: Load all employees based on data scope
                    loadDropdownOptions('#addEmployeeName');
                } else {
                    // Limited access: Only show current user
                    if (currentEmployeeData) {
                        $('#addEmployeeName').empty()
                            .append(`<option value="${currentEmployeeData.employeeNo}" selected>${currentEmployeeData.employeeName}</option>`)
                            .prop('disabled', true)
                            .trigger('change');
                    }
                }

                setTimeout(() => {
                    $('#addTimeIn').val('08:00').prop('disabled', false).prop('readonly', false);
                    $('#addTimeOut').val('17:00').prop('disabled', false).prop('readonly', false);
                }, 100);
                $('#addWFHRequestModal').modal('show');
            });

            // EVENT HANDLERS - CANCEL ACTION (INSIDE MODAL)
            $('#btnCancelWFHRequest').click(() => {
                const id = $('#viewWFHRequestId').val();
                cancelWithReason({
                    title: 'Cancel WFH Request',
                    text: 'Are you sure you want to cancel this WFH Request?',
                    url: config.endpoints.cancel,
                    id: id,
                    cancelledByUser: sessemployeeNo || 'CURRENT_USER',
                    button: $('#btnCancelWFHRequest'),
                    table: table,
                    onSuccess: function(response) {
                        $('#viewWFHRequestModal').modal('hide');
                    }
                });
            });

            $('#btnSaveNewWFHRequest').click(() => {
                if (!validateForm('#addWFHRequestForm', ['addEmployeeName', 'addReason', 'addDateIn', 'addTimeIn', 'addDateOut', 'addTimeOut'])) return;
                if (!validateDates('#addDateIn', '#addDateOut')) return;

                const formData = new FormData();
                formData.append('employeeNo', $('#addEmployeeName').val());
                formData.append('wfhDateIn', toISODate($('#addDateIn').val()));
                formData.append('wfhTimeIn', $('#addTimeIn').val());
                formData.append('wfhDateOut', toISODate($('#addDateOut').val()));
                formData.append('wfhTimeOut', $('#addTimeOut').val());
                formData.append('wfhReason', $('#addReason').val().trim());
                formData.append('remarks', $('#addRemarks').val().trim());

                saveRequest(config.endpoints.add, formData, '#btnSaveNewWFHRequest', true);
            });

            // EVENT HANDLERS - VIEW/EDIT MODAL
            $(document).on('click', '.viewWFHRequest', function(e) {
                e.preventDefault();
                const id = $(this).data('id');
                const $btn = $(this);
                toggleButtonLoading($btn, true);

                $.get(config.endpoints.get, { id })
                    .done(data => {
                        if (data) {
                            resetViewForm();
                            setViewMode();

                            if (canEditEmployee) {
                                // FULL access: Load all employees
                                $.when(loadDropdownOptionsAsync('#viewEmployeeName'))
                                    .done(() => {
                                        populateViewForm(data);
                                        updateViewButtons(data);
                                        $('#viewWFHRequestModal').modal('show');
                                    });
                            } else {
                                // Limited access: Only show record's employee
                                $('#viewEmployeeName').empty()
                                    .append(`<option value="${data.employeeNo}" selected>${data.employeeName}</option>`)
                                    .prop('disabled', true);
                                populateViewForm(data);
                                updateViewButtons(data);
                                $('#viewWFHRequestModal').modal('show');
                            }
                        } else {
                            showNotification('Unable to load WFH Request data', 'error');
                        }
                    })
                    .fail(() => showNotification('Unable to load WFH Request data', 'error'))
                    .always(() => toggleButtonLoading($btn, false));
            });

            $('#btnApproveWFHRequest').click(() => {
                const id = $('#viewWFHRequestId').val();
                Swal.fire({
                    title: 'Approve Request',
                    text: 'Are you sure you want to approve this WFH Request?',
                    icon: 'question',
                    showCancelButton: true,
                    confirmButtonText: 'Yes, Approve',
                    cancelButtonText: 'Cancel',
                    confirmButtonColor: '#28a745',
                    cancelButtonColor: '#6c757d'
                }).then(result => {
                    if (result.isConfirmed) {
                        const $btn = $('#btnApproveWFHRequest');
                        toggleButtonLoading($btn, true, 'Approving...');
                        $.post(config.endpoints.approve, { id, approvedByUser: sessemployeeNo || 'CURRENT_USER' })
                            .done(response => {
                                if (response.success) {
                                    $('#viewWFHRequestModal').modal('hide');
                                    table.ajax.reload(null, false);
                                    showNotification(response.message, 'success');
                                } else {
                                    showNotification(response.message, 'error');
                                    toggleButtonLoading($btn, false);
                                }
                            })
                            .fail(() => {
                                showNotification('Unable to approve. Please try again.', 'error');
                                toggleButtonLoading($btn, false);
                            });
                    }
                });
            });

            $('#btnEditWFHRequest').click(() => {
                setEditMode();
                setTimeout(() => {
                    $('#viewTimeIn, #viewTimeOut').prop('disabled', false).prop('readonly', false);
                }, 100);
                $('#viewEmployeeName').focus();
            });

            $('#btnCancelEdit').click(() => {
                const id = $('#viewWFHRequestId').val();
                $.get(config.endpoints.get, { id }).done(function(data) {
                    if (data) {
                        populateViewForm(data);
                        setViewMode();
                        updateViewButtons(data);   // ← pass full data object
                        clearValidation('#viewWFHRequestForm');
                    }
                });
            });

            $('#btnSaveWFHRequest').click(() => {
                if (!validateForm('#viewWFHRequestForm', ['viewEmployeeName', 'viewReason', 'viewDateIn', 'viewTimeIn', 'viewDateOut', 'viewTimeOut'])) return;
                if (!validateDates('#viewDateIn', '#viewDateOut')) return;

                const formData = new FormData();
                formData.append('id', $('#viewWFHRequestId').val());
                formData.append('employeeNo', $('#viewEmployeeName').val());
                formData.append('wfhDateIn', toISODate($('#viewDateIn').val()));
                formData.append('wfhTimeIn', $('#viewTimeIn').val());
                formData.append('wfhDateOut', toISODate($('#viewDateOut').val()));
                formData.append('wfhTimeOut', $('#viewTimeOut').val());
                formData.append('wfhReason', $('#viewReason').val().trim());
                formData.append('remarks', $('#viewRemarks').val().trim());

                saveRequest(config.endpoints.update, formData, '#btnSaveWFHRequest', false);
            });

            // EVENT HANDLERS - DECLINE ACTION (FROM TABLE)
            $(document).on('click', '.declineWFHRequest', function(e) {
                e.preventDefault();
                declineWithReason({
                    title: 'Decline WFH Request',
                    text: 'Are you sure you want to decline this WFH Request?',
                    url: config.endpoints.decline,
                    id: $(this).data('id'),
                    declinedByUser: sessemployeeNo || 'CURRENT_USER',
                    button: $(this),
                    table: table
                });
            });

            // EVENT HANDLERS - MODAL LIFECYCLE
            $('#addWFHRequestModal').on('shown.bs.modal', function() {
                $('#addTimeIn, #addTimeOut').prop('disabled', false).prop('readonly', false);
            });

            $('#addWFHRequestModal').on('hidden.bs.modal', resetAddForm);

            $('#viewWFHRequestModal').on('shown.bs.modal', function() {
                if ($('#viewWFHRequestModal .modal-body').hasClass('edit-mode')) {
                    $('#viewTimeIn, #viewTimeOut').prop('disabled', false).prop('readonly', false);
                }
            });

            $('#viewWFHRequestModal').on('hidden.bs.modal', () => {
                resetViewForm();
                setViewMode();
                resetAllButtons();
            });

            // EVENT HANDLERS - KEYBOARD
            $('#addWFHRequestForm').on('keypress', e => {
                if (e.which === 13) { e.preventDefault(); $('#btnSaveNewWFHRequest').click(); }
            });
            $('#viewWFHRequestForm').on('keypress', e => {
                if (e.which === 13 && $('#viewWFHRequestModal .modal-body').hasClass('edit-mode')) {
                    e.preventDefault(); $('#btnSaveWFHRequest').click();
                }
            });

            // EVENT HANDLER - PRINT PDF
            $(document).on('click', '.printWFHRequest', function(e) {
                e.preventDefault();
                const id = $(this).data('id');
                const $btn = $(this);

                toggleButtonLoading($btn, true);

                // Open PDF in new tab
                window.open(`/WFHRequestPdf/PreviewPdf?id=${id}`, '_blank');

                setTimeout(() => toggleButtonLoading($btn, false), 1000);
            });

            // EVENT HANDLER - EXPORT TO EXCEL
            $('#btnExportToExcel').click(function() {
                const $btn = $(this);
                const pageInfo = table.page.info();

                if (pageInfo.recordsDisplay === 0) {
                    return showNotification('No data available to export', 'warning');
                }

                const sortMap = [
                    '',
                    'employeeNo',
                    'employeeName',
                    'displayDateIn',
                    'displayDateOut',
                    '',
                    '',
                    'dtAdded',
                    'statusName',
                    'requestedByUser'
                ];

                const [sortIndex, sortDir] = table.order()[0] || [7, 'desc'];

                const exportLimit = pageInfo.length === -1 ? -1 : pageInfo.length;

                const params = new URLSearchParams({
                    status:        isInitialLoad ? 'Default' : ($('#filterStatusName').val() || 'Default'),
                    branch:        $('#filterBranch').val() || '',
                    department:    $('#filterDepartment').val() || '',
                    dateFrom:      $('#dateFrom').val() || '',
                    dateTo:        $('#dateTo').val() || '',
                    offset:        pageInfo.start,
                    limit:         exportLimit,
                    sortColumn:    sortMap[sortIndex] || '',
                    sortDirection: sortDir
                });

                toggleButtonLoading($btn, true, 'Exporting...');

                fetch(`/WFHRequestExport/ExportToExcel?${params.toString()}`, {
                    method: 'GET',
                    headers: { 'Accept': 'application/vnd.openxmlformats-officedocument.spreadsheetml.sheet' }
                })
                .then(response => {
                    if (!response.ok) {
                        return response.text().then(text => {
                            throw new Error(`Server error (${response.status}): ${text}`);
                        });
                    }
                    return response.blob();
                })
                .then(blob => {
                    const url = window.URL.createObjectURL(blob);
                    const link = document.createElement('a');
                    link.href = url;
                    link.download = `WFHRequest_${new Date().getTime()}.xlsx`;
                    document.body.appendChild(link);
                    link.click();
                    document.body.removeChild(link);
                    window.URL.revokeObjectURL(url);
                    toggleButtonLoading($btn, false);
                    showNotification(`Successfully exported ${pageInfo.recordsDisplay} record(s).`, 'success');
                })
                .catch(error => {
                    toggleButtonLoading($btn, false);
                    showNotification(error.message || 'An error occurred during export. Please try again.', 'error');
                });
            });

            // EVENT HANDLERS - VALIDATION
            $('#addEmployeeName, #addReason, #addDateIn, #addTimeIn, #addDateOut, #addTimeOut, #addRemarks, #viewEmployeeName, #viewReason, #viewDateIn, #viewTimeIn, #viewDateOut, #viewTimeOut, #viewRemarks')
                .on('input change', function() { $(this).removeClass('is-invalid'); });

            // HELPER FUNCTIONS - SELECT2 INITIALIZATION
            function initializeSelect2() {
                const modals = {
                    add: { employee: '#addEmployeeName', parent: '#addWFHRequestModal' },
                    view: { employee: '#viewEmployeeName', parent: '#viewWFHRequestModal' }
                };
                Object.values(modals).forEach(modal => {
                    $(modal.employee).select2({ placeholder: "Select Employee", allowClear: true, dropdownParent: $(modal.parent), width: '100%' });
                });
            }

            function initializeFilterSelect2() {
                $('#filterStatusName').select2({ selectOnClose: true, minimumResultsForSearch: Infinity });
                $('#filterBranch').select2({
                    placeholder: "Select Branch", allowClear: true,
                    ajax: {
                        url: '/Setup/GetEmployeeBranch', dataType: 'json', delay: 250,
                        processResults: data => ({
                            results: [{ id: 'ALL', text: 'All Branches' }].concat(data.map(item => ({ id: item.branchCode, text: item.branchName })))
                        })
                    }
                });
                $('#filterDepartment').select2({
                    placeholder: "Select Employee Department", allowClear: true,
                    ajax: {
                        url: '/Setup/GetEmployeeDepartment', dataType: 'json', delay: 250,
                        processResults: data => ({
                            results: [{ id: 'ALL', text: 'All Departments' }].concat(data.map(item => ({ id: item.departmentCode, text: item.departmentName })))
                        })
                    }
                });
            }

            // HELPER FUNCTIONS - DROPDOWN LOADING
            function loadDropdownOptions(employeeSelector) {
                $.get(config.endpoints.employees, data => {
                    const $select = $(employeeSelector);
                    $select.empty().append('<option value="">Select Employee...</option>');
                    data.forEach(item => $select.append(`<option value="${item.employeeNo}">${item.employeeName}</option>`));
                });
            }

            function loadDropdownOptionsAsync(employeeSelector) {
                return $.get(config.endpoints.employees).done(data => {
                    const $select = $(employeeSelector);
                    $select.empty().append('<option value="">Select Employee...</option>');
                    data.forEach(item => $select.append(`<option value="${item.employeeNo}">${item.employeeName}</option>`));
                });
            }

            // HELPER FUNCTIONS - FORM MANAGEMENT
            function populateViewForm(data) {
                $('#viewWFHRequestId').val(data.id);
                $('#viewWFHRequestStatus').val(data.statusLevel4 || data.statusName);
                $('#viewEmployeeName').val(data.employeeNo).trigger('change');
                $('#viewDateIn').val(data.displayDateIn);
                $('#viewTimeIn').val(data.displayTimeIn);
                $('#viewDateOut').val(data.displayDateOut);
                $('#viewTimeOut').val(data.displayTimeOut);
                $('#viewReason').val(data.wfhReason);
                $('#viewRemarks').val(data.remarks);

                renderApprovalProgress(data);
            }

            function renderApprovalProgress(data) {
                const $progress = $('#approvalProgress');
                const $steps    = $('#approvalSteps');
                $steps.empty();

                const overall = data.statusLevel4 || data.statusName;

                if (overall === 'Cancelled' || overall === 'Processed') {
                    $progress.addClass('d-none');
                    return;
                }

                const required = data.requiredLevels || [];
                if (required.length === 0) {
                    $progress.addClass('d-none');
                    return;
                }

                const levelStatus = {
                    1: data.statusLevel1,
                    2: data.statusLevel2,
                    3: data.statusLevel3,
                    4: data.statusLevel4
                };

                required.forEach(function(level) {
                    const st = levelStatus[level] || 'Pending';
                    let badgeClass, icon;

                    switch (st) {
                        case 'Approved':
                            badgeClass = 'bg-success';
                            icon       = 'fa-check-circle';
                            break;
                        case 'Declined':
                            badgeClass = 'bg-danger';
                            icon       = 'fa-times-circle';
                            break;
                        default:
                            badgeClass = 'bg-warning';
                            icon       = 'fa-clock';
                    }

                    $steps.append(`
                        <span class="badge ${badgeClass} fs-6 px-3 py-2">
                            <i class="fas ${icon} me-1"></i>
                            Level ${level}: ${st}
                        </span>
                        ${required.indexOf(level) < required.length - 1
                            ? '<i class="fas fa-arrow-right align-self-center text-muted"></i>'
                            : ''}
                    `);
                });

                $progress.removeClass('d-none');
            }

            function saveRequest(url, data, buttonSelector, closeModal) {
                const $btn = $(buttonSelector);
                toggleButtonLoading($btn, true, 'Saving...');
                $.ajax({
                    url, type: 'POST', data, processData: false, contentType: false,
                    success: response => {
                        if (response.success) {
                            if (closeModal) $('#addWFHRequestModal').modal('hide');
                            else setViewMode();
                            table.ajax.reload(null, false);
                            showNotification(response.message, 'success');
                        } else {
                            showNotification(response.message, 'error');
                        }
                    },
                    error: () => showNotification('Unable to save. Please try again.', 'error'),
                    complete: () => toggleButtonLoading($btn, false)
                });
            }

            function updateViewButtons(data) {
                const isFullObject = (typeof data === 'object' && data !== null);
                const status       = isFullObject
                    ? (data.statusLevel4 || data.statusName)
                    : data;

                $('#btnApproveWFHRequest, #btnEditWFHRequest, #btnCancelWFHRequest').addClass('d-none');
                $('#btnSaveWFHRequest, #btnCancelEdit').addClass('d-none');

                const requestEmployeeNo = isFullObject ? data.employeeNo : $('#viewEmployeeName').val();
                const isOwnRequest      = requestEmployeeNo === sessemployeeNo;

                if (status === 'Cancelled' || status === 'Processed') return;
                if (status === 'Approved') return;

                if (status === 'Declined') {
                    if (isOwnRequest || access === 'FULL') {
                        $('#btnEditWFHRequest, #btnCancelWFHRequest').removeClass('d-none');
                    }
                    return;
                }

                // Pending / Partially Approved
                if (isFullObject && typeof data.canCurrentUserApprove !== 'undefined') {
                    if (data.canCurrentUserApprove) {
                        $('#btnApproveWFHRequest').removeClass('d-none');
                    }
                } else {
                    if (access === 'FULL') {
                        $('#btnApproveWFHRequest').removeClass('d-none');
                    }
                }

                if (isOwnRequest || access === 'FULL') {
                    $('#btnEditWFHRequest, #btnCancelWFHRequest').removeClass('d-none');
                }
            }

            function resetAddForm() {
                $('#addWFHRequestForm')[0].reset();
                $('#addEmployeeName').val(null).trigger('change');
                clearValidation('#addWFHRequestForm');
                $('#btnSaveNewWFHRequest').prop('disabled', false).html('Save');
            }

            function resetViewForm() {
                $('#viewWFHRequestForm')[0].reset();
                $('#viewEmployeeName').val(null).trigger('change');
                clearValidation('#viewWFHRequestForm');
                $('#btnSaveWFHRequest').prop('disabled', false).html('Save');
            }

            function resetAllButtons() {
                $('#btnApproveWFHRequest').prop('disabled', false).html('<i class="fas fa-check"></i> Approve');
                $('#btnEditWFHRequest').prop('disabled', false).html('<i class="fas fa-edit"></i> Edit');
                $('#btnCancelWFHRequest').prop('disabled', false).html('<i class="fas fa-ban"></i> Cancel Request');
            }

            // HELPER FUNCTIONS - VIEW MODES
            function setViewMode() {
                const status = $('#viewWFHRequestStatus').val();
                $('#viewModalTitle').text('View Work From Home Request');
                $('#viewWFHRequestModal .modal-body').removeClass('edit-mode');
                $('#viewEmployeeName').prop('disabled', true);
                $('#viewDateIn, #viewDateOut').datepicker('destroy').prop('readonly', true);
                $('#viewTimeIn, #viewTimeOut, #viewReason, #viewRemarks').prop('readonly', true);
                $('.edit-required').addClass('d-none');
                updateViewButtons(status);
                $('#btnSaveWFHRequest, #btnCancelEdit').addClass('d-none');
                clearValidation('#viewWFHRequestForm');
            }

            function setEditMode() {
                $('#viewModalTitle').text('Edit Work From Home Request');
                $('#viewWFHRequestModal .modal-body').addClass('edit-mode');

                // ✅ Only enable employee selector if user has FULL access
                if (canEditEmployee) {
                    $('#viewEmployeeName').prop('disabled', false);
                } else {
                    $('#viewEmployeeName').prop('disabled', true);
                }

                $('#viewDateIn, #viewDateOut').prop('readonly', false).datepicker({ format: 'mm/dd/yyyy', autoclose: true, todayHighlight: true, startDate: minWFHDate });
                $('#viewTimeIn, #viewTimeOut').prop('readonly', false).prop('disabled', false);
                $('#viewReason, #viewRemarks').prop('readonly', false);
                $('.edit-required').removeClass('d-none');
                $('#btnApproveWFHRequest, #btnEditWFHRequest').addClass('d-none');
                $('#btnSaveWFHRequest, #btnCancelEdit').removeClass('d-none');
            }

            // HELPER FUNCTIONS - VALIDATION
            function validateForm(formSelector, fields) {
                clearValidation(formSelector);
                let isValid = true;
                fields.forEach(field => {
                    if (!$(`#${field}`).val()) {
                        $(`#${field}`).addClass('is-invalid');
                        isValid = false;
                    }
                });
                return isValid;
            }

            function validateDates(dateInSelector, dateOutSelector) {
                if ($(dateInSelector).val() && $(dateOutSelector).val()) {
                    const dateIn = new Date($(dateInSelector).val());
                    const dateOut = new Date($(dateOutSelector).val());
                    if (dateOut < dateIn) {
                        $(dateOutSelector).addClass('is-invalid');
                        showNotification('Date Out cannot be earlier than Date In', 'error');
                        return false;
                    }
                }
                return true;
            }

            function clearValidation(formSelector) {
                $(`${formSelector} .form-control, ${formSelector} .form-select`).removeClass('is-invalid');
            }

            // HELPER FUNCTIONS - UI UTILITIES
            function toggleButtonLoading($btn, loading, text = '') {
                if (loading) {
                    if (!$btn.data('original-html')) $btn.data('original-html', $btn.html());
                    const icon = text ? '<i class="fas fa-spinner fa-spin"></i> ' : '<i class="fas fa-spinner fa-spin"></i>';
                    $btn.prop('disabled', true).html(icon + text);
                } else {
                    const originalHtml = $btn.data('original-html') || 'Save';
                    $btn.prop('disabled', false).html(originalHtml).removeData('original-html');
                }
            }

            function showNotification(message, type) {
                const types = { success: 'Success', error: 'Error', warning: 'Warning', info: 'Information' };
                toastr[type](message, types[type] || 'Notification');
            }

            validationinputs();
        });
    </script>
}