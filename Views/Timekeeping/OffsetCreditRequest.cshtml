@{
    Layout = "~/Views/Shared/_LayoutFillow.cshtml";
    ViewData["Title"] = "Offset Credit Request";
}

<div class="col-12">
    <div class="card">
        <div class="card-header">
            <div class="row" style="width:100%;">
                <h4 class="card-title">Offset Credit Request</h4>
                <br> <br> <br>

                <div class="row date-range" style="margin-left:0px;width:100%;">
                    <div class="col-md-3">
                        <div class="form-group">
                            <h5>Select Status</h5>
                            <select name="filterStatusName" id="filterStatusName" class="form-control">
                                <option value="All">ALL</option>
                                <option value="Pending">Pending</option>
                                <option value="Approved">Approved</option>
                                <option value="Cancelled">Cancelled</option>
                                <option value="Declined">Declined</option>
                                <option value="Processed">Processed</option>
                            </select>
                        </div>
                    </div>
                    <div class="col-md-3 ">
                        <label>Date From </label>
                        <div class="input-hasicon">
                            <input name="dateFrom" id="dateFrom" class="form-control formInput date-from" placeholder="mm/dd/yyyy">
                            <div class="icon"><i class="far fa-calendar"></i></div>
                        </div>
                    </div>
                    <div class="col-md-3">
                        <label>Date To </label>
                        <div class="input-hasicon">
                            <input name="dateTo" id="dateTo" class="form-control formInput date-to" placeholder="mm/dd/yyyy">
                            <div class="icon"><i class="far fa-calendar"></i></div>
                        </div>
                    </div>
                </div>

                <div class="row align-items-end mt-2" style="margin-left:0px;width:100%;">
                    <div class="col-md-3">
                        <div class="form-group">
                            <h5>Branch</h5>
                            <select name="branch" id="filterBranch" class="form-control"></select>
                        </div>
                    </div>
                    <div class="col-md-3">
                        <div class="form-group">
                            <h5>Department</h5>
                            <select name="department" id="filterDepartment" class="form-control"></select>
                        </div>
                    </div>
                    <div class="col-md-6 d-flex justify-content-end">
                        <div class="form-group me-2">
                            <button type="button" class="btn btn-warning" id="btnExportToExcel">
                                <i class="fas fa-file-excel"></i> Export to Excel
                            </button>
                        </div>
                        <div class="form-group">
                            <button type="button" class="btn btn-primary" id="btnAddOffsetRequest">
                                <i class="fa fa-plus"></i> New Offset Request
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="card-body">
            <div class="table-responsive">
                <table id="offsetRequestTable" class="display" style="min-width: 845px">
                    <thead>
                        <tr>
                            <th>Action</th>
                            <th>Control</th>
                            <th>Employee Name</th>
                            <th>Offset Date In</th>
                            <th>Offset Date Out</th>
                            <th>Reason</th>
                            <th>Date Requested</th>
                            <th>Status</th>
                            <th>Requested By</th>
                        </tr>
                    </thead>
                </table>
            </div>
        </div>

        <!-- Modal for Add -->
        <div class="modal fade" id="addOffsetRequestModal" tabindex="-1" aria-hidden="true">
            <div class="modal-dialog modal-lg">
                <div class="modal-content">
                    <div class="modal-header">
                        <h5 class="modal-title">Add Offset Credit Request</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                    </div>
                    <div class="modal-body">
                        <form id="addOffsetRequestForm">
                            <div class="row">
                                <div class="col-md-12 mb-3">
                                    <label for="addEmployeeName" class="form-label">Employee Name <span class="text-danger">*</span></label>
                                    <select class="form-select" id="addEmployeeName" name="employeeNo" style="width:100%" required>
                                        <option value="">Select Employee...</option>
                                    </select>
                                    <div class="invalid-feedback">Please select an employee.</div>
                                </div>
                            </div>

                            <div class="row date-range">
                                <div class="col-md-6 mb-3">
                                    <label>Offset Date In <span class="text-danger">*</span></label>
                                    <div class="input-hasicon">
                                        <input name="addDateIn" id="addDateIn" class="form-control formInput date-from" placeholder="mm/dd/yyyy">
                                        <div class="icon"><i class="far fa-calendar"></i></div>
                                    </div>
                                    <div class="invalid-feedback">Please select offset date in.</div>
                                </div>
                                <div class="col-md-6 mb-3">
                                    <label>Offset Date Out <span class="text-danger">*</span></label>
                                    <div class="input-hasicon">
                                        <input name="addDateOut" id="addDateOut" class="form-control formInput date-to" placeholder="mm/dd/yyyy">
                                        <div class="icon"><i class="far fa-calendar"></i></div>
                                    </div>
                                    <div class="invalid-feedback">Please select offset date out.</div>
                                </div>
                            </div>

                            <div class="row">
                                <div class="col-md-6 mb-3">
                                    <label for="addTimeIn" class="form-label">Time In <span class="text-danger">*</span></label>
                                    <input type="time" class="form-control" id="addTimeIn" name="overTimeIN" required>
                                    <div class="invalid-feedback">Please select time in.</div>
                                </div>
                                <div class="col-md-6 mb-3">
                                    <label for="addTimeOut" class="form-label">Time Out <span class="text-danger">*</span></label>
                                    <input type="time" class="form-control" id="addTimeOut" name="overTimeOUT" required>
                                    <div class="invalid-feedback">Please select time out.</div>
                                </div>
                            </div>

                            <div class="row">
                                <div class="col-md-12 mb-3">
                                    <label for="addReason" class="form-label">Reason <span class="text-danger">*</span></label>
                                    <textarea class="form-control" id="addReason" name="offsetReason" rows="3" required maxlength="500" placeholder="Enter reason for offset credit..."></textarea>
                                    <small class="text-muted">Example: Overtime work on weekend for urgent project deadline</small>
                                    <div class="invalid-feedback">Please provide the reason.</div>
                                </div>
                            </div>

                            <div class="mb-3">
                                <label for="addRemarks" class="form-label">Remarks</label>
                                <textarea class="form-control" id="addRemarks" name="remarks" rows="2" maxlength="1000"></textarea>
                            </div>
                        </form>
                        <div id="addCTOBalanceTracker" class="mt-3">
                            <div class="alert alert-info mb-0">
                                <i class="fas fa-info-circle"></i> Select an employee to see CTO balance
                            </div>
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-primary" id="btnSaveNewOffsetRequest">Save</button>
                    </div>
                </div>
            </div>
        </div>

        <!-- Modal for View/Edit -->
        <div class="modal fade" id="viewOffsetRequestModal" tabindex="-1" aria-hidden="true">
            <div class="modal-dialog modal-lg">
                <div class="modal-content">
                    <div class="modal-header">
                        <h5 class="modal-title" id="viewModalTitle">View Offset Credit Request</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                    </div>
                    <div class="modal-body">
                        <form id="viewOffsetRequestForm">
                            <input type="hidden" id="viewOffsetRequestId" name="id">
                            <input type="hidden" id="viewOffsetRequestStatus" name="statusName">
                            <input type="hidden" id="viewOriginalOffsetDays" value="0">

                            <div class="row">
                                <div class="col-md-12 mb-3">
                                    <label for="viewEmployeeName" class="form-label">Employee Name <span class="text-danger edit-required d-none">*</span></label>
                                    <select class="form-select" id="viewEmployeeName" name="employeeNo" style="width:100%" disabled>
                                        <option value="">Select Employee...</option>
                                    </select>
                                    <div class="invalid-feedback">Please select an employee.</div>
                                </div>
                            </div>

                            <div class="row date-range">
                                <div class="col-md-6 mb-3">
                                    <label>Offset Date In <span class="text-danger edit-required d-none">*</span></label>
                                    <div class="input-hasicon">
                                        <input name="viewDateIn" id="viewDateIn" class="form-control formInput date-from" placeholder="mm/dd/yyyy" readonly>
                                        <div class="icon"><i class="far fa-calendar"></i></div>
                                    </div>
                                    <div class="invalid-feedback">Please select offset date in.</div>
                                </div>
                                <div class="col-md-6 mb-3">
                                    <label>Offset Date Out <span class="text-danger edit-required d-none">*</span></label>
                                    <div class="input-hasicon">
                                        <input name="viewDateOut" id="viewDateOut" class="form-control formInput date-to" placeholder="mm/dd/yyyy" readonly>
                                        <div class="icon"><i class="far fa-calendar"></i></div>
                                    </div>
                                    <div class="invalid-feedback">Please select offset date out.</div>
                                </div>
                            </div>

                            <div class="row">
                                <div class="col-md-6 mb-3">
                                    <label for="viewTimeIn" class="form-label">Time In <span class="text-danger edit-required d-none">*</span></label>
                                    <input type="time" class="form-control" id="viewTimeIn" name="overTimeIN" readonly>
                                    <div class="invalid-feedback">Please select time in.</div>
                                </div>
                                <div class="col-md-6 mb-3">
                                    <label for="viewTimeOut" class="form-label">Time Out <span class="text-danger edit-required d-none">*</span></label>
                                    <input type="time" class="form-control" id="viewTimeOut" name="overTimeOUT" readonly>
                                    <div class="invalid-feedback">Please select time out.</div>
                                </div>
                            </div>

                            <div class="row">
                                <div class="col-md-12 mb-3">
                                    <label for="viewReason" class="form-label">Reason <span class="text-danger edit-required d-none">*</span></label>
                                    <textarea class="form-control" id="viewReason" name="offsetReason" rows="3" readonly maxlength="500"></textarea>
                                    <div class="invalid-feedback">Please provide the reason.</div>
                                </div>
                            </div>

                            <div class="mb-3">
                                <label for="viewRemarks" class="form-label">Remarks</label>
                                <textarea class="form-control" id="viewRemarks" name="remarks" rows="2" maxlength="1000" readonly></textarea>
                            </div>
                            <!-- Approval Progress Tracker -->
                            <div id="approvalProgress" class="mt-3 d-none">
                                <hr>
                                <h6 class="text-muted mb-2"><i class="fas fa-tasks me-1"></i> Approval Progress</h6>
                                <div id="approvalSteps" class="d-flex flex-wrap gap-2"></div>
                            </div>
                        </form>
                        <div id="viewCTOBalanceTracker" class="mt-3">
                            <div class="alert alert-info mb-0">
                                <i class="fas fa-info-circle"></i> CTO balance will appear here
                            </div>
                        </div>
                    </div>
                    <div class="modal-footer d-flex justify-content-between">
                        <div>
                            <button type="button" class="btn btn-secondary btn-custom d-none" id="btnCancelOffsetRequest">
                                <i class="fas fa-ban"></i> Cancel Request
                            </button>
                        </div>
                        <div>
                            <button type="button" class="btn btn-success d-none" id="btnApproveOffsetRequest">
                                <i class="fas fa-check"></i> Approve
                            </button>
                            <button type="button" class="btn btn-primary d-none" id="btnEditOffsetRequest">
                                <i class="fas fa-edit"></i> Edit
                            </button>
                            <button type="button" class="btn btn-success d-none" id="btnSaveOffsetRequest">Save</button>
                            <button type="button" class="btn btn-danger d-none" id="btnCancelEdit">Cancel</button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Fillow_style
{
    <style>
        .table-responsive {
            border-radius: 0.375rem;
        }

        #offsetRequestTable_wrapper .dataTables_length, #offsetRequestTable_wrapper .dataTables_filter {
            margin-bottom: 1rem;
        }

        #offsetRequestTable_wrapper .dataTables_info, #offsetRequestTable_wrapper .dataTables_paginate {
            margin-top: 1rem;
        }

        .btn-sm {
            padding: 0.25rem 0.5rem;
            font-size: 0.875rem;
        }

        .modal-content {
            border-radius: 0.5rem;
            box-shadow: 0 0.5rem 1rem rgba(0, 0, 0, 0.15);
        }

        .form-control:focus, .form-select:focus {
            border-color: #0d6efd;
            box-shadow: 0 0 0 0.2rem rgba(13, 110, 253, 0.25);
        }

        .form-control[readonly], .form-select[disabled] {
            background-color: #f8f9fa;
            border-color: #dee2e6;
        }

        .edit-mode .form-control[readonly], .edit-mode .form-select[disabled] {
            background-color: #ffffff;
            border-color: #ced4da;
        }

        .invalid-feedback {
            display: none;
        }

        .form-control.is-invalid, .form-select.is-invalid {
            border-color: #dc3545;
        }

            .form-control.is-invalid ~ .invalid-feedback, .form-select.is-invalid ~ .invalid-feedback {
                display: block;
            }

        .is-invalid + .select2-container .select2-selection--single {
            border-color: #dc3545;
        }

        .select2-container .select2-selection--single {
            height: 38px;
            border: 1px solid #ced4da;
            border-radius: 0.375rem;
        }

        .select2-container--default .select2-selection--single .select2-selection__rendered {
            line-height: 36px;
            padding-left: 12px;
        }

        .select2-container--default .select2-selection--single .select2-selection__arrow {
            height: 36px;
        }

        .select2-container--default.select2-container--focus .select2-selection--single {
            border-color: #0d6efd;
            box-shadow: 0 0 0 0.2rem rgba(13, 110, 253, 0.25);
        }

        .select2-container--default .select2-selection--single.select2-selection--disabled {
            background-color: #f8f9fa;
            border-color: #dee2e6;
        }

        .swal2-popup {
            border-radius: 15px !important;
            padding: 2rem !important;
        }

        .swal2-icon.swal2-error {
            border-color: #f27474 !important;
            color: #f27474 !important;
        }

            .swal2-icon.swal2-error .swal2-x-mark {
                display: none !important;
            }

            .swal2-icon.swal2-error::before {
                content: "\f2ed" !important;
                font-family: "Font Awesome 5 Free" !important;
                font-weight: 900 !important;
                font-size: 2.5rem !important;
                color: #f27474 !important;
                display: block !important;
            }

        .swal2-title {
            font-size: 1.875rem !important;
            font-weight: 600 !important;
            color: #545454 !important;
            margin: 1rem 0 0.5rem 0 !important;
        }

        .swal2-html-container {
            font-size: 1rem !important;
            color: #737373 !important;
            margin: 0 0 2rem 0 !important;
        }

        .swal2-actions {
            gap: 0.5rem !important;
        }

        .swal2-confirm {
            background-color: #7c3aed !important;
            border-color: #7c3aed !important;
            color: white !important;
            font-weight: 500 !important;
            padding: 0.75rem 2rem !important;
            border-radius: 8px !important;
            font-size: 0.875rem !important;
        }

        .swal2-cancel {
            background-color: #6b7280 !important;
            border-color: #6b7280 !important;
            color: white !important;
            font-weight: 500 !important;
            padding: 0.75rem 2rem !important;
            border-radius: 8px !important;
            font-size: 0.875rem !important;
        }

        .swal2-confirm:hover {
            background-color: #6d28d9 !important;
            border-color: #6d28d9 !important;
        }

        .swal2-cancel:hover {
            background-color: #4b5563 !important;
            border-color: #4b5563 !important;
        }

        .status-badge {
            display: inline-block;
            padding: 0.35rem 0.65rem;
            font-size: 0.75rem;
            font-weight: 600;
            line-height: 1;
            text-align: center;
            white-space: nowrap;
            vertical-align: baseline;
            border-radius: 0.25rem;
        }

        .status-pending {
            background-color: #ffc107;
            color: #000;
        }

        .status-approved {
            background-color: #28a745;
            color: #fff;
        }

        .status-declined {
            background-color: #dc3545;
            color: #fff;
        }

        .status-cancelled {
            background-color: #6c757d;
            color: #fff;
        }

        .status-processed {
            background-color: #17a2b8;
            color: #fff;
        }

        .card-header {
            border-bottom: none !important;
        }

        #btnCancelOffsetRequest {
            background-color: #6c757d !important;
            border-color: #6c757d !important;
            color: white !important;
        }

            #btnCancelOffsetRequest:hover {
                background-color: #5a6268 !important;
                border-color: #545b62 !important;
            }

        .status-partial {
            background-color: #fd7e14;
            color: #fff;
        }
    </style>
}

@section Fillow_script
{
    <script>
        $(document).ready(function () {
            // CONFIGURATION
            MODULE = 'RoffsetCreditM';
            access = ROLE_ACCESS?.[MODULE];

            let canEditEmployee = false;
            let currentEmployeeData = null;
            let isApprover = false;

            $.get('/OffsetCreditRequest/GetCurrentEmployee', function(data) {
                canEditEmployee = data.canEditEmployee;
                currentEmployeeData = data.currentEmployee;
                isApprover = data.isApprover;
            });

            if (access != 'READWRITE' && access != 'FULL') {
                $('#btnAddOffsetRequest').hide();
                $('#btnEditOffsetRequest').hide();
                $('#btnApproveOffsetRequest').hide();
            }

            const config = {
                toastr: { positionClass: "toast-top-right", timeOut: 5000, closeButton: true, progressBar: true, preventDuplicates: true },
                endpoints: {
                    list:       "/OffsetCreditRequest/GetOffsetCreditRequestList",
                    get:        "/OffsetCreditRequest/GetOffsetCreditRequest",
                    employees:  "/OffsetCreditRequest/GetEmployeeList",
                    ctoBalance: "/OffsetCreditRequest/GetCTOBalance",
                    add:        "/OffsetCreditRequest/AddOffsetCreditRequest",
                    update:     "/OffsetCreditRequest/UpdateOffsetCreditRequest",
                    approve:    "/OffsetCreditRequest/ApproveOffsetCreditRequest",
                    decline:    "/OffsetCreditRequest/DeclineOffsetCreditRequest",
                    cancel:     "/OffsetCreditRequest/CancelOffsetCreditRequest"
                }
            };

            toastr.options = config.toastr;
            let isInitialLoad = true;

            // INITIALIZATION
            // Earliest allowed date = today minus 3 calendar days
            var minOffsetDate = (access === 'FULL') ? null : new Date();
            if (minOffsetDate) minOffsetDate.setDate(minOffsetDate.getDate() - 3);

            $('#dateFrom, #dateTo').datepicker({
                format: 'mm/dd/yyyy',
                autoclose: true,
                todayHighlight: true
            });

            $('#addDateIn, #addDateOut, #viewDateIn, #viewDateOut').datepicker({
                format: 'mm/dd/yyyy',
                autoclose: true,
                todayHighlight: true,
                startDate: minOffsetDate
            });

            $('#filterStatusName').val('Pending');
            initializeSelect2();
            initializeFilterSelect2();

            // DATATABLE CONFIGURATION
            const table = $('#offsetRequestTable').DataTable({
                processing: true,
                serverSide: false,
                ajax: {
                    url: config.endpoints.list,
                    type: "GET",
                    data: d => ({
                        status:     isInitialLoad ? 'Default' : $('#filterStatusName').val(),
                        branch:     $('#filterBranch').val(),
                        department: $('#filterDepartment').val(),
                        dateFrom:   $('#dateFrom').val(),
                        dateTo:     $('#dateTo').val()
                    }),
                    dataSrc: function (json) { isInitialLoad = false; return json.data; },
                    error: () => showNotification('Error loading data. Please refresh the page.', 'error')
                },
                columns: [
                    {
                        data: null, width: "10%", orderable: false,
                        render: (data, type, row) => {
                            let viewBtn = '';
                            let declineBtn = '';

                            if (access === 'READ' || access === 'READWRITE' || access === 'FULL') {
                                viewBtn = `<button class="btn btn-sm btn-primary shadow-sm viewOffsetRequest" data-id="${row.id}" title="View"><i class="fas fa-eye"></i></button>`;
                            }
                            const displayStatus = computeDisplayStatus(row);
                            if (['Pending', 'Partially Approved', 'Approved'].includes(displayStatus) && row.employeeNo !== sessemployeeNo && (access === 'FULL' || isApprover)) {
                                declineBtn = `<button class="btn btn-sm btn-danger shadow-sm declineOffsetRequest" data-id="${row.id}" title="Decline"><i class="fas fa-times"></i></button>`;
                            }
                            return `<div class="d-flex gap-1">${viewBtn}${declineBtn}</div>`;
                        }
                    },
                    {
                        data: null, width: "5%", orderable: false,
                        render: function (data, type, row) {
                            return `<button class="btn btn-sm btn-warning shadow-sm printOffsetRequest"
                                            data-id="${row.id}" title="Print PDF">
                                        <i class="fas fa-print"></i>
                                    </button>`;
                        }
                    },
                    { data: "employeeName",  width: "15%", render: data => data || '' },
                    { data: "displayDateIn",  width: "12%", render: data => data || '' },
                    { data: "displayDateOut", width: "12%", render: data => data || '' },
                    { data: "overTimeReason", width: "21%", render: data => !data ? '' : (data.length > 80 ? data.substring(0, 80) + '...' : data) },
                    { data: "dateRequested",  width: "10%", render: data => data || '' },
                    {
                        data: null, width: "10%",
                        render: function(data, type, row) {
                            const displayStatus = computeDisplayStatus(row);
                            const statusMap = {
                                'Approved':           'status-approved',
                                'Declined':           'status-declined',
                                'Cancelled':          'status-cancelled',
                                'Processed':          'status-processed',
                                'Partially Approved': 'status-partial'
                            };
                            const statusClass = statusMap[displayStatus] || 'status-pending';
                            return `<span class="status-badge ${statusClass}">${displayStatus}</span>`;
                        }
                    },
                    { data: "requestedByUser", width: "12%", render: data => data || '' }
                ],
                order: [],
                pageLength: 25,
                lengthMenu: [[10, 25, 50, 100, -1], [10, 25, 50, 100, "All"]],
                language: {
                    processing:  "Loading...",
                    emptyTable:  "No offset credit requests found",
                    zeroRecords: "No matching offset credit requests found",
                    paginate: { next: '<i class="fa fa-angle-double-right"></i>', previous: '<i class="fa fa-angle-double-left"></i>' }
                }
            });

            // EVENT HANDLERS - FILTERS
            $('#filterStatusName, #filterBranch, #filterDepartment, #dateFrom, #dateTo')
                .on('change', () => table.ajax.reload(null, false));

            // HELPER: Compute display status
            function computeDisplayStatus(row) {
                const l4 = row.statusLevel4 || row.statusName;
                const l3 = row.statusLevel3;
                const l2 = row.statusLevel2;
                const l1 = row.statusLevel1;

                if (l4 === 'Processed') return 'Processed';
                if (l4 === 'Approved')  return 'Approved';
                if (l4 === 'Declined')  return 'Declined';
                if (l4 === 'Cancelled') return 'Cancelled';

                if (l3 === 'Declined' || l2 === 'Declined' || l1 === 'Declined') return 'Declined';
                if (l3 === 'Approved' || l2 === 'Approved' || l1 === 'Approved') return 'Partially Approved';

                return 'Pending';
            }

            // HELPER: Convert mm/dd/yyyy → yyyy-mm-dd
            function toISODate(mmddyyyy) {
                if (!mmddyyyy) return '';
                const [m, d, y] = mmddyyyy.split('/');
                return `${y}-${m.padStart(2, '0')}-${d.padStart(2, '0')}`;
            }

            // ── HELPER: Compute offset days from dates + time in/out ───────────────
            // Same rule as server: days = (dateOut - dateIn).Days + 1
            // hoursPerDay = timeOut - timeIn (minus 1hr lunch if span crosses 12:00 PM)
            // offsetDays = (hoursPerDay * days) / 8
            function computeDaysFromDates(dateInStr, dateOutStr, timeInStr, timeOutStr) {
                if (!dateInStr || !dateOutStr || !timeInStr || !timeOutStr) return null;
                const dateIn  = new Date(toISODate(dateInStr));
                const dateOut = new Date(toISODate(dateOutStr));
                if (isNaN(dateIn) || isNaN(dateOut)) return null;

                const diffMs   = dateOut - dateIn;
                const diffDays = Math.round(diffMs / (1000 * 60 * 60 * 24));
                if (diffDays < 0) return null;
                const numDays = diffDays + 1;

                const [inH, inM]   = timeInStr.split(':').map(Number);
                const [outH, outM] = timeOutStr.split(':').map(Number);
                let hoursPerDay = (outH + outM / 60) - (inH + inM / 60);
                if (hoursPerDay <= 0) return null;

                const crossesNoon = (inH + inM / 60) < 12 && (outH + outM / 60) > 12;
                if (crossesNoon) hoursPerDay -= 1;
                if (hoursPerDay < 0) hoursPerDay = 0;

                return (hoursPerDay * numDays) / 8;
            }

