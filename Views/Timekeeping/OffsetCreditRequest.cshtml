            function setEditMode() {
                $('#viewModalTitle').text('Edit Offset Credit Request');
                $('#viewOffsetRequestModal .modal-body').addClass('edit-mode');

                if (canEditEmployee) {
                    $('#viewEmployeeName').prop('disabled', false);
                } else {
                    $('#viewEmployeeName').prop('disabled', true);
                }

                $('#viewDateIn, #viewDateOut').prop('readonly', false)
                    .datepicker({ format: 'mm/dd/yyyy', autoclose: true, todayHighlight: true, startDate: minOffsetDate });
                $('#viewTimeIn, #viewTimeOut, #viewReason, #viewRemarks').prop('readonly', false);
                $('.edit-required').removeClass('d-none');
                $('#btnApproveOffsetRequest, #btnEditOffsetRequest').addClass('d-none');
                $('#btnSaveOffsetRequest, #btnCancelEdit').removeClass('d-none');
            }

            // ── VALIDATION ────────────────────────────────────────────────────────
            function validateForm(formSelector, fields) {
                clearValidation(formSelector);
                let isValid = true;
                fields.forEach(field => {
                    if (!$(`#${field}`).val()) {
                        $(`#${field}`).addClass('is-invalid');
                        isValid = false;
                    }
                });
                return isValid;
            }

            function validateDates(dateInSelector, dateOutSelector) {
                if ($(dateInSelector).val() && $(dateOutSelector).val()) {
                    const dateIn  = new Date(toISODate($(dateInSelector).val()));
                    const dateOut = new Date(toISODate($(dateOutSelector).val()));
                    if (dateOut < dateIn) {
                        $(dateOutSelector).addClass('is-invalid');
                        showNotification('Offset Date Out cannot be earlier than Offset Date In', 'error');
                        return false;
                    }
                }
                return true;
            }

            function clearValidation(formSelector) {
                $(`${formSelector} .form-control, ${formSelector} .form-select`).removeClass('is-invalid');
            }

            // ── UI UTILITIES ──────────────────────────────────────────────────────
            function toggleButtonLoading($btn, loading, text = '') {
                if (loading) {
                    if (!$btn.data('original-html')) $btn.data('original-html', $btn.html());
                    const icon = '<i class="fas fa-spinner fa-spin"></i>';
                    $btn.prop('disabled', true).html(text ? `${icon} ${text}` : icon);
                } else {
                    const originalHtml = $btn.data('original-html') || 'Save';
                    $btn.prop('disabled', false).html(originalHtml).removeData('original-html');
                }
            }

            function showNotification(message, type) {
                const types = { success: 'Success', error: 'Error', warning: 'Warning', info: 'Information' };
                toastr[type](message, types[type] || 'Notification');
            }

            validationinputs();
        });
    </script>
}