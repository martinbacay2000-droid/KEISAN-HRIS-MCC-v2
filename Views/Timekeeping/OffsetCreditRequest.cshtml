            function resetAllButtons() {
                $('#btnApproveOffsetRequest').prop('disabled', false).html('<i class="fas fa-check"></i> Approve');
                $('#btnEditOffsetRequest').prop('disabled', false).html('<i class="fas fa-edit"></i> Edit');
