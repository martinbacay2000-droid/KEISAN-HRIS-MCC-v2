            // ── HELPER: CTO Balance Tracker ───────────────────────────────────────
            function loadCTOBalanceTracker(employeeNo, targetSelector) {
                if (!employeeNo) {
                    $(targetSelector).html(`
                        <div class="alert alert-info mb-0">
                            <i class="fas fa-info-circle"></i> <strong>CTO Balance:</strong> Select an employee to view balance
                        </div>
                    `);
                    return;
                }

                $.get(config.endpoints.ctoBalance, { employeeNo }, function(data) {
                    if (data && data.success) {
                        const totalEarned      = data.totalEarned || 0;
                        const totalUsed        = data.totalUsed || 0;
                        const availableBalance = data.availableBalance || 0;

                        const alertClass = availableBalance <= 0 ? 'alert-warning' : 'alert-success';
                        const icon       = availableBalance <= 0 ? 'fa-info-circle' : 'fa-check-circle';

                        $(targetSelector).html(`
                            <div class="alert ${alertClass} mb-0">
                                <i class="fas ${icon}"></i>
                                <strong>CTO Balance:</strong>
                                Total Earned: <strong>${totalEarned.toFixed(2)} days</strong> |
                                Total Used: ${totalUsed.toFixed(2)} days |
                                Available: <strong>${availableBalance.toFixed(2)} days</strong>
                                <div id="ctoUsageWarning" class="mt-1"></div>
                            </div>
                        `);
                    } else {
                        $(targetSelector).html(`
                            <div class="alert alert-danger mb-0">
                                <i class="fas fa-exclamation-triangle"></i> Error loading CTO balance
                            </div>
                        `);
                    }
                }).fail(function() {
                    $(targetSelector).html(`
                        <div class="alert alert-danger mb-0">
                            <i class="fas fa-exclamation-triangle"></i> Error loading CTO balance
                        </div>
                    `);
                });
            }

            // ── HELPER: CTO Usage Indicator ───────────────────────────────────────
            // Uses date-only computation: same day = 1 day, next day = 2 days, etc.
            function updateCTOUsageIndicator(trackerSelector) {
                const isAddModal = trackerSelector === '#addCTOBalanceTracker';
                const dateIn     = isAddModal ? $('#addDateIn').val()  : $('#viewDateIn').val();
                const dateOut    = isAddModal ? $('#addDateOut').val() : $('#viewDateOut').val();
                const timeIn     = isAddModal ? $('#addTimeIn').val()  : $('#viewTimeIn').val();
                const timeOut    = isAddModal ? $('#addTimeOut').val() : $('#viewTimeOut').val();

                if (!dateIn || !dateOut || !timeIn || !timeOut) return;

                const totalDays = computeDaysFromDates(dateIn, dateOut, timeIn, timeOut);

                const warningDiv = $(trackerSelector).find('#ctoUsageWarning');

                if (totalDays === null || totalDays <= 0) {
                    warningDiv.html(`
                        <small class="text-danger">
                            <i class="fas fa-times-circle"></i>
                            Invalid date range. Offset Date Out cannot be before Offset Date In.
                        </small>
                    `);
                    return;
                }

                // Get available balance from tracker text
                const trackerText     = $(trackerSelector).find('.alert').text();
                const availableMatch  = trackerText.match(/Available:\s*([\d.]+)\s*days/);
                const availableBalance = availableMatch ? parseFloat(availableMatch[1]) : 0;

                // In edit mode, availableBalance already includes this request's
                // original earned days — subtract them first to avoid double-counting
                const originalDays = isAddModal ? 0 : (parseFloat($('#viewOriginalOffsetDays').val()) || 0);

                const newBalance = availableBalance - originalDays + totalDays;

                warningDiv.html(`
                    <small class="text-success">
                        <i class="fas fa-check-circle"></i>
                        Will earn <strong>${totalDays.toFixed(2)} days</strong> of CTO.
                        New balance will be: <strong>${newBalance.toFixed(2)} days</strong>
                    </small>
                `);
            }

            // ── HELPER: Form management ───────────────────────────────────────────
            function populateViewForm(data) {
                $('#viewOffsetRequestId').val(data.id);
                $('#viewOffsetRequestStatus').val(data.statusLevel4 || data.statusName);
                $('#viewEmployeeName').val(data.employeeNo).trigger('change');
                $('#viewDateIn').val(data.displayDateIn);
                $('#viewDateOut').val(data.displayDateOut);
                $('#viewTimeIn').val(data.displayTimeIn);
                $('#viewTimeOut').val(data.displayTimeOut);
                $('#viewReason').val(data.overTimeReason);
                $('#viewRemarks').val(data.remarks);

                // Remember this request's currently-earned days so the live preview
                // can subtract it before adding the newly computed days (avoids double count)
                const originalDays = data.approvedRenderOT ? (Number(data.approvedRenderOT) / 8) : 0;
                $('#viewOriginalOffsetDays').val(originalDays);

                loadCTOBalanceTracker(data.employeeNo, '#viewCTOBalanceTracker');
                renderApprovalProgress(data);
            }

            function renderApprovalProgress(data) {
                const $progress = $('#approvalProgress');
                const $steps    = $('#approvalSteps');
                $steps.empty();

                const overall = data.statusLevel4 || data.statusName;

                if (overall === 'Cancelled' || overall === 'Processed') { $progress.addClass('d-none'); return; }

                const required = data.requiredLevels || [];
                if (required.length === 0) { $progress.addClass('d-none'); return; }

                const levelStatus = { 1: data.statusLevel1, 2: data.statusLevel2, 3: data.statusLevel3, 4: data.statusLevel4 };

                required.forEach(function(level) {
                    const st = levelStatus[level] || 'Pending';
                    let badgeClass, icon;

                    switch (st) {
                        case 'Approved': badgeClass = 'bg-success'; icon = 'fa-check-circle';  break;
                        case 'Declined': badgeClass = 'bg-danger';  icon = 'fa-times-circle';  break;
                        default:         badgeClass = 'bg-warning'; icon = 'fa-clock';
                    }

                    $steps.append(`
                        <span class="badge ${badgeClass} fs-6 px-3 py-2">
                            <i class="fas ${icon} me-1"></i>Level ${level}: ${st}
                        </span>
                        ${required.indexOf(level) < required.length - 1
                            ? '<i class="fas fa-arrow-right align-self-center text-muted"></i>'
                            : ''}
                    `);
                });

                $progress.removeClass('d-none');
            }

            function saveRequest(url, data, buttonSelector, closeModal) {
                const $btn = $(buttonSelector);
                toggleButtonLoading($btn, true, 'Saving...');
                $.ajax({
                    url, type: 'POST', data, processData: false, contentType: false,
                    success: response => {
                        if (response.success) {
                            if (closeModal) $('#addOffsetRequestModal').modal('hide');
                            else setViewMode();
                            table.ajax.reload(null, false);
                            showNotification(response.message, 'success');
                        } else {
                            showNotification(response.message, 'error');
                        }
                    },
                    error:    () => showNotification('Unable to save. Please try again.', 'error'),
                    complete: () => toggleButtonLoading($btn, false)
                });
            }

            function updateViewButtons(data) {
                const isFullObject = (typeof data === 'object' && data !== null);
                const status       = isFullObject ? (data.statusLevel4 || data.statusName) : data;

                $('#btnApproveOffsetRequest, #btnEditOffsetRequest, #btnCancelOffsetRequest').addClass('d-none');
                $('#btnSaveOffsetRequest, #btnCancelEdit').addClass('d-none');

                const requestEmployeeNo = isFullObject ? data.employeeNo : $('#viewEmployeeName').val();
                const isOwnRequest      = requestEmployeeNo === sessemployeeNo;

                if (status === 'Cancelled' || status === 'Approved' || status === 'Processed') return;

                if (status === 'Declined') {
                    if (isOwnRequest || access === 'FULL')
                        $('#btnEditOffsetRequest, #btnCancelOffsetRequest').removeClass('d-none');
                    return;
                }

                if (isFullObject && typeof data.canCurrentUserApprove !== 'undefined') {
                    if (data.canCurrentUserApprove) $('#btnApproveOffsetRequest').removeClass('d-none');
                } else {
                    if (access === 'FULL') $('#btnApproveOffsetRequest').removeClass('d-none');
                }

                if (isOwnRequest || access === 'FULL')
                    $('#btnEditOffsetRequest, #btnCancelOffsetRequest').removeClass('d-none');
            }

