                $('#addEmployeeName').val(null).trigger('change');
                $('#addRemainingDays, #addTotalDays').val('');
                $('#addCTOBalanceTable tbody').html('<tr><td colspan="2" class="text-center text-muted">Select an employee first</td></tr>');
                $('input[name="addLeaveDuration"][value="whole"]').prop('checked', true);
                clearValidation('#addOffsetApplicationForm');
                $('#btnSaveNewOffsetApplication').prop('disabled', false).html('Save');
            }

            function resetViewForm() {
                $('#viewOffsetApplicationForm')[0].reset();
                $('#viewEmployeeName').val(null).trigger('change');
                $('#currentAttachments').empty();
                $('#viewRemainingDays, #viewTotalDays').val('');
                $('#viewCTOBalanceTable tbody').html('<tr><td colspan="2" class="text-center text-muted">No data</td></tr>');
                $('input[name="viewLeaveDuration"][value="whole"]').prop('checked', true);
                clearValidation('#viewOffsetApplicationForm');
                $('#btnSaveOffsetApplication').prop('disabled', false).html('Save');
                $('#approvalProgress').addClass('d-none');   // ← ADD THIS
                $('#approvalSteps').empty();                  // ← ADD THIS
            }

            function resetAllButtons() {
                $('#btnApproveOffsetApplication').prop('disabled', false).html('<i class="fas fa-check"></i> Approve');
                $('#btnEditOffsetApplication').prop('disabled', false).html('<i class="fas fa-edit"></i> Edit');
                $('#btnCancelOffsetApplication').prop('disabled', false).html('<i class="fas fa-ban"></i> Cancel Request');
            }

            function setViewMode() {
                $('#viewModalTitle').text('View Offset Application Request');
                $('#viewOffsetApplicationModal .modal-body').removeClass('edit-mode');
                $('#viewEmployeeName').prop('disabled', true);
                $('#viewDateFrom, #viewDateTo').datepicker('destroy').prop('readonly', true);
                $('#viewReason, #viewRemarks').prop('readonly', true);
                $('input[name="viewLeaveDuration"]').prop('disabled', true);
                $('.edit-required, #viewAttachment, .edit-mode-only, #btnSaveOffsetApplication, #btnCancelEdit').addClass('d-none');
                updateViewButtons($('#viewOffsetApplicationStatus').val());
                clearValidation('#viewOffsetApplicationForm');
            }

            function setEditMode() {
                $('#viewModalTitle').text('Edit Offset Application Request');
                $('#viewOffsetApplicationModal .modal-body').addClass('edit-mode');
                if (canEditEmployee) $('#viewEmployeeName').prop('disabled', false);
                $('#viewDateFrom, #viewDateTo').prop('readonly', false).datepicker({ format: 'mm/dd/yyyy', autoclose: true, todayHighlight: true, startDate: minCTODate });
                $('#viewReason, #viewRemarks').prop('readonly', false);
                $('input[name="viewLeaveDuration"]').prop('disabled', false);
                $('.edit-required, #viewAttachment, .edit-mode-only, #btnSaveOffsetApplication, #btnCancelEdit').removeClass('d-none');
                $('#btnApproveOffsetApplication, #btnEditOffsetApplication').addClass('d-none');
            }

            function validateForm(formSel, fields) {
                clearValidation(formSel);
                let valid = true;
                fields.forEach(f => { if (!$(`#${f}`).val()) { $(`#${f}`).addClass('is-invalid'); valid = false; } });
                return valid;
            }

            function validateDates(dfSel, dtSel) {
                if ($(dfSel).val() && $(dtSel).val()) {
                    if (new Date($(dtSel).val()) < new Date($(dfSel).val())) {
                        $(dtSel).addClass('is-invalid');
                        showNotification('Date To cannot be earlier than Date From', 'error');
                        return false;
                    }
                }
                return true;
            }

            function validateCTOBalance(remSel, reqSel) {
                const rem = parseFloat($(remSel).val()) || 0, req = parseFloat($(reqSel).val()) || 0;
                if (req > rem) {
                    showNotification(`Insufficient CTO balance. Available: ${rem.toFixed(2)}, Requested: ${req.toFixed(1)}`, 'error');
                    return false;
                }
                return true;
            }

            function clearValidation(formSel) {
                $(`${formSel} .form-control, ${formSel} .form-select`).removeClass('is-invalid');
            }

            function toggleButtonLoading($btn, loading, text = '') {
                if (loading) {
                    if (!$btn.data('original-html')) $btn.data('original-html', $btn.html());
                    $btn.prop('disabled', true).html((text ? '<i class="fas fa-spinner fa-spin"></i> ' : '<i class="fas fa-spinner fa-spin"></i>') + text);
                } else {
                    $btn.prop('disabled', false).html($btn.data('original-html') || 'Save').removeData('original-html');
                }
            }

            function showNotification(msg, type) {
                const types = { success: 'Success', error: 'Error', warning: 'Warning', info: 'Information' };
                toastr[type](msg, types[type] || 'Notification');
            }

            function toISODate(mmddyyyy) {
                if (!mmddyyyy) return '';
                const [m, d, y] = mmddyyyy.split('/');
                return `${y}-${m.padStart(2, '0')}-${d.padStart(2, '0')}`;
            }

            function formatLeaveType(type) {
                return { 'whole': 'Whole Day', 'first': 'First Half', 'second': 'Second Half' }[type] || type;
            }

            validationinputs();
        });
    </script>
}