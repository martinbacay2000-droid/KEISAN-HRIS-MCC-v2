@{
    Layout = "~/Views/Shared/_LayoutFillow.cshtml";
    ViewData["Title"] = "Offset Application Request (CTO)";
}

<div class="col-12">
    <div class="card">
        <div class="card-header">
            <div class="row" style="width:100%;">
                <h4 class="card-title">Offset Application Request (CTO)</h4>
                <br> <br> <br>

                <div class="row date-range" style="margin-left:0px;width:100%;">
                    <div class="col-md-3">
                        <div class="form-group">
                            <h5>Select Status</h5>
                            <select name="filterStatusName" id="filterStatusName" class="form-control">
                                <option value="All">ALL</option>
                                <option value="Pending">Pending</option>
                                <option value="Approved">Approved</option>
                                <option value="Cancelled">Cancelled</option>
                                <option value="Declined">Declined</option>
                                <option value="Processed">Processed</option>
                            </select>
                        </div>
                    </div>
                    <div class="col-md-3">
                        <label>Date From </label>
                        <div class="input-hasicon">
                            <input name="dateFrom" id="dateFrom" class="form-control formInput date-from" placeholder="mm/dd/yyyy">
                            <div class="icon"><i class="far fa-calendar"></i></div>
                        </div>
                    </div>
                    <div class="col-md-3">
                        <label>Date To </label>
                        <div class="input-hasicon">
                            <input name="dateTo" id="dateTo" class="form-control formInput date-to" placeholder="mm/dd/yyyy">
                            <div class="icon"><i class="far fa-calendar"></i></div>
                        </div>
                    </div>
                </div>

                <div class="row align-items-end mt-2" style="margin-left:0px;width:100%;">
                    <div class="col-md-3">
                        <div class="form-group">
                            <h5>Branch</h5>
                            <select name="branch" id="filterBranch" class="form-control"></select>
                        </div>
                    </div>
                    <div class="col-md-3">
                        <div class="form-group">
                            <h5>Department</h5>
                            <select name="department" id="filterDepartment" class="form-control"></select>
                        </div>
                    </div>
                    <div class="col-md-6 d-flex justify-content-end">
                        <div class="form-group me-2">
                            <button type="button" class="btn btn-warning" id="btnExportToExcel">
                                <i class="fas fa-file-excel"></i> Export to Excel
                            </button>
                        </div>
                        <div class="form-group">
                            <button type="button" class="btn btn-primary" id="btnAddOffsetApplication">
                                <i class="fa fa-plus"></i> New Offset Application
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="card-body">
            <div class="table-responsive">
                <table id="offsetApplicationTable" class="display" style="min-width: 845px">
                    <thead>
                        <tr>
                            <th>Action</th>
                            <th>Control</th>
                            <th>Employee Name</th>
                            <th>Leave Type</th>
                            <th>Date From</th>
                            <th>Date To</th>
                            <th>Days</th>
                            <th>Type</th>
                            <th>Reason</th>
                            <th>Attached File</th>
                            <th>Status</th>
                            <th>Requested By</th>
                        </tr>
                    </thead>
                </table>
            </div>
        </div>

        <!-- Modal for Add -->
        <div class="modal fade" id="addOffsetApplicationModal" tabindex="-1" aria-hidden="true">
            <div class="modal-dialog modal-xl">
                <div class="modal-content">
                    <div class="modal-header">
                        <h5 class="modal-title">Add Offset Application Request (CTO)</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                    </div>
                    <div class="modal-body">
                        <div class="row">
                            <!-- LEFT COLUMN -->
                            <div class="col-lg-8">
                                <form id="addOffsetApplicationForm">
                                    <div class="row">
                                        <div class="col-md-12 mb-3">
                                            <label for="addEmployeeName" class="form-label">Employee Name <span class="text-danger">*</span></label>
                                            <select class="form-select" id="addEmployeeName" name="employeeNo" style="width:100%" required>
                                                <option value="">Select Employee...</option>
                                            </select>
                                            <div class="invalid-feedback">Please select an employee.</div>
                                        </div>
                                    </div>

                                    <div class="row">
                                        <div class="col-md-12 mb-3">
                                            <label for="addRemainingDays" class="form-label">Available CTO Balance</label>
                                            <input type="text" class="form-control" id="addRemainingDays" readonly style="background-color: #f8f9fa;">
                                            <small class="text-muted">This is your earned CTO credits from offset credit requests</small>
                                        </div>
                                    </div>

                                    <div class="row date-range">
                                        <div class="col-md-6 mb-3">
                                            <label>Date From <span class="text-danger">*</span></label>
                                            <div class="input-hasicon">
                                                <input name="addDateFrom" id="addDateFrom" class="form-control formInput date-from" placeholder="mm/dd/yyyy" required>
                                                <div class="icon"><i class="far fa-calendar"></i></div>
                                            </div>
                                            <div class="invalid-feedback">Please select date from.</div>
                                        </div>
                                        <div class="col-md-6 mb-3">
                                            <label>Date To <span class="text-danger">*</span></label>
                                            <div class="input-hasicon">
                                                <input name="addDateTo" id="addDateTo" class="form-control formInput date-to" placeholder="mm/dd/yyyy" required>
                                                <div class="icon"><i class="far fa-calendar"></i></div>
                                            </div>
                                            <div class="invalid-feedback">Please select date to.</div>
                                        </div>
                                    </div>

                                    <div class="row">
                                        <div class="col-md-12 mb-3">
                                            <label class="form-label">Leave Duration <span class="text-danger">*</span></label>
                                            <div class="form-check form-check-inline">
                                                <input class="form-check-input" type="radio" name="addLeaveDuration" id="addWholeDayRadio" value="whole" checked>
                                                <label class="form-check-label" for="addWholeDayRadio">Whole Day</label>
                                            </div>
                                            <div class="form-check form-check-inline">
                                                <input class="form-check-input" type="radio" name="addLeaveDuration" id="addFirstHalfRadio" value="first">
                                                <label class="form-check-label" for="addFirstHalfRadio">First Half</label>
                                            </div>
                                            <div class="form-check form-check-inline">
                                                <input class="form-check-input" type="radio" name="addLeaveDuration" id="addSecondHalfRadio" value="second">
                                                <label class="form-check-label" for="addSecondHalfRadio">Second Half</label>
                                            </div>
                                        </div>
                                    </div>

                                    <div class="row">
                                        <div class="col-md-12 mb-3">
                                            <label for="addTotalDays" class="form-label">Total Requested Days</label>
                                            <input type="text" class="form-control" id="addTotalDays" readonly style="background-color: #f8f9fa;">
                                        </div>
                                    </div>

                                    <div class="row">
                                        <div class="col-md-12 mb-3">
                                            <label for="addReason" class="form-label">Reason Details <span class="text-danger">*</span></label>
                                            <textarea class="form-control" id="addReason" name="leaveReason" rows="3" required maxlength="500" placeholder="Enter reason for using CTO..."></textarea>
                                            <div class="invalid-feedback">Please provide reason details.</div>
                                        </div>
                                    </div>

                                    <div class="mb-3">
                                        <label for="addRemarks" class="form-label">Remarks</label>
                                        <textarea class="form-control" id="addRemarks" name="remarks" rows="2" maxlength="1000"></textarea>
                                    </div>

                                    <div class="mb-3">
                                        <label for="addAttachment" class="form-label">Attachment</label>
                                        <input type="file" class="form-control" id="addAttachment" name="attachment" accept=".pdf,.jpg,.jpeg,.png,.doc,.docx">
                                        <small class="text-muted">Allowed formats: PDF, JPG, PNG, DOC, DOCX (Max: 5MB)</small>
                                    </div>
                                </form>
                            </div>

                            <!-- RIGHT COLUMN - CTO Balance Table -->
                            <div class="col-lg-4">
                                <h5 class="form-label">CTO Balance</h5>
                                <div class="table-responsive">
                                    <table id="addCTOBalanceTable" class="table table-sm table-bordered">
                                        <thead class="table-light">
                                            <tr>
                                                <th>CTO Type</th>
                                                <th>Balance</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            <tr>
                                                <td colspan="2" class="text-center text-muted">Select an employee first</td>
                                            </tr>
                                        </tbody>
                                    </table>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-primary" id="btnSaveNewOffsetApplication">Save</button>
                    </div>
                </div>
            </div>
        </div>

        <!-- Modal for View/Edit -->
        <div class="modal fade" id="viewOffsetApplicationModal" tabindex="-1" aria-hidden="true">
            <div class="modal-dialog modal-xl">
                <div class="modal-content">
                    <div class="modal-header">
                        <h5 class="modal-title" id="viewModalTitle">View Offset Application Request</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                    </div>
                    <div class="modal-body">
                        <div class="row">
                            <!-- LEFT COLUMN -->
                            <div class="col-lg-8">
                                <form id="viewOffsetApplicationForm">
                                    <input type="hidden" id="viewOffsetApplicationId" name="id">
                                    <input type="hidden" id="viewOffsetApplicationStatus" name="statusName">

                                    <div class="row">
                                        <div class="col-md-12 mb-3">
                                            <label for="viewEmployeeName" class="form-label">Employee Name <span class="text-danger edit-required d-none">*</span></label>
                                            <select class="form-select" id="viewEmployeeName" name="employeeNo" style="width:100%" disabled>
                                                <option value="">Select Employee...</option>
                                            </select>
                                            <div class="invalid-feedback">Please select an employee.</div>
                                        </div>
                                    </div>

                                    <div class="row">
                                        <div class="col-md-12 mb-3">
                                            <label for="viewRemainingDays" class="form-label">Available CTO Balance</label>
                                            <input type="text" class="form-control" id="viewRemainingDays" readonly style="background-color: #f8f9fa;">
                                            <small class="text-muted">This is your earned CTO credits from offset credit requests</small>
                                        </div>
                                    </div>

                                    <div class="row date-range">
                                        <div class="col-md-6 mb-3">
                                            <label>Date From <span class="text-danger edit-required d-none">*</span></label>
                                            <div class="input-hasicon">
                                                <input name="viewDateFrom" id="viewDateFrom" class="form-control formInput date-from" placeholder="mm/dd/yyyy" readonly>
                                                <div class="icon"><i class="far fa-calendar"></i></div>
                                            </div>
                                            <div class="invalid-feedback">Please select date from.</div>
                                        </div>
                                        <div class="col-md-6 mb-3">
                                            <label>Date To <span class="text-danger edit-required d-none">*</span></label>
                                            <div class="input-hasicon">
                                                <input name="viewDateTo" id="viewDateTo" class="form-control formInput date-to" placeholder="mm/dd/yyyy" readonly>
                                                <div class="icon"><i class="far fa-calendar"></i></div>
                                            </div>
                                            <div class="invalid-feedback">Please select date to.</div>
                                        </div>
                                    </div>

                                    <div class="row">
                                        <div class="col-md-12 mb-3">
                                            <label class="form-label">Leave Duration <span class="text-danger edit-required d-none">*</span></label>
                                            <div class="form-check form-check-inline">
                                                <input class="form-check-input" type="radio" name="viewLeaveDuration" id="viewWholeDayRadio" value="whole" disabled>
                                                <label class="form-check-label" for="viewWholeDayRadio">Whole Day</label>
                                            </div>
                                            <div class="form-check form-check-inline">
                                                <input class="form-check-input" type="radio" name="viewLeaveDuration" id="viewFirstHalfRadio" value="first" disabled>
                                                <label class="form-check-label" for="viewFirstHalfRadio">First Half</label>
                                            </div>
                                            <div class="form-check form-check-inline">
                                                <input class="form-check-input" type="radio" name="viewLeaveDuration" id="viewSecondHalfRadio" value="second" disabled>
                                                <label class="form-check-label" for="viewSecondHalfRadio">Second Half</label>
                                            </div>
                                        </div>
                                    </div>

                                    <div class="row">
                                        <div class="col-md-12 mb-3">
                                            <label for="viewTotalDays" class="form-label">Total Requested Days</label>
                                            <input type="text" class="form-control" id="viewTotalDays" readonly style="background-color: #f8f9fa;">
                                        </div>
                                    </div>

                                    <div class="row">
                                        <div class="col-md-12 mb-3">
                                            <label for="viewReason" class="form-label">Reason Details <span class="text-danger edit-required d-none">*</span></label>
                                            <textarea class="form-control" id="viewReason" name="leaveReason" rows="3" readonly maxlength="500"></textarea>
                                            <div class="invalid-feedback">Please provide reason details.</div>
                                        </div>
                                    </div>

                                    <div class="mb-3">
                                        <label for="viewRemarks" class="form-label">Remarks</label>
                                        <textarea class="form-control" id="viewRemarks" name="remarks" rows="2" maxlength="1000" readonly></textarea>
                                    </div>

                                    <div class="mb-3">
                                        <label for="viewAttachment" class="form-label">Attachment</label>
                                        <div id="currentAttachments" class="mb-2"></div>
                                        <input type="file" class="form-control d-none" id="viewAttachment" name="attachment" accept=".pdf,.jpg,.jpeg,.png,.doc,.docx">
                                        <small class="text-muted d-none edit-mode-only">Allowed formats: PDF, JPG, PNG, DOC, DOCX (Max: 5MB)</small>
                                    </div>
                                    <!-- Approval Progress Tracker -->
                                    <div id="approvalProgress" class="mt-3 d-none">
                                        <hr>
                                        <h6 class="text-muted mb-2">
                                            <i class="fas fa-tasks me-1"></i> Approval Progress
                                        </h6>
                                        <div id="approvalSteps" class="d-flex flex-wrap gap-2"></div>
                                    </div>
                                </form>
                            </div>

                            <!-- RIGHT COLUMN - CTO Balance Table -->
                            <div class="col-lg-4">
                                <h5 class="form-label">CTO Balance</h5>
                                <div class="table-responsive">
                                    <table id="viewCTOBalanceTable" class="table table-sm table-bordered">
                                        <thead class="table-light">
                                            <tr>
                                                <th>CTO Type</th>
                                                <th>Balance</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            <tr>
                                                <td colspan="2" class="text-center text-muted">No data</td>
                                            </tr>
                                        </tbody>
                                    </table>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="modal-footer d-flex justify-content-between">
                        <div>
                            <button type="button" class="btn btn-secondary btn-custom d-none" id="btnCancelOffsetApplication">
                                <i class="fas fa-ban"></i> Cancel Request
                            </button>
                        </div>
                        <div>
                            <button type="button" class="btn btn-success d-none" id="btnApproveOffsetApplication">
                                <i class="fas fa-check"></i> Approve
                            </button>
                            <button type="button" class="btn btn-primary d-none" id="btnEditOffsetApplication">
                                <i class="fas fa-edit"></i> Edit
                            </button>
                            <button type="button" class="btn btn-success d-none" id="btnSaveOffsetApplication">Save</button>
                            <button type="button" class="btn btn-danger d-none" id="btnCancelEdit">Cancel</button>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Attachment View Modal -->
        <div class="modal fade" id="attachmentModal" tabindex="-1" aria-hidden="true">
            <div class="modal-dialog modal-lg">
                <div class="modal-content">
                    <div class="modal-header">
                        <h5 class="modal-title">View Attachments</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                    </div>
                    <div class="modal-body">
                        <div id="attachmentList"></div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Fillow_style
{
    <style>
        .table-responsive {
            border-radius: 0.375rem;
        }

        #offsetApplicationTable_wrapper .dataTables_length, #offsetApplicationTable_wrapper .dataTables_filter {
            margin-bottom: 1rem;
        }

        #offsetApplicationTable_wrapper .dataTables_info, #offsetApplicationTable_wrapper .dataTables_paginate {
            margin-top: 1rem;
        }

        .btn-sm {
            padding: 0.25rem 0.5rem;
            font-size: 0.875rem;
        }

        .modal-content {
            border-radius: 0.5rem;
            box-shadow: 0 0.5rem 1rem rgba(0, 0, 0, 0.15);
        }

        .form-control:focus, .form-select:focus {
            border-color: #0d6efd;
            box-shadow: 0 0 0 0.2rem rgba(13, 110, 253, 0.25);
        }

        .form-control[readonly], .form-select[disabled] {
            background-color: #f8f9fa;
            border-color: #dee2e6;
        }

        .edit-mode .form-control[readonly]:not([id*="Remaining"]):not([id*="Total"]),
        .edit-mode .form-select[disabled] {
            background-color: #ffffff;
            border-color: #ced4da;
        }

        .edit-mode input[type="radio"][disabled] {
            pointer-events: auto;
        }

        .invalid-feedback {
            display: none;
        }

        .form-control.is-invalid, .form-select.is-invalid {
            border-color: #dc3545;
        }

            .form-control.is-invalid ~ .invalid-feedback, .form-select.is-invalid ~ .invalid-feedback {
                display: block;
            }

        .is-invalid + .select2-container .select2-selection--single {
            border-color: #dc3545;
        }

        .select2-container .select2-selection--single {
            height: 38px;
            border: 1px solid #ced4da;
            border-radius: 0.375rem;
        }

        .select2-container--default .select2-selection--single .select2-selection__rendered {
            line-height: 36px;
            padding-left: 12px;
        }

        .select2-container--default .select2-selection--single .select2-selection__arrow {
            height: 36px;
        }

        .select2-container--default.select2-container--focus .select2-selection--single {
            border-color: #0d6efd;
            box-shadow: 0 0 0 0.2rem rgba(13, 110, 253, 0.25);
        }

        .select2-container--default .select2-selection--single.select2-selection--disabled {
            background-color: #f8f9fa;
            border-color: #dee2e6;
        }

        .status-badge {
            display: inline-block;
            padding: 0.35rem 0.65rem;
            font-size: 0.75rem;
            font-weight: 600;
            line-height: 1;
            text-align: center;
            white-space: nowrap;
            vertical-align: baseline;
            border-radius: 0.25rem;
        }

        .status-pending {
            background-color: #ffc107;
            color: #000;
        }

        .status-approved {
            background-color: #28a745;
            color: #fff;
        }

        .status-declined {
            background-color: #dc3545;
            color: #fff;
        }

        .status-cancelled {
            background-color: #6c757d;
            color: #fff;
        }

        .status-processed {
            background-color: #17a2b8;
            color: #fff;
        }

        .card-header {
            border-bottom: none !important;
        }

        .attachment-item {
            display: flex;
            align-items: center;
            gap: 10px;
            padding: 8px;
            border: 1px solid #dee2e6;
            border-radius: 4px;
            margin-bottom: 5px;
            background-color: #f8f9fa;
        }

            .attachment-item a {
                text-decoration: none;
                color: #0d6efd;
            }

                .attachment-item a:hover {
                    text-decoration: underline;
                }

        #btnCancelOffsetApplication {
            background-color: #6c757d !important;
            border-color: #6c757d !important;
            color: white !important;
        }

            #btnCancelOffsetApplication:hover {
                background-color: #5a6268 !important;
                border-color: #545b62 !important;
            }

        #addCTOBalanceTable, #viewCTOBalanceTable {
            font-size: 0.875rem;
        }

            #addCTOBalanceTable thead, #viewCTOBalanceTable thead {
                position: sticky;
                top: 0;
                z-index: 1;
            }

        .status-partial {
            background-color: #fd7e14;
            color: #fff;
        }
    </style>
}

@section Fillow_script
{
    <script>
        $(document).ready(function () {
            MODULE = 'RoffsetApplicationM';
            access = ROLE_ACCESS?.[MODULE];

            let canEditEmployee = false;
            let currentEmployeeData = null;
            let isApprover = false;

            $.get('/OffsetApplicationRequest/GetCurrentEmployee', function(data) {
                canEditEmployee = data.canEditEmployee;
                currentEmployeeData = data.currentEmployee;
                isApprover = data.isApprover;
            });

            if (access != 'READWRITE' && access != 'FULL') {
                $('#btnAddOffsetApplication, #btnEditOffsetApplication, #btnApproveOffsetApplication').hide();
            }

            const config = {
                toastr: { positionClass: "toast-top-right", timeOut: 5000, closeButton: true, progressBar: true, preventDuplicates: true },
                endpoints: {
                    list: "/OffsetApplicationRequest/GetOffsetApplicationRequestList",
                    get: "/OffsetApplicationRequest/GetOffsetApplicationRequest",
                    employees: "/OffsetApplicationRequest/GetEmployeeList",
                    employeeCTOTypes: "/OffsetApplicationRequest/GetEmployeeCTOTypes",
                    calculateDays: "/OffsetApplicationRequest/CalculateLeaveDays",
                    attachments: "/OffsetApplicationRequest/GetCTOAttachments",
                    add: "/OffsetApplicationRequest/AddOffsetApplicationRequest",
                    update: "/OffsetApplicationRequest/UpdateOffsetApplicationRequest",
                    approve: "/OffsetApplicationRequest/ApproveOffsetApplicationRequest",
                    decline: "/OffsetApplicationRequest/DeclineOffsetApplicationRequest",
                    cancel: "/OffsetApplicationRequest/CancelOffsetApplicationRequest"
                }
            };

            toastr.options = config.toastr;
            let isInitialLoad = true;

            function computeDisplayStatus(row) {
                const l4 = row.statusLevel4 || row.statusName;
                const l3 = row.statusLevel3;
                const l2 = row.statusLevel2;
                const l1 = row.statusLevel1;

                if (l4 === 'Approved')  return 'Approved';
                if (l4 === 'Declined')  return 'Declined';
                if (l4 === 'Cancelled') return 'Cancelled';
                if (l4 === 'Processed') return 'Processed';

                if (l3 === 'Declined' || l2 === 'Declined' || l1 === 'Declined') return 'Declined';
                if (l3 === 'Approved' || l2 === 'Approved' || l1 === 'Approved') return 'Partially Approved';

                return 'Pending';
            }

            // Earliest allowed date = today minus 3 calendar days
            var minCTODate = (access === 'FULL') ? null : new Date();
            if (minCTODate) minCTODate.setDate(minCTODate.getDate() - 3);

            $('#dateFrom, #dateTo').datepicker({
                format: 'mm/dd/yyyy',
                autoclose: true,
                todayHighlight: true
            });

            $('#addDateFrom, #addDateTo, #viewDateFrom, #viewDateTo').datepicker({
                format: 'mm/dd/yyyy',
                autoclose: true,
                todayHighlight: true,
                startDate: minCTODate
            });

            $('#filterStatusName').val('Pending');
            initializeSelect2();
            initializeFilterSelect2();

            const table = $('#offsetApplicationTable').DataTable({
                processing: true,
                serverSide: false,
                ajax: {
                    url: config.endpoints.list,
                    type: "GET",
                    data: d => ({
                        status: isInitialLoad ? 'Default' : $('#filterStatusName').val(),
                        branch: $('#filterBranch').val(),
                        department: $('#filterDepartment').val(),
                        dateFrom: $('#dateFrom').val(),
                        dateTo: $('#dateTo').val()
                    }),
                    dataSrc: function(json) { isInitialLoad = false; return json.data; },
                    error: () => showNotification('Error loading data', 'error')
                },
                columns: [
                    { data: null, width: "10%", orderable: false, render: (data, type, row) => {
                        let viewBtn = (access === 'READ' || access === 'READWRITE' || access === 'FULL') ?
                            `<button class="btn btn-sm btn-primary shadow-sm viewOffsetApplication" data-id="${row.id}" title="View"><i class="fas fa-eye"></i></button>` : '';
                        const displayStatus = computeDisplayStatus(row);
                        let declineBtn = (['Pending', 'Partially Approved', 'Approved'].includes(displayStatus) && row.employeeNo !== sessemployeeNo && (access === 'FULL' || isApprover)) ?
                            `<button class="btn btn-sm btn-danger shadow-sm declineOffsetApplication" data-id="${row.id}" title="Decline"><i class="fas fa-times"></i></button>` : '';
                        return `<div class="d-flex gap-1">${viewBtn}${declineBtn}</div>`;
                    }},
                    { data: null, width: "5%", orderable: false, render: (data, type, row) =>
                        `<button class="btn btn-sm btn-warning shadow-sm printOffsetApplication" data-id="${row.id}" title="Print PDF"><i class="fas fa-print"></i></button>`
                    },
                    { data: "fullName", width: "15%", render: data => data || '' },
                    { data: "leaveName", width: "12%", render: data => data || 'CTO' },
                    { data: "displayDateFrom", width: "10%", render: data => data || '' },
                    { data: "displayDateTo", width: "10%", render: data => data || '' },
                    { data: "leaveCountDays", width: "6%", render: data => data || '0' },
                    { data: "leaveType", width: "8%", render: data => formatLeaveType(data) },
                    { data: "leaveReason", width: "15%", render: data => !data ? '' : (data.length > 50 ? data.substring(0, 50) + '...' : data) },
                    { data: null, width: "8%", orderable: false, render: (data, type, row) =>
                        `<button class="btn btn-sm btn-outline-primary viewAttachment" data-employee="${row.employeeNo}" title="View Attachments"><i class="fas fa-paperclip"></i></button>`
                    },
