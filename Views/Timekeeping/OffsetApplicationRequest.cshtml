                            const map = {
                                'Approved':           'status-approved',
                                'Declined':           'status-declined',
                                'Cancelled':          'status-cancelled',
                                'Processed':          'status-processed',
                                'Partially Approved': 'status-partial'
                            };
                            return `<span class="status-badge ${map[displayStatus] || 'status-pending'}">${displayStatus}</span>`;
                        }
                    },
                    { data: "requestedByUser", width: "12%", render: data => data || '' }
                ],
