                        processResults: data => ({ results: [{ id: 'ALL', text: 'All Branches' }].concat(data.map(i => ({ id: i.branchCode, text: i.branchName }))) })
                    }
                });
                $('#filterDepartment').select2({
                    placeholder: "Select Department", allowClear: true,
