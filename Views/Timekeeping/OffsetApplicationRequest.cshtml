            $('#btnExportToExcel').click(function() {
                const $btn = $(this), info = table.page.info();
                if (info.recordsDisplay === 0) return showNotification('No data to export', 'warning');

                const sortMap = ['', '', 'fullName', 'leaveName', 'displayDateFrom', 'displayDateTo', 'leaveCountDays', 'leaveType', 'leaveReason', '', 'statusName'];
                const [sortIndex, sortDir] = table.order()[0] || [4, 'desc'];

                const exportLimit = info.length === -1 ? -1 : info.length;

                const params = new URLSearchParams({
                    status:        isInitialLoad ? 'Default' : ($('#filterStatusName').val() || 'Default'),
                    branch:        $('#filterBranch').val() || '',
                    department:    $('#filterDepartment').val() || '',
                    dateFrom:      $('#dateFrom').val() || '',
                    dateTo:        $('#dateTo').val() || '',
                    offset:        info.start,
                    limit:         exportLimit,
                    sortColumn:    sortMap[sortIndex] || '',
                    sortDirection: sortDir
                });

                toggleButtonLoading($btn, true, 'Exporting...');

                fetch(`/OffsetApplicationRequestExport/ExportToExcel?${params.toString()}`, {
                    method: 'GET',
                    headers: { 'Accept': 'application/vnd.openxmlformats-officedocument.spreadsheetml.sheet' }
                })
                .then(response => {
                    if (!response.ok) {
                        return response.text().then(text => {
                            throw new Error(`Server error (${response.status}): ${text}`);
                        });
                    }
                    return response.blob();
                })
                .then(blob => {
                    const url = window.URL.createObjectURL(blob);
                    const link = document.createElement('a');
                    link.href = url;
                    link.download = `OffsetApplicationRequest_${new Date().getTime()}.xlsx`;
                    document.body.appendChild(link);
                    link.click();
                    document.body.removeChild(link);
                    window.URL.revokeObjectURL(url);
                    toggleButtonLoading($btn, false);
                    showNotification(`Successfully exported ${info.recordsDisplay} record(s).`, 'success');
                })
                .catch(error => {
                    toggleButtonLoading($btn, false);
                    showNotification(error.message || 'An error occurred during export. Please try again.', 'error');
                });
            });

