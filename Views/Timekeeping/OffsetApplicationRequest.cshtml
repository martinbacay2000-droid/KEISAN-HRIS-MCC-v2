            function loadEmployeeDropdown(selector) {
                return $.get(config.endpoints.employees, data => {
                    $(selector).empty().append('<option value="">Select Employee...</option>');
                    data.forEach(i => $(selector).append(`<option value="${i.employeeNo}">${i.employeeName}</option>`));
                });
            }

            function loadCTOBalance(employeeNo, remainingSelector, tableSelector) {
                if (!employeeNo) {
                    $(remainingSelector).val('');
                    $(tableSelector + ' tbody').html('<tr><td colspan="2" class="text-center text-muted">Select an employee first</td></tr>');
                    return;
                }

                $.get(config.endpoints.employeeCTOTypes, { employeeNo: employeeNo })
                    .done(response => {
                        if (response?.data?.length > 0) {
                            const avail = parseFloat(response.data[0].remainingLeaveDays || 0);
                            $(remainingSelector).val(avail.toFixed(2));

                            const $tbody = $(tableSelector + ' tbody');
                            $tbody.empty();
                            response.data.forEach(item => {
                                $tbody.append(`
                                    <tr>
                                        <td>${item.leaveName || 'CTO'}</td>
                                        <td class="text-end">${parseFloat(item.remainingLeaveDays || 0).toFixed(2)}</td>
                                    </tr>
                                `);
                            });
                        } else {
                            $(remainingSelector).val('0.00');
                            $(tableSelector + ' tbody').html('<tr><td colspan="2" class="text-center text-muted">No CTO balance available</td></tr>');
                        }
                    })
                    .fail(() => {
                        $(remainingSelector).val('0.00');
                        $(tableSelector + ' tbody').html('<tr><td colspan="2" class="text-center text-danger">Error loading balance</td></tr>');
                    });
            }

            function calculateLeaveDays(df, dt, lt, target) {
                $.get(config.endpoints.calculateDays, { dateFrom: df, dateTo: dt, leaveType: lt }, data => {
                    $(target).val(data.leaveCount ? data.leaveCount.toFixed(1) : '0');
                });
            }

            function populateViewForm(data) {
                $('#viewOffsetApplicationId').val(data.id);
                $('#viewOffsetApplicationStatus').val(data.statusName);
                $('#viewEmployeeName').val(data.employeeNo).trigger('change');
                loadCTOBalance(data.employeeNo, '#viewRemainingDays', '#viewCTOBalanceTable');
                $('#viewDateFrom').val(data.displayDateFrom);
                $('#viewDateTo').val(data.displayDateTo);
                $('#viewTotalDays').val(data.leaveCountDays);
                $(`input[name="viewLeaveDuration"][value="${data.leaveType}"]`).prop('checked', true);
                $('#viewReason').val(data.leaveReason);
                $('#viewRemarks').val(data.remarks);
                loadCurrentAttachments(data.employeeNo);
                renderApprovalProgress(data);
            }

            function renderApprovalProgress(data) {
                const $progress = $('#approvalProgress');
                const $steps    = $('#approvalSteps');
                $steps.empty();

                const overall = data.statusLevel4 || data.statusName;

                if (overall === 'Cancelled') {
                    $progress.addClass('d-none');
                    return;
                }

                const required = data.requiredLevels || [];
                if (required.length === 0) {
                    $progress.addClass('d-none');
                    return;
                }

                // rq_leave (CTO) column mapping:
                //   Level 2 → statusLevel2
                //   Level 3 → statusLevel3
                //   Level 4 → statusLevel4 (final gate)
                const levelStatus = {
                    1: data.statusLevel1,
                    2: data.statusLevel2,
                    3: data.statusLevel3,
                    4: data.statusLevel4
                };

                required.forEach(function(level) {
                    const st = levelStatus[level] || 'Pending';
                    let badgeClass, icon;

                    switch (st) {
                        case 'Approved':
                            badgeClass = 'bg-success';
                            icon       = 'fa-check-circle';
                            break;
                        case 'Declined':
                            badgeClass = 'bg-danger';
                            icon       = 'fa-times-circle';
                            break;
                        default:
                            badgeClass = 'bg-warning';
                            icon       = 'fa-clock';
                    }

                    $steps.append(`
                        <span class="badge ${badgeClass} fs-6 px-3 py-2">
                            <i class="fas ${icon} me-1"></i>
                            Level ${level}: ${st}
                        </span>
                        ${required.indexOf(level) < required.length - 1
                            ? '<i class="fas fa-arrow-right align-self-center text-muted"></i>'
                            : ''}
                    `);
                });

                $progress.removeClass('d-none');
            }

            function loadCurrentAttachments(empNo) {
                $.get(config.endpoints.attachments, { employeeNo: empNo }, data => {
                    const c = $('#currentAttachments').empty();
                    if (data?.length > 0) {
                        data.forEach(a => {
                            const fn = a.attachmentPath.split('/').pop();
                            c.append(`<div class="attachment-item"><i class="fas fa-file"></i><a href="${a.attachmentPath}" target="_blank">${fn}</a>
                                <small class="text-muted ms-auto">${new Date(a.dtAdded).toLocaleDateString()}</small></div>`);
                        });
                    } else c.append('<small class="text-muted">No attachments</small>');
                });
            }

            function loadAttachmentsList(empNo) {
                $.get(config.endpoints.attachments, { employeeNo: empNo }, data => {
                    const c = $('#attachmentList').empty();
                    if (data?.length > 0) {
                        data.forEach(a => {
                            const fn = a.attachmentPath.split('/').pop();
                            c.append(`<div class="attachment-item mb-3"><i class="fas fa-file-alt fa-2x me-3"></i>
                                <div class="flex-grow-1"><h6 class="mb-1"><a href="${a.attachmentPath}" target="_blank" class="text-decoration-none">${fn}</a></h6>
                                <small class="text-muted">Added: ${new Date(a.dtAdded).toLocaleDateString()}</small></div>
                                <a href="${a.attachmentPath}" target="_blank" class="btn btn-sm btn-outline-primary ms-2"><i class="fas fa-download"></i> View</a></div>`);
                        });
                    } else c.append('<p class="text-muted text-center">No attachments found.</p>');
                });
            }

            function saveRequest(url, data, btnSel, closeModal) {
                const $btn = $(btnSel);
                toggleButtonLoading($btn, true, 'Saving...');
                $.ajax({
                    url, type: 'POST', data, processData: false, contentType: false,
                    success: r => {
                        if (r.success) {
                            if (closeModal) $('#addOffsetApplicationModal').modal('hide');
                            else setViewMode();
                            table.ajax.reload(null, false);
                            showNotification(r.message, 'success');
                        } else showNotification(r.message, 'error');
                    },
                    error: () => showNotification('Unable to save', 'error'),
                    complete: () => toggleButtonLoading($btn, false)
                });
            }

            function updateViewButtons(data) {
                const isFullObject = (typeof data === 'object' && data !== null);
                const status       = isFullObject
                    ? (data.statusLevel4 || data.statusName)
                    : data;

                $('#btnApproveOffsetApplication, #btnEditOffsetApplication, #btnCancelOffsetApplication')
                    .addClass('d-none');
                $('#btnSaveOffsetApplication, #btnCancelEdit').addClass('d-none');

                const requestEmployeeNo = isFullObject ? data.employeeNo : $('#viewEmployeeName').val();
                const isOwn             = requestEmployeeNo === sessemployeeNo;

                if (status === 'Cancelled' || status === 'Approved') return;

                if (status === 'Declined') {
                    if (isOwn || access === 'FULL') {
                        $('#btnEditOffsetApplication, #btnCancelOffsetApplication').removeClass('d-none');
                    }
                    return;
                }

                // Pending / Partially Approved
                if (isFullObject && typeof data.canCurrentUserApprove !== 'undefined') {
                    if (data.canCurrentUserApprove) {
                        $('#btnApproveOffsetApplication').removeClass('d-none');
                    }
                } else {
                    // Fallback (called with status string from setViewMode)
                    if (access === 'FULL' || (isApprover && !isOwn)) {
                        $('#btnApproveOffsetApplication').removeClass('d-none');
                    }
                }

                if (isOwn || access === 'FULL') {
                    $('#btnEditOffsetApplication, #btnCancelOffsetApplication').removeClass('d-none');
                }
            }

