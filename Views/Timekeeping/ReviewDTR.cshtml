            // Show a "X/5" badge on the button when not all groups are selected
            function updateColVisBadge() {
                const total   = $('.col-vis-check').length;
                const checked = $('.col-vis-check:checked').length;
                const $btn    = $('#btnToggleColVis');

                // Remove any existing badge
                $btn.find('.badge').remove();

                if (checked < total) {
                    $btn.append(
                        `<span class="badge rounded-pill ms-1"
                               style="background:#886cc0;font-size:0.7rem;">${checked}/${total}</span>`
                    );
                }
