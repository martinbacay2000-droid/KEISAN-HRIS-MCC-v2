            // ── DTR Posted Check ─────────────────────────────────────
            function checkIfDtrPosted() {
                const cutOffType = $('#cutOffType').val();
                const dateMonth  = $('#dateMonth').val();
                const dateYear   = $('#dateYear').val();
                const branchCode = $('#filterBranch').val() || '';

                if (!cutOffType || !dateMonth || !dateYear) return;

                $.get('/ReviewDTR/IsDtrPosted', {
                    cutOffType,
                    dateMonth,
                    dateYear,
                    // Pass selected branch so Casual lock never blocks other branches
                    branchCode: branchCode === 'ALL' ? '' : branchCode
                }, function (res) {
                    // Only touch the button visibility if this user can process
                    if (!canProcess()) return;

                    // Super admin keeps Process DTR regardless of lock state
                    if (res.posted && roleCode !== 'RL-000000') {
                        $('#processDtr').hide();
                    } else {
                        $('#processDtr').show();
                    }
                });
            }

            // ── Casual Lock State Check ──────────────────────────────────────
            // Determines whether to show Lock or Unlock for Casual branch
            // Called on filter change and after filter button click
            function checkIfCasualLocked() {
                const dateFrom   = $('#dateFrom').val();
                const dateTo     = $('#dateTo').val();
                const branchCode = $('#filterBranch').val();

                // Only check when filters are filled
                if (!dateFrom || !dateTo) {
                    // No date range yet — keep buttons disabled
                    if (roleCode === 'HR CASUAL') {
                        $('#lockDtr').prop('disabled', true)
                                     .attr('title', 'Please filter first');
                    }
                    if (roleCode === 'RL-000000') {
                        $('#lockDtr').hide();
                        $('#unlockDtr').hide();
                    }
                    return;
                }

                $.get('/ReviewDTR/IsDateRangePosted', {
                    dateFrom,
                    dateTo,
                    branchCode: 'Casual'
                }, function (res) {
                    const isLocked  = !!(res && res.posted);
                    const hasData   = $('#reviewDTRTable').DataTable().rows().count() > 0;

                    if (roleCode === 'HR CASUAL') {
                        if (isLocked) {
                            // Already locked — disable with indicator
                            $('#lockDtr').prop('disabled', true)
                                         .attr('title', 'DTR is already locked for this period')
                                         .html('<i class="fas fa-lock"></i> DTR Locked');
                        } else {
                            // Not locked — enable only if data is loaded
                            $('#lockDtr').prop('disabled', !hasData)
                                         .attr('title', hasData ? '' : 'Please filter first')
                                         .html('<i class="fas fa-lock"></i> Lock DTR');
                        }
                    }

                    if (roleCode === 'RL-000000') {
                        if (isLocked) {
                            // Show Unlock, hide Lock
                            $('#lockDtr').hide();
                            $('#unlockDtr').show().prop('disabled', false);
                        } else {
                            // Show Lock, hide Unlock — only enable if data is loaded
                            $('#unlockDtr').hide();
                            $('#lockDtr').show().prop('disabled', !hasData)
                                         .html('<i class="fas fa-lock"></i> Lock DTR');
                        }
                    }
                });
            }

