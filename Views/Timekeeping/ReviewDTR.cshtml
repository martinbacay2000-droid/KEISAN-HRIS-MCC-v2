                Swal.fire({
                    icon: 'warning',
                    title: 'Unlock DTR?',
                    html: `This will unlock all <strong>Casual</strong> branch records for
                           <strong>${dateMonth}</strong> — <strong>Cut-off ${cutOffType}</strong>
                           (<strong>${dateFrom}</strong> to <strong>${dateTo}</strong>).<br><br>
                           Employees will be able to modify their records again.`,
