            // ── Date Range Calculator ────────────────────────────────
            function updateDateRange() {
                const cutOff = $('#cutOffType').val();
                const month  = parseInt($('#dateMonth').val());
                const year   = parseInt($('#dateYear').val());

                if (!cutOff || !month || !year) {
                    $('#dateFrom').val('');
                    $('#dateTo').val('');
                    return;
                }

                let fromDate, toDate;

                if (cutOff === "1") {
                    // 1st Cut-Off: 26 (prev month) → 10 (current month)
                    let prevMonth = month - 1;
                    let prevYear  = year;
                    if (prevMonth === 0) { prevMonth = 12; prevYear--; }
                    fromDate = new Date(prevYear, prevMonth - 1, 26);
                    toDate   = new Date(year, month - 1, 10);
                } else if (cutOff === "2") {
                    // 2nd Cut-Off: 11 → 25 (current month)
                    fromDate = new Date(year, month - 1, 11);
                    toDate   = new Date(year, month - 1, 25);
                }

                $('#dateFrom').val(formatDate(fromDate));
                $('#dateTo').val(formatDate(toDate));
            }

            function formatDate(date) {
                const y = date.getFullYear();
                const m = ("0" + (date.getMonth() + 1)).slice(-2);
                const d = ("0" + date.getDate()).slice(-2);
                return `${y}-${m}-${d}`;
            }

            // $('#dateFrom, #dateTo').prop('readonly', true);
            $('#dateFrom, #dateTo').prop('disabled', false);

            $('#dateMonth, #dateYear, #cutOffType').on('change', function () {
                updateDateRange();
                if (canProcess()) checkIfDtrPosted();
                if (roleCode === 'HR CASUAL' || roleCode === 'RL-000000') checkIfCasualLocked();
                // Keep pending badge count in sync with the new date range
                if (dtrAccessLevel === 'FULL') loadPendingRequestsCount();
            });

            // ── Defaults ─────────────────────────────────────────────
            (function initDefaults() {
                const now = new Date();
                const day = now.getDate();
                const month = now.getMonth() + 1;
                const year = now.getFullYear();

                let cutOff;
                let displayMonth;
                let displayYear = year;

                if (day >= 26) {
                    cutOff = "2";  // ← wait, no:
                    // 26-31 = 1st cutoff of NEXT month
                    cutOff = "1";
                    const nextMonth = month === 12 ? 1 : month + 1;
                    displayYear = month === 12 ? year + 1 : year;
                    displayMonth = nextMonth;
                } else if (day >= 11) {
                    cutOff = "2";
                    displayMonth = month;
                } else {
                    cutOff = "1";
                    displayMonth = month;
                }

                $('#dateYear').val(displayYear);

                // Set month and trigger Select2
                $('#dateMonth').val(("0" + displayMonth).slice(-2)).trigger('change');

                // Set cutoff and trigger Select2
                $('#cutOffType').val(cutOff).trigger('change');

                updateDateRange();
                checkIfDtrPosted();
            })();

