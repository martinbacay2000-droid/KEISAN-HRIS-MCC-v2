            // ════════════════════════════════════════════════════════
            // EXPORT TO EXCEL
            // ════════════════════════════════════════════════════════
            $('#btnExportToExcel').on('click', function () {
                const $btn = $(this);

                // Validate date range
                const dateFrom = $('#dateFrom').val();
                const dateTo   = $('#dateTo').val();
                if (!dateFrom || !dateTo) {
                    Swal.fire({ icon: 'warning', title: 'Missing Dates', text: 'Please select a date range first.' });
                    return;
                }

                // Validate data availability
                if (summaryTable.rows({ search: 'applied' }).count() === 0) {
                    Swal.fire({ icon: 'warning', title: 'No Data', text: 'No data available to export.' });
                    return;
                }

                // Validate at least one column group is selected
                const checkedGroups   = $('.col-vis-check:checked').map((_, el) => el.value).get();
                const uncheckedGroups = $('.col-vis-check:not(:checked)').map((_, el) => el.value).get();

                if (checkedGroups.length === 0) {
                    Swal.fire({
                        icon: 'warning',
                        title: 'No Columns Selected',
                        text: 'Please select at least one column group to export.'
                    });
                    return;
                }

                // Pagination + sort info from DataTable
                const pageInfo = summaryTable.page.info();

                const sortMap = [
                    '', 'employeeNo', 'fullName', 'payrollType',
                    'ndHours', 'otHours', 'otndHours',
                    'rdHours', 'rdotHours', 'rdndHours',
                    'splHolidayHours', 'splHolidayOTHours', 'splHolidayNDHours',
                    'regHolidayHours', 'regHolidayOTHours', 'regHolidayNDHours',
                    'totalLateMinutes', 'totalUndertimeMinutes', 'totalPresentDays'
                ];

                const [sortIndex, sortDir] = summaryTable.order()[0] || [1, 'asc'];

                const params = new URLSearchParams({
                    dateFrom:      dateFrom,
                    dateTo:        dateTo,
                    branchCode:    $('#filterBranch').val() || '',
                    offset:        pageInfo.start,
                    limit:         pageInfo.length,
                    sortColumn:    sortMap[sortIndex] || '',
                    sortDirection: sortDir,
                    // Comma-separated list of excluded group keys
                    excludeGroups: uncheckedGroups.join(',')
                });

                // Loading state
                const originalHtml = $btn.html();
                $btn.prop('disabled', true).html('<i class="fas fa-spinner fa-spin"></i> Exporting...');

                // Trigger file download
                const link = document.createElement('a');
                link.href     = `/ReviewDTRExport/ExportToExcel?${params.toString()}`;
                link.download = '';
                document.body.appendChild(link);
                link.click();
                document.body.removeChild(link);

                // Reset button after short delay
                setTimeout(() => {
                    $btn.prop('disabled', false).html(originalHtml);
                }, 1500);
            });

            // ── PENDING REQUESTS ─────────────────────────────────────────
            var pendingTable = null;
            var pendingSelect2Initialized = false;

            function initPendingRequestsTable() {
                // Destroy existing instance safely
                if ($.fn.DataTable.isDataTable('#pendingRequestsTable')) {
                    $('#pendingRequestsTable').DataTable().destroy();
                    pendingTable = null;
                }

                pendingTable = $('#pendingRequestsTable').DataTable({
                    processing: true,
                    ajax: {
                        url: '/ReviewDTR/GetPendingBiometricsRequests',
                        type: 'GET',
                        data: function (d) {
                            d.branchCode = $('#pendingFilterBranch').val() || '';
                            d.dateFrom   = $('#dateFrom').val()            || '';
                            d.dateTo     = $('#dateTo').val()              || '';
                        },
                        dataSrc: function (res) {
                            if (res.success === false) return [];
                            const rows = res.data || [];
                            $('#pendingEmptyState').toggle(rows.length === 0);
                            return rows;
                        }
                    },
                    columns: [
                        {
                            data: null,
                            render: function (d) {
                                return `<div style="font-weight:600;font-size:0.85rem;">
                                            ${d.fullName}
                                        </div>
                                        <div style="font-size:0.75rem;color:#888;">
                                            ${d.employeeNo}
                                        </div>`;
                            }
                        },
                        { data: 'branchName', defaultContent: '—' },
                        {
                            data: 'workDate',
                            render: function (d) {
                                return `<span class="fw-semibold">${d || '—'}</span>`;
                            }
                        },
                        { data: 'originalTimeIn',  defaultContent: '<span class="text-muted">—</span>' },
                        { data: 'originalTimeOut', defaultContent: '<span class="text-muted">—</span>' },
                        {
                            data: 'requestedTimeIn',
                            render: function (d) {
                                return d
                                    ? `<span style="color:#886cc0;font-weight:600;">${d}</span>`
                                    : '<span class="text-muted">—</span>';
                            }
                        },
                        {
                            data: 'requestedTimeOut',
                            render: function (d) {
                                return d
                                    ? `<span style="color:#886cc0;font-weight:600;">${d}</span>`
                                    : '<span class="text-muted">—</span>';
                            }
                        },
                        {
                            data: 'reason',
                            render: function (d) {
                                if (!d) return '—';
                                const s = d.length > 60 ? d.substring(0, 57) + '...' : d;
                                return `<span title="${d.replace(/"/g, '&quot;')}"
                                              style="font-size:0.82rem;">${s}</span>`;
                            }
                        },
                        {
                            data: 'submittedBy', defaultContent: '—',
                            render: function (d) {
                                return `<span style="font-size:0.82rem;">${d || '—'}</span>`;
                            }
                        },
                        {
                            data: 'submittedAt', defaultContent: '—',
                            render: function (d) {
                                return `<span style="font-size:0.82rem;">${d || '—'}</span>`;
                            }
                        },
                        {
                            data: null,
                            orderable: false,
                            render: function (d) {
                                return `
                                    <div class="d-flex gap-1 justify-content-center">
                                        <button class="btn btn-success btn-sm shadow-sm btn-approve-request"
                                                data-id="${d.id}"
                                                data-ubio-id="${d.uBiometricsId || ''}">
                                            <i class="fas fa-check me-1"></i> Approve
                                        </button>
                                        <button class="btn btn-danger btn-sm shadow-sm btn-decline-request"
                                                data-id="${d.id}"
                                                data-ubio-id="${d.uBiometricsId || ''}"
                                                data-employee="${d.fullName}"
                                                data-date="${d.workDate}">
                                            <i class="fas fa-times me-1"></i> Decline
                                        </button>
                                    </div>`;
                            }
                        }
                    ],
                    pageLength: 25,
                    lengthMenu: [[10, 25, 50, -1], [10, 25, 50, 'All']],
                    order: [[9, 'desc']],
                    language: {
                        emptyTable: ' ',
                        paginate: {
                            next:     '<i class="fa fa-angle-double-right"></i>',
                            previous: '<i class="fa fa-angle-double-left"></i>'
                        }
                    }
                });
            }

            // Open modal — sync date range display then init table
            $('#btnPendingRequests').on('click', function () {
                const df = $('#dateFrom').val() || '';
                const dt = $('#dateTo').val()   || '';
                $('#pendingDateRangeDisplay').val(df && dt ? `${df}  →  ${dt}` : '—');
                new bootstrap.Modal('#pendingRequestsModal').show();
            });

            // Init table AFTER modal is fully shown (avoids DataTable width/rendering issues)
            $('#pendingRequestsModal').on('shown.bs.modal', function () {
                // Init Select2 on branch filter once
                if (!pendingSelect2Initialized) {
                    $('#pendingFilterBranch').select2({
                        dropdownParent: $('#pendingRequestsModal'),
                        placeholder: 'All Branches',
                        allowClear: true,
                        ajax: {
                            url: '/Setup/GetEmployeeBranch',
                            dataType: 'json',
                            delay: 250,
                            processResults: function (data) {
                                var results = $.map(data, function (item) {
                                    return { id: item.branchCode, text: item.branchName };
                                });
                                results.unshift({ id: '', text: 'All Branches' });
                                return { results: results };
                            }
                        }
                    });
                    pendingSelect2Initialized = true;
                }

                // Always reload the table when the modal opens
                initPendingRequestsTable();
            });

            // Refresh button — reload existing table
            $(document).on('click', '#btnRefreshPending', function () {
                if (pendingTable) {
                    pendingTable.ajax.reload(null, false);
                } else {
                    initPendingRequestsTable();
                }
            });

            // Approve
            $(document).on('click', '.btn-approve-request', function () {
                const id   = $(this).data('id');
                const $btn = $(this);
                Swal.fire({
                    title: 'Approve Request?',
                    text: 'The new time will take effect immediately.',
                    icon: 'question',
                    showCancelButton: true,
                    confirmButtonText: 'Yes, Approve',
                    cancelButtonText: 'Cancel',
                    confirmButtonColor: '#198754',
                    cancelButtonColor: '#6c757d'
                }).then(function (result) {
                    if (!result.isConfirmed) return;
                    var origHtml = $btn.html();
                    $btn.prop('disabled', true).html('<i class="fas fa-spinner fa-spin"></i>');
                    $.post('/ReviewDTR/ApproveBiometricsRequest', { id: id }, function (res) {
                        $btn.prop('disabled', false).html(origHtml);
                        if (!res.success) {
                            Swal.fire({ icon: 'error', title: 'Error', text: res.message });
                            return;
                        }
                        Swal.fire({ icon: 'success', title: 'Approved', text: res.message,
                                    timer: 1800, showConfirmButton: false });
                        if (pendingTable) pendingTable.ajax.reload(null, false);
                        loadPendingRequestsCount();
                    }).fail(function () {
                        $btn.prop('disabled', false).html(origHtml);
                        Swal.fire({ icon: 'error', title: 'Error', text: 'Failed to approve.' });
                    });
                });
            });

            // Decline
            $(document).on('click', '.btn-decline-request', function () {
                const id       = $(this).data('id');
                const uBioId   = $(this).data('ubio-id');
                const empName  = $(this).data('employee');
                const workDate = $(this).data('date');
                const $btn     = $(this);
                Swal.fire({
                    title: 'Decline Request?',
                    html: `Declining will revert the time record for
                           <strong>${empName}</strong> on
                           <strong>${workDate}</strong>.`,
                    icon: 'warning',
                    showCancelButton: true,
                    confirmButtonText: 'Yes, Decline',
                    cancelButtonText: 'Cancel',
                    confirmButtonColor: '#dc3545',
                    cancelButtonColor: '#6c757d'
                }).then(function (result) {
                    if (!result.isConfirmed) return;
                    var origHtml = $btn.html();
                    $btn.prop('disabled', true).html('<i class="fas fa-spinner fa-spin"></i>');
                    $.post('/ReviewDTR/DeclineBiometricsRequest',
                        { id: id, uBiometricsId: uBioId },
                        function (res) {
                            $btn.prop('disabled', false).html(origHtml);
                            if (!res.success) {
                                Swal.fire({ icon: 'error', title: 'Error', text: res.message });
                                return;
                            }
                            Swal.fire({ icon: 'info', title: 'Declined', text: res.message,
                                        timer: 1800, showConfirmButton: false });
                            if (pendingTable) pendingTable.ajax.reload(null, false);
                            loadPendingRequestsCount();
                        }
                    ).fail(function () {
                        $btn.prop('disabled', false).html(origHtml);
                        Swal.fire({ icon: 'error', title: 'Error', text: 'Failed to decline.' });
                    });
                });
            });

            function loadPendingRequestsCount() {
                $.get('/ReviewDTR/GetPendingBiometricsRequests', {
                    branchCode: '',
                    dateFrom:   $('#dateFrom').val() || '',
                    dateTo:     $('#dateTo').val()   || ''
                }, function (res) {
                    var count  = (res.data || []).length;
                    var $badge = $('#pendingCountBadge');
                    if (count > 0) { $badge.text(count).show(); }
                    else           { $badge.hide(); }
                });
            }

        }); // end $(function)
    </script>
}