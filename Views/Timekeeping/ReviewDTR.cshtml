@model List<KEISAN_HRIS_v2.Models.Timekeeping.ReviewDTREmployeeSummaryViewModel>
@{
    Layout = "~/Views/Shared/_LayoutFillow.cshtml";
    ViewData["Title"] = "Review DTR Summary";
}

<div class="col-12">
    <div class="card">
        <div class="card-header">
            <div class="row" style="width:100%;">
                <h4 class="card-title">Review Daily Time Record</h4>
                <br> <br> <br>

                <!-- FILTERS ROW 1 -->
                <div class="row date-range" style="margin-left:0px;width:100%;margin-bottom:20px;">
                    <div class="col-md-3">
                        <div class="form-group">
                            <h5>Branch</h5>
                            <select id="filterBranch" class="form-control"></select>
                        </div>
                    </div>

                    <div class="col-md-3">
                        <div class="form-group">
                            <h5>Month</h5>
                            <select id="dateMonth" class="form-control select2">
                                <option value="">Select Month</option>
                                <option value="01">January</option>
                                <option value="02">February</option>
                                <option value="03">March</option>
                                <option value="04">April</option>
                                <option value="05">May</option>
                                <option value="06">June</option>
                                <option value="07">July</option>
                                <option value="08">August</option>
                                <option value="09">September</option>
                                <option value="10">October</option>
                                <option value="11">November</option>
                                <option value="12">December</option>
                            </select>
                        </div>
                    </div>

                    <div class="col-md-3">
                        <div class="form-group">
                            <h5>Cut Off</h5>
                            <select id="cutOffType" class="form-control select2">
                                <option value="1">1st Cut Off</option>
                                <option value="2">2nd Cut Off</option>
                            </select>
                        </div>
                    </div>

                    <div class="col-md-3">
                        <div class="form-group">
                            <h5>Year</h5>
                            <div class="input-hasicon">
                                <input type="text" name="dateYear" id="dateYear" class="form-control yearpicker"
                                       value="@DateTime.Now.Year" readonly placeholder="Select Year">
                                <div class="icon"><i class="far fa-calendar"></i></div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- FILTERS ROW 2 -->
                <div class="row date-range" style="margin-left:0px;width:100%;margin-bottom:20px;">
                    <div class="col-md-3">
                        <label>Date From</label>
                        <div class="input-hasicon">
                            <input id="dateFrom" class="form-control">
                            <div class="icon"><i class="far fa-calendar"></i></div>
                        </div>
                    </div>
                    <div class="col-md-3">
                        <label>Date To</label>
                        <div class="input-hasicon">
                            <input id="dateTo" class="form-control">
                            <div class="icon"><i class="far fa-calendar"></i></div>
                        </div>
                    </div>
                    <div class="col-md-3">
                        <label>&nbsp;</label>
                        <button id="filter" class="btn btn-primary w-100">
                            <i class="fas fa-filter"></i> Filter
                        </button>
                    </div>
                </div>

                <!-- ACTION BUTTONS -->
                <div class="col-md-12 d-flex justify-content-end align-items-start" style="margin-top:15px;gap:10px;">

                    @* <div class="form-group">
                        <button type="button" class="btn btn-danger" id="lockDtr" style="display:none;" disabled>
                            <i class="fas fa-lock"></i> Lock DTR
                        </button>
                        <button type="button" class="btn btn-warning" id="unlockDtr" style="display:none;" disabled>
                            <i class="fas fa-lock-open"></i> Unlock DTR
                        </button>
                    </div> *@
                    @if ((Context.Session.GetString("roleCode") ?? "").Trim().ToUpper() != "HR CASUAL")
                    {
                        <div class="form-group">
                            <button type="button" class="btn btn-success" id="processDtr" style="display:none;">
                                <i class="fas fa-cogs"></i> Process DTR
                            </button>
                        </div>
                    }
                    <div class="form-group" id="pendingRequestsWrapper" style="display:none;">
                        <button type="button" class="btn btn-danger position-relative"
                                id="btnPendingRequests">
                            <i class="fas fa-clock"></i> Pending Requests
                            <span id="pendingCountBadge"
                                  class="position-absolute top-0 start-100 translate-middle
                         badge rounded-pill bg-warning text-dark"
                                  style="display:none; font-size:0.7rem;">0</span>
                        </button>
                    </div>
                    <div class="form-group">
                        <button type="button" class="btn btn-warning" id="btnExportToExcel">
                            <i class="fas fa-file-excel"></i> Export to Excel
                        </button>
                    </div>
                    <!-- Column Visibility Dropdown -->
                    <div class="form-group position-relative" id="colVisWrapper">

                        <button type="button" class="btn btn-primary" id="btnToggleColVis"
                                title="Choose which column groups to include in the Excel export">
                            <i class="fas fa-columns"></i> Columns
                            <i class="fas fa-chevron-down ms-1" id="colVisChevron" style="font-size:0.75rem;"></i>
                        </button>

                        <!-- Dropdown Panel -->
                        <div id="colVisPanel"
                             class="shadow border rounded bg-white p-3"
                             style="display:none;
                                    position:absolute;
                                    top:calc(100% + 6px);
                                    right:0;
                                    min-width:230px;
                                    z-index:1055;">

                            <div class="d-flex justify-content-between align-items-center mb-2 pb-2 border-bottom">
                                <span class="fw-semibold text-secondary"
                                      style="font-size:0.8rem;text-transform:uppercase;letter-spacing:.05em;">
                                    Export Columns
                                </span>
                                <div style="display:flex;gap:6px;">
                                    <button type="button" class="btn btn-link btn-sm p-0 text-primary"
                                            id="btnSelectAll" style="font-size:0.78rem;">
                                        All
                                    </button>
                                    <span class="text-muted" style="font-size:0.78rem;">|</span>
                                    <button type="button" class="btn btn-link btn-sm p-0 text-secondary"
                                            id="btnSelectNone" style="font-size:0.78rem;">
                                        None
                                    </button>
                                </div>
                            </div>

                            <div class="d-flex flex-column gap-2">
                                <label class="col-vis-item d-flex align-items-center gap-2 mb-0"
                                       style="cursor:pointer;">
                                    <input type="checkbox" class="col-vis-check form-check-input mt-0"
                                           value="Attendance" checked>
                                    <span>Attendance</span>
                                </label>
                                <label class="col-vis-item d-flex align-items-center gap-2 mb-0"
                                       style="cursor:pointer;">
                                    <input type="checkbox" class="col-vis-check form-check-input mt-0"
                                           value="NightDifferential" checked>
                                    <span>Regular OT</span>
                                </label>
                                <label class="col-vis-item d-flex align-items-center gap-2 mb-0"
                                       style="cursor:pointer;">
                                    <input type="checkbox" class="col-vis-check form-check-input mt-0"
                                           value="RestDay" checked>
                                    <span>Rest Day</span>
                                </label>
                                <label class="col-vis-item d-flex align-items-center gap-2 mb-0"
                                       style="cursor:pointer;">
                                    <input type="checkbox" class="col-vis-check form-check-input mt-0"
                                           value="SpecialHoliday" checked>
                                    <span>Special Holiday</span>
                                </label>
                                <label class="col-vis-item d-flex align-items-center gap-2 mb-0"
                                       style="cursor:pointer;">
                                    <input type="checkbox" class="col-vis-check form-check-input mt-0"
                                           value="SpecialHolidayRestDay" checked>
                                    <span>Special Holiday Rest Day</span>
                                </label>
                                <label class="col-vis-item d-flex align-items-center gap-2 mb-0"
                                       style="cursor:pointer;">
                                    <input type="checkbox" class="col-vis-check form-check-input mt-0"
                                           value="RegularHoliday" checked>
                                    <span>Regular Holiday</span>
                                </label>
                                <label class="col-vis-item d-flex align-items-center gap-2 mb-0"
                                       style="cursor:pointer;">
                                    <input type="checkbox" class="col-vis-check form-check-input mt-0"
                                           value="RegularHolidayRestDay" checked>
                                    <span>Regular Holiday Rest Day</span>
                                </label>
                            </div>

                            <div class="mt-3 pt-2 border-top"
                                 style="font-size:0.77rem;color:#888;">
                                <i class="fas fa-info-circle me-1"></i>
                                Unchecked groups will be excluded from the Excel export.
                            </div>
                        </div>
                    </div>
                    <!-- /Column Visibility Dropdown -->
                </div>
            </div>
        </div>

        <!-- SUMMARY TABLE -->
        <div class="card-body">
            <div class="table-responsive">
                <table id="reviewDTRTable" class="display table table-bordered" style="width:100%">
                    <thead class="table-primary">
                        <tr>
                            <th rowspan="2" style="vertical-align: middle;">Action</th>
                            <th rowspan="2" style="vertical-align: middle;">Employee No</th>
                            <th rowspan="2" style="vertical-align: middle;">Full Name</th>
                            <th rowspan="2" style="vertical-align: middle;">Payroll Type</th>
                            <th colspan="4" class="text-center">Attendance</th>
                            <th colspan="3" class="text-center">Regular OT</th>
                            <th colspan="4" class="text-center">Rest Day</th>
                            <th colspan="4" class="text-center">Special Holiday</th>
                            <th colspan="4" class="text-center">Special Holiday Rest Day</th>
                            <th colspan="4" class="text-center">Regular Holiday</th>
                            <th colspan="4" class="text-center">Regular Holiday Rest Day</th>
                        </tr>
                        <tr>
                            <!-- Attendance -->
                            <th class="sub-header">Late<br />(Minutes)</th>
                            <th class="sub-header">Undertime<br />(Minutes)</th>
                            <th class="sub-header">Present<br />(Days)</th>
                            <th class="sub-header">Absent<br />(Days)</th>
                            <!-- Night Differential -->
                            <th class="sub-header">ND<br />(Hours)</th>
                            <th class="sub-header">OT<br />(Hours)</th>
                            <th class="sub-header">OT ND<br />(Hours)</th>
                            <!-- Rest Day -->
                            <th class="sub-header">RD<br />(Hours)</th>
                            <th class="sub-header">RD OT<br />(Hours)</th>
                            <th class="sub-header">RD ND<br />(Hours)</th>
                            <th class="sub-header">RD ND OT<br />(Hours)</th>
                            <!-- Special Holiday -->
                            <th class="sub-header">SPL<br />(Hours)</th>
                            <th class="sub-header">SPL OT<br />(Hours)</th>
                            <th class="sub-header">SPL ND<br />(Hours)</th>
                            <th class="sub-header">SPL ND OT<br />(Hours)</th>
                            <!-- Special Holiday Rest Day -->
                            <th class="sub-header">SPL RD<br />(Hours)</th>
                            <th class="sub-header">SPL RD OT<br />(Hours)</th>
                            <th class="sub-header">SPL RD ND<br />(Hours)</th>
                            <th class="sub-header">SPL RD ND OT<br />(Hours)</th>
                            <!-- Regular Holiday -->
                            <th class="sub-header">REG<br />(Hours)</th>
                            <th class="sub-header">REG OT<br />(Hours)</th>
                            <th class="sub-header">REG ND<br />(Hours)</th>
                            <th class="sub-header">REG ND OT<br />(Hours)</th>
                            <!-- Regular Holiday Rest Day -->
                            <th class="sub-header">REG RD<br />(Hours)</th>
                            <th class="sub-header">REG RD OT<br />(Hours)</th>
                            <th class="sub-header">REG RD ND<br />(Hours)</th>
                            <th class="sub-header">REG RD ND OT<br />(Hours)</th>
                        </tr>
                    </thead>
                </table>
            </div>
        </div>

        <!-- EMPLOYEE DAILY DETAILS MODAL -->
        <div class="modal fade" id="employeeModal" tabindex="-1">
            <div class="modal-dialog modal-full modal-dialog-scrollable"
                 style="width: 100% !important; max-width: 95% !important;">
                <div class="modal-content">
                    <div class="modal-header">
                        <h5 class="modal-title">Employee Daily Details</h5>
                        <button class="btn-close" data-bs-dismiss="modal"></button>
                    </div>
                    <div class="modal-body" id="modalContent">
                        <div class="table-responsive">
                            <table id="employeeDetailsTable" class="display table table-bordered" style="width:100%">
                                <thead>
                                    <tr>
                                        <th rowspan="2" style="vertical-align: middle;">Date</th>
                                        <th rowspan="2" style="vertical-align: middle;">Weekday</th>
                                        <th colspan="2" class="text-center">Schedule</th>
                                        <th colspan="2" class="text-center">Actual Time</th>
                                        <th rowspan="2" style="vertical-align: middle;">Remarks</th>
                                        <th colspan="2" class="text-center">Attendance</th>
                                        <th colspan="3" class="text-center">Overtime</th>
                                        <th rowspan="2" style="vertical-align: middle;">OT Reason</th>
                                    </tr>
                                    <tr>
                                        <!-- Schedule -->
                                        <th class="sub-header">Sched In</th>
                                        <th class="sub-header">Sched Out</th>
                                        <!-- Actual Time -->
                                        <th class="sub-header">Time In</th>
                                        <th class="sub-header">Time Out</th>
                                        <!-- Attendance -->
                                        <th class="sub-header">Late (Min)</th>
                                        <th class="sub-header">UT (Min)</th>
                                        <!-- Overtime -->
                                        <th class="sub-header">ND</th>
                                        <th class="sub-header">OT In</th>
                                        <th class="sub-header">OT Out</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <!-- Populated via AJAX -->
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- PENDING REQUESTS MODAL -->
        <div class="modal fade" id="pendingRequestsModal" tabindex="-1">
            <div class="modal-dialog modal-xl modal-dialog-scrollable">
                <div class="modal-content" style="border-radius:12px;border:none;">
                    <div class="modal-header"
                         style="background:linear-gradient(135deg,#886cc0 0%,#6b5b95 100%);
                                border-radius:12px 12px 0 0;border:none;">
                        <div class="d-flex align-items-center gap-2">
                            <div style="background:rgba(255,255,255,0.2);border-radius:8px;
                                        width:36px;height:36px;display:flex;
                                        align-items:center;justify-content:center;">
                                <i class="fas fa-clock" style="color:#fff;font-size:1rem;"></i>
                            </div>
                            <div>
                                <h6 class="mb-0 fw-bold text-white">
                                    Pending Time Modification Requests
                                </h6>
                                <small class="text-white-50">
                                    Review and act on employee biometrics requests
                                </small>
                            </div>
                        </div>
                        <button type="button" class="btn-close btn-close-white"
                                data-bs-dismiss="modal"></button>
                    </div>
                    <div class="row g-2 mb-3 align-items-end px-2">
                        <div class="col-5">
                            <label class="form-label fw-semibold"
                                   style="font-size:0.8rem;">Branch</label>
                            <select id="pendingFilterBranch"
                                    class="form-control form-control-sm"></select>
                        </div>
                        <div class="col-5">
                            <label class="form-label fw-semibold"
                                   style="font-size:0.8rem;">Date Range</label>
                            <input type="text" id="pendingDateRangeDisplay"
                                   class="form-control form-control-sm"
                                   readonly
                                   style="background:#f8f4ff;color:#6b5b95;
                                          font-weight:600;cursor:default;
                                          border:1px solid #d8ccf0;">
                        </div>
                        <div class="col-2">
                            <label class="form-label fw-semibold"
                                   style="font-size:0.8rem;visibility:hidden;">_</label>
                            <button type="button" class="btn btn-primary btn-sm w-100 d-block"
                                    id="btnRefreshPending">
                                <i class="fas fa-sync-alt me-1"></i> Refresh
                            </button>
                        </div>
                    </div>
                    <div class="modal-body pt-0">
                        <div class="table-responsive">
                            <table id="pendingRequestsTable"
                                   class="display table table-bordered table-sm"
                                   style="width:100%;">
                                <thead style="background:#886cc0;color:#fff;">
                                    <tr>
                                        <th>Employee</th>
                                        <th>Branch</th>
                                        <th>Work Date</th>
                                        <th>Original Time In</th>
                                        <th>Original Time Out</th>
                                        <th>Requested Time In</th>
                                        <th>Requested Time Out</th>
                                        <th>Reason</th>
                                        <th>Submitted By</th>
                                        <th>Submitted At</th>
                                        <th style="min-width:150px;">Action</th>
                                    </tr>
                                </thead>
                            </table>
                        </div>
                        <div id="pendingEmptyState" class="text-center py-5"
                             style="display:none;">
                            <div style="width:64px;height:64px;background:#f0eaff;
                                        border-radius:50%;display:flex;align-items:center;
                                        justify-content:center;margin:0 auto 12px;">
                                <i class="fas fa-check-circle"
                                   style="color:#886cc0;font-size:1.8rem;"></i>
                            </div>
                            <h6 class="fw-semibold text-muted">No Pending Requests</h6>
                            <p class="text-muted mb-0" style="font-size:0.85rem;">
                                All time modification requests have been resolved.
                            </p>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- PROCESS DTR MODAL -->
        <div class="modal fade" id="processDtrModal" tabindex="-1" data-bs-backdrop="static">
            <div class="modal-dialog modal-dialog-centered">
                <div class="modal-content text-center p-4">
                    <h5 class="mb-3">Processing</h5>
                    <div class="d-flex justify-content-center mb-3">
                        <div class="spinner-border text-primary" role="status" style="width:3rem;height:3rem;">
                            <span class="visually-hidden">Loading...</span>
                        </div>
                    </div>
                    <h6 id="currentEmployeeName" class="fw-bold"></h6>
                    <p id="processCounter" class="fw-bold"></p>
                </div>
            </div>
        </div>

    </div>
</div>

@section Fillow_style
{
    <style>
        .yearpicker {
            cursor: pointer;
        }

        .ui-datepicker-calendar {
            display: none;
        }

        /*  #dateFrom, #dateTo {
                    background-color: #e9ecef;
                    cursor: not-allowed;
                } */

        /* Table Styling */
        .table-responsive {
            border-radius: 0.375rem;
        }

        #reviewDTRTable_wrapper .dataTables_length,
        #reviewDTRTable_wrapper .dataTables_filter {
            margin-bottom: 1rem;
        }

        #reviewDTRTable_wrapper .dataTables_info,
        #reviewDTRTable_wrapper .dataTables_paginate {
            margin-top: 1rem;
        }

        /* ============================================
                           MAIN TABLE HEADER STYLING - LIGHT PURPLE
                           ============================================ */
        #reviewDTRTable thead tr:first-child th {
            background-color: #886cc0;
            color: white;
            font-weight: 600;
            border: 1px solid #7a5fb3;
            padding: 12px 8px;
        }

        #reviewDTRTable thead tr:nth-child(2) th.sub-header {
            background-color: #6b5b95;
            color: white;
            font-weight: 500;
            font-size: 0.85rem;
            border: 1px solid #5d4f82;
            padding: 10px 6px;
        }

        /* ============================================
                           MODAL TABLE HEADER STYLING - DEEP PURPLE
                           ============================================ */
        #employeeDetailsTable thead tr:first-child th {
            background-color: #886cc0;
            color: white;
            font-weight: 600;
            border: 1px solid #7a5fb3;
            padding: 12px 8px;
        }

        #employeeDetailsTable thead tr:nth-child(2) th.sub-header {
            background-color: #6b5b95;
            color: white;
            font-weight: 500;
            font-size: 0.85rem;
            border: 1px solid #5d4f82;
            padding: 10px 6px;
        }

        /* Column group borders */
        #reviewDTRTable thead tr:first-child th[colspan],
        #employeeDetailsTable thead tr:first-child th[colspan] {
            border-left: 2px solid #7a5fb3;
            border-right: 2px solid #7a5fb3;
        }

        /* Button Styling */
        .btn-sm {
            padding: 0.25rem 0.5rem;
            font-size: 0.875rem;
        }

        /* Modal Styling */
        .modal-content {
            border-radius: 0.5rem;
            box-shadow: 0 0.5rem 1rem rgba(0, 0, 0, 0.15);
        }

        /* Form Control Styling */
        .form-control:focus,
        .form-select:focus {
            border-color: #0d6efd;
            box-shadow: 0 0 0 0.2rem rgba(13, 110, 253, 0.25);
        }

        .card-header {
            border-bottom: none !important;
        }

        /* Select2 Styling */
        .select2-container .select2-selection--single {
            height: 38px;
            border: 1px solid #ced4da;
            border-radius: 0.375rem;
        }

        .select2-container--default .select2-selection--single .select2-selection__rendered {
            line-height: 36px;
            padding-left: 12px;
        }

        .select2-container--default .select2-selection--single .select2-selection__arrow {
            height: 36px;
        }

        .select2-container--default.select2-container--focus .select2-selection--single {
            border-color: #0d6efd;
            box-shadow: 0 0 0 0.2rem rgba(13, 110, 253, 0.25);
        }

        /* DataTables Column Alignment */
        .dt-right {
            text-align: right;
        }

        .btn-view-details {
            margin: 2px;
        }

        /* Modal Table */
        #employeeDetailsTable {
            font-size: 0.9rem;
        }

            #employeeDetailsTable tbody td {
                padding: 8px;
                vertical-align: middle;
            }

        #employeeDetailsTable_wrapper .dataTables_length,
        #employeeDetailsTable_wrapper .dataTables_filter {
            margin-bottom: 1rem;
        }

        #employeeDetailsTable_wrapper .dataTables_info,
        #employeeDetailsTable_wrapper .dataTables_paginate {
            margin-top: 1rem;
        }

        #employeeDetailsTable thead th:first-child,
        #employeeDetailsTable tbody td:first-child {
            min-width: 100px;
            white-space: nowrap;
        }

        #employeeDetailsTable thead th:nth-child(2),
        #employeeDetailsTable tbody td:nth-child(2) {
            min-width: 100px;
        }

        /* ============================================
                           COLUMN VISIBILITY DROPDOWN PANEL
                           ============================================ */
        #colVisPanel .col-vis-item {
            padding: 4px 6px;
            border-radius: 4px;
            transition: background-color 0.15s ease;
        }

            #colVisPanel .col-vis-item:hover {
                background-color: #f8f4ff;
            }

        #colVisPanel .form-check-input:checked {
            background-color: #886cc0;
            border-color: #886cc0;
        }

        #colVisPanel .form-check-input:focus {
            box-shadow: 0 0 0 0.2rem rgba(136, 108, 192, 0.25);
        }

        /* Badge on the Columns button when some groups are hidden */
        #btnToggleColVis .badge {
            vertical-align: middle;
        }

        /* Keep the panel above the DataTable */
        #colVisWrapper {
            z-index: 900;
        }

        #pendingRequestsTable thead tr th {
            background-color: #886cc0 !important;
            color: #fff !important;
            font-weight: 600;
            border: 1px solid #7a5fb3 !important;
        }
    </style>
}

@section Fillow_script
{
    <script>
        $(function () {

             $('#dateFrom, #dateTo').datepicker({
                format: 'mm/dd/yyyy',
                autoclose: true,
                todayHighlight: true
            });

            // ════════════════════════════════════════════════════════
            // RBAC — fetch access level first, then boot the page
            // The UI initialises immediately; only the Process DTR
            // button visibility waits for this one lightweight call.
            // ════════════════════════════════════════════════════════
            let dtrAccessLevel = 'READ'; // safest default
            let roleCode = '';            // populated after GetCurrentAccess

            const canEdit    = () => ['EDIT', 'READWRITE', 'FULL'].includes(dtrAccessLevel);
            const canProcess = () => ['READWRITE', 'FULL'].includes(dtrAccessLevel);

            // Fetch access level, apply gated UI once resolved
            $.get('/ReviewDTR/GetCurrentAccess', function (res) {
                dtrAccessLevel = res.accessLevel || 'READ';
                roleCode       = res.roleCode    || '';
                applyAccessUI();
            }).fail(function () {
                dtrAccessLevel = 'READ';
                roleCode       = '';
                applyAccessUI();
            });

            function applyAccessUI() {
                // HR CASUAL: Lock DTR only, no Process DTR, no Unlock
                if (dtrAccessLevel !== 'NO_ACCESS' && roleCode === 'HR CASUAL') {
                    $('#processDtr').hide();
                    $('#unlockDtr').hide();
                    $('#lockDtr').show().prop('disabled', true);
                    checkIfCasualLocked();
                }
                // Super Admin: Lock + Unlock toggle for Casual, keep Process DTR hidden for Casual scope
                else if (roleCode === 'RL-000000') {
                    $('#processDtr').show();
                    checkIfDtrPosted();
                    checkIfCasualLocked();
                }
                // Everyone else with process permission
                else if (canProcess()) {
                    $('#processDtr').show();
                    $('#lockDtr').hide();
                    $('#unlockDtr').hide();
                    checkIfDtrPosted();
                }
                // No permission
                else {
                    $('#processDtr').hide();
                    $('#lockDtr').hide();
                    $('#unlockDtr').hide();
                }
                // Expose edit flag to the employee detail partial
                window._dtrCanEdit = canEdit();
                // Expose full-access flag to the employee detail partial
                window._dtrIsFull  = dtrAccessLevel === 'FULL';
                // Show Pending Requests button for FULL access only
                if (dtrAccessLevel === 'FULL') {
                    $('#pendingRequestsWrapper').show();
                    loadPendingRequestsCount();
                } else {
                    $('#pendingRequestsWrapper').hide();
                }
