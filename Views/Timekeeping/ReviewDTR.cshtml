                    }, function (res) {
                        $btn.prop('disabled', false).html('<i class="fas fa-lock-open"></i> Unlock DTR');
                        if (!res.success) {
                            Swal.fire({ icon: 'error', title: 'Error', text: res.message });
                            return;
                        }
                        Swal.fire({
                            icon: 'success',
                            title: 'DTR Unlocked',
                            text: `${res.rowsUpdated} record(s) have been unlocked successfully.`
                        });
                        // Refresh to reflect unlocked state
                        summaryTable.ajax.reload(function () {
