            // ── Process DTR ──────────────────────────────────────────
            $('#processDtr').on('click', async function () {
                // Client-side guard (server also enforces via AccessHelper.CanCreate)
                if (!canProcess()) {
                    Swal.fire({ icon: 'error', title: 'Access Denied',
                                text: 'You do not have permission to process DTR.' });
                    return;
                }

                const dateFrom   = $('#dateFrom').val();
                const dateTo     = $('#dateTo').val();
                const branchCode = $('#filterBranch').val();
                const cutOffType = $('#cutOffType').val();
                const dateMonth  = $('#dateMonth option:selected').text();

                const tableData = $('#reviewDTRTable').DataTable().rows().data().toArray();
                const employees = tableData.filter(x => x.totalPresentDays > 0);

                if (employees.length === 0) {
                    Swal.fire('No employees to process');
                    return;
                }

                const modal = new bootstrap.Modal('#processDtrModal');
                modal.show();
                $('#processCounter').text(`0 / ${employees.length}`);

                let processed = 0;

                for (let i = 0; i < employees.length; i++) {
                    const emp = employees[i];
                    $('#currentEmployeeName').text(emp.fullName);
                    $('#processCounter').text(`${i + 1} / ${employees.length}`);

                    const result = await $.ajax({
                        url: '/ReviewDTR/ProcessEmployeeDTR',
                        type: 'POST',
                        data: { employeeNo: emp.employeeNo, dateFrom, dateTo, branchCode, cutOffType, dateMonth }
                    });

                    // Stop immediately if the server rejects a record
                    if (result && result.success === false) {
                        modal.hide();
                        Swal.fire({ icon: 'error', title: 'Error', text: result.message });
                        return;
                    }

                    processed++;
                }

                modal.hide();

                Swal.fire({
                    icon: 'success',
                    title: 'DTR Processing Complete',
                    text: `${processed} employee(s) processed`
                });
            });

            // ── Lock DTR ─────────────────────────────────────────────────────
            $('#lockDtr').on('click', function () {
                const dateFrom   = $('#dateFrom').val();
                const dateTo     = $('#dateTo').val();
                const cutOffType = $('#cutOffType').val();
                const dateMonth  = $('#dateMonth option:selected').text();
                const branch     = $('#filterBranch').val();

                // All filters must be filled
                if (!branch || !dateFrom || !dateTo || !cutOffType || !dateMonth || dateMonth === 'Select Month') {
                    Swal.fire({
                        icon: 'warning',
                        title: 'Incomplete Filters',
                        text: 'Please select Branch, Month, Cut-off, Year, Date From, and Date To before locking.'
                    });
                    return;
                }

                // Data must be loaded (button is disabled until filter is clicked — this is a safety net)
                if ($('#reviewDTRTable').DataTable().rows().count() === 0) {
                    Swal.fire({
                        icon: 'warning',
                        title: 'No Data',
                        text: 'Please filter first and ensure data is loaded before locking.'
                    });
                    return;
                }

                Swal.fire({
                    icon: 'warning',
                    title: 'Lock DTR?',
                    html: `This will lock all <strong>Casual</strong> branch records for
                           <strong>${dateMonth}</strong> — <strong>Cut-off ${cutOffType}</strong>
                           (<strong>${dateFrom}</strong> to <strong>${dateTo}</strong>).<br><br>
                           This action <strong>cannot be undone</strong>.`,
                    showCancelButton: true,
                    confirmButtonText: 'Yes, Lock',
                    cancelButtonText: 'Cancel',
                    confirmButtonColor: '#dc3545',
                    cancelButtonColor: '#6c757d'
                }).then(function (result) {
                    if (!result.isConfirmed) return;

                    const $btn = $('#lockDtr');
                    $btn.prop('disabled', true).html('<i class="fas fa-spinner fa-spin"></i> Locking...');

                    $.post('/ReviewDTR/LockDTR', {
                        dateFrom,
                        dateTo,
                        cutOffType,
                        dateMonth
                    }, function (res) {
                        $btn.prop('disabled', false).html('<i class="fas fa-lock"></i> Lock DTR');
                        if (!res.success) {
                            Swal.fire({ icon: 'error', title: 'Error', text: res.message });
                            return;
                        }
                        Swal.fire({
                            icon: 'success',
                            title: 'DTR Locked',
                            text: `${res.rowsUpdated} record(s) have been locked successfully.`
                        });
                        // Refresh to show locked state
                        summaryTable.ajax.reload(function () {
                            checkIfCasualLocked();
                        });
                    }).fail(function () {
                        $btn.prop('disabled', false).html('<i class="fas fa-lock"></i> Lock DTR');
                        Swal.fire({ icon: 'error', title: 'Error', text: 'Failed to lock DTR.' });
                    });
                });
            });

            // ── Unlock DTR ───────────────────────────────────────────────────
