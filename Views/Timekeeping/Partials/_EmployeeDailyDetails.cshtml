<!-- ============================================================
     COMBINED TIME IN / TIME OUT EDITOR MODAL
     Opens on double-click of either cell.
     ============================================================ -->
<div class="modal fade" id="combinedTimeModal" tabindex="-1"
     data-bs-backdrop="static" data-bs-keyboard="false">
    <div class="modal-dialog modal-dialog-centered" style="max-width:520px;">
        <div class="modal-content"
             style="border-radius:12px;border:none;
                    box-shadow:0 8px 32px rgba(136,108,192,0.18);">

            <div class="modal-header"
                 style="background:linear-gradient(135deg,#886cc0 0%,#6b5b95 100%);
                        border-radius:12px 12px 0 0;border:none;">
                <div class="d-flex align-items-center gap-2">
                    <div style="background:rgba(255,255,255,0.2);border-radius:8px;
                                width:36px;height:36px;display:flex;
                                align-items:center;justify-content:center;">
                        <i class="fas fa-clock" style="color:#fff;font-size:1rem;"></i>
                    </div>
                    <div>
                        <h6 class="mb-0 fw-bold text-white" id="combinedModalTitle">
                            Edit Time Record
                        </h6>
                        <small class="text-white-50" id="combinedModalSubtitle"></small>
                    </div>
                </div>
                <button type="button" class="btn-close btn-close-white"
                        id="btnCloseCombinedModal"></button>
            </div>

            <div class="modal-body p-4">

                <!-- Info banner for EDIT/READWRITE users -->
                <div id="combinedRequestBanner"
                     class="d-flex align-items-start gap-2 p-3 mb-3"
                     style="background:#f8f4ff;border:1px solid #d4c8f0;
                            border-radius:8px;border-left:4px solid #886cc0;display:none!important;">
                    <i class="fas fa-info-circle mt-1"
                       style="color:#886cc0;font-size:0.9rem;flex-shrink:0;"></i>
                    <div style="font-size:0.83rem;color:#5d4f82;line-height:1.5;">
                        Your changes will be submitted as a <strong>Pending Request</strong>
                        and must be approved before taking effect.
                    </div>
                </div>

                <!-- Work Date (read-only) -->
                <div class="mb-3">
                    <label class="form-label fw-semibold" style="font-size:0.85rem;">Work Date</label>
                    <input type="text" id="combinedWorkDate" class="form-control form-control-sm"
                           readonly style="background:#e9ecef;cursor:not-allowed;">
                </div>

                <!-- TIME IN row -->
                <div class="mb-3">
                    <label class="form-label fw-semibold" style="font-size:0.85rem;">
                        Time In
                        <small class="text-muted fw-normal ms-1">(leave unchanged to keep original)</small>
                    </label>
                    <div id="combinedTIPickerWrap"></div>
                    <input type="hidden" id="combinedTIHidden">
                    <!-- shows original value for reference -->
                    <small class="text-muted" id="combinedTIOrigLabel" style="font-size:0.75rem;"></small>
                </div>

                <!-- TIME OUT row -->
                <div class="mb-3">
                    <label class="form-label fw-semibold" style="font-size:0.85rem;">
                        Time Out
                        <small class="text-muted fw-normal ms-1">(leave unchanged to keep original)</small>
                    </label>
                    <!-- Date out selector (for overnight shifts) -->
                    <div class="mb-2">
                        <label class="form-label" style="font-size:0.78rem;color:#666;">Date Out</label>
                        <input type="text" id="combinedTODate"
                               class="form-control form-control-sm bt-datepicker-combined"
                               placeholder="yyyy-mm-dd">
                    </div>
                    <div id="combinedTOPickerWrap"></div>
                    <input type="hidden" id="combinedTOHidden">
                    <small class="text-muted" id="combinedTOOrigLabel" style="font-size:0.75rem;"></small>
                </div>

                <!-- Reason (only shown for EDIT/READWRITE request flow) -->
                <div id="combinedReasonWrap" style="display:none;">
                    <label class="form-label fw-semibold"
                           style="font-size:0.85rem;color:#444;">
                        Reason for Modification <span class="text-danger">*</span>
                    </label>
                    <textarea id="combinedReasonInput" class="form-control" rows="3"
                              maxlength="500"
                              placeholder="Please explain why you are requesting this time modification..."
                              style="border-color:#d4c8f0;border-radius:8px;
                                     font-size:0.875rem;resize:none;"></textarea>
                    <div class="d-flex justify-content-between mt-1">
                        <small class="text-danger d-none" id="combinedReasonError">
                            Reason is required.
                        </small>
                        <small class="ms-auto text-muted" id="combinedReasonCount"
                               style="font-size:0.75rem;">0 / 500</small>
                    </div>
                </div>
            </div>

            <div class="modal-footer border-0 px-4 pb-4 pt-0 gap-2">
