            <input type="hidden" id="cancelPendingWorkDate">
            <input type="hidden" id="cancelPendingUBioId">
        </div>
    </div>
</div>

<style>
    /* ── EDITABLE CELL BASE ─────────────────────────────────────────── */
    .timein-cell,
    .timeout-cell {
        display: inline-block;
        min-width: 130px;
        min-height: 36px;
        padding: 7px 7px;
        border: 1.5px dashed #886cc0;
        border-radius: 5px;
        cursor: pointer;
        transition: border-color 0.2s, background 0.2s;
        font-size: 0.875rem;
        background: #faf8ff;
        position: relative;
        vertical-align: middle;
    }

        .timein-cell:hover, .timeout-cell:hover {
            border-color: #5d2d91;
            background: #f0eaff;
        }

        .timein-cell::after, .timeout-cell::after {
            content: "✎ double-click to edit";
            position: absolute;
            bottom: calc(100% + 4px);
            left: 50%;
            transform: translateX(-50%);
            background: #5d2d91;
            color: #fff;
            font-size: 0.68rem;
            white-space: nowrap;
            padding: 2px 7px;
            border-radius: 4px;
            opacity: 0;
            pointer-events: none;
            transition: opacity 0.15s;
            z-index: 99;
        }

        .timein-cell:hover::after, .timeout-cell:hover::after {
            opacity: 1;
        }

        /* Approved / FULL-access saved — solid purple */
        .timein-cell.edited-manually, .timeout-cell.edited-manually {
            color: #6b21a8;
            font-weight: 600;
            border-style: solid;
            border-color: #6b21a8;
        }

        /* ── PENDING STATE ───────────────────────────────────────────────── */
        .timein-cell.pending-request,
        .timeout-cell.pending-request {
            border-style: solid !important;
            border-color: #f59e0b !important;
            background: #fffbeb !important;
            color: inherit !important;
            font-weight: normal !important;
        }

            .timein-cell.pending-request::after,
            .timeout-cell.pending-request::after {
                display: none;
            }

            .timein-cell.pending-request:hover,
            .timeout-cell.pending-request:hover {
                border-color: #d97706 !important;
                background: #fef3c7 !important;
            }

        /* READ-ONLY — no dashed border, no tooltip */
        .timein-cell.readonly-cell,
        .timeout-cell.readonly-cell {
            border-style: none !important;
            background: transparent !important;
            cursor: default !important;
        }

        .timein-cell.readonly-cell::after,
        .timeout-cell.readonly-cell::after {
            display: none !important;
        }

        /* ── LOCKED CELL — payroll posted, no interaction allowed ────── */
        .timein-cell.locked-cell,
        .timeout-cell.locked-cell {
            border-style: solid !important;
            border-color: #adb5bd !important;
            background: #f8f9fa !important;
            color: #6c757d !important;
            cursor: not-allowed !important;
            font-weight: normal !important;
        }

            .timein-cell.locked-cell::after,
            .timeout-cell.locked-cell::after {
                display: none !important;
            }

            .timein-cell.locked-cell:hover,
            .timeout-cell.locked-cell:hover {
                border-color: #adb5bd !important;
                background: #f8f9fa !important;
            }

    .pending-badge {
        display: inline-flex;
        align-items: center;
        gap: 4px;
        font-size: 0.72rem;
        font-weight: 600;
        color: #92400e;
        background: #fde68a;
        border-radius: 4px;
        padding: 1px 6px;
        margin-top: 3px;
