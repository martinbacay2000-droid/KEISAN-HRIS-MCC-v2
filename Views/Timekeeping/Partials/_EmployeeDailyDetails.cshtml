    $(document).on('click', '#btnExportEmployeeDetail', function () {
        var $btn = $(this);
        if (!_currentDetailEmpNo) {
            Swal.fire({ icon:'warning', title:'No Data', text:'No employee data loaded yet.' });
            return;
        }
        var params = new URLSearchParams({
            employeeNo:   _currentDetailEmpNo,
            employeeName: _currentDetailEmpName,
            dateFrom:     _currentDetailFrom,
            dateTo:       _currentDetailTo,
            branchCode:   _currentDetailBranch || ''
        });
        var originalHtml = $btn.html();
        $btn.prop('disabled', true)
            .html('<i class="fas fa-spinner fa-spin me-1"></i> Exporting...');
        var link = document.createElement('a');
        link.href = '/ReviewDTREmployeeDetailExport/ExportToExcel?' + params.toString();
        link.download = '';
        document.body.appendChild(link);
        link.click();
        document.body.removeChild(link);
        setTimeout(function () { $btn.prop('disabled', false).html(originalHtml); }, 1500);
    });

    // ================================================================
    // initEmployeeDetailsTable
    // ================================================================
    function initEmployeeDetailsTable(empNo, dateFrom, dateTo, branchCode) {
       _currentDetailEmpNo  = empNo;
        _currentDetailFrom   = dateFrom;
        _currentDetailTo     = dateTo;
        _currentDetailBranch = branchCode;

        window._currentCutOffType = $('#cutOffType').val()  || '';
        window._currentDateMonth  = $('#dateMonth').val()   || '';
        window._currentDateYear   = $('#dateYear').val()    || '';

        var empRow = $('#reviewDTRTable').DataTable().rows().data().toArray()
                         .find(function(r) { return r.employeeNo === empNo; });
        _currentDetailEmpName = empRow ? (empRow.fullName || '') : '';

        _dtrIsPosted = false;
        renderAccessBadge();

        $.get('/ReviewDTR/IsDateRangePosted', { dateFrom: dateFrom, dateTo: dateTo, branchCode: branchCode })
            .always(function (res) {
                _dtrIsPosted = !!(res && res.posted);
                renderAccessBadge();

                if ($.fn.DataTable.isDataTable('#employeeDetailsTable')) {
                    $('#employeeDetailsTable').DataTable().destroy();
                }

                $('#employeeDetailsTable').DataTable({
                    paginate: false,
                    processing: true,
                    ajax: {
                        url: '/ReviewDTR/GetEmployeeDailyData',
                        type: 'GET',
                        data: { employeeNo: empNo, dateFrom, dateTo, branchCode }
                    },
                    columns: [
                        { data: 'workDate' },
                        { data: 'weekDayName' },
                        { data: 'scheduleTimeIn',  render: formatDateTime },
                        { data: 'scheduleTimeOut', render: formatDateTime },

                        // ── TIME IN CELL ──────────────────────────────────────────────
                        // FIX 3: tstatusName and tTimeIn now come correctly from the server.
                        // 'pending'  → yellow cell + cancel link (if tTimeIn is set)
                        // 'modified' → purple/bold cell (admin saved directly, no pending)
                        // null       → normal dashed purple cell (unedited)
                        {
                            data: 'biometricsDateIn',
                            render: function (data, type, row) {
                                // A cell is "pending" only if THIS side was part of the request
                                const isPendingTI = row.tstatusName === 'pending' && !!row.tTimeIn;
                                const isModified  = row.tstatusName === 'modified';
                                const uBioId      = row.tid || '';
                                const workDate    = row.workDate;
                                const empNo       = row.employeeNo;

                                const displayValue = isPendingTI
                                    ? formatDateTime(row.tTimeIn)
                                    : (data ? formatDateTime(data) : '');

                                // ── POSTED LOCK ───────────────────────────────────────
                                if (_dtrIsPosted) {
                                    return _renderLockedCell('timein-cell', empNo, workDate, data, uBioId, displayValue);
                                }

                                if (!canEditBiometrics()) {
                                    return `<span class="timein-cell readonly-cell"
                                                  data-employee="${empNo}"
                                                  data-workdate="${workDate}"
                                                  data-original="${data || ''}"
                                                  data-ubio-id="${uBioId}">
                                                ${displayValue}
                                            </span>`;
                                }

                                if (isPendingTI) {
                                    return `
                                        <span class="timein-cell pending-request"
                                              data-employee="${empNo}"
                                              data-workdate="${workDate}"
                                              data-original="${data || ''}"
                                              data-ubio-id="${uBioId}">
                                            ${displayValue || '(no time)'}
                                            <span class="pending-badge">
                                                <i class="fas fa-hourglass-half"
                                                   style="font-size:0.65rem;"></i> Pending
                                            </span>
                                            <a class="cancel-pending-link"
                                               data-employee="${empNo}"
                                               data-workdate="${workDate}"
                                               data-ubio-id="${uBioId}">
                                                <i class="fas fa-times-circle"></i> Cancel Request
                                            </a>
                                        </span>`;
                                }

                                const editedCls = (isModified && row.isTimeInManuallyEdited) ? 'edited-manually' : '';
                                const showUndoTI = isFullAccess() && isModified && row.isTimeInManuallyEdited;
                                return `
                                    <span class="timein-cell ${editedCls}"
                                          data-employee="${empNo}"
                                          data-workdate="${workDate}"
                                          data-original="${data || ''}"
                                          data-ubio-id="${uBioId}">
                                        ${displayValue}
                                        ${showUndoTI ? `<a class="undo-edit-link"
                                                           data-employee="${empNo}"
                                                           data-workdate="${workDate}"
                                                           data-ubio-id="${uBioId}">
                                                           <i class="fas fa-undo"></i> Undo Edit
                                                        </a>` : ''}
                                    </span>`;
                            }
                        },

                        // ── TIME OUT CELL ─────────────────────────────────────────────
                        // FIX 2 + 3: Cancel link only appears here if tTimeOut was set
                        // (meaning Time Out was part of the pending request).
                            // TIME OUT CELL:
                        {
                            data: 'biometricsDateOut',
                            render: function (data, type, row) {
                                // Only pending if THIS side was part of the request
                                const isPendingTO = row.tstatusName === 'pending' && !!row.tTimeOut;
                                const isModified  = row.tstatusName === 'modified';
                                const uBioId      = row.tid || '';
                                const workDate    = row.workDate;
                                const empNo       = row.employeeNo;

                                const displayValue = isPendingTO
                                    ? formatDateTime(row.tTimeOut)
                                    : (data ? formatDateTime(data) : '');

                                // ── POSTED LOCK ───────────────────────────────────────
                                if (_dtrIsPosted) {
                                    return _renderLockedCell('timeout-cell', empNo, workDate, data, uBioId, displayValue);
                                }

                                if (!canEditBiometrics()) {
                                    return `<span class="timeout-cell readonly-cell"
                                                  data-employee="${empNo}"
                                                  data-workdate="${workDate}"
                                                  data-original="${data || ''}"
                                                  data-ubio-id="${uBioId}">
                                                ${displayValue}
                                            </span>`;
                                }

                                if (isPendingTO) {
                                    return `
                                        <span class="timeout-cell pending-request"
                                              data-employee="${empNo}"
                                              data-workdate="${workDate}"
                                              data-original="${data || ''}"
                                              data-ubio-id="${uBioId}">
                                            ${displayValue || '(no time)'}
                                            <span class="pending-badge">
                                                <i class="fas fa-hourglass-half"
                                                   style="font-size:0.65rem;"></i> Pending
                                            </span>
                                            <a class="cancel-pending-link"
                                               data-employee="${empNo}"
                                               data-workdate="${workDate}"
                                               data-ubio-id="${uBioId}">
                                                <i class="fas fa-times-circle"></i> Cancel Request
                                            </a>
                                        </span>`;
                                }

                                const editedCls = (isModified && row.isTimeOutManuallyEdited) ? 'edited-manually' : '';
                                const showUndoTO = isFullAccess() && isModified && row.isTimeOutManuallyEdited;
                                return `
                                    <span class="timeout-cell ${editedCls}"
                                          data-employee="${empNo}"
                                          data-workdate="${workDate}"
                                          data-original="${data || ''}"
                                          data-ubio-id="${uBioId}">
                                        ${displayValue}
                                        ${showUndoTO ? `<a class="undo-edit-link"
                                                           data-employee="${empNo}"
                                                           data-workdate="${workDate}"
                                                           data-ubio-id="${uBioId}">
                                                           <i class="fas fa-undo"></i> Undo Edit
                                                        </a>` : ''}
                                    </span>`;
                            }
                        },

                        { data: 'remarks' },
                        { data: 'lateMinutesFormatted',      defaultContent: '0 min' },
                        { data: 'underTimeMinutesFormatted', defaultContent: '0 min' },
                        { data: 'ndHoursFormatted',            defaultContent: '0 hrs' },
                        { data: 'overtimeDateTimeIn',          render: formatDateTime },
                        { data: 'overTimeDateTimeOUT',         render: formatDateTime },
                        { data: 'otReason' },
                        { data: 'otHoursFormatted',            defaultContent: '0 hrs' },
                        { data: 'rdHoursFormatted',              defaultContent: '0 hrs' },
                        { data: 'rdotHoursFormatted',            defaultContent: '0 hrs' },
                        { data: 'rdndotHoursFormatted',          defaultContent: '0 hrs' },
                        { data: 'holidayName' },
                        { data: 'splHolidayHoursFormatted',      defaultContent: '0 hrs' },
                        { data: 'splHolidayOTHoursFormatted',    defaultContent: '0 hrs' },
                        { data: 'splHolidayNDHoursFormatted',    defaultContent: '0 hrs' },
                        { data: 'splHolidayNDOTHoursFormatted',  defaultContent: '0 hrs' },
                        { data: 'splHolidayRESTHoursFormatted',      defaultContent: '0 hrs' },
                        { data: 'splHolidayRESTOTHoursFormatted',    defaultContent: '0 hrs' },
                        { data: 'splHolidayRESTNDHoursFormatted',    defaultContent: '0 hrs' },
                        { data: 'splHolidayRESTNDOTHoursFormatted',  defaultContent: '0 hrs' },
                        { data: 'regHolidayHoursFormatted',      defaultContent: '0 hrs' },
                        { data: 'regHolidayOTHoursFormatted',    defaultContent: '0 hrs' },
                        { data: 'regHolidayNDHoursFormatted',    defaultContent: '0 hrs' },
                        { data: 'regHolidayNDOTHoursFormatted',  defaultContent: '0 hrs' },
                        { data: 'regHolidayRESTHoursFormatted',      defaultContent: '0 hrs' },
                        { data: 'regHolidayRESTOTHoursFormatted',    defaultContent: '0 hrs' },
                        { data: 'regHolidayRESTNDHoursFormatted',    defaultContent: '0 hrs' },
                        { data: 'regHolidayRESTNDOTHoursFormatted',  defaultContent: '0 hrs' },
                        { data: 'leaveName' },
                        { data: 'leaveReason' },
                        { data: 'obReason' },
                        { data: 'wfhReason' }
                    ]
                });
            }); // closes .always()
    }
</script>