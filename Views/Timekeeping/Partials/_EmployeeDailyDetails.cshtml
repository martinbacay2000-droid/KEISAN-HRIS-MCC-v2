</style>

<script>
    // ================================================================
    // UTILITIES
    // ================================================================
    function formatDateTime(value) {
        if (!value) return '';
        const d = new Date(value);
        if (isNaN(d)) return '';
        return d.toLocaleString('en-US', {
            year:'numeric', month:'2-digit', day:'2-digit',
            hour:'2-digit', minute:'2-digit'
        });
    }

    // ── Context tracking ─────────────────────────────────────────────
    var _currentDetailEmpNo   = '';
    var _currentDetailEmpName = '';
    var _currentDetailFrom    = '';
    var _currentDetailTo      = '';
    var _currentDetailBranch  = '';

    // State for the open combined editor
    var _combinedCtx = {};

    // Whether the currently loaded date range overlaps a posted payroll period.
    // When true, ALL cells render as locked regardless of access level.
    var _dtrIsPosted = false;

    // Renders a fully locked time cell for posted payroll periods.
    // No hover tooltip, no double-click handler, lock icon + grey styling.
    function _renderLockedCell(cssClass, empNo, workDate, originalData, uBioId, displayValue) {
        return `<span class="${cssClass} locked-cell"
                      data-employee="${empNo}"
                      data-workdate="${workDate}"
                      data-original="${originalData || ''}"
                      data-ubio-id="${uBioId}"
                      title="Payroll posted — this record is locked">
                    <i class="fas fa-lock"
                       style="font-size:0.65rem;color:#adb5bd;margin-right:3px;"></i>${displayValue}
                </span>`;
    }

    // ── RBAC helpers ─────────────────────────────────────────────────

    // function canEditBiometrics() { return window._dtrCanEdit === true; }

    function canEditBiometrics() {
        // Posted payroll period overrides ALL access levels — nobody can edit
        if (_dtrIsPosted) return false;
        return window._dtrCanEdit === true;
    }
    function isFullAccess()      { return window._dtrIsFull  === true; }

    // function renderAccessBadge() {
    //     const $b = $('#dtrAccessBadge');
    //     if (isFullAccess()) {
    //         $b.text('Full Access').css({ background:'#886cc0', color:'#fff' });
    //     } else if (canEditBiometrics()) {
    //         $b.text('Edit — Request Required').css({ background:'#f59e0b', color:'#fff' });
    //     } else {
    //         $b.text('View Only').css({ background:'#6c757d', color:'#fff' });
    //     }
    // }

    function renderAccessBadge() {
        const $b = $('#dtrAccessBadge');
        // Posted lock takes priority and is shown before any access-level badge
        if (_dtrIsPosted) {
            $b.html('<i class="fas fa-lock me-1"></i> Payroll Posted — Locked')
              .css({ background: '#dc3545', color: '#fff' });
            return;
        }
        if (isFullAccess()) {
            $b.text('Full Access').css({ background:'#886cc0', color:'#fff' });
        } else if (canEditBiometrics()) {
            $b.text('Edit — Request Required').css({ background:'#f59e0b', color:'#fff' });
        } else {
            $b.text('View Only').css({ background:'#6c757d', color:'#fff' });
        }
    }

    // ================================================================
    // SEGMENTED TIME PICKER
    // (BUG 1 already fixed in original — bind to editor div, not cell)
    // ================================================================
    function buildSegmentedTimePicker(existingTime24, hiddenClass) {
        let hh = '08', mm = '00', ampm = 'AM';
        if (existingTime24) {
            const parts = existingTime24.split(':');
            let hours = parseInt(parts[0], 10);
            mm   = parts[1] ? String(parseInt(parts[1], 10)).padStart(2, '0') : '00';
            ampm = hours >= 12 ? 'PM' : 'AM';
            hours = hours % 12 || 12;
            hh   = String(hours).padStart(2, '0');
        }
        return `
            <div class="seg-time-picker">
                <div class="seg-time-inner">
                    <div class="seg-block">
                        <button type="button" class="seg-btn seg-up" data-target="hh"
                                tabindex="-1">▲</button>
                        <input type="text" class="seg-input seg-hh alphanum"
                               maxlength="2" value="${hh}"
                               inputmode="numeric"
                               autocomplete="off"
                               placeholder="hh"
                               title="Hour (1–12)">
                        <button type="button" class="seg-btn seg-down" data-target="hh"
                                tabindex="-1">▼</button>
                    </div>
                    <div class="seg-sep">:</div>
                    <div class="seg-block">
                        <button type="button" class="seg-btn seg-up" data-target="mm"
                                tabindex="-1">▲</button>
                        <input type="text" class="seg-input seg-mm alphanum"
                               maxlength="2" value="${mm}"
                               inputmode="numeric"
                               autocomplete="off"
                               placeholder="mm"
                               title="Minute (00–59)">
                        <button type="button" class="seg-btn seg-down" data-target="mm"
                                tabindex="-1">▼</button>
                    </div>
                    <div class="seg-block seg-block-ampm">
                        <button type="button" class="seg-btn seg-up" data-target="ampm"
                                tabindex="-1">▲</button>
                        <input type="text" class="seg-input seg-ampm"
                               readonly value="${ampm}"
                               title="Press A for AM, P for PM, or Space/arrows to toggle">
                        <button type="button" class="seg-btn seg-down" data-target="ampm"
                                tabindex="-1">▼</button>
                    </div>
                </div>
                <input type="hidden" class="${hiddenClass} seg-time-value">
            </div>`;
    }

    function syncSegmentedValue($picker) {
        let hh = parseInt($picker.find('.seg-hh').val(), 10);
        let mm = parseInt($picker.find('.seg-mm').val(), 10);
        const ampm = $picker.find('.seg-ampm').val();
        if (isNaN(hh) || isNaN(mm)) return;
        hh = Math.min(Math.max(hh, 1), 12);
        mm = Math.min(Math.max(mm, 0), 59);
        const h24 = ampm === 'PM' ? (hh === 12 ? 12 : hh + 12) : (hh === 12 ? 0 : hh);
        $picker.find('.seg-time-value').val(
            String(h24).padStart(2, '0') + ':' + String(mm).padStart(2, '0') + ':00');
    }

    function finalizeSegmentedValue($picker) {
        let hh = parseInt($picker.find('.seg-hh').val(), 10);
        let mm = parseInt($picker.find('.seg-mm').val(), 10);
        const ampm = $picker.find('.seg-ampm').val();
        if (isNaN(hh) || hh < 1) hh = 1;
        if (hh > 12) hh = 12;
        if (isNaN(mm) || mm < 0) mm = 0;
        if (mm > 59) mm = 59;
        $picker.find('.seg-hh').val(String(hh).padStart(2, '0'));
        $picker.find('.seg-mm').val(String(mm).padStart(2, '0'));
        const h24 = ampm === 'PM' ? (hh === 12 ? 12 : hh + 12) : (hh === 12 ? 0 : hh);
        $picker.find('.seg-time-value').val(
            String(h24).padStart(2, '0') + ':' + String(mm).padStart(2, '0') + ':00');
    }

    function bindSegmentedPicker($container) {

        // ── arrow buttons ────────────────────────────────────────────────
        $container.find('.seg-up').on('click', function (e) {
            e.preventDefault(); e.stopPropagation();
            const $p = $(this).closest('.seg-time-picker');
            const t  = $(this).data('target');
            if (t === 'hh') {
                let v = parseInt($p.find('.seg-hh').val(), 10);
                if (isNaN(v)) v = 8;
                v = v >= 12 ? 1 : v + 1;
                $p.find('.seg-hh').val(String(v).padStart(2, '0'));
            } else if (t === 'mm') {
                let v = parseInt($p.find('.seg-mm').val(), 10);
                if (isNaN(v)) v = 0;
                v = v >= 59 ? 0 : v + 1;
                $p.find('.seg-mm').val(String(v).padStart(2, '0'));
            } else {
                const $a = $p.find('.seg-ampm');
                $a.val($a.val() === 'AM' ? 'PM' : 'AM');
            }
            syncSegmentedValue($p);
        });

        $container.find('.seg-down').on('click', function (e) {
            e.preventDefault(); e.stopPropagation();
            const $p = $(this).closest('.seg-time-picker');
            const t  = $(this).data('target');
            if (t === 'hh') {
                let v = parseInt($p.find('.seg-hh').val(), 10);
                if (isNaN(v)) v = 8;
                v = v <= 1 ? 12 : v - 1;
                $p.find('.seg-hh').val(String(v).padStart(2, '0'));
            } else if (t === 'mm') {
                let v = parseInt($p.find('.seg-mm').val(), 10);
                if (isNaN(v)) v = 0;
                v = v <= 0 ? 59 : v - 1;
                $p.find('.seg-mm').val(String(v).padStart(2, '0'));
            } else {
                const $a = $p.find('.seg-ampm');
                $a.val($a.val() === 'AM' ? 'PM' : 'AM');
            }
            syncSegmentedValue($p);
        });

        // ── select-all on focus ──────────────────────────────────────────
        $container.find('.seg-hh, .seg-mm').on('focus', function () {
            $(this).select();
        });

        // ── keydown: HH ─────────────────────────────────────────────────
        $container.find('.seg-hh').on('keydown', function (e) {
            const $p  = $(this).closest('.seg-time-picker');
            const key = e.key;

            if (['Backspace', 'Delete', 'ArrowLeft', 'ArrowRight', 'Tab'].includes(key)) return;

            if (key === 'ArrowUp') {
                e.preventDefault();
                let v = parseInt($(this).val(), 10);
                if (isNaN(v)) v = 8;
                v = v >= 12 ? 1 : v + 1;
                $(this).val(String(v).padStart(2, '0'));
                syncSegmentedValue($p);
                return;
            }
            if (key === 'ArrowDown') {
                e.preventDefault();
                let v = parseInt($(this).val(), 10);
                if (isNaN(v)) v = 8;
                v = v <= 1 ? 12 : v - 1;
                $(this).val(String(v).padStart(2, '0'));
                syncSegmentedValue($p);
                return;
            }

            if (key < '0' || key > '9') { e.preventDefault(); return; }

            // Auto-advance to MM after second digit
            const isAllSelected = this.selectionStart === 0 && this.selectionEnd === this.value.length;
            if (!isAllSelected) {
                setTimeout(function () {
                    $p.find('.seg-mm').focus().select();
                }, 0);
            }
        });

        // ── keydown: MM ─────────────────────────────────────────────────
        $container.find('.seg-mm').on('keydown', function (e) {
            const $p  = $(this).closest('.seg-time-picker');
            const key = e.key;

            if (['Backspace', 'Delete', 'ArrowLeft', 'ArrowRight', 'Tab'].includes(key)) return;

            if (key === 'ArrowUp') {
                e.preventDefault();
                let v = parseInt($(this).val(), 10);
                if (isNaN(v)) v = 0;
                v = v >= 59 ? 0 : v + 1;
                $(this).val(String(v).padStart(2, '0'));
                syncSegmentedValue($p);
                return;
            }
            if (key === 'ArrowDown') {
                e.preventDefault();
                let v = parseInt($(this).val(), 10);
                if (isNaN(v)) v = 0;
                v = v <= 0 ? 59 : v - 1;
                $(this).val(String(v).padStart(2, '0'));
                syncSegmentedValue($p);
                return;
            }

            if (key < '0' || key > '9') { e.preventDefault(); return; }

            // Auto-advance to AM/PM after second digit
            const isAllSelected = this.selectionStart === 0 && this.selectionEnd === this.value.length;
            if (!isAllSelected) {
                setTimeout(function () {
                    $p.find('.seg-ampm').focus().select();
                }, 0);
            }
        });

        // ── keydown: AM/PM — A/P/Space/arrows to toggle ─────────────────
        $container.find('.seg-ampm').on('keydown', function (e) {
            const $p  = $(this).closest('.seg-time-picker');
            const key = e.key;

            if (key === 'Tab') return;

            e.preventDefault();

            if (key === 'a' || key === 'A') {
                $(this).val('AM');
            } else if (key === 'p' || key === 'P') {
                $(this).val('PM');
            } else if (key === ' ' || key === 'ArrowUp' || key === 'ArrowDown') {
                $(this).val($(this).val() === 'AM' ? 'PM' : 'AM');
            }

            syncSegmentedValue($p);
        });

        // ── input: digits-only scrub + live sync ─────────────────────────
        $container.find('.seg-hh').on('input', function () {
            const $p = $(this).closest('.seg-time-picker');
            $(this).val($(this).val().replace(/[^0-9]/g, ''));
            syncSegmentedValue($p);
        });

        $container.find('.seg-mm').on('input', function () {
            const $p = $(this).closest('.seg-time-picker');
            $(this).val($(this).val().replace(/[^0-9]/g, ''));
            syncSegmentedValue($p);
        });

        // ── blur: clamp + zero-pad ───────────────────────────────────────
        $container.find('.seg-hh').on('blur', function () {
            finalizeSegmentedValue($(this).closest('.seg-time-picker'));
        });

        $container.find('.seg-mm').on('blur', function () {
            finalizeSegmentedValue($(this).closest('.seg-time-picker'));
        });

        // ── mouse wheel: HH ──────────────────────────────────────────────
        $container.find('.seg-hh').on('wheel', function (e) {
            e.preventDefault(); e.stopPropagation();
            const $p = $(this).closest('.seg-time-picker');
            let v = parseInt($p.find('.seg-hh').val(), 10);
            if (isNaN(v)) v = 8;
            v = e.originalEvent.deltaY < 0 ? (v >= 12 ? 1 : v + 1) : (v <= 1 ? 12 : v - 1);
            $p.find('.seg-hh').val(String(v).padStart(2, '0'));
            syncSegmentedValue($p);
        });

        // ── mouse wheel: MM ──────────────────────────────────────────────
        $container.find('.seg-mm').on('wheel', function (e) {
            e.preventDefault(); e.stopPropagation();
            const $p = $(this).closest('.seg-time-picker');
            let v = parseInt($p.find('.seg-mm').val(), 10);
            if (isNaN(v)) v = 0;
            v = e.originalEvent.deltaY < 0 ? (v >= 59 ? 0 : v + 1) : (v <= 0 ? 59 : v - 1);
            $p.find('.seg-mm').val(String(v).padStart(2, '0'));
            syncSegmentedValue($p);
        });

        // ── sync on init ─────────────────────────────────────────────────
        $container.find('.seg-time-picker').each(function () {
            finalizeSegmentedValue($(this));
        });
    }

    // Convert a full DateTime string to HH:mm:ss (24h)
    function toTime24(dtString) {
        if (!dtString) return null;
        const d = new Date(dtString);
        if (isNaN(d)) return null;
        return d.toTimeString().substring(0, 8);
    }

    // Convert a full DateTime string to yyyy-mm-dd
    function toDateStr(dtString) {
        if (!dtString) return null;
        const d = new Date(dtString);
        if (isNaN(d)) return null;
        return d.toISOString().split('T')[0];
    }

    // ================================================================
    // COMBINED EDITOR — open
    // ================================================================
    function openCombinedEditor($tiCell, $toCell) {
        if (!canEditBiometrics()) return;

        // If either cell has a pending request, block editing
        if ($tiCell.hasClass('pending-request') || $toCell.hasClass('pending-request')) {
            Swal.fire({
                icon: 'info', title: 'Pending Request Exists',
                text: 'Cancel your pending request before making a new one.',
                confirmButtonText: 'OK'
            });
            return;
        }

        const employeeNo = $tiCell.data('employee');
        const workDate   = $tiCell.data('workdate');
        const origTI     = $tiCell.data('original') || null;
        const origTO     = $toCell.data('original') || null;

        // Pre-fill time values from originals
        const tiTime24 = toTime24(origTI);
        const toTime24val = toTime24(origTO);
        const toDateVal   = toDateStr(origTO) || workDate;

        _combinedCtx = {
            employeeNo,
            workDate,
            $tiCell,
            $toCell,
            origTI,
            origTO,
            origTITime24: tiTime24,
            origTOTime24: toTime24val,
            origTODate:   toDateStr(origTO) || workDate
        };

        // Set modal header
        $('#combinedModalTitle').text('Edit Time Record');
        $('#combinedModalSubtitle').text(employeeNo + ' — ' + workDate);
        $('#combinedWorkDate').val(workDate);

        // Show/hide request banner & reason for non-full users
        const isFull = isFullAccess();
        if (isFull) {
            $('#combinedRequestBanner').hide();
            $('#combinedReasonWrap').hide();
            $('#btnSaveCombinedIcon').attr('class', 'fas fa-save me-1');
            $('#btnSaveCombinedLabel').text('Save');
        } else {
            $('#combinedRequestBanner').css('display','flex');
            $('#combinedReasonWrap').show();
            $('#combinedReasonInput').val('');
            $('#combinedReasonError').addClass('d-none');
            $('#combinedReasonCount').text('0 / 500');
            $('#btnSaveCombinedIcon').attr('class', 'fas fa-paper-plane me-1');
            $('#btnSaveCombinedLabel').text('Submit Request');
        }

        // Build Time In picker
        $('#combinedTIPickerWrap').html(buildSegmentedTimePicker(tiTime24, 'seg-ti-val'));
        bindSegmentedPicker($('#combinedTIPickerWrap'));
        $('#combinedTIOrigLabel').text(origTI ? 'Original: ' + formatDateTime(origTI) : 'Original: (none)');

        // Build Time Out picker
        $('#combinedTODate').val(toDateVal);
        $('#combinedTOPickerWrap').html(buildSegmentedTimePicker(toTime24val, 'seg-to-val'));
        bindSegmentedPicker($('#combinedTOPickerWrap'));
        $('#combinedTOOrigLabel').text(origTO ? 'Original: ' + formatDateTime(origTO) : 'Original: (none)');

        // Init datepicker on Date Out field (fresh each time)
        $('#combinedTODate').datepicker('destroy').datepicker({
            format: 'yyyy-mm-dd', autoclose: true, todayHighlight: true
        });

        $('#combinedTimeModal').modal('show');
    }

    // ================================================================
    // COMBINED EDITOR — save/submit
    // ================================================================
    $(document).on('click', '#btnSaveCombined', function () {
        const ctx = _combinedCtx;
        if (!ctx.employeeNo) return;

        // Finalize pickers
        $('#combinedTIPickerWrap .seg-time-picker').each(function () {
            finalizeSegmentedValue($(this));
        });
        $('#combinedTOPickerWrap .seg-time-picker').each(function () {
            finalizeSegmentedValue($(this));
        });

        const newTI     = $('#combinedTIPickerWrap .seg-ti-val').val();  // e.g. "08:15:00"
        const newTO     = $('#combinedTOPickerWrap .seg-to-val').val();  // e.g. "17:13:00"
        const newTODate = $('#combinedTODate').val();                     // e.g. "2026-01-26"

        // Determine what actually changed
        // A field is "changed" if its new value differs from the original
        const tiChanged = newTI && newTI !== ctx.origTITime24;
        const toChanged = newTO && (newTO !== ctx.origTOTime24 || newTODate !== ctx.origTODate);

        if (!tiChanged && !toChanged) {
            Swal.fire({ icon:'info', title:'No Changes', text:'No time values were changed.' });
            return;
        }

        const $btn = $(this);

        if (isFullAccess()) {
            // ── FULL ACCESS: save via single unified endpoint ─────────────
            // Sends only the sides that changed — NULL sides fall back to
            // original u_biometrics in the SQL CASE (same as pending request)
            $btn.prop('disabled', true)
                .html('<i class="fas fa-spinner fa-spin me-1"></i> Saving...');

            $.post('/ReviewDTR/SaveBiometricsEdit', {
                employeeNo:    ctx.employeeNo,
                workDate:      ctx.workDate,
                newTimeIn:     tiChanged ? newTI    : '',
                newTimeOut:    toChanged ? newTO    : '',
                newTimeOutDate: toChanged ? newTODate : ''
            }, function (res) {
                $btn.prop('disabled', false)
                    .html('<i class="fas fa-save me-1"></i> Save');

                if (!res.success) {
                    Swal.fire({ icon: 'error', title: 'Error', text: res.message });
                    $('#combinedTimeModal').modal('hide');
                    return;
                }

                const uBioId = res.uBiometricsId || '';

                $('#combinedTimeModal').modal('hide');

                // Update only the cells that actually changed
                if (tiChanged) {
                    const combined = ctx.workDate + 'T' + newTI;
                    ctx.$tiCell
                        .data('original', combined)
                        .data('ubio-id', uBioId)
                        .removeClass('pending-request')
                        .addClass('edited-manually')
                        .html(formatDateTime(combined) +
                            `<a class="undo-edit-link"
                                data-employee="${ctx.employeeNo}"
                                data-workdate="${ctx.workDate}"
                                data-ubio-id="${uBioId}">
                                <i class="fas fa-undo"></i> Undo Edit
                             </a>`);
                }

                if (toChanged) {
                    const combined = newTODate + 'T' + newTO;
                    ctx.$toCell
                        .data('original', combined)
                        .data('ubio-id', uBioId)
                        .removeClass('pending-request')
                        .addClass('edited-manually')
                        .html(formatDateTime(combined) +
                            `<a class="undo-edit-link"
                                data-employee="${ctx.employeeNo}"
                                data-workdate="${ctx.workDate}"
                                data-ubio-id="${uBioId}">
                                <i class="fas fa-undo"></i> Undo Edit
                             </a>`);
                }

                Swal.fire({ icon: 'success', title: 'Saved', timer: 1800, showConfirmButton: false });
            }).fail(function () {
                $btn.prop('disabled', false)
                    .html('<i class="fas fa-save me-1"></i> Save');
                Swal.fire({ icon: 'error', title: 'Error', text: 'Failed to save.' });
            });

        } else {
            // ── EDIT / READWRITE: submit as pending request ───────────────
            const reason = $('#combinedReasonInput').val().trim();
            if (!reason) {
                $('#combinedReasonInput').addClass('is-invalid');
                $('#combinedReasonError').removeClass('d-none');
                return;
            }

            $btn.prop('disabled', true)
                .html('<i class="fas fa-spinner fa-spin me-1"></i> Submitting...');

            $.post('/ReviewDTR/SubmitBiometricsRequest', {
                employeeNo:          ctx.employeeNo,
                workDate:            ctx.workDate,
                // Send both sides; backend saves whichever are non-empty
                requestType:         'both',
                timeIn:              tiChanged ? newTI   : '',
                timeOut:             toChanged ? newTO   : '',
                timeOutDate:         toChanged ? newTODate : '',
                existingTimeIn:      ctx.origTITime24  || '',
                existingTimeOut:     ctx.origTOTime24  || '',
                existingTimeOutDate: ctx.origTODate    || '',
                reason:              reason
            }, function (res) {
                $btn.prop('disabled', false)
                    .html('<i class="fas fa-paper-plane me-1"></i> Submit Request');

                if (!res.success) {
                    Swal.fire({ icon:'error', title:'Error', text: res.message });
                    $('#combinedTimeModal').modal('hide');
                    return;
                }

                $('#combinedTimeModal').modal('hide');

                // ── Apply pending state to the correct cells ─────────────
                // Cancel link ONLY on cells whose value was actually requested.
                const empNo  = ctx.employeeNo;
                const wkDate = ctx.workDate;
                const uBioId = ctx.$tiCell.data('ubio-id') || '';

                if (tiChanged) {
                    const display = formatDateTime(ctx.workDate + 'T' + newTI);
                    ctx.$tiCell
                        .removeClass('edited-manually')
                        .addClass('pending-request')
                        .html(
                            display +
                            `<span class="pending-badge">
                                 <i class="fas fa-hourglass-half"
                                    style="font-size:0.65rem;"></i> Pending
                             </span>
                             <a class="cancel-pending-link"
                                data-employee="${empNo}"
                                data-workdate="${wkDate}"
                                data-ubio-id="${uBioId}">
                                 <i class="fas fa-times-circle"></i> Cancel Request
                             </a>`
                        );
                }

                if (toChanged) {
                    const display = formatDateTime(newTODate + 'T' + newTO);
                    ctx.$toCell
                        .removeClass('edited-manually')
                        .addClass('pending-request')
                        .html(
                            display +
                            `<span class="pending-badge">
                                 <i class="fas fa-hourglass-half"
                                    style="font-size:0.65rem;"></i> Pending
                             </span>
                             <a class="cancel-pending-link"
                                data-employee="${empNo}"
                                data-workdate="${wkDate}"
                                data-ubio-id="${uBioId}">
                                 <i class="fas fa-times-circle"></i> Cancel Request
                             </a>`
                        );
                }

                Swal.fire({
                    icon:'success', title:'Request Submitted',
                    text:'Your time modification request is pending approval.',
                    timer:2500, showConfirmButton:false
                });
            }).fail(function () {
                $btn.prop('disabled', false)
                    .html('<i class="fas fa-paper-plane me-1"></i> Submit Request');
                Swal.fire({ icon:'error', title:'Error', text:'Failed to submit request.' });
            });
        }
    });

