    $(document).on('click', '#btnConfirmCancelPending', function () {
        const $btn   = $(this);
        const empNo  = $('#cancelPendingEmployeeNo').val();
        const wkDate = $('#cancelPendingWorkDate').val();
        const uBioId = $('#cancelPendingUBioId').val();

        $btn.prop('disabled', true)
            .html('<i class="fas fa-spinner fa-spin me-1"></i> Cancelling...');

        $.post('/ReviewDTR/CancelBiometricsRequest', {
            employeeNo:    empNo,
            workDate:      wkDate,
            uBiometricsId: uBioId || null
        }, function (res) {
            $btn.prop('disabled', false)
                .html('<i class="fas fa-undo me-1"></i> Yes, Cancel Request');
            $('#cancelPendingModal').modal('hide');

            if (!res.success) {
                Swal.fire({ icon:'error', title:'Error', text:res.message });
                return;
            }

            // Restore both cells in the matching row
            $('#employeeDetailsTable tbody tr').each(function () {
                const $tiCell = $(this).find('.timein-cell');
                if (!$tiCell.length || $tiCell.data('workdate') !== wkDate) return;

                $tiCell.removeClass('pending-request editing edited-manually');
                $tiCell.data('original', res.originalTimeIn || '');
                $tiCell.html(res.originalTimeIn ? formatDateTime(res.originalTimeIn) : '');

                const $toCell = $(this).find('.timeout-cell');
                $toCell.removeClass('pending-request editing edited-manually');
                $toCell.data('original', res.originalTimeOut || '');
                $toCell.html(res.originalTimeOut ? formatDateTime(res.originalTimeOut) : '');
            });

            Swal.fire({
                icon:'success', title:'Request Cancelled',
                text:'The pending request has been removed.',
                timer:2000, showConfirmButton:false
            });
        }).fail(function () {
            $btn.prop('disabled', false)
                .html('<i class="fas fa-undo me-1"></i> Yes, Cancel Request');
            Swal.fire({ icon:'error', title:'Error', text:'Failed to cancel the request.' });
        });
    });

    // ================================================================
    // UNDO BIOMETRICS EDIT (Full Access only)
    // ================================================================
    $(document).on('click', '.undo-edit-link', function (e) {
        e.stopPropagation();

        const empNo  = $(this).data('employee');
        const wkDate = $(this).data('workdate');
        const uBioId = $(this).data('ubio-id');

        const doUndo = function () {
            Swal.fire({
                title: 'Undo Edit?',
                html: `This will restore the <strong>original device time</strong> for
                       <strong>${empNo}</strong> on <strong>${wkDate}</strong>.`,
                icon: 'warning',
                showCancelButton: true,
                confirmButtonText: 'Yes, Undo',
                cancelButtonText: 'Cancel',
                confirmButtonColor: '#d97706',
                cancelButtonColor: '#6c757d'
            }).then(function (result) {
                if (!result.isConfirmed) return;

                $.post('/ReviewDTR/UndoBiometricsEdit', {
                    employeeNo:    empNo,
                    workDate:      wkDate,
                    uBiometricsId: uBioId || null
                }, function (res) {
                    if (!res.success) {
                        Swal.fire({ icon: 'error', title: 'Error', text: res.message });
                        return;
                    }

                    // Restore BOTH cells in the matching row (same as cancel request)
                    $('#employeeDetailsTable tbody tr').each(function () {
                        const $tiCell = $(this).find('.timein-cell');
                        if (!$tiCell.length || $tiCell.data('workdate') !== wkDate) return;

                        $tiCell.removeClass('edited-manually pending-request');
                        $tiCell.data('original', res.originalTimeIn || '');
                        $tiCell.html(res.originalTimeIn ? formatDateTime(res.originalTimeIn) : '');

                        const $toCell = $(this).find('.timeout-cell');
                        $toCell.removeClass('edited-manually pending-request');
                        $toCell.data('original', res.originalTimeOut || '');
                        $toCell.html(res.originalTimeOut ? formatDateTime(res.originalTimeOut) : '');
                    });

                    Swal.fire({
                        icon: 'success', title: 'Edit Undone',
                        text: 'Original time record has been restored.',
                        timer: 2000, showConfirmButton: false
                    });
                }).fail(function () {
                    Swal.fire({ icon: 'error', title: 'Error', text: 'Failed to undo edit.' });
                });
            });
        };

        // Warn if DTR already processed for this period
        const cutOffType = window._currentCutOffType || '';
        const dateMonth  = window._currentDateMonth  || '';
        const dateYear   = window._currentDateYear   || '';

        if (cutOffType && dateMonth && dateYear) {
            $.get('/ReviewDTR/IsDtrPosted', { cutOffType, dateMonth, dateYear }, function (res) {
                if (res.posted) {
                    Swal.fire({
                        icon: 'warning',
                        title: 'DTR Already Processed',
                        html: `DTR for this cutoff is already posted.<br>
                               <strong>You will need to re-process after undoing.</strong>`,
                        showCancelButton: true,
                        confirmButtonText: 'Continue Anyway',
                        cancelButtonText: 'Cancel',
                        confirmButtonColor: '#d97706',
                        cancelButtonColor: '#6c757d'
                    }).then(function (r) { if (r.isConfirmed) doUndo(); });
                } else {
                    doUndo();
                }
            }).fail(doUndo);
        } else {
            doUndo();
        }
    });

    // ================================================================
