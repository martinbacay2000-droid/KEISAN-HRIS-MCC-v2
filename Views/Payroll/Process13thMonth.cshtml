@{
    Layout = "~/Views/Shared/_LayoutFillow.cshtml";
    ViewData["Title"] = "13th Month Pay";
}

<div class="col-12">
    <div class="card">
        <div class="card-header">
            <div class="row" style="width:100%;">
                <h4 class="card-title">13th Month Pay</h4>
                <br> <br> <br>

                <div class="row" style="margin-left:0px;width:100%;">
                    <div class="col-md-3">
                        <div class="form-group">
                            <h5>Year</h5>
                            <div class="input-hasicon">
                                <input type="text" name="dateYear" id="dateYear" class="form-control yearpicker"
                                       value="@DateTime.Now.Year" readonly placeholder="Select Year">
                                <div class="icon"><i class="far fa-calendar"></i></div>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-5">
                        <div class="form-group">
                            <h5>Company</h5>
                            <select name="branch" id="filterBranch" class="form-control"></select>
                        </div>
                    </div>
                    <div class="col-md-4 d-flex justify-content-end">
                        <div class="form-group">
                            <h5>&nbsp;</h5>
                            <button type="button" class="btn btn-warning" id="btnExportToExcel">
                                <i class="fas fa-file-excel"></i> Export to Excel
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="card-body">
            <div class="row">
                <div class="table-responsive">
                    <table id="requestTable" class="display" style="min-width: 845px">
                        <thead>
                            <tr>
                                <th>Action</th>
                                <th>Employee No</th>
                                <th>Full Name</th>
                                <th>Branch</th>
                                <th>Basic Pay</th>
                                <th>Allowance</th>
                                <th>Adjustment</th>
                                <th>Total Late</th>
                                <th>Total Undertime</th>
                                <th>Total Absent</th>
                                <th>13th Month Pay</th>
                            </tr>
                        </thead>
                        <tfoot>
                            <tr>
                                <th></th>
                                <th colspan="3" class="text-right font-weight-bold">TOTAL</th>

                                <!-- numeric columns -->
                                <th></th>
                                <th></th>
                                <th></th>
                                <th></th>
                                <th></th>
                                <th></th>
                                <th></th>
                            </tr>
                        </tfoot>
                    </table>
                </div>
            </div>

        </div>
    </div>
</div>
@section Fillow_style
{
    <style>

    </style>

}

@section Fillow_script
{
    <script>
        $(document).ready(function () {
            //datepicker
            $('.bt-datepicker').datepicker({
                format: 'yyyy/mm/dd',
                autoclose: true,
                todayHighlight: true    // Highlight today's date
            });

            $('#dateYear').datepicker({
                format: 'yyyy',
                viewMode: 'years',
                minViewMode: 'years',
                autoclose: true,
                orientation: 'bottom'
            });

            initializeFilterSelect2();

            const moneyFmt = $.fn.dataTable.render.number(',', '.', 2);

            const requestTable = $('#requestTable').DataTable({
                //responsive: true,
                ajax: {
                    url: "/Month13/GetReportList",
                    type: "GET",
                    dataType: "json",
                    data: function (d) {
                        d.branch = $('#filterBranch').val();
                        d.dateYear = $('#dateYear').val();
                        d.employeeNo = "";
                    }
                },

               footerCallback: function (row, data, start, end, display) {
                    const api = this.api();

                    // convert formatted string to number
                    const parseNumber = val =>
                        typeof val === 'string'
                            ? val.replace(/[,₱]/g, '') * 1
                            : typeof val === 'number'
                            ? val
                            : 0;

                    const numericCols = [4, 5, 6, 7, 8, 9, 10];

                    numericCols.forEach(colIdx => {
                        const total = api
                            .column(colIdx, { page: 'current' }) // current page total
                            .data()
                            .reduce((a, b) => parseNumber(a) + parseNumber(b), 0);

                        $(api.column(colIdx).footer())
                            .html(moneyFmt.display(total))
                            .addClass('dt-right');
                    });
                },

                columnDefs: [
                    {
                        targets: [4, 5, 6, 7, 8, 9, 10], // indexes of numeric columns
                        render: moneyFmt,
                        className: 'dt-right'
                    }
                ],

                columns: [
                    // Control column - Print PDF button (NEW)
                    {
                        data: null,
                        width: "5%",
                        orderable: false,
                        // visible: false,
                        render: function(data, type, row) {
                            return `<button class="btn btn-sm btn-warning shadow-sm print13thMonth"
                                            data-employeeno="${row.employeeNo}"
                                            data-dateyear="${$('#dateYear').val()}"
                                            title="Print Summary">
                                        <i class="fas fa-print"></i>
                                    </button>`;
                        }
                    },
                    { data: "employeeNo" },
                    { data: "fullName" },
                    { data: "branchName" },

                    { data: "basicPay" },
                    { data: "rataAmount" },
                    { data: "adjustment" },
                    { data: "totalLate" },
                    { data: "totalUndertime" },
                    { data: "absentAmount" },
                    { data: "v13thMonth" }
                ],
                language: {
                    paginate: {
                        next: '<i class="fa fa-angle-double-right" aria-hidden="true"></i>',
                        previous: '<i class="fa fa-angle-double-left" aria-hidden="true"></i>'
                    }
                }
            });

            //apply filter when user chose a param
            $('#filterBranch').on('change', function () {
                requestTable.ajax.reload(null, true); // true = reset paging to first page
            });

            // EVENT HANDLER - EXPORT TO EXCEL (CURRENT PAGE ONLY)
            $('#btnExportToExcel').click(function() {
                const $btn = $(this);

                // Validate data availability
                if (requestTable.rows({ search: 'applied' }).count() === 0) {
                    Swal.fire({
                        icon: 'warning',
                        title: 'No Data',
                        text: 'No data available to export',
                        confirmButtonText: 'OK'
                    });
                    return;
                }

                const currentPageData = requestTable.rows({ page: 'current' }).data().toArray();
                if (currentPageData.length === 0) {
                    Swal.fire({
                        icon: 'warning',
                        title: 'No Data',
                        text: 'No data on current page to export',
                        confirmButtonText: 'OK'
                    });
                    return;
                }

                // Validate year is selected
                const dateYear = $('#dateYear').val();
                if (!dateYear) {
                    Swal.fire({
                        icon: 'warning',
                        title: 'Year Required',
                        text: 'Please select a year before exporting',
                        confirmButtonText: 'OK'
                    });
                    return;
                }

                // Get pagination and filter info
                const pageInfo = requestTable.page.info();
                const params = new URLSearchParams({
                    branch: $('#filterBranch').val() || 'ALL',
                    dateYear: dateYear,
                    offset: pageInfo.start,
                    limit: pageInfo.length
                });

                // Show loading state
                const originalHtml = $btn.html();
                $btn.prop('disabled', true).html('<i class="fas fa-spinner fa-spin"></i> Exporting...');

                const url = `/Month13Export/ExportToExcel?${params.toString()}`;

                fetch(url, {
                    method: 'GET',
                    headers: {
                        'Accept': 'application/vnd.openxmlformats-officedocument.spreadsheetml.sheet'
                    }
                })
                .then(response => {
                    if (!response.ok) {
                        return response.text().then(text => {
                            throw new Error(`Server error (${response.status}): ${text}`);
                        });
                    }
                    return response.blob();
                })
                .then(blob => {
                    const url = window.URL.createObjectURL(blob);
                    const link = document.createElement('a');
                    link.href = url;
                    link.download = `13thMonthPay_${dateYear}_${new Date().getTime()}.xlsx`;
                    document.body.appendChild(link);
                    link.click();
                    document.body.removeChild(link);
                    window.URL.revokeObjectURL(url);

                    // Reset button
                    $btn.prop('disabled', false).html(originalHtml);
                })
                .catch(error => {
                    // Reset button
                    $btn.prop('disabled', false).html(originalHtml);

                    // Show error notification
                    Swal.fire({
                        icon: 'error',
                        title: 'Export Failed',
                        text: 'An error occurred during export. Please try again.',
                        confirmButtonText: 'OK'
                    });
                });
            });

        });

        function initializeFilterSelect2(){

            // branch
            $('#filterBranch').select2({
                placeholder: "Select Branch",
                allowClear: true,
                ajax: {
                    url: '/Setup/GetEmployeeBranch',
                    dataType: 'json',
                    delay: 250,
                    processResults: function (data) {
                        // Add "All" option manually
                        var allOption = {
                            id: 'ALL',
                            text: 'All Branches'
                        };

                        var results = $.map(data, function (item) {
                            return {
                                id: item.branchCode,
                                text: item.branchName
                            };
                        });

                        // Put "All" on top
                        results.unshift(allOption);

                        return {
                            results: results
                        };
                    }
                }
            });

            // EVENT HANDLER - PRINT PDF
            $(document).on('click', '.print13thMonth', function(e) {
                e.preventDefault();

                const employeeNo = $(this).data('employeeno');
                const dateYear = $(this).data('dateyear');

                var parameter = employeeNo + "_" + dateYear;
                var url = '/ThirteenthMonthPdf/PreviewPdf'
                            + '?employeeNo=' + encodeURIComponent(employeeNo)
                            + '&dateYear='   + encodeURIComponent(dateYear);
                        window.open(url, '_blank');
            });

        }

    </script>
}