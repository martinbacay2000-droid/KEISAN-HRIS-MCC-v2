@{
    Layout = "~/Views/Shared/_LayoutFillow.cshtml";
    ViewData["Title"] = "Import Adjustment Requests";
}

<div class="col-12">
    <div class="card">
        <div class="card-header">
            <div class="row" style="width:100%;">
                <div class="col-md-6">
                    <h4 class="card-title">Import Adjustment Requests</h4>
                </div>
                <div class="col-md-6 text-end">
                    <a href="/AdjustmentRequestList/Index" class="btn btn-primary">
                        <i class="fas fa-arrow-left"></i> Back to List
                    </a>
                </div>
            </div>
        </div>
        <div class="card-body">
            <!-- Step Indicator -->
            <div class="import-steps mb-4">
                <div class="step active" id="step1">
                    <div class="step-number">1</div>
                    <div class="step-label">Download Template</div>
                </div>
                <div class="step-line"></div>
                <div class="step" id="step2">
                    <div class="step-number">2</div>
                    <div class="step-label">Upload File</div>
                </div>
                <div class="step-line"></div>
                <div class="step" id="step3">
                    <div class="step-number">3</div>
                    <div class="step-label">Review & Import</div>
                </div>
            </div>

            <!-- Step 1: Download Template -->
            <div id="downloadSection" class="import-section">
                <div class="section-header">
                    <h5><i class="fas fa-download"></i> Step 1: Download Template</h5>
                </div>
                <div class="section-content">
                    <p class="text-muted">Download the Excel template to get started with importing adjustment requests.</p>
                    <button type="button" class="btn btn-primary" id="btnDownloadTemplate">
                        <i class="fas fa-file-excel"></i> Download Excel Template
                    </button>
                </div>
            </div>

            <!-- Step 2: Upload File -->
            <div id="uploadSection" class="import-section mt-4">
                <div class="section-header">
                    <h5><i class="fas fa-upload"></i> Step 2: Upload Filled Template</h5>
                </div>
                <div class="section-content">
                    <p class="text-muted">Upload your completed Excel file. The system will validate the data before import.</p>

                    <!-- FIXED: File input OUTSIDE the upload area -->
                    <input type="file" id="excelFile" accept=".xlsx" style="display:none;">

                    <div class="upload-area" id="uploadArea">
                        <div class="upload-placeholder">
                            <i class="fas fa-cloud-upload-alt fa-3x mb-3"></i>
                            <p class="mb-2"><strong>Click to upload</strong> or drag and drop</p>
                            <p class="text-muted small">Excel files only (.xlsx)</p>
                        </div>
                        <div class="upload-file-info" style="display:none;">
                            <i class="fas fa-file-excel fa-2x text-success"></i>
                            <span class="file-name ms-2"></span>
                            <button type="button" class="btn btn-sm btn-danger ms-2" id="btnRemoveFile">
                                <i class="fas fa-times"></i>
                            </button>
                        </div>
                    </div>
                    <button type="button" class="btn btn-success mt-3" id="btnValidateFile" style="display:none;">
                        <i class="fas fa-check-circle"></i> Validate File
                    </button>
                </div>
            </div>

            <!-- Step 3: Review & Import -->
            <div id="reviewSection" class="import-section mt-4" style="display:none;">
                <div class="section-header">
                    <h5><i class="fas fa-list-check"></i> Step 3: Review & Import</h5>
                </div>
                <div class="section-content">
                    <!-- Validation Summary -->
                    <div id="validationSummary" class="mb-3"></div>

                    <!-- Validation Errors -->
                    <div id="validationErrors" style="display:none;" class="mb-3">
                        <div class="alert alert-danger">
                            <h6><i class="fas fa-exclamation-triangle"></i> Validation Errors</h6>
                            <ul id="errorList" class="mb-0"></ul>
                        </div>
                    </div>

                    <!-- Preview Table -->
                    <div id="previewTableContainer" style="display:none;">
                        <h6 class="mb-3">Data Preview:</h6>
                        <div class="table-responsive">
                            <table id="previewTable" class="table table-striped table-bordered">
                                <thead>
                                    <tr>
                                        <th>Row</th>
                                        <th>Employee No</th>
                                        <th>Adjustment Code</th>
                                        <th>Amount</th>
                                        <th>Effectivity Date</th>
                                        <th>Remarks</th>
                                        <th>Day Type</th>
                                        <th>Value</th>
                                        <th>Unit</th>
                                    </tr>
                                </thead>
                                <tbody id="previewTableBody"></tbody>
                            </table>
                        </div>
                    </div>

                    <!-- Action Buttons -->
                    <div class="mt-3">
                        <button type="button" class="btn btn-success" id="btnImportData" style="display:none;">
                            <i class="fas fa-file-import"></i> Import Data
                        </button>
                        <button type="button" class="btn btn-primary" id="btnStartOver">
                            <i class="fas fa-redo"></i> Start Over
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Fillow_style
{
    <style>
        .import-steps {
            display: flex;
            justify-content: center;
            align-items: center;
            padding: 2rem 0;
        }

        .step {
            display: flex;
            flex-direction: column;
            align-items: center;
            opacity: 0.5;
        }

            .step.active {
                opacity: 1;
            }

            .step.completed {
                opacity: 1;
            }

        .step-number {
            width: 40px;
            height: 40px;
            border-radius: 50%;
            background-color: #e9ecef;
            color: #6c757d;
            display: flex;
            align-items: center;
            justify-content: center;
            font-weight: bold;
            margin-bottom: 0.5rem;
        }

        .step.active .step-number {
            background-color: #0d6efd;
            color: white;
        }

        .step.completed .step-number {
            background-color: #28a745;
            color: white;
        }

        .step-label {
            font-size: 0.875rem;
            text-align: center;
        }

        .step-line {
            width: 100px;
            height: 2px;
            background-color: #e9ecef;
            margin: 0 1rem;
            margin-bottom: 2rem;
        }

        .import-section {
            border: 1px solid #dee2e6;
            border-radius: 0.5rem;
            padding: 1.5rem;
        }

        .section-header {
            border-bottom: 2px solid #0d6efd;
            padding-bottom: 0.75rem;
            margin-bottom: 1.5rem;
        }

            .section-header h5 {
                margin: 0;
                color: #0d6efd;
            }

        .upload-area {
            border: 2px dashed #dee2e6;
            border-radius: 0.5rem;
            padding: 3rem;
            text-align: center;
            cursor: pointer;
            transition: all 0.3s;
        }

            .upload-area:hover {
                border-color: #0d6efd;
                background-color: #f8f9fa;
            }

            .upload-area.drag-over {
                border-color: #0d6efd;
                background-color: #e7f1ff;
            }

        .upload-placeholder {
            color: #6c757d;
        }

        .upload-file-info {
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .table-responsive {
            max-height: 400px;
            overflow-y: auto;
        }

        #errorList {
            max-height: 300px;
            overflow-y: auto;
        }
    </style>
}

@section Fillow_script
{
    <script>
        $(document).ready(function () {
            let validatedData = null;

            // Download template
            $('#btnDownloadTemplate').click(function () {
                const $btn = $(this);
                const originalHtml = $btn.html();
                $btn.prop('disabled', true).html('<i class="fas fa-spinner fa-spin"></i> Downloading...');

                const link = document.createElement('a');
                link.href = '/AdjustmentRequestListImport/DownloadTemplate';
                link.download = '';
                document.body.appendChild(link);
                link.click();
                document.body.removeChild(link);

                setTimeout(() => {
                    $btn.prop('disabled', false).html(originalHtml);
                    markStepCompleted(1);
                    toastr.success('Template downloaded successfully');
                }, 1000);
            });

            // FIXED: Simple upload area click - no infinite loop
            $('#uploadArea').on('click', function (e) {
                // Don't trigger if clicking the remove button
                if ($(e.target).closest('#btnRemoveFile').length === 0) {
                    $('#excelFile').click();
                }
            });

            // FIXED: File input change - properly isolated
            $('#excelFile').on('change', function () {
                if (this.files.length > 0) {
                    handleFileSelect(this.files[0]);
                }
            });

            // Drag and drop handlers
            $('#uploadArea')
                .on('dragover', function (e) {
                    e.preventDefault();
                    e.stopPropagation();
                    $(this).addClass('drag-over');
                })
                .on('dragleave', function (e) {
                    e.preventDefault();
                    e.stopPropagation();
                    $(this).removeClass('drag-over');
                })
                .on('drop', function (e) {
                    e.preventDefault();
                    e.stopPropagation();
                    $(this).removeClass('drag-over');
                    const files = e.originalEvent.dataTransfer.files;
                    if (files.length > 0) {
                        handleFileSelect(files[0]);
                    }
                });

            // Remove file button
            $('#btnRemoveFile').on('click', function (e) {
                e.stopPropagation();
                e.preventDefault();
                resetFileUpload();
            });

            // Validate file button
            $('#btnValidateFile').on('click', function () {
                const file = $('#excelFile')[0].files[0];
                if (!file) {
                    toastr.error('Please select a file first');
                    return;
                }
                validateFile(file);
            });

            // Import data button
            $('#btnImportData').on('click', function () {
                if (!validatedData || validatedData.length === 0) {
                    toastr.error('No valid data to import');
                    return;
                }

                Swal.fire({
                    title: 'Confirm Import',
                    text: `Are you sure you want to import ${validatedData.length} adjustment requests?`,
                    icon: 'question',
                    showCancelButton: true,
                    confirmButtonText: 'Yes, Import',
                    cancelButtonText: 'Cancel',
                    confirmButtonColor: '#28a745',
                    cancelButtonColor: '#6c757d'
                }).then(result => {
                    if (result.isConfirmed) {
                        importData();
                    }
                });
            });

            // Start over button
            $('#btnStartOver').on('click', function () {
                resetAll();
            });

            // Handle file selection
            function handleFileSelect(file) {
                console.log('File selected:', file.name);

                if (!file.name.endsWith('.xlsx')) {
                    toastr.error('Please select a valid Excel file (.xlsx)');
                    $('#excelFile').val('');
                    return;
                }

                // Update UI to show selected file
                $('.upload-placeholder').hide();
                $('.upload-file-info').show();
                $('.upload-file-info .file-name').text(file.name);
                $('#btnValidateFile').show();
                markStepCompleted(2);
            }

            // Validate file
            function validateFile(file) {
                const $btn = $('#btnValidateFile');
                const originalHtml = $btn.html();
                $btn.prop('disabled', true).html('<i class="fas fa-spinner fa-spin"></i> Validating...');

                const formData = new FormData();
                formData.append('file', file);

                $.ajax({
                    url: '/AdjustmentRequestListImport/ValidateImport',
                    type: 'POST',
                    data: formData,
                    processData: false,
                    contentType: false,
                    success: function (response) {
                        console.log('Validation response:', response);
                        if (response.success) {
                            validatedData = response.data;
                            showValidationResults(response);
                            markStepCompleted(3);
                        } else {
                            toastr.error(response.message);
                        }
                    },
                    error: function (xhr) {
                        console.error('Validation error:', xhr);
                        const errorMsg = xhr.responseJSON?.message || 'Validation failed';
                        toastr.error(errorMsg);
                    },
                    complete: function () {
                        $btn.prop('disabled', false).html(originalHtml);
                    }
                });
            }

            // Show validation results
            function showValidationResults(response) {
                $('#reviewSection').show();

                // Summary
                let summaryHtml = `
                    <div class="alert ${response.validRows > 0 ? 'alert-success' : 'alert-warning'}">
                        <strong>Validation Results:</strong><br>
                        Total Rows: ${response.totalRows}<br>
                        Valid Rows: ${response.validRows}<br>
                        ${response.errors.length > 0 ? `Errors: ${response.errors.length}` : ''}
                    </div>
                `;
                $('#validationSummary').html(summaryHtml);

                // Errors
                if (response.errors && response.errors.length > 0) {
                    $('#validationErrors').show();
                    const errorHtml = response.errors.map(err => `<li>${err}</li>`).join('');
                    $('#errorList').html(errorHtml);
                } else {
                    $('#validationErrors').hide();
                }

                // Preview table
                if (response.validRows > 0) {
                    $('#previewTableContainer').show();
                    const tbody = $('#previewTableBody');
                    tbody.empty();

                    response.data.forEach(row => {
                        tbody.append(`
                            <tr>
                                <td>${row.rowNumber}</td>
                                <td>${row.employeeNo}</td>
                                <td>${row.adjustmentCode}</td>
                                <td>${row.amount.toFixed(2)}</td>
                                <td>${formatDate(row.dateToAdjustment)}</td>
                                <td>${row.reason || '-'}</td>
                                <td>${row.dayType || '-'}</td>
                                <td>${row.value ? row.value.toFixed(2) : '-'}</td>
                                <td>${row.units || '-'}</td>
                            </tr>
                        `);
                    });

                    $('#btnImportData').show();
                }

                // Scroll to review section
                $('html, body').animate({
                    scrollTop: $('#reviewSection').offset().top - 100
                }, 500);
            }

            // Import data
            function importData() {
                const $btn = $('#btnImportData');
                const originalHtml = $btn.html();
                $btn.prop('disabled', true).html('<i class="fas fa-spinner fa-spin"></i> Importing...');

                $.ajax({
                    url: '/AdjustmentRequestListImport/ImportData',
                    type: 'POST',
                    contentType: 'application/json',
                    data: JSON.stringify(validatedData),
                    success: function (response) {
                        console.log('Import response:', response);
                        if (response.success) {
                            Swal.fire({
                                title: 'Import Complete',
                                html: `
                                    <p>Successfully imported: ${response.successCount}</p>
                                    ${response.failureCount > 0 ? `<p class="text-danger">Failed: ${response.failureCount}</p>` : ''}
                                `,
                                icon: 'success',
                                confirmButtonText: 'Go to Adjustment List'
                            }).then(() => {
                                window.location.href = '/AdjustmentRequestList/Index';
                            });
                        } else {
                            toastr.error(response.message);
                        }
                    },
                    error: function (xhr) {
                        console.error('Import error:', xhr);
                        const errorMsg = xhr.responseJSON?.message || 'Import failed';
                        toastr.error(errorMsg);
                    },
                    complete: function () {
                        $btn.prop('disabled', false).html(originalHtml);
                    }
                });
            }

            // Reset functions
            function resetFileUpload() {
                $('#excelFile').val('');
                $('.upload-file-info').hide();
                $('.upload-placeholder').show();
                $('#btnValidateFile').hide();
                validatedData = null;
                console.log('File upload reset');
            }

            function resetAll() {
                resetFileUpload();
                $('#reviewSection').hide();
                $('#validationSummary').empty();
                $('#validationErrors').hide();
                $('#errorList').empty();
                $('#previewTableContainer').hide();
                $('#previewTableBody').empty();
                $('#btnImportData').hide();
                $('.step').removeClass('completed');
                setActiveStep(1);
                console.log('All reset');
            }

            function markStepCompleted(stepNumber) {
                $(`#step${stepNumber}`).addClass('completed');
                if (stepNumber < 3) {
                    setActiveStep(stepNumber + 1);
                }
            }

            function setActiveStep(stepNumber) {
                $('.step').removeClass('active');
                $(`#step${stepNumber}`).addClass('active');
            }

            function formatDate(dateString) {
                const date = new Date(dateString);
                return date.toISOString().split('T')[0];
            }

            // Toastr configuration
            toastr.options = {
                positionClass: "toast-top-right",
                timeOut: 5000,
                closeButton: true,
                progressBar: true
            };
        });
    </script>
}