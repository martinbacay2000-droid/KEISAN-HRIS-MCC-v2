                                    return `
                                        <input type="checkbox" class="row-checkbox"
                                               value="${row.employeeNo}">
                                    `;
                                }
                            },
                            { data: "employeeNo" },
                            { data: "fullName" },
                            { data: "statusName" }

                        ],
                        language: {
                            paginate: {
                            next: '<i class="fa fa-angle-double-right" aria-hidden="true"></i>',
                            previous: '<i class="fa fa-angle-double-left" aria-hidden="true"></i>'
                            }
                        }
                        });

                        // Select all
                        $('#checkAll').on('change', function () {
                            const isChecked = $(this).is(':checked');
                            $('.row-checkbox').prop('checked', isChecked);
                        });

                        // Uncheck "select all" if one row is unchecked
                        $('#requestTable').on('change', '.row-checkbox', function () {
                            if (!$(this).is(':checked')) {
                                $('#checkAll').prop('checked', false);
                            }
                        });

                        //apply filter when user chose a param
                        // Use Select2's own event for Select2 dropdowns
                        $('#filterBranch, #filterDepartment').on('select2:select select2:clear', function () {
                            requestTable.ajax.reload(null, true);
                        });

                        // Keep native change for non-Select2 inputs
                        $('#dateFrom, #dateTo').on('change', function () {
                            requestTable.ajax.reload(null, true);
                        });

                        $(document).on('change', '#cutOff', function () {
                            var obj = $("#cutOff").select2('data')[0];

                            if (!obj) {
                                console.warn('No cut-off selected');
                                // Optional: clear input fields
                                $('#dateYear, #dateFrom, #dateTo').val('');
                                return;
                            }

                            console.log('Selected CutOff:', obj);

                            // Safely set values if elements exist
                            if (document.getElementById('dateYear')) document.getElementById('dateYear').value = obj.dateYear;
                            if (document.getElementById('dateMonth')) document.getElementById('dateMonth').value = obj.dateMonth;
                            if (document.getElementById('cutOffType')) document.getElementById('cutOffType').value = obj.cutOffType;
                            if (document.getElementById('dateFrom')) document.getElementById('dateFrom').value = obj.dateFrom;
                            if (document.getElementById('dateTo')) document.getElementById('dateTo').value = obj.dateTo;

                            requestTable.ajax.reload(null, true);
                        });

                    $('#btnProcess').on('click', function () {


                        if(!$('#cutOffType').val())
                        {
                            showNotification('Please select cutoff.', 'danger');
                            return;
                        }

                        const selectedEmployees = getSelectedEmployees();

                        if (selectedEmployees.length === 0) {
                            showNotification('Please select at least one record.', 'warning');
                            return;
                        }

                        loadProcessPayroll();
                    });
                    });

        function getSelectedEmployees() {
            let selected = [];

            $('.row-checkbox:checked').each(function () {
                selected.push($(this).val());
            });

            return selected;
        }

        var ctr = 0;
                var selectedRows = [];

        function loadProcessPayroll() {

            var dtApi = $('#requestTable').DataTable();

            // Build selected rows ONCE
            if (ctr === 0) {
                const selectedEmployees = getSelectedEmployees();

                if (selectedEmployees.length === 0) {
                    showNotification('Please select at least one record.', 'warning');
                    return;
                }

                selectedRows = dtApi.rows().indexes().filter(function (idx) {
                    return selectedEmployees.includes(
                        dtApi.row(idx).data().employeeNo.toString()
                    );
                }).toArray();
            }
            
            if (ctr >= selectedRows.length) {
                ctr = 0;
                selectedRows = [];
                $('#btnProcess').val('Process');
                showNotification('Process Completed.', 'info');
                return;
            }

            $('#btnProcess').val(`Processing... ${ctr + 1}/${selectedRows.length}`);

            const rowIndex = selectedRows[ctr];
            var data = $.extend(true, {}, dtApi.row(rowIndex).data());

            var model = {
                cutOffType: $('#cutOffType').val(),
                dateMonth: $('#dateMonth').val(),
                dateYear: $('#dateYear').val(),
                dateFrom: $('#dateFrom').val(),
                dateTo: $('#dateTo').val(),
                branchCode: $('#filterBranch').val(),
                employeeNo: data.employeeNo
            };

            $.ajax({
                type: "POST",
                url: "/PayrollProcess/ProcessPayroll",
                data: JSON.stringify(model),
                contentType: "application/json; charset=utf-8",
                dataType: "json",

                beforeSend: function () {
                    data.statusName = "<span class='badge badge-info'>Processing...</span>";
                    dtApi.row(rowIndex).data(data).invalidate().draw(false);
                },

                success: function (r) {
                    data.statusName = r.success
                        ? "<span class='badge badge-success'>Completed</span>"
                        : "<span class='badge badge-danger'>Failed</span>";

                    if (!r.success) showNotification(r.message, 'error');

                    dtApi.row(rowIndex).data(data).invalidate().draw(false);

                    ctr++;
                    loadProcessPayroll();
                },

                error: function (jqXHR, exception) {
                    data.statusName = "<span class='badge badge-danger'>Failed</span>";
                    dtApi.row(rowIndex).data(data).invalidate().draw(false);
                    errorHandlingNotification(jqXHR.status, jqXHR.responseText, exception);

                    ctr++;
                    loadProcessPayroll();
                }
            });
        }
