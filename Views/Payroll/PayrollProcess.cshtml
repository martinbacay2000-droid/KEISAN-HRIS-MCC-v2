                 function initializeFilterSelect2(){

                             $('#cutOff').select2({
                                placeholder: "Select CutOff",
                                allowClear: true,
                                ajax: {
                                    url: '/Setup/GetOpenCutOff',
                                    dataType: 'json',
                                    delay: 250,
                                    processResults: function (data) {
                                        console.log(data)

                                        var results = $.map(data, function(item) {
                                            return {
                                                id: item.dateYear + '-' + item.dateMonth + '-' + item.cutOffType + '-' + item.dateFrom + '-' + item.dateTo,
                                                text: item.dateYear + '-' + item.dateMonth + '-' + ((item.cutOffType == '1') ? '1ST CUTOFF' : '2ND CUTOFF') +
                                                      ' (' + item.dateFrom + '-' + item.dateTo + ')',

                                                cutOffType: item.cutOffType,
                                                dateMonth: item.dateMonth,
                                                dateYear: item.dateYear,
                                                dateFrom: item.dateFrom,
                                                dateTo: item.dateTo
                                            };
                                        });

                                        return {
                                            results: results
                                        };
                                    }
                                }
                            });

                            // branch
                             $('#filterBranch').select2({
                                placeholder: "Select Branch",
                                allowClear: true,
                                ajax: {
                                    url: '/Setup/GetEmployeeBranch',
                                    dataType: 'json',
                                    delay: 250,
                                    processResults: function (data) {
                                        // Add "All" option manually
                                        var allOption = {
                                            id: 'ALL',
                                            text: 'All Branches'
                                        };

                                        var results = $.map(data, function (item) {
                                            return {
                                                id: item.branchCode,
                                                text: item.branchName
                                            };
                                        });

                                        // Put "All" on top
                                        results.unshift(allOption);

                                        return {
                                            results: results
                                        };
                                    }
                                }
                            });

                             // department
                             $('#filterDepartment').select2({
                                placeholder: "Select Employee Department",
                                allowClear: true,
                                ajax: {
                                    url: '/Setup/GetEmployeeDepartment',
                                    dataType: 'json',
                                    delay: 250,
                                    processResults: function (data) {
                                        // Map your results as usual
                                        var results = $.map(data, function (item) {
                                            return {
                                                id: item.departmentCode,
                                                text: item.departmentName
                                            };
                                        });

                                        // Add the "All" option at the top
                                        results.unshift({
                                            id: 'ALL',
                                            text: 'All Departments'
                                        });

                                        return {
                                            results: results
                                        };
                                    }
                                }
                            });

