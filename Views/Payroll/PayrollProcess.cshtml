@{
    Layout = "~/Views/Shared/_LayoutFillow.cshtml";
    ViewData["Title"] = "Payroll Process";
}

<div class="col-12">
    <div class="card">
        <div class="card-header">

            <div class="row" style="width:100%;">
                <h4 class="card-title">Payroll Process</h4>
                <br> <br> <br>

                <div class="row" style="margin-left:0px;width:100%;">
                    <div class="col-md-4">
                        <div class="form-group">
                            <h5>Select CutOff</h5>
                            <select name="cutOff" id="cutOff" class="form-control"></select>
                            <input type="hidden" name="cutOffType" id="cutOffType" />
                            <input type="hidden" name="dateMonth" id="dateMonth" />
                            <input type="hidden" name="dateYear" id="dateYear" />
                            <input type="hidden" name="dateFrom" id="dateFrom" />
                            <input type="hidden" name="dateTo" id="dateTo" />
                        </div>
                    </div>

                    <div class="col-md-3">
                        <div class="form-group">
                            <h5>Company</h5>
                            <select name="branch" id="filterBranch" class="form-control"></select>
                        </div>
                    </div>
                    <div class="col-md-3">
                        <div class="form-group">
                            <h5>Department</h5>
                            <select name="department" id="filterDepartment" class="form-control"></select>
                        </div>
                    </div>
                    <div class="col-md-2">
                        <div class="form-group">
                            <h5>&nbsp;</h5>
                            <button type="button" class="btn btn-success w-100" id="btnProcess">
                                <i class="fas fa-money-bill-wave"></i> Process Payroll
                            </button>
                        </div>
                    </div>
                </div>

            </div>


        </div>
        <div class="card-body">
            <div class="row">
                <div class="table-responsive">
                    <table id="requestTable" class="display" style="min-width: 845px">
                        <thead>
                            <tr>
                                <th class="text-center">
                                    <input type="checkbox" id="checkAll">
                                </th>
                                <th>Employee No</th>
                                <th>Employee Name</th>
                                <th>Status</th>
                            </tr>
                        </thead>
                    </table>
                </div>
            </div>
            @* <div class="row">
                <div class="col-md-10"></div>
                <div class="col-md-2 d-flex justify-content-end">
                    <div class="form-group">
                        <h5>&nbsp;</h5>
                        <input type="button" class="btn btn-success" id="btnProcess" value="Process Payroll">
                    </div>
                </div>
            </div> *@
        </div>
    </div>
</div>
