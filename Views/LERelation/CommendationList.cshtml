@{
    Layout = "~/Views/Shared/_LayoutFillow.cshtml";
    ViewData["Title"] = "Commendation List";
}

<div class="col-12">
    <div class="card">
        <div class="card-header">
            <div class="row" style="width:100%;">
                <h4 class="card-title">Commendation List</h4>
                <br><br><br>

                <div class="row" style="margin-left:0px;width:100%;">
                    <div class="row" style="margin-left:0px;width:100%;">
                        <div class="col-md-3">
                            <div class="form-group">
                                <h5>Record Status</h5>
                                <select name="filterRecordStatus" id="filterRecordStatus" class="form-control">
                                    <option value="active" selected>ACTIVE</option>
                                    <option value="inactive">INACTIVE</option>
                                </select>
                            </div>
                        </div>
                        <div class="col-md-3">
                            <div class="form-group">
                                <h5>Employee</h5>
                                <select name="filterEmployee" id="filterEmployee" class="form-control">
                                    <option value="">All Employees</option>
                                </select>
                            </div>
                        </div>
                        <div class="col-md-3">
                            <div class="form-group">
                                <h5>Department</h5>
                                <select name="filterDepartment" id="filterDepartment" class="form-control"></select>
                            </div>
                        </div>
                        <div class="col-md-12 d-flex justify-content-end align-items-center mt-2 gap-2">
                            <button type="button" class="btn btn-warning" id="btnExportToExcel">
                                <i class="fas fa-file-excel"></i> Export to Excel
                            </button>
                            <button type="button" class="btn btn-primary" id="btnAddCommendation">
                                <i class="fa fa-plus"></i> New Commendation
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="card-body">
            <div class="table-responsive">
                <table id="commendationTable" class="display" style="min-width: 845px">
                    <thead>
                        <tr>
                            <th>Action</th>
                            <th>Employee Name</th>
                            <th>Type</th>
                            <th>Activity</th>
                            <th>Remarks</th>
                            <th>Date</th>
                            <th>Attachment</th>
                        </tr>
                    </thead>
                </table>
            </div>
        </div>

        <!-- ══════════════════════════════════════════════════════════════
             ADD MODAL
        ══════════════════════════════════════════════════════════════════ -->
        <div class="modal fade" id="addCommendationModal" tabindex="-1" aria-hidden="true">
            <div class="modal-dialog modal-lg">
                <div class="modal-content">
                    <div class="modal-header">
                        <h5 class="modal-title">Add Commendation</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                    </div>
                    <div class="modal-body">
                        <form id="addCommendationForm">

                            <div class="row">
                                <div class="col-md-6 mb-3">
                                    <label for="addEmployeeName" class="form-label">
                                        Employee Name <span class="text-danger">*</span>
                                    </label>
                                    <select class="form-select" id="addEmployeeName" name="employeeNo"
                                            style="width:100%" required>
                                        <option value="">Select Employee...</option>
                                    </select>
                                    <div class="invalid-feedback">Please select an employee.</div>
                                </div>
                                <div class="col-md-6 mb-3">
                                    <label for="addCommendationType" class="form-label">
                                        Type of Commendation <span class="text-danger">*</span>
                                    </label>
                                    <select class="form-select" id="addCommendationType" name="commendationCode"
                                            style="width:100%" required>
                                        <option value="">Select Type...</option>
                                    </select>
                                    <div class="invalid-feedback">Please select a commendation type.</div>
                                </div>
                            </div>

                            <div class="row">
                                <div class="col-md-6 mb-3">
                                    <label for="addActivity" class="form-label">
                                        Activity <span class="text-danger">*</span>
                                    </label>
                                    <input type="text" class="form-control" id="addActivity"
                                           name="activity" maxlength="500" required
                                           placeholder="Type activity description" autocomplete="off">
                                    <div class="invalid-feedback">Please provide an activity description.</div>
                                </div>
                                <div class="col-md-6 mb-3">
                                    <label for="addDateIssued" class="form-label">
                                        Date Issued <span class="text-danger">*</span>
                                    </label>
                                    <div class="datepicker-wrapper">
                                        <input type="text" class="form-control bt-datepicker" id="addDateIssued"
                                               name="dateissued" placeholder="yyyy/mm/dd" required autocomplete="off">
                                        <span class="datepicker-icon"><i class="far fa-calendar"></i></span>
                                    </div>
                                    <div class="invalid-feedback">Please select a date issued.</div>
                                </div>
                            </div>

                            <div class="mb-3">
                                <label for="addIssuedBy" class="form-label">
                                    Issued By <span class="text-danger">*</span>
                                </label>
                                <input type="text" class="form-control" id="addIssuedBy"
                                       name="issuedBy" maxlength="100" required
                                       placeholder="Enter name of issuer" autocomplete="off">
                                <div class="invalid-feedback">Please provide who issued this commendation.</div>
                            </div>

                            <div class="mb-3">
                                <label for="addRemarks" class="form-label">Remarks</label>
                                <textarea class="form-control" id="addRemarks"
                                          name="remarks" rows="3" maxlength="1000"></textarea>
                            </div>

                            <div class="mb-3">
                                <label for="addAttachment" class="form-label">Attachment</label>
                                <input type="file" class="form-control" id="addAttachment"
                                       name="attachment" accept=".pdf,.jpg,.jpeg,.png,.doc,.docx">
                                <small class="text-muted">Allowed formats: PDF, JPG, PNG, DOC, DOCX (Max: 5MB)</small>
                            </div>

                        </form>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-primary" id="btnSaveNewCommendation">Save</button>
                    </div>
                </div>
            </div>
        </div>

        <!-- ══════════════════════════════════════════════════════════════
             VIEW / EDIT MODAL
        ══════════════════════════════════════════════════════════════════ -->
        <div class="modal fade" id="viewCommendationModal" tabindex="-1" aria-hidden="true">
            <div class="modal-dialog modal-lg">
                <div class="modal-content">
                    <div class="modal-header">
                        <h5 class="modal-title" id="viewModalTitle">View Commendation</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                    </div>
                    <div class="modal-body">
                        <form id="viewCommendationForm">
                            <input type="hidden" id="viewCommendationId" name="id">

                            <div class="row">
                                <div class="col-md-6 mb-3">
                                    <label for="viewEmployeeName" class="form-label">
                                        Employee Name
                                        <span class="text-danger edit-required d-none">*</span>
                                    </label>
                                    <select class="form-select" id="viewEmployeeName"
                                            name="employeeNo" style="width:100%" disabled>
                                        <option value="">Select Employee...</option>
                                    </select>
                                    <div class="invalid-feedback">Please select an employee.</div>
                                </div>
                                <div class="col-md-6 mb-3">
                                    <label for="viewCommendationType" class="form-label">
                                        Type of Commendation
                                        <span class="text-danger edit-required d-none">*</span>
                                    </label>
                                    <select class="form-select" id="viewCommendationType"
                                            name="commendationCode" style="width:100%" disabled>
                                        <option value="">Select Type...</option>
                                    </select>
                                    <div class="invalid-feedback">Please select a commendation type.</div>
                                </div>
                            </div>

                            <div class="row">
                                <div class="col-md-6 mb-3">
                                    <label for="viewActivity" class="form-label">
                                        Activity
                                        <span class="text-danger edit-required d-none">*</span>
                                    </label>
                                    <input type="text" class="form-control" id="viewActivity"
                                           name="activity" maxlength="500" readonly autocomplete="off">
                                    <div class="invalid-feedback">Please provide an activity description.</div>
                                </div>
                                <div class="col-md-6 mb-3">
                                    <label for="viewDateIssued" class="form-label">
                                        Date Issued
                                        <span class="text-danger edit-required d-none">*</span>
                                    </label>
                                    <div class="datepicker-wrapper">
                                        <input type="text" class="form-control bt-datepicker" id="viewDateIssued"
                                               name="dateissued" placeholder="yyyy/mm/dd" readonly autocomplete="off">
                                        <span class="datepicker-icon"><i class="far fa-calendar"></i></span>
                                    </div>
                                    <div class="invalid-feedback">Please select a date issued.</div>
                                </div>
                            </div>

                            <div class="mb-3">
                                <label for="viewIssuedBy" class="form-label">
                                    Issued By
                                    <span class="text-danger edit-required d-none">*</span>
                                </label>
                                <input type="text" class="form-control" id="viewIssuedBy"
                                       name="issuedBy" maxlength="100" readonly autocomplete="off">
                                <div class="invalid-feedback">Please provide who issued this commendation.</div>
                            </div>

                            <div class="mb-3">
                                <label for="viewRemarks" class="form-label">Remarks</label>
                                <textarea class="form-control" id="viewRemarks"
                                          name="remarks" rows="3" maxlength="1000" readonly></textarea>
                            </div>

                            <div class="mb-3">
                                <label class="form-label">Attachment</label>
                                <div id="currentAttachments" class="mb-2"></div>
                                <input type="file" class="form-control d-none" id="viewAttachment"
                                       name="attachment" accept=".pdf,.jpg,.jpeg,.png,.doc,.docx">
                                <small class="text-muted d-none edit-mode-only">
                                    Allowed formats: PDF, JPG, PNG, DOC, DOCX (Max: 5MB)
                                </small>
                            </div>

                        </form>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-primary d-none" id="btnEditCommendation">
                            <i class="fas fa-edit"></i> Edit
                        </button>
                        <button type="button" class="btn btn-success d-none" id="btnSaveCommendation">Save</button>
                        <button type="button" class="btn btn-danger d-none" id="btnCancelEdit">Cancel</button>
                    </div>
                </div>
            </div>
        </div>

        <!-- ══════════════════════════════════════════════════════════════
             ATTACHMENT VIEW MODAL
        ══════════════════════════════════════════════════════════════════ -->
        <div class="modal fade" id="attachmentModal" tabindex="-1" aria-hidden="true">
            <div class="modal-dialog modal-lg">
                <div class="modal-content">
                    <div class="modal-header">
                        <h5 class="modal-title">View Attachments</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                    </div>
                    <div class="modal-body">
                        <div id="attachmentList"></div>
                    </div>
                </div>
            </div>
        </div>

    </div><!-- /.card -->
</div><!-- /.col-12 -->
@section Fillow_style {
    <style>
        .table-responsive {
            border-radius: 0.375rem;
        }

        #commendationTable_wrapper .dataTables_length,
        #commendationTable_wrapper .dataTables_filter {
            margin-bottom: 1rem;
        }

        #commendationTable_wrapper .dataTables_info,
        #commendationTable_wrapper .dataTables_paginate {
            margin-top: 1rem;
        }

        .btn-sm {
            padding: 0.25rem 0.5rem;
            font-size: 0.875rem;
        }

        .modal-content {
            border-radius: 0.5rem;
            box-shadow: 0 0.5rem 1rem rgba(0,0,0,.15);
        }

        .form-control:focus, .form-select:focus {
            border-color: #0d6efd;
            box-shadow: 0 0 0 .2rem rgba(13,110,253,.25);
        }

        .form-control[readonly], .form-select[disabled] {
            background-color: #f8f9fa;
            border-color: #dee2e6;
        }

        .edit-mode .form-control[readonly],
        .edit-mode .form-select[disabled] {
            background-color: #fff;
            border-color: #ced4da;
        }

        .invalid-feedback {
            display: none;
        }

        .form-control.is-invalid, .form-select.is-invalid {
            border-color: #dc3545;
        }

            .form-control.is-invalid ~ .invalid-feedback,
            .form-select.is-invalid ~ .invalid-feedback {
                display: block;
            }

        .is-invalid + .select2-container .select2-selection--single {
            border-color: #dc3545;
        }

        .select2-container .select2-selection--single {
            height: 38px;
            border: 1px solid #ced4da;
            border-radius: 0.375rem;
        }

        .select2-container--default .select2-selection--single .select2-selection__rendered {
            line-height: 36px;
            padding-left: 12px;
        }

        .select2-container--default .select2-selection--single .select2-selection__arrow {
            height: 36px;
        }

        .select2-container--default.select2-container--focus .select2-selection--single {
            border-color: #0d6efd;
            box-shadow: 0 0 0 .2rem rgba(13,110,253,.25);
        }

        .select2-container--default .select2-selection--single.select2-selection--disabled {
            background-color: #f8f9fa;
            border-color: #dee2e6;
        }

        .card-header {
            border-bottom: none !important;
        }

        .attachment-item {
            display: flex;
            align-items: center;
            gap: 10px;
            padding: 8px;
            border: 1px solid #dee2e6;
            border-radius: 4px;
            margin-bottom: 5px;
            background-color: #f8f9fa;
        }

            .attachment-item a {
                text-decoration: none;
                color: #0d6efd;
            }

                .attachment-item a:hover {
                    text-decoration: underline;
                }

        .truncate {
            max-width: 150px;
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
            display: inline-block;
        }

        .truncate-remarks {
            max-width: 200px;
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
            display: inline-block;
        }

        .datepicker-wrapper {
            position: relative;
            display: block;
        }

            .datepicker-wrapper .form-control {
                padding-right: 36px;
            }

            .datepicker-wrapper .datepicker-icon {
                position: absolute;
                right: 10px;
                top: 50%;
                transform: translateY(-50%);
                color: #6c757d;
                pointer-events: none;
                line-height: 1;
            }

        /* ── SweetAlert2 ─────────────────────────────────────────────── */
        .swal2-popup {
            border-radius: 15px !important;
            padding: 2rem !important;
        }

        .swal2-confirm {
            background-color: #7c3aed !important;
            border-color: #7c3aed !important;
            color: white !important;
            font-weight: 500 !important;
            padding: .75rem 2rem !important;
            border-radius: 8px !important;
            font-size: .875rem !important;
        }

            .swal2-confirm:hover {
                background-color: #6d28d9 !important;
            }

        .swal2-cancel {
            background-color: #6b7280 !important;
            border-color: #6b7280 !important;
            color: white !important;
            font-weight: 500 !important;
            padding: .75rem 2rem !important;
            border-radius: 8px !important;
            font-size: .875rem !important;
        }

            .swal2-cancel:hover {
                background-color: #4b5563 !important;
            }
    </style>
}

@section Fillow_script {
    <script>
        $(document).ready(function () {

            // ── ACCESS CONTROL ─────────────────────────────────────────────────────
            MODULE = 'FCommendation';
            access = ROLE_ACCESS?.[MODULE];

            if (access !== 'READWRITE' && access !== 'FULL') {
                $('#btnAddCommendation').hide();
            }

            // ── CONFIG ─────────────────────────────────────────────────────────────
            const config = {
                toastr: {
                    positionClass: "toast-top-right", timeOut: 5000,
                    closeButton: true, progressBar: true, preventDuplicates: true
                },
                endpoints: {
                    list:        '/CommendationList/GetCommendationList',
                    get:         '/CommendationList/GetCommendation',
                    employees:   '/CommendationList/GetEmployeeList',
                    types:       '/CommendationList/GetCommendationTypes',
                    attachments: '/CommendationList/GetCommendationAttachments',
                    add:         '/CommendationList/AddCommendation',
                    update:      '/CommendationList/UpdateCommendation',
                    delete:      '/CommendationList/DeleteCommendation',
                    restore:     '/CommendationList/RestoreCommendation'
                },
                datepickerFormat: 'yyyy/mm/dd'
            };

            toastr.options = config.toastr;
            let isViewingDeleted = false;

            // ── INIT ───────────────────────────────────────────────────────────────
            initSelect2();

            $('.bt-datepicker').datepicker({
                format: config.datepickerFormat,
                autoclose: true
            });

            $('#filterRecordStatus').select2({
                selectOnClose: true,
                minimumResultsForSearch: Infinity
            });

            $('#filterRecordStatus').on('change', function () {
                isViewingDeleted = $(this).val() === 'inactive';
                updateTableView();
            });

            $('#filterEmployee, #filterDepartment').on('change', function () {
                table.ajax.reload(null, false);
            });

            // ── DATATABLE ──────────────────────────────────────────────────────────
            const table = $('#commendationTable').DataTable({
                processing: true,
                serverSide: false,
                ajax: {
                    url: config.endpoints.list,
                    type: 'GET',
                    data: () => ({
                        status:     isViewingDeleted ? 'inactive' : 'active',
                        employeeNo: $('#filterEmployee').val() || '',
                        department: $('#filterDepartment').val() || ''
                    }),
                    error: () => showNotification('Error loading data. Please refresh the page.', 'error')
                },
                columns: [
                    {
                        data: null, width: '10%', orderable: false,
                        render: (data, type, row) => {
                            let viewBtn    = '';
                            let deleteBtn  = '';
                            let restoreBtn = '';

                            if (isViewingDeleted) {
                                if (access === 'FULL') {
                                    restoreBtn = `<button class="btn btn-sm btn-success shadow-sm restoreCommendation"
                                                    data-id="${row.id}" title="Restore">
                                                    <i class="fas fa-undo"></i>
                                                  </button>`;
                                }
                                return `<div class="d-flex gap-1">${restoreBtn}</div>`;
                            }

                            if (access === 'READ' || access === 'READWRITE' || access === 'FULL') {
                                viewBtn = `<button class="btn btn-sm btn-primary shadow-sm viewCommendation"
                                             data-id="${row.id}" title="View">
                                             <i class="fas fa-eye"></i>
                                           </button>`;
                            }
                            if (access === 'FULL') {
                                deleteBtn = `<button class="btn btn-sm btn-danger shadow-sm deleteCommendation"
                                               data-id="${row.id}" title="Delete">
                                               <i class="fa fa-trash"></i>
                                             </button>`;
                            }
                            return `<div class="d-flex gap-1">${viewBtn}${deleteBtn}</div>`;
                        }
                    },
                    {
                        data: 'employeeName', width: '18%',
                        render: d => `<span class="truncate" title="${escHtml(d)}">${escHtml(d)}</span>`
                    },
                    {
                        data: 'commendationType', width: '15%',
                        render: d => `<span class="truncate" title="${escHtml(d)}">${escHtml(d)}</span>`
                    },
                    {
                        data: 'activity', width: '17%',
                        render: d => `<span class="truncate" title="${escHtml(d)}">${escHtml(d)}</span>`
                    },
                    {
                        data: 'remarks', width: '15%',
                        render: d => `<span class="truncate-remarks" title="${escHtml(d)}">${escHtml(d)}</span>`
                    },
                    {
                        data: 'dateissued', width: '10%',
                        render: d => {
                            if (!d) return '';
                            const dt = new Date(d);
                            if (isNaN(dt.getTime())) return d;
                            const y   = dt.getFullYear();
                            const m   = String(dt.getMonth() + 1).padStart(2, '0');
                            const day = String(dt.getDate()).padStart(2, '0');
                            return `${y}/${m}/${day}`;
                        }
                    },
                    {
                        data: null, width: '8%', orderable: false,
                        render: (data, type, row) =>
                            `<button class="btn btn-sm btn-outline-primary viewAttachment"
                                       data-employee="${escHtml(row.employeeNo)}" title="View Attachments">
                               <i class="fas fa-paperclip"></i>
                             </button>`
                    }
                ],
                order: [[0, 'desc']],
                pageLength: 25,
                lengthMenu: [[10, 25, 50, 100, -1], [10, 25, 50, 100, 'All']],
                language: {
                    processing: 'Loading...',
                    emptyTable: 'No commendations found',
                    zeroRecords: 'No matching records found',
                    paginate: {
                        next: '<i class="fa fa-angle-double-right"></i>',
                        previous: '<i class="fa fa-angle-double-left"></i>'
                    }
                }
            });

            // ── ADD ────────────────────────────────────────────────────────────────
            $('#btnAddCommendation').click(() => {
                resetAddForm();
                loadDropdowns('#addEmployeeName', '#addCommendationType');
                $('#addCommendationModal').modal('show');
            });

            $('#btnSaveNewCommendation').click(() => {
                if (!validateForm('#addCommendationForm', [
                    'addEmployeeName', 'addCommendationType', 'addActivity', 'addDateIssued', 'addIssuedBy'
                ])) return;

                const fd = new FormData();
                fd.append('employeeNo',       $('#addEmployeeName').val());
                fd.append('commendationCode', $('#addCommendationType').val());
                fd.append('activity',         $('#addActivity').val().trim());
                fd.append('dateissued',        $('#addDateIssued').val());
                fd.append('issuedBy',         $('#addIssuedBy').val().trim());
                fd.append('remarks',          $('#addRemarks').val().trim());

                const file = $('#addAttachment')[0].files[0];
                if (file) fd.append('attachment', file);

                ajaxSave(config.endpoints.add, fd, '#btnSaveNewCommendation', true);
            });

            // ── VIEW / EDIT ────────────────────────────────────────────────────────
            $(document).on('click', '.viewCommendation', function (e) {
                e.preventDefault();
                const id   = $(this).data('id');
                const $btn = $(this);
                toggleLoading($btn, true);

                $.get(config.endpoints.get, { id })
                    .done(data => {
                        if (!data) { showNotification('Unable to load record.', 'error'); return; }
                        resetViewForm();
                        setViewMode();
                        loadDropdownsAsync('#viewEmployeeName', '#viewCommendationType').done(() => {
                            populateViewForm(data);
                            loadCurrentAttachments(data.employeeNo);
                            $('#viewCommendationModal').modal('show');
                        });
                    })
                    .fail(() => showNotification('Unable to load record.', 'error'))
                    .always(() => toggleLoading($btn, false));
            });

            $('#btnEditCommendation').click(() => {
                setEditMode();
                $('#viewActivity').focus();
            });

            $('#btnCancelEdit').click(() => {
                const id = $('#viewCommendationId').val();
                $.get(config.endpoints.get, { id }).done(data => {
                    if (data) { populateViewForm(data); setViewMode(); clearValidation('#viewCommendationForm'); }
                });
            });

            $('#btnSaveCommendation').click(() => {
                if (!validateForm('#viewCommendationForm', [
                    'viewEmployeeName', 'viewCommendationType', 'viewActivity', 'viewDateIssued', 'viewIssuedBy'
                ])) return;

                const fd = new FormData();
                fd.append('id',               $('#viewCommendationId').val());
                fd.append('employeeNo',       $('#viewEmployeeName').val());
                fd.append('commendationCode', $('#viewCommendationType').val());
                fd.append('activity',         $('#viewActivity').val().trim());
                fd.append('dateissued',        $('#viewDateIssued').val());
                fd.append('issuedBy',         $('#viewIssuedBy').val().trim());
                fd.append('remarks',          $('#viewRemarks').val().trim());

                const file = $('#viewAttachment')[0].files[0];
                if (file) fd.append('attachment', file);

                ajaxSave(config.endpoints.update, fd, '#btnSaveCommendation', false);
            });

            // ── DELETE ─────────────────────────────────────────────────────────────
            $(document).on('click', '.deleteCommendation', function (e) {
                e.preventDefault();
                deleteWithReason({
                    title:  'Inactive Commendation',
                    text:   'Are you sure you want to inactive this commendation?',
                    url:    config.endpoints.delete,
                    id:     $(this).data('id'),
                    button: $(this),
                    table
                });
            });

            // ── RESTORE ────────────────────────────────────────────────────────────
            $(document).on('click', '.restoreCommendation', function (e) {
                e.preventDefault();
                const id   = $(this).data('id');
                const $btn = $(this);

                Swal.fire({
                    title: 'Restore Record',
                    text:  'Are you sure you want to restore this commendation?',
                    icon:  'question',
                    showCancelButton:   true,
                    confirmButtonText:  'Yes, Restore',
                    cancelButtonText:   'Cancel',
                    confirmButtonColor: '#28a745',
                    cancelButtonColor:  '#6c757d',
                    allowOutsideClick:  false,
                    allowEscapeKey:     false
                }).then(result => {
                    if (!result.isConfirmed) return;
                    toggleLoading($btn, true);
                    $.post(config.endpoints.restore, { id })
                        .done(res => {
                            if (res.success) { table.ajax.reload(null, false); showNotification(res.message, 'success'); }
                            else             { showNotification(res.message, 'error'); }
                        })
                        .fail(() => showNotification('Unable to restore. Please try again.', 'error'))
                        .always(() => toggleLoading($btn, false));
                });
            });

            // ── ATTACHMENTS ────────────────────────────────────────────────────────
            $(document).on('click', '.viewAttachment', function (e) {
                e.preventDefault();
                loadAttachmentsList($(this).data('employee'));
                $('#attachmentModal').modal('show');
            });

            // ── MODAL LIFECYCLE ────────────────────────────────────────────────────
            $('#addCommendationModal').on('hidden.bs.modal', resetAddForm);
            $('#viewCommendationModal').on('hidden.bs.modal', () => { resetViewForm(); setViewMode(); });

            // ── KEYBOARD ───────────────────────────────────────────────────────────
            $('#addCommendationForm').on('keypress', e => {
                if (e.which === 13) { e.preventDefault(); $('#btnSaveNewCommendation').click(); }
            });
            $('#viewCommendationForm').on('keypress', e => {
                if (e.which === 13 && $('#viewCommendationModal .modal-body').hasClass('edit-mode')) {
                    e.preventDefault(); $('#btnSaveCommendation').click();
                }
            });

            // ── INLINE VALIDATION CLEAR ────────────────────────────────────────────
            $(document).on('input change',
                '#addEmployeeName, #addCommendationType, #addActivity, #addDateIssued, #addIssuedBy, ' +
                '#viewEmployeeName, #viewCommendationType, #viewActivity, #viewDateIssued, #viewIssuedBy',
                function () { $(this).removeClass('is-invalid'); }
            );

            // ══════════════════════════════════════════════════════════════════════
            // HELPERS
            // ══════════════════════════════════════════════════════════════════════

            function initSelect2() {
                $('#addEmployeeName').select2({
                    placeholder: 'Select Employee', allowClear: true,
                    dropdownParent: $('#addCommendationModal'), width: '100%'
                });
                $('#viewEmployeeName').select2({
                    placeholder: 'Select Employee', allowClear: true,
                    dropdownParent: $('#viewCommendationModal'), width: '100%'
                });
                $('#addCommendationType').select2({
                    placeholder: 'Select Type', allowClear: true,
                    dropdownParent: $('#addCommendationModal'),
                    minimumResultsForSearch: Infinity, width: '100%'
                });
                $('#viewCommendationType').select2({
                    placeholder: 'Select Type', allowClear: true,
                    dropdownParent: $('#viewCommendationModal'),
                    minimumResultsForSearch: Infinity, width: '100%'
                });
                $('#filterEmployee').select2({
                    placeholder: 'All Employees',
                    allowClear: true,
                    ajax: {
                        url: '/Setup/GetEmployeeName',
                        dataType: 'json',
                        delay: 250,
                        data: function (params) {
                            return { employeeName: params.term || '' };
                        },
                        processResults: function (data) {
                            return {
                                results: $.map(data, function (item) {
                                    return { id: item.employeeNo, text: item.employeeName };
                                })
                            };
                        }
                    }
                });
                $('#filterDepartment').select2({
                    placeholder: 'Select Department',
                    allowClear: true,
                    ajax: {
                        url: '/Setup/GetEmployeeDepartment',
                        dataType: 'json',
                        delay: 250,
                        processResults: data => ({
                            results: [{ id: 'ALL', text: 'All Departments' }].concat(
                                data.map(item => ({ id: item.departmentCode, text: item.departmentName }))
                            )
                        })
                    }
                });
            }

            function loadDropdowns(empSelector, typeSelector) {
                $.get(config.endpoints.employees, data => {
                    const $s = $(empSelector).empty().append('<option value="">Select Employee...</option>');
                    data.forEach(i => $s.append(`<option value="${escHtml(i.employeeNo)}">${escHtml(i.employeeName)}</option>`));
                });
                $.get(config.endpoints.types, data => {
                    const $s = $(typeSelector).empty().append('<option value="">Select Type...</option>');
                    data.forEach(i => $s.append(`<option value="${escHtml(i.commendationCode)}">${escHtml(i.commendationName)}</option>`));
                });
            }

            function loadDropdownsAsync(empSelector, typeSelector) {
                return $.when(
                    $.get(config.endpoints.employees).done(data => {
                        const $s = $(empSelector).empty().append('<option value="">Select Employee...</option>');
                        data.forEach(i => $s.append(`<option value="${escHtml(i.employeeNo)}">${escHtml(i.employeeName)}</option>`));
                    }),
                    $.get(config.endpoints.types).done(data => {
                        const $s = $(typeSelector).empty().append('<option value="">Select Type...</option>');
                        data.forEach(i => $s.append(`<option value="${escHtml(i.commendationCode)}">${escHtml(i.commendationName)}</option>`));
                    })
                );
            }

            function populateViewForm(data) {
                $('#viewCommendationId').val(data.id);
                $('#viewEmployeeName').val(data.employeeNo).trigger('change');
                $('#viewCommendationType').val(data.commendationCode).trigger('change');
                $('#viewActivity').val(data.activity || '');
                $('#viewIssuedBy').val(data.issuedBy || '');
                $('#viewRemarks').val(data.remarks || '');

                let formattedDate = '';
                if (data.dateissued) {
                    const dt = new Date(data.dateissued);
                    if (!isNaN(dt.getTime())) {
                        const y   = dt.getFullYear();
                        const m   = String(dt.getMonth() + 1).padStart(2, '0');
                        const day = String(dt.getDate()).padStart(2, '0');
                        formattedDate = `${y}/${m}/${day}`;
                    }
                }
                $('#viewDateIssued').val(formattedDate);

                if (access === 'READWRITE' || access === 'FULL') {
                    $('#btnEditCommendation').removeClass('d-none');
                } else {
                    $('#btnEditCommendation').addClass('d-none');
                }
            }

            function loadCurrentAttachments(employeeNo) {
                $.get(config.endpoints.attachments, { employeeNo }, data => {
                    const $c = $('#currentAttachments').empty();
                    if (data && data.length > 0) {
                        data.forEach(a => {
                            const name = a.attachmentPath.split('/').pop();
                            $c.append(`
                                <div class="attachment-item">
                                    <i class="fas fa-file"></i>
                                    <a href="${a.attachmentPath}" target="_blank">${escHtml(name)}</a>
                                    <small class="text-muted ms-auto">
                                        ${new Date(a.dtAdded).toLocaleDateString()}
                                    </small>
                                </div>`);
                        });
                    } else {
                        $c.append('<small class="text-muted">No attachments found</small>');
                    }
                });
            }

            function loadAttachmentsList(employeeNo) {
                $.get(config.endpoints.attachments, { employeeNo }, data => {
                    const $c = $('#attachmentList').empty();
                    if (data && data.length > 0) {
                        data.forEach(a => {
                            const name = a.attachmentPath.split('/').pop();
                            $c.append(`
                                <div class="attachment-item mb-3">
                                    <i class="fas fa-file-alt fa-2x me-3"></i>
                                    <div class="flex-grow-1">
                                        <h6 class="mb-1">
                                            <a href="${a.attachmentPath}" target="_blank"
                                               class="text-decoration-none">${escHtml(name)}</a>
                                        </h6>
                                        <small class="text-muted">
                                            Added: ${new Date(a.dtAdded).toLocaleDateString()}
                                        </small>
                                    </div>
                                    <a href="${a.attachmentPath}" target="_blank"
                                       class="btn btn-sm btn-outline-primary ms-2">
                                        <i class="fas fa-download"></i> View
                                    </a>
                                </div>`);
                        });
                    } else {
                        $c.append('<p class="text-muted text-center">No attachments found.</p>');
                    }
                });
            }

            function updateTableView() {
                table.ajax.reload(null, false);
                const canAdd = access === 'READWRITE' || access === 'FULL';
                $('#btnAddCommendation')[isViewingDeleted || !canAdd ? 'hide' : 'show']();
                $('#btnExportToExcel')[isViewingDeleted ? 'hide' : 'show']();
            }

            $('#btnExportToExcel').click(function () {
                const $btn     = $(this);
                const pageInfo = table.page.info();

                if (pageInfo.recordsDisplay === 0) {
                    return showNotification('No data available to export', 'warning');
                }

                const params = new URLSearchParams({
                    employeeNo: $('#filterEmployee').val()   || '',
                    department: $('#filterDepartment').val() || '',
                    offset:     pageInfo.start,
                    limit:      pageInfo.length === -1 ? 0 : pageInfo.length
                });

                toggleLoading($btn, true, 'Exporting...');

                const link = Object.assign(document.createElement('a'), {
                    href:     `/CommendationExport/ExportToExcel?${params}`,
                    download: ''
                });
                document.body.appendChild(link);
                link.click();
                document.body.removeChild(link);

                setTimeout(() => {
                    toggleLoading($btn, false);
                    showNotification(
                        `Exported ${pageInfo.recordsDisplay} record(s) successfully.`,
                        'success'
                    );
                }, 1500);
            });

            function ajaxSave(url, data, btnSelector, closeModal) {
                const $btn = $(btnSelector);
                toggleLoading($btn, true, 'Saving...');
                $.ajax({
                    url, type: 'POST', data, processData: false, contentType: false,
                    success: res => {
                        if (res.success) {
                            if (closeModal) $('#addCommendationModal').modal('hide');
                            else            setViewMode();
                            table.ajax.reload(null, false);
                            showNotification(res.message, 'success');
                        } else {
                            showNotification(res.message, 'error');
                        }
                    },
                    error:    () => showNotification('Unable to save. Please try again.', 'error'),
                    complete: () => toggleLoading($btn, false)
                });
            }

            function resetAddForm() {
                $('#addCommendationForm')[0].reset();
                $('#addEmployeeName, #addCommendationType').val(null).trigger('change');
                $('#addDateIssued').datepicker('update', '');
                clearValidation('#addCommendationForm');
                $('#btnSaveNewCommendation').prop('disabled', false).html('Save');
            }

            function resetViewForm() {
                $('#viewCommendationForm')[0].reset();
                $('#viewEmployeeName, #viewCommendationType').val(null).trigger('change');
                $('#viewDateIssued').datepicker('update', '');
                $('#currentAttachments').empty();
                clearValidation('#viewCommendationForm');
                $('#btnSaveCommendation').prop('disabled', false).html('Save');
            }

            function setViewMode() {
                $('#viewModalTitle').text('View Commendation');
                $('#viewCommendationModal .modal-body').removeClass('edit-mode');
                $('#viewEmployeeName, #viewCommendationType').prop('disabled', true);
                $('#viewActivity, #viewIssuedBy, #viewRemarks').prop('readonly', true);
                $('#viewDateIssued').datepicker('remove').prop('readonly', true);
                $('.edit-required').addClass('d-none');
                $('#viewAttachment').addClass('d-none');
                $('.edit-mode-only').addClass('d-none');
                $('#btnSaveCommendation, #btnCancelEdit').addClass('d-none');
                clearValidation('#viewCommendationForm');
            }

            function setEditMode() {
                $('#viewModalTitle').text('Edit Commendation');
                $('#viewCommendationModal .modal-body').addClass('edit-mode');
                $('#viewEmployeeName, #viewCommendationType').prop('disabled', false);
                $('#viewActivity, #viewIssuedBy, #viewRemarks').prop('readonly', false);
                $('#viewDateIssued').prop('readonly', false).datepicker({
                    format: config.datepickerFormat, autoclose: true
                });
                $('.edit-required').removeClass('d-none');
                $('#viewAttachment').removeClass('d-none');
                $('.edit-mode-only').removeClass('d-none');
                $('#btnEditCommendation').addClass('d-none');
                $('#btnSaveCommendation, #btnCancelEdit').removeClass('d-none');
            }

            function validateForm(formSelector, fields) {
                clearValidation(formSelector);
                let valid = true;
                fields.forEach(f => {
                    const $f = $(`#${f}`);
                    if (!$f.val() || !$f.val().toString().trim()) {
                        $f.addClass('is-invalid'); valid = false;
                    }
                });
                return valid;
            }

            function clearValidation(formSelector) {
                $(`${formSelector} .form-control, ${formSelector} .form-select`).removeClass('is-invalid');
            }

            function toggleLoading($btn, loading, text = '') {
                if (loading) {
                    if (!$btn.data('orig')) $btn.data('orig', $btn.html());
                    $btn.prop('disabled', true).html(`<i class="fas fa-spinner fa-spin"></i>${text ? ' ' + text : ''}`);
                } else {
                    $btn.prop('disabled', false).html($btn.data('orig') || 'Save').removeData('orig');
                }
            }

            function showNotification(message, type) {
                const titles = { success: 'Success', error: 'Error', warning: 'Warning', info: 'Information' };
                toastr[type](message, titles[type] || 'Notification');
            }

            function escHtml(str) {
                if (!str) return '';
                return String(str)
                    .replace(/&/g, '&amp;')
                    .replace(/</g, '&lt;')
                    .replace(/>/g, '&gt;')
                    .replace(/"/g, '&quot;');
            }

        });
    </script>
}
