@{
    Layout = "~/Views/Shared/_LayoutFillow.cshtml";
    ViewData["Title"] = "Audit Trail";
}

<div class="col-12">
    <div class="card">
        <div class="card-header">
            <div class="row" style="width:100%;">
                <h4 class="card-title">Audit Trail Logs</h4>
                <br> <br> <br>

                <div class="row date-range" style="margin-left:0px;width:100%;">
                    <div class="col-md-3">
                        <label>Date From</label>
                        <div class="input-hasicon">
                            <input name="dateFrom" id="dateFrom" class="form-control formInput date-from" placeholder="mm/dd/yyyy">
                            <div class="icon"><i class="far fa-calendar"></i></div>
                        </div>
                    </div>
                    <div class="col-md-3">
                        <label>Date To</label>
                        <div class="input-hasicon">
                            <input name="dateTo" id="dateTo" class="form-control formInput date-to" placeholder="mm/dd/yyyy">
                            <div class="icon"><i class="far fa-calendar"></i></div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="card-body">
            <div class="table-responsive">
                <table id="auditTable" class="display" style="min-width: 845px">
                    <thead>
                        <tr>
                            <th>Date/Time</th>
                            <th>Table</th>
                            <th>Reference ID</th>
                            <th>Action</th>
                            <th>Remarks</th>
                            <th>User</th>
                        </tr>
                    </thead>
                </table>
            </div>
        </div>
    </div>
</div>

@section Fillow_style
{
    <style>
        .input-hasicon .icon {
            display: none;
        }

        .input-hasicon input {
            width: 100%;
        }

        .date-range {
            margin-bottom: 20px;
        }

            .date-range .col-md-3 {
                margin-bottom: 15px;
            }

            .date-range label {
                font-weight: 500;
                margin-bottom: 5px;
                display: block;
            }

        .table-responsive {
            border-radius: 0.375rem;
        }

        .card-header {
            border-bottom: none !important;
        }

        .datepicker {
            z-index: 1051 !important;
        }
    </style>
}

@section Fillow_script
{
    <script>

        MODULE = 'Aaudittrail';
        access = ROLE_ACCESS?.[MODULE];

        $(document).ready(function () {
            toastr.options = {
                positionClass: "toast-bottom-right",
                timeOut: 5000,
                closeButton: true,
                progressBar: true
            };

            // Initialize datepickers
            $('#dateFrom, #dateTo').datepicker({
                format: 'mm/dd/yyyy',
                autoclose: true,
                todayHighlight: true
            });

            var table = $('#auditTable').DataTable({
                processing: true,
                serverSide: false,
                ajax: {
                    url: "/AuditTrail/GetAuditTrailList",
                    type: "GET",
                    data: function(d) {
                        return {
                            dateFrom: $('#dateFrom').val(),
                            dateTo: $('#dateTo').val()
                        };
                    },
                    dataSrc: function(json) {
                        console.log('Audit Trail Data Received:', json);
                        console.log('Number of records:', json.data ? json.data.length : 0);
                        if (json.data && json.data.length > 0) {
                            console.log('First record date:', json.data[0].dtAdded);
                            console.log('Last record date:', json.data[json.data.length - 1].dtAdded);
                        }
                        return json.data || [];
                    },
                    error: function(xhr, error, code) {
                        console.log('Error loading audit data:', error);
                        console.log('XHR Response:', xhr.responseText);
                        toastr.error('Error loading audit trail data', 'Error');
                    }
                },
                columns: [
                    {
                        data: "dtAdded",
                        width: "15%",
                        type: "date",
                        render: function(data, type, row) {
                            if (type === 'display' || type === 'filter') {
                                if (!data) return '';
                                var date = new Date(data);
                                return date.toLocaleString('en-US', {
                                    year: 'numeric',
                                    month: '2-digit',
                                    day: '2-digit',
                                    hour: '2-digit',
                                    minute: '2-digit',
                                    second: '2-digit'
                                });
                            }
                            // For sorting, return the raw date string or timestamp
                            return data;
                        }
                    },
                    {
                        data: "tableName",
                        width: "12%"
                    },
                    {
                        data: "referenceID",
                        width: "8%"
                    },
                    {
                        data: "action",
                        width: "10%",
                        render: function(data) {
                            return `<span class="badge badge-primary">${data}</span>`;
                        }
                    },
                    {
                        data: "remarks",
                        width: "40%"
                    },
                    {
                        data: "usercode",
                        width: "15%",
                        render: function(data) {
                            return data || 'SYSTEM';
                        }
                    }
                ],
                order: [[0, 'desc']],
                pageLength: 25,
                lengthMenu: [[10, 25, 50, 100, -1], [10, 25, 50, 100, "All"]],
                language: {
                    processing: "Loading...",
                    emptyTable: "No audit logs found",
                    zeroRecords: "No matching audit logs found",
                    paginate: {
                        next: '<i class="fa fa-angle-double-right" aria-hidden="true"></i>',
                        previous: '<i class="fa fa-angle-double-left" aria-hidden="true"></i>'
                    }
                },
                drawCallback: function(settings) {
                    console.log('Table drawn. Current page:', this.api().page.info().page + 1);
                }
            });

            // Reload table when date filters change
            $('#dateFrom, #dateTo').on('change', function() {
                table.ajax.reload(null, false);
            });

            validationinputs();
        });
    </script>
}