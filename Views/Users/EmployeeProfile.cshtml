@{
    Layout = "~/Views/Shared/_LayoutFillow.cshtml";
    ViewData["Title"] = "Employee Management";
}

<div class="col-12">
    <div class="card">
        <div class="card-header">
            <div class="row" style="width:100%;">
                <h4 class="card-title">Employee List</h4>
                <br><br><br>

                <div class="row" style="margin-left:0px;width:100%;">
                    <div class="col-md-3">
                        <div class="form-group">
                            <h5>Record Status</h5>
                            <select name="filterStatusName" id="filterStatusName" class="form-control">
                                <option value="All">ALL</option>
                                <option value="1" selected>ACTIVE</option>
                                <option value="0">INACTIVE</option>
                            </select>
                        </div>
                    </div>

                    <div class="col-md-3">
                        <div class="form-group">
                            <h5>Employment Status</h5>
                            <select name="employmentStatus" id="filterEmploymentStatus" class="form-control"></select>
                        </div>
                    </div>

                    <div class="col-md-3">
                        <div class="form-group">
                            <h5>Branch</h5>
                            <select name="branch" id="filterBranch" class="form-control"></select>
                        </div>
                    </div>

                    <div class="col-md-3">
                        <div class="form-group">
                            <h5>Department</h5>
                            <select name="department" id="filterDepartment" class="form-control"></select>
                        </div>
                    </div>

                    <div class="col-md-3">
                        <div class="form-group">
                            <h5>Rank</h5>
                            <select name="rank" id="filterRank" class="form-control"></select>
                        </div>
                    </div>

                    <div class="col-md-6"></div>
                    <div class="col-md-3 d-flex justify-content-end align-items-end">
                        <div class="form-group">
                            <button type="button" class="btn btn-primary" id="btnNewEmployee">
                                <i class="fa fa-plus"></i> New Employee
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="card-body">
            <div class="table-responsive">
                <table id="userTable" class="display" style="min-width: 845px">
                    <thead>
                        <tr>
                            <th>Action</th>
                            <th>Profile</th>
                            <th>Employee No</th>
                            <th>Employee Name</th>
                            <th>Position</th>
                            <th>Rank</th>
                            <th>Branch</th>
                            <th id="dateColumnHeader">Date Hired</th>
                        </tr>
                    </thead>
                </table>
            </div>
        </div>

        <!-- Modal Employee Profile -->
        <div class="modal fade" id="employeeModal" tabindex="-1" aria-hidden="true">
            <div class="modal-dialog modal-xl">
                <div class="modal-content">
                    <div class="modal-header">
                        <h5 class="modal-title">Employee Details</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                    </div>
                    <div class="modal-body">
                        <ul class="nav nav-tabs" id="employeeTabs">
                            <li class="nav-item"><a class="nav-link active" data-tab="BasicInfo" data-module="" href="#">Basic Information</a></li>
                            <li class="nav-item"><a class="nav-link" data-tab="PersonalInfo" data-module="FSPersonalInfoM" href="#">Personal Info</a></li>
                            <li class="nav-item"><a class="nav-link" data-tab="EducationalBackground" data-module="FSEducationalBackgroundM" href="#">Educational Background</a></li>
                            <li class="nav-item"><a class="nav-link" data-tab="PayrollDetails" data-module="FSPayrollDetailsM" href="#">Payroll Details</a></li>
                            <li class="nav-item"><a class="nav-link" data-tab="Allowances" data-module="FSAllowancesM" href="#">Allowances</a></li>
                            <li class="nav-item"><a class="nav-link" data-tab="Loans" data-module="FSLoansM" href="#">Loans</a></li>
                            <li class="nav-item"><a class="nav-link" data-tab="LeaveLedger" data-module="FSleaveLedgerM" href="#">Leave Ledger</a></li>
                            <li class="nav-item"><a class="nav-link" data-tab="LeaveSetup" data-module="FSLeaveSetupM" href="#">Leave Setup</a></li>
                            <li class="nav-item"><a class="nav-link" data-tab="DisciplinaryActionTab" data-module="FDisciplinaryAction" href="#">Disciplinary Action</a></li>
                            <li class="nav-item"><a class="nav-link" data-tab="CommendationTab" data-module="FCommendation" href="#">Commendation</a></li>
                            @* <li class="nav-item"><a class="nav-link" data-tab="MedicalAvailment" data-module="FSMedicalAvailmentM" href="#">Medical Availment</a></li> *@
                            <li class="nav-item"><a class="nav-link" data-tab="EmploymentHistory" data-module="FSEmploymentHistoryM" href="#">Employment History</a></li>
                            <li class="nav-item"><a class="nav-link" data-tab="LicensesAndCertification" data-module="FSLicencesAndCertificationM" href="#">Licenses & Certification</a></li>
                            <li class="nav-item"><a class="nav-link" data-tab="Trainings" data-module="FSTrainingsM" href="#">Trainings</a></li>
                            <li class="nav-item"><a class="nav-link" data-tab="DTR" data-module="FSdtrM" href="#">DTR</a></li>
                            <li class="nav-item"><a class="nav-link" data-tab="Attachments" data-module="FSAttachmentsM" href="#">Attachments</a></li>
                        </ul>
                        <div id="tabContent" class="mt-3"></div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- COE Purpose Modal -->
<div class="modal fade" id="coePurposeModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-sm modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header py-2">
                <h6 class="modal-title">
                    <i class="fas fa-file-alt me-1"></i> Employee Certificate
                </h6>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <p class="mb-2 small text-muted" id="coeEmployeeLabel"></p>
                <label class="form-label fw-semibold" for="coePurposeInput">
                    Purpose <span class="text-danger">*</span>
                </label>
                <input type="text"
                       id="coePurposeInput"
                       class="form-control form-control-sm"
                       placeholder="e.g. car loan application, visa application"
                       maxlength="200">
                <div class="invalid-feedback">Please enter the purpose.</div>

                <!-- Monthly Incentive — only shown for COE With Compensation -->
                <div class="mt-3" id="coeIncentiveGroup" style="display:none;">
                    <label class="form-label fw-semibold" for="coeIncentiveInput">
                        Monthly Incentive <span class="text-muted fw-normal small">(optional)</span>
                    </label>
                    <div class="input-group input-group-sm">
                        <span class="input-group-text">Php</span>
                        <input type="number"
                               id="coeIncentiveInput"
                               class="form-control form-control-sm"
                               placeholder="e.g. 10000"
                               min="0"
                               step="0.01">
                    </div>
                    <div class="form-text text-muted" style="font-size:0.75rem;">
                        <i class="fas fa-info-circle me-1"></i>
                        Will appear as <em>"not fixed amount, average"</em> in the document.
                    </div>
                </div>
            </div>
            <div class="modal-footer py-2">
                <button type="button" class="btn btn-sm btn-danger" data-bs-dismiss="modal">
                    Cancel
                </button>
                <button type="button" class="btn btn-sm btn-primary" id="btnGenerateCoe">
                    <i class="fas fa-file-pdf me-1"></i> Generate PDF
                </button>
            </div>
        </div>
    </div>
</div>
