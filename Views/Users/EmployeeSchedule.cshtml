@{
    Layout = "~/Views/Shared/_LayoutFillow.cshtml";
    ViewData["Title"] = "Employee Schedule";
}

<div class="col-12">
    <div class="card">
        <div class="card-header">
            <div class="row" style="width:100%;">
                <h4 class="card-title">Employee Schedule</h4>
                <br> <br> <br>

                <div class="row date-range" style="margin-left:0px;width:100%;">
                    <div class="col-md-3">
                        <div class="form-group">
                            <h5>Employee</h5>
                            <select name="filterEmployeeName" id="filterEmployeeName" class="form-control">
                                <option value="">All Employees</option>
                            </select>
                        </div>
                    </div>
                    <div class="col-md-3">
                        <label>Effectivity Date From </label>
                        <div class="input-hasicon">
                            <input name="dateFrom" id="dateFrom" class="form-control formInput" placeholder="mm/dd/yyyy">
                            <div class="icon"><i class="far fa-calendar"></i></div>
                        </div>
                    </div>
                    <div class="col-md-3">
                        <label>Effectivity Date To </label>
                        <div class="input-hasicon">
                            <input name="dateTo" id="dateTo" class="form-control formInput" placeholder="mm/dd/yyyy">
                            <div class="icon"><i class="far fa-calendar"></i></div>
                        </div>
                    </div>
                </div>

                <div class="row align-items-end mt-2" style="margin-left:0px;width:100%;">
                    <div class="col-md-3">
                        <div class="form-group">
                            <h5>Branch</h5>
                            <select name="branch" id="filterBranch" class="form-control"></select>
                        </div>
                    </div>
                    <div class="col-md-3">
                        <div class="form-group">
                            <h5>Department</h5>
                            <select name="department" id="filterDepartment" class="form-control"></select>
                        </div>
                    </div>
                    <div class="col-md-6 d-flex justify-content-end">
                        <div class="form-group me-2">
                            <button type="button" class="btn btn-warning" id="btnExportToExcel">
                                <i class="fas fa-file-excel"></i> Export to Excel
                            </button>
                        </div>
                        <div class="form-group">
                            <button type="button" class="btn btn-primary" id="btnAddSchedule">
                                <i class="fa fa-plus"></i> New Schedule
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="card-body">
            <div class="table-responsive">
                <table id="scheduleTable" class="display" style="min-width: 845px">
                    <thead>
                        <tr>
                            <th>Action</th>
                            <th>Employee No</th>
                            <th>Full Name</th>
                            <th>Effectivity Date</th>
                            <th>Schedule Type</th>
                            <th>Working Days</th>
                            <th>Day Count</th>
                        </tr>
                    </thead>
                </table>
            </div>
        </div>

        <!-- Modal for Viewing Weekly Schedule -->
        <div class="modal fade" id="weeklyScheduleModal" tabindex="-1" aria-hidden="true">
            <div class="modal-dialog modal-xl">
                <div class="modal-content">
                    <div class="modal-header">
                        <h5 class="modal-title">Employee Schedule Details</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                    </div>
                    <div class="modal-body">
                        <div class="row mb-3">
                            <div class="col-md-6">
                                <strong>Employee:</strong> <span id="weeklyEmployeeName"></span>
                            </div>
                            <div class="col-md-6">
                                <div class="d-flex align-items-center gap-2">
                                    <strong>Effectivity Date:</strong>
                                    <div class="input-hasicon" style="min-width: 180px;">
                                        <input type="text" id="effectivityDateFilter" class="form-control form-control-sm" placeholder="mm/dd/yyyy" autocomplete="off" readonly>
                                        <div class="icon"><i class="far fa-calendar"></i></div>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="table-responsive">
                            <table class="table table-bordered table-hover">
                                <thead class="table-light">
                                    <tr>
                                        <th style="width: 15%;">Day</th>
                                        <th style="width: 20%;">Schedule Type</th>
                                        <th style="width: 13%;">Time In</th>
                                        <th style="width: 13%;">Time Out</th>
                                        <th style="width: 13%;">Render Hours</th>
                                        <th style="width: 13%;">Break (mins)</th>
                                        <th style="width: 13%;">Action</th>
                                    </tr>
                                </thead>
                                <tbody id="weeklyScheduleBody">
                                    <!-- Schedule rows will be populated here -->
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Modal for Add -->
        <div class="modal fade" id="addScheduleModal" tabindex="-1" aria-hidden="true">
            <div class="modal-dialog modal-lg">
                <div class="modal-content">
                    <div class="modal-header">
                        <h5 class="modal-title">Add Employee Schedule</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                    </div>
                    <div class="modal-body">
                        <form id="addScheduleForm">
                            <div class="row">
                                <div class="col-md-12 mb-3">
                                    <label for="addEmployeeName" class="form-label">Employee Name <span class="text-danger">*</span></label>
                                    <select class="form-select" id="addEmployeeName" name="employeeNo" style="width:100%" required>
                                        <option value="">Select Employee...</option>
                                    </select>
                                    <div class="invalid-feedback">Please select an employee.</div>
                                </div>
                            </div>

                            <div class="row">
                                <div class="col-md-12 mb-3">
                                    <label class="form-label">
                                        <span class="text-danger">*</span> Days of the Week
                                        <span class="ms-2">
                                            <input class="form-check-input" type="checkbox" id="addChkSelectAll">
                                            <label class="form-check-label" for="addChkSelectAll">Select All</label>
                                        </span>
                                    </label>
                                    <div class="d-flex flex-wrap gap-2">
                                        <div class="form-check">
                                            <input class="form-check-input weekday-checkbox" type="checkbox" value="Monday" id="addChkMonday" name="weekdays[]">
                                            <label class="form-check-label" for="addChkMonday">Monday</label>
                                        </div>
                                        <div class="form-check">
                                            <input class="form-check-input weekday-checkbox" type="checkbox" value="Tuesday" id="addChkTuesday" name="weekdays[]">
                                            <label class="form-check-label" for="addChkTuesday">Tuesday</label>
                                        </div>
                                        <div class="form-check">
                                            <input class="form-check-input weekday-checkbox" type="checkbox" value="Wednesday" id="addChkWednesday" name="weekdays[]">
                                            <label class="form-check-label" for="addChkWednesday">Wednesday</label>
                                        </div>
                                        <div class="form-check">
                                            <input class="form-check-input weekday-checkbox" type="checkbox" value="Thursday" id="addChkThursday" name="weekdays[]">
                                            <label class="form-check-label" for="addChkThursday">Thursday</label>
                                        </div>
                                        <div class="form-check">
                                            <input class="form-check-input weekday-checkbox" type="checkbox" value="Friday" id="addChkFriday" name="weekdays[]">
                                            <label class="form-check-label" for="addChkFriday">Friday</label>
                                        </div>
                                        <div class="form-check">
                                            <input class="form-check-input weekday-checkbox" type="checkbox" value="Saturday" id="addChkSaturday" name="weekdays[]">
                                            <label class="form-check-label" for="addChkSaturday">Saturday</label>
                                        </div>
                                        <div class="form-check">
                                            <input class="form-check-input weekday-checkbox" type="checkbox" value="Sunday" id="addChkSunday" name="weekdays[]">
                                            <label class="form-check-label" for="addChkSunday">Sunday</label>
                                        </div>
                                    </div>
                                    <div class="invalid-feedback d-block" id="weekdaysError" style="display:none !important;">Please select at least one day.</div>
                                </div>
                            </div>

                            <div class="row">
                                <div class="col-md-6 mb-3">
                                    <label for="addEffectivityDate" class="form-label">Effectivity Date <span class="text-danger">*</span></label>
                                    <input type="text" class="form-control" id="addEffectivityDate" name="effectivityDate" placeholder="yyyy/mm/dd" required>
                                    <div class="invalid-feedback">Please select effectivity date.</div>
                                </div>
                                <div class="col-md-6 mb-3">
                                    <label for="addScheduleType" class="form-label">Schedule Type <span class="text-danger">*</span></label>
                                    <select class="form-select" id="addScheduleType" name="scheduleTypeCode" style="width:100%" required>
                                        <option value="">Select Schedule Type...</option>
                                    </select>
                                    <div class="invalid-feedback">Please select a schedule type.</div>
                                </div>
                            </div>

                            <div class="row" id="addTimeRow">
                                <div class="col-md-6 mb-3">
                                    <label for="addTimeIn" class="form-label">Time In <span class="text-danger time-required">*</span></label>
                                    <input type="time" class="form-control" id="addTimeIn" name="timeIn">
                                    <div class="invalid-feedback">Please select time in.</div>
                                </div>
                                <div class="col-md-6 mb-3">
                                    <label for="addTimeOut" class="form-label">Time Out <span class="text-danger time-required">*</span></label>
                                    <input type="time" class="form-control" id="addTimeOut" name="timeOut">
                                    <div class="invalid-feedback">Please select time out.</div>
                                </div>
                            </div>

                            <div class="row" id="addRenderRow">
                                <div class="col-md-6 mb-3">
                                    <label for="addRenderHours" class="form-label">Render Hours <span class="text-danger time-required">*</span></label>
                                    <input type="number" step="0.01" class="form-control" id="addRenderHours" name="totalRenderHour" placeholder="e.g., 8">
                                    <div class="invalid-feedback">Please enter render hours.</div>
                                </div>
                                <div class="col-md-6 mb-3">
                                    <label for="addBreaktime" class="form-label">Breaktime (minutes) <span class="text-danger time-required">*</span></label>
                                    <input type="number" step="0.01" class="form-control" id="addBreaktime" name="totalBreaktimeMinute" placeholder="e.g., 60">
                                    <div class="invalid-feedback">Please enter breaktime minutes.</div>
                                </div>
                            </div>
                        </form>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-primary" id="btnSaveNewSchedule">Save</button>
                    </div>
                </div>
            </div>
        </div>

        <!-- Modal for View/Edit Single Schedule -->
        <div class="modal fade" id="viewScheduleModal" tabindex="-1" aria-hidden="true">
            <div class="modal-dialog modal-lg">
                <div class="modal-content">
                    <div class="modal-header">
                        <h5 class="modal-title" id="viewModalTitle">View Employee Schedule</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                    </div>
                    <div class="modal-body">
                        <form id="viewScheduleForm">
                            <input type="hidden" id="viewScheduleId" name="id">

                            <div class="row">
                                <div class="col-md-12 mb-3">
                                    <label for="viewEmployeeName" class="form-label">Employee Name <span class="text-danger edit-required d-none">*</span></label>
                                    <select class="form-select" id="viewEmployeeName" name="employeeNo" style="width:100%" disabled>
                                        <option value="">Select Employee...</option>
                                    </select>
                                    <div class="invalid-feedback">Please select an employee.</div>
                                </div>
                            </div>

                            <div class="row">
                                <div class="col-md-12 mb-3">
                                    <label for="viewWeekdayName" class="form-label">Day <span class="text-danger edit-required d-none">*</span></label>
                                    <select class="form-select" id="viewWeekdayName" name="weekdayName" disabled>
                                        <option value="">Select Day...</option>
                                        <option value="Monday">Monday</option>
                                        <option value="Tuesday">Tuesday</option>
                                        <option value="Wednesday">Wednesday</option>
                                        <option value="Thursday">Thursday</option>
                                        <option value="Friday">Friday</option>
                                        <option value="Saturday">Saturday</option>
                                        <option value="Sunday">Sunday</option>
                                    </select>
                                    <div class="invalid-feedback">Please select a day.</div>
                                </div>
                            </div>

                            <div class="row">
                                <div class="col-md-6 mb-3">
                                    <label for="viewEffectivityDate" class="form-label">Effectivity Date <span class="text-danger edit-required d-none">*</span></label>
                                    <input type="text" class="form-control" id="viewEffectivityDate" name="effectivityDate" placeholder="yyyy/mm/dd" readonly>
                                    <div class="invalid-feedback">Please select effectivity date.</div>
                                </div>
                                <div class="col-md-6 mb-3">
                                    <label for="viewScheduleType" class="form-label">Schedule Type <span class="text-danger edit-required d-none">*</span></label>
                                    <select class="form-select" id="viewScheduleType" name="scheduleTypeCode" style="width:100%" disabled>
                                        <option value="">Select Schedule Type...</option>
                                    </select>
                                    <div class="invalid-feedback">Please select a schedule type.</div>
                                </div>
                            </div>

                            <div class="row" id="viewTimeRow">
                                <div class="col-md-6 mb-3">
                                    <label for="viewTimeIn" class="form-label">Time In <span class="text-danger edit-time-required d-none">*</span></label>
                                    <input type="time" class="form-control" id="viewTimeIn" name="timeIn" readonly>
                                    <div class="invalid-feedback">Please select time in.</div>
                                </div>
                                <div class="col-md-6 mb-3">
                                    <label for="viewTimeOut" class="form-label">Time Out <span class="text-danger edit-time-required d-none">*</span></label>
                                    <input type="time" class="form-control" id="viewTimeOut" name="timeOut" readonly>
                                    <div class="invalid-feedback">Please select time out.</div>
                                </div>
                            </div>

                            <div class="row" id="viewRenderRow">
                                <div class="col-md-6 mb-3">
                                    <label for="viewRenderHours" class="form-label">Render Hours <span class="text-danger edit-time-required d-none">*</span></label>
                                    <input type="number" step="0.01" class="form-control" id="viewRenderHours" name="totalRenderHour" readonly>
                                    <div class="invalid-feedback">Please enter render hours.</div>
                                </div>
                                <div class="col-md-6 mb-3">
                                    <label for="viewBreaktime" class="form-label">Breaktime (minutes) <span class="text-danger edit-time-required d-none">*</span></label>
                                    <input type="number" step="0.01" class="form-control" id="viewBreaktime" name="totalBreaktimeMinute" readonly>
                                    <div class="invalid-feedback">Please enter breaktime minutes.</div>
                                </div>
                            </div>
                        </form>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-primary d-none" id="btnEditSchedule">
                            <i class="fas fa-edit"></i> Edit
                        </button>
                        <button type="button" class="btn btn-success d-none" id="btnSaveSchedule">Save</button>
                        <button type="button" class="btn btn-danger d-none" id="btnCancelEdit">Cancel</button>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Fillow_style
{
    <style>
        .table-responsive {
            border-radius: 0.375rem;
        }

        #scheduleTable_wrapper .dataTables_length, #scheduleTable_wrapper .dataTables_filter {
            margin-bottom: 1rem;
        }

        #scheduleTable_wrapper .dataTables_info, #scheduleTable_wrapper .dataTables_paginate {
            margin-top: 1rem;
        }

        .btn-sm {
            padding: 0.25rem 0.5rem;
            font-size: 0.875rem;
        }

        .modal-content {
            border-radius: 0.5rem;
            box-shadow: 0 0.5rem 1rem rgba(0, 0, 0, 0.15);
        }

        .form-control:focus, .form-select:focus {
            border-color: #0d6efd;
            box-shadow: 0 0 0 0.2rem rgba(13, 110, 253, 0.25);
        }

        .form-control[readonly], .form-select[disabled] {
            background-color: #f8f9fa;
            border-color: #dee2e6;
        }

        .edit-mode .form-control[readonly], .edit-mode .form-select[disabled] {
            background-color: #ffffff;
            border-color: #ced4da;
        }

        .invalid-feedback {
            display: none;
        }

        .form-control.is-invalid, .form-select.is-invalid {
            border-color: #dc3545;
        }

            .form-control.is-invalid ~ .invalid-feedback, .form-select.is-invalid ~ .invalid-feedback {
                display: block;
            }

        .is-invalid + .select2-container .select2-selection--single {
            border-color: #dc3545;
        }

        .select2-container .select2-selection--single {
            height: 38px;
            border: 1px solid #ced4da;
            border-radius: 0.375rem;
        }

        .select2-container--default .select2-selection--single .select2-selection__rendered {
            line-height: 36px;
            padding-left: 12px;
        }

        .select2-container--default .select2-selection--single .select2-selection__arrow {
            height: 36px;
        }

        .select2-container--default.select2-container--focus .select2-selection--single {
            border-color: #0d6efd;
            box-shadow: 0 0 0 0.2rem rgba(13, 110, 253, 0.25);
        }

        .select2-container--default .select2-selection--single.select2-selection--disabled {
            background-color: #f8f9fa;
            border-color: #dee2e6;
        }

        .card-header {
            border-bottom: none !important;
        }

        .form-check {
            padding-left: 0;
        }

        .form-check-input {
            margin-right: 0.5rem;
        }

        .swal2-popup {
            border-radius: 15px !important;
            padding: 2rem !important;
        }

        .badge-days {
            display: inline-block;
            padding: 0.35rem 0.65rem;
            font-size: 0.875rem;
            font-weight: 500;
            line-height: 1;
            color: #fff;
            background-color: #6c757d;
            border-radius: 0.375rem;
            margin: 2px;
        }

        .day-count-badge {
            background-color: #0d6efd;
            color: white;
            padding: 0.25rem 0.6rem;
            border-radius: 0.375rem;
            font-size: 0.875rem;
            font-weight: 600;
        }

        /* Smooth fade animation for filtered rows */
        .schedule-row {
            transition: opacity 0.3s ease-in-out;
        }

        .schedule-row.filtered-out {
            display: none;
        }

        /* Effectivity date calendar filter */
        #weeklyScheduleModal .input-hasicon {
            position: relative;
        }

        #weeklyScheduleModal .input-hasicon .icon {
            position: absolute;
            right: 10px;
            top: 50%;
            transform: translateY(-50%);
            pointer-events: none;
            color: #6c757d;
        }

        #weeklyScheduleModal .input-hasicon .form-control {
            padding-right: 32px;
            cursor: pointer;
        }
    </style>
}

@section Fillow_script
{
    <script>
        $(document).ready(function () {
            // CONFIGURATION
            MODULE = 'FscheduleM';
            access = ROLE_ACCESS?.[MODULE];

            if (access != 'READWRITE' && access != 'FULL') {
                $('#btnAddSchedule').hide();
                $('#btnEditSchedule').hide();
            }

            const config = {
                toastr: { positionClass: "toast-top-right", timeOut: 5000, closeButton: true, progressBar: true, preventDuplicates: true },
                endpoints: {
                    list: "/EmployeeSchedule/GetScheduleList",
                    get: "/EmployeeSchedule/GetSchedule",
                    weekly: "/EmployeeSchedule/GetWeeklySchedule",
                    employees: "/EmployeeSchedule/GetEmployeeList",
                    scheduleTypes: "/EmployeeSchedule/GetScheduleTypes",
                    allSchedules: "/EmployeeSchedule/GetEmployeeAllSchedules",
                    add: "/EmployeeSchedule/AddSchedule",
                    update: "/EmployeeSchedule/UpdateSchedule",
                    inactive: "/EmployeeSchedule/InactiveSchedule",
                    deleteGroup: "/EmployeeSchedule/DeleteScheduleGroup"
                }
            };

            toastr.options = config.toastr;

            // GLOBAL VARIABLE TO STORE ALL SCHEDULES
            let allSchedulesData = [];

            // INITIALIZATION
            $('#addEffectivityDate, #viewEffectivityDate').datepicker({
                format: 'mm/dd/yyyy', autoclose: true, todayHighlight: true
            });

            // Filter date pickers — use changeDate to reliably catch selection
            $('#dateFrom').datepicker({
                format: 'mm/dd/yyyy', autoclose: true, todayHighlight: true
            }).on('changeDate', function(e) {
                console.log('[dateFrom] changeDate fired:', $(this).val());
                const fromDate = e.date;
                if (!fromDate) {
                    $('#dateTo').datepicker('setStartDate', null);
                } else {
                    $('#dateTo').datepicker('setStartDate', fromDate);
                }
                table.ajax.reload(null, false);
            }).on('change', function() {
                // Also handle manual clear (user deletes text)
                if (!$(this).val()) {
                    console.log('[dateFrom] cleared manually');
                    $('#dateTo').datepicker('setStartDate', null);
                    table.ajax.reload(null, false);
                }
            });

            $('#dateTo').datepicker({
                format: 'mm/dd/yyyy', autoclose: true, todayHighlight: true
            }).on('changeDate', function(e) {
                console.log('[dateTo] changeDate fired:', $(this).val());
                const toDate   = e.date;
                const fromDate = $('#dateFrom').datepicker('getDate');
                if (fromDate && toDate && toDate < fromDate) {
                    showNotification('Date To cannot be earlier than Date From.', 'error');
                    $(this).datepicker('clearDates');
                    return;
                }
                table.ajax.reload(null, false);
            }).on('change', function() {
                if (!$(this).val()) {
                    console.log('[dateTo] cleared manually');
                    table.ajax.reload(null, false);
                }
            });

            initializeSelect2();
            initializeFilterSelect2();

            // EVENT HANDLERS - SELECT ALL WEEKDAYS
            $('#addChkSelectAll').on('change', function() {
                $('.weekday-checkbox').prop('checked', $(this).is(':checked'));
                $('#weekdaysError').hide();
            });

            $('.weekday-checkbox').on('change', function() {
                const totalCheckboxes = $('.weekday-checkbox').length;
                const checkedCheckboxes = $('.weekday-checkbox:checked').length;
                $('#addChkSelectAll').prop('checked', totalCheckboxes === checkedCheckboxes);
                if (checkedCheckboxes > 0) {
                    $('#weekdaysError').hide();
                }
            });

            // EVENT HANDLERS - SCHEDULE TYPE CHANGE (ADD MODAL)
            $('#addScheduleType').on('change', function() {
                const selectedText = $(this).find('option:selected').text().toUpperCase();
                const isRestDay = selectedText.includes('REST DAY');

                if (isRestDay) {
                    $('#addTimeRow, #addRenderRow').hide();
                    $('.time-required').hide();
                    $('#addTimeIn, #addTimeOut, #addRenderHours, #addBreaktime').val('').prop('required', false);
                } else {
                    $('#addTimeRow, #addRenderRow').show();
                    $('.time-required').show();
                    $('#addTimeIn, #addTimeOut, #addRenderHours, #addBreaktime').prop('required', true);
                    // Set defaults only if fields are currently empty
                    if (!$('#addTimeIn').val()) $('#addTimeIn').val('08:00');
                    if (!$('#addTimeOut').val()) $('#addTimeOut').val('17:00');
                }
            });

            // EVENT HANDLERS - SCHEDULE TYPE CHANGE (VIEW MODAL)
            $('#viewScheduleType').on('change', function() {
                const selectedText = $(this).find('option:selected').text().toUpperCase();
                const isRestDay = selectedText.includes('REST DAY');
                const isEditMode = $('#viewScheduleModal .modal-body').hasClass('edit-mode');

                if (isRestDay) {
                    $('#viewTimeRow, #viewRenderRow').hide();
                    if (isEditMode) {
                        $('.edit-time-required').hide();
                        $('#viewTimeIn, #viewTimeOut, #viewRenderHours, #viewBreaktime').val('').prop('required', false);
                    }
                } else {
                    $('#viewTimeRow, #viewRenderRow').show();
                    if (isEditMode) {
                        $('.edit-time-required').show();
                        $('#viewTimeIn, #viewTimeOut, #viewRenderHours, #viewBreaktime').prop('required', true);
                        // Set defaults only if fields are currently empty
                        if (!$('#viewTimeIn').val()) $('#viewTimeIn').val('08:00');
                        if (!$('#viewTimeOut').val()) $('#viewTimeOut').val('17:00');
                    }
                }
            });

            // EFFECTIVITY DATE FILTER - calendar change
            $('#effectivityDateFilter').on('changeDate change', function () {
                const raw = $(this).val(); // mm/dd/yyyy from datepicker
                const iso = toISODate(raw); // convert to yyyy-mm-dd
                filterSchedulesByDate(iso);
            });

            // HELPER FUNCTIONS - DATE CONVERSION
            function toISODate(dateStr) {
                if (!dateStr) return '';

                // Already in ISO format (yyyy-mm-dd), return as-is
                if (/^\d{4}-\d{2}-\d{2}$/.test(dateStr)) return dateStr;

                // Convert from mm/dd/yyyy
                if (dateStr.includes('/')) {
                    const [m, d, y] = dateStr.split('/');
                    if (!m || !d || !y) return '';
                    return `${y}-${m.padStart(2, '0')}-${d.padStart(2, '0')}`;
                }

                return dateStr;
            }

