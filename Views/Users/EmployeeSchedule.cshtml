                { data: "fullname", width: "20%", name: "fullname" },
                {
                data: "effectivityDate",
                width: "20%",
                name: "effectivityDate",
                render: data => {
                    if (!data) return 'N/A';
                    const dates = data.split(', ').map(d => d.trim()).filter(Boolean);

                    // Sort dates descending to get the latest first
                    dates.sort((a, b) => new Date(b) - new Date(a));

                    const latestDate = dates[0];
                    const remaining = dates.length - 1;

                    let html = `<span class="badge bg-primary text-white me-1">${latestDate}</span>`;

                    if (remaining > 0) {
                        html += `<span class="badge bg-info text-white"
                                      style="cursor:pointer;"
                                      title="${dates.slice(1).join(', ')}">
                                      +${remaining} more
                                 </span>`;
                    }

                    return html;
                }
