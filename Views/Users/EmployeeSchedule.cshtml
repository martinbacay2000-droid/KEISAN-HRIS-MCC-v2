                            if (!mmddyyyy) return '';
                            const parts = mmddyyyy.split('/');
                            if (parts.length !== 3) return mmddyyyy;
                            const [m, d, y] = parts;
                            const result = `${y}-${m.padStart(2, '0')}-${d.padStart(2, '0')}`;
                            console.log('[ajax data] converted date:', mmddyyyy, '→', result);
                            return result;
                        }

