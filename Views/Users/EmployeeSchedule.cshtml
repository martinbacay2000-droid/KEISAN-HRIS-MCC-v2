                            ? `<button class="btn btn-sm btn-danger deleteSchedule ms-1" data-id="${schedule.id}" title="Delete"><i class="fas fa-trash"></i></button>`
                            : '';

                        // Add data-date attribute to each schedule row for filtering
                        const row = `
                            <tr class="schedule-row" data-date="${date}">
                                <td><strong>${schedule.weekdayName}</strong></td>
                                <td>${schedule.scheduleTypeName || 'N/A'}</td>
                                <td>${convertTo12Hour(schedule.timeIn) || 'N/A'}</td>
                                <td>${convertTo12Hour(schedule.timeOut) || 'N/A'}</td>
