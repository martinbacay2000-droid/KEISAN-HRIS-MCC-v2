                $('#viewTimeOut').val(data.timeOut || '');
                $('#viewRenderHours').val(data.totalRenderHour || 0);
                $('#viewBreaktime').val(data.totalBreaktimeMinute || 0);

                // Show/hide time rows based on schedule type
                const isRestDay = (data.scheduleTypeName || '').toUpperCase().includes('REST DAY');
                if (isRestDay) {
                    $('#viewTimeRow, #viewRenderRow').hide();
                } else {
                    $('#viewTimeRow, #viewRenderRow').show();
                }

                // Show edit button only if user has access
                if (access === 'READWRITE' || access === 'FULL') {
                    $('#btnEditSchedule').removeClass('d-none');
                }
            }

            function saveRequest(url, data, buttonSelector, closeModal) {
                const $btn = $(buttonSelector);
                toggleButtonLoading($btn, true, 'Saving...');
                $.ajax({
                    url, type: 'POST', data,
                    success: response => {
                        if (response.success) {
                            if (closeModal) $('#addScheduleModal').modal('hide');
                            else {
                                setViewMode();
                                $('#viewScheduleModal').modal('hide');
                            }
                            table.ajax.reload(null, false);
                            showNotification(response.message, 'success');
                        } else {
                            showNotification(response.message, 'error');
                        }
                    },
                    error: () => showNotification('Unable to save. Please try again.', 'error'),
                    complete: () => toggleButtonLoading($btn, false)
                });
            }

            function resetAddForm() {
                $('#addScheduleForm')[0].reset();
                $('#addEmployeeName, #addScheduleType').val(null).trigger('change');
                $('input[name="weekdays[]"]').prop('checked', false);
                $('#addChkSelectAll').prop('checked', false);
                $('#weekdaysError').hide();
                $('.time-required').show();
                // Always show time rows on reset, defaults applied when modal opens
                $('#addTimeRow, #addRenderRow').show();
                clearValidation('#addScheduleForm');
                $('#btnSaveNewSchedule').prop('disabled', false).html('Save');
            }

            function resetViewForm() {
                $('#viewScheduleForm')[0].reset();
                $('#viewEmployeeName, #viewScheduleType, #viewWeekdayName').val(null).trigger('change');
                $('#viewTimeRow, #viewRenderRow').show();
                clearValidation('#viewScheduleForm');
                $('#btnSaveSchedule').prop('disabled', false).html('Save');
            }

            function resetAllButtons() {
                $('#btnEditSchedule').prop('disabled', false).html('<i class="fas fa-edit"></i> Edit');
            }

            // HELPER FUNCTIONS - VIEW MODES
            function setViewMode() {
                $('#viewModalTitle').text('View Employee Schedule');
                $('#viewScheduleModal .modal-body').removeClass('edit-mode');
                $('#viewEmployeeName, #viewWeekdayName, #viewScheduleType').prop('disabled', true);
                $('#viewEffectivityDate').datepicker('destroy').prop('readonly', true);
                $('#viewTimeIn, #viewTimeOut, #viewRenderHours, #viewBreaktime').prop('readonly', true);
                $('.edit-required, .edit-time-required').addClass('d-none');
                $('#btnEditSchedule').removeClass('d-none');
                $('#btnSaveSchedule, #btnCancelEdit').addClass('d-none');
                clearValidation('#viewScheduleForm');
            }

            function setEditMode() {
                $('#viewModalTitle').text('Edit Employee Schedule');
                $('#viewScheduleModal .modal-body').addClass('edit-mode');
                $('#viewEmployeeName, #viewWeekdayName, #viewScheduleType').prop('disabled', false);
                $('#viewEmployeeName').trigger('change.select2');
                $('#viewScheduleType').trigger('change.select2');
                $('#viewEffectivityDate').prop('readonly', false).datepicker({ format: 'mm/dd/yyyy', autoclose: true, todayHighlight: true });
                $('#viewTimeIn, #viewTimeOut, #viewRenderHours, #viewBreaktime').prop('readonly', false);

                // Check if current schedule type is Rest Day
                const scheduleTypeName = $('#viewScheduleType option:selected').text().toUpperCase();
                const isRestDay = scheduleTypeName.includes('REST DAY');

                $('.edit-required').removeClass('d-none');
                if (!isRestDay) {
                    $('.edit-time-required').removeClass('d-none');
                }

                $('#btnEditSchedule').addClass('d-none');
                $('#btnSaveSchedule, #btnCancelEdit').removeClass('d-none');
            }

            // HELPER FUNCTIONS - VALIDATION
            function validateForm(formSelector, fields) {
                clearValidation(formSelector);
                let isValid = true;
                fields.forEach(field => {
                    if (!$(`#${field}`).val()) {
                        $(`#${field}`).addClass('is-invalid');
                        isValid = false;
                    }
                });
                return isValid;
            }

            function clearValidation(formSelector) {
                $(`${formSelector} .form-control, ${formSelector} .form-select`).removeClass('is-invalid');
            }

            // HELPER FUNCTIONS - UI UTILITIES
            function toggleButtonLoading($btn, loading, text = '') {
                if (loading) {
                    if (!$btn.data('original-html')) $btn.data('original-html', $btn.html());
                    const icon = text ? '<i class="fas fa-spinner fa-spin"></i> ' : '<i class="fas fa-spinner fa-spin"></i>';
                    $btn.prop('disabled', true).html(icon + text);
                } else {
                    const originalHtml = $btn.data('original-html') || 'Save';
                    $btn.prop('disabled', false).html(originalHtml).removeData('original-html');
                }
            }

            function showNotification(message, type) {
                const types = { success: 'Success', error: 'Error', warning: 'Warning', info: 'Information' };
                toastr[type](message, types[type] || 'Notification');
            }

            validationinputs();
        });
    </script>
}