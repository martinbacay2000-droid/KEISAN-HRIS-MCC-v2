             function calculateRenderHours(timeInSelector, timeOutSelector, renderHoursSelector) {
                const timeIn  = $(timeInSelector).val();
                const timeOut = $(timeOutSelector).val();

                if (!timeIn || !timeOut) return;

                const [inHours,  inMinutes]  = timeIn.split(':').map(Number);
                const [outHours, outMinutes] = timeOut.split(':').map(Number);

                const dateIn = new Date();
                dateIn.setHours(inHours, inMinutes, 0, 0);

                const dateOut = new Date();
                dateOut.setHours(outHours, outMinutes, 0, 0);

                let diffMs = dateOut - dateIn;

                // Overnight shift: timeOut is earlier than timeIn → add one full day
                if (diffMs < 0) {
                    diffMs += 24 * 60 * 60 * 1000;
                }

                const diffHours = diffMs / (1000 * 60 * 60);
                $(renderHoursSelector).val(diffHours.toFixed(2));
             }

