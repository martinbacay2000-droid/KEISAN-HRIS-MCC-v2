                        </tr>
                    `;
                    tbody.append(dateHeaderRow);

                    const dayOrder = ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday', 'Sunday'];

                    groupedByDate[date].sort((a, b) =>
                        dayOrder.indexOf(a.weekdayName) - dayOrder.indexOf(b.weekdayName)
