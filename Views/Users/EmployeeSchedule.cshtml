                        const dateTo   = $('#dateTo').val();

                        console.log('[ajax data] raw dateFrom:', dateFrom, '| raw dateTo:', dateTo);
                        console.log('[ajax data] converted dateFrom:', toISO(dateFrom), '| converted dateTo:', toISO(dateTo));

