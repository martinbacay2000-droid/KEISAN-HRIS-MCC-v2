            // HELPER FUNCTION - TIME CONVERSION
            function convertTo12Hour(time24) {
                if (!time24) return '';
                const [hours, minutes] = time24.split(':');
                let hour = parseInt(hours);
                const ampm = hour >= 12 ? 'PM' : 'AM';
                hour = hour % 12;
                hour = hour ? hour : 12;
                return `${hour}:${minutes} ${ampm}`;
            }

            // EFFECTIVITY DATE FILTER - init calendar and auto-select most recent date
            function populateEffectivityDateDropdown(schedules) {
                const uniqueDates = [...new Set(schedules.map(s => s.effectivityDate))];
                // Sort descending — most recent first
                uniqueDates.sort((a, b) => new Date(b) - new Date(a));

                const $input = $('#effectivityDateFilter');

                // Destroy existing datepicker instance if any
                if ($input.data('datepicker')) {
                    $input.datepicker('destroy');
                }

                // Init Bootstrap Datepicker inside the modal
                $input.datepicker({
                    format: 'mm/dd/yyyy',
                    autoclose: true,
                    todayHighlight: false,
                    container: '#weeklyScheduleModal',
                    orientation: 'bottom auto'
                });

                // Auto-select the most recent date
                if (uniqueDates.length > 0) {
                    // uniqueDates[0] is yyyy-mm-dd — convert to mm/dd/yyyy for datepicker
                    const [y, m, d] = uniqueDates[0].split('-');
                    const displayDate = `${m}/${d}/${y}`;
                    $input.datepicker('setDate', displayDate);
                    filterSchedulesByDate(uniqueDates[0]); // filter immediately
                }
            }

            // FILTER SCHEDULES BY DATE
            function filterSchedulesByDate(selectedDate) {
                const $tbody = $('#weeklyScheduleBody');

                // Remove any previous "no schedules" notice
                $tbody.find('.no-schedule-row').remove();

                if (!selectedDate) {
                    $('.date-header-row, .schedule-row').show();
                    return;
                }

                // Hide all rows first
                $('.date-header-row, .schedule-row').hide();

                // Show matching rows
                const $matchingRows = $(`.schedule-row[data-date="${selectedDate}"]`);
                $(`.date-header-row[data-date="${selectedDate}"]`).show();
                $matchingRows.show();

                // Show feedback if nothing matched
                if ($matchingRows.length === 0) {
                    $tbody.append(`
                        <tr class="no-schedule-row">
                            <td colspan="7" class="text-center text-muted py-3">
                                <i class="fas fa-calendar-times me-1"></i>
                                No schedules found for <strong>${selectedDate}</strong>.
                            </td>
                        </tr>
                    `);
                }
            }

