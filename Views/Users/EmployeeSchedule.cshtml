            function displayAllSchedules(schedules) {
                if (schedules.length === 0) return;

                const firstSchedule = schedules[0];
                $('#weeklyEmployeeName').text(firstSchedule.fullname);

                // STORE EMPLOYEE NUMBER IN MODAL DATA ATTRIBUTE
                $('#weeklyScheduleModal').data('current-employee', firstSchedule.employeeNo);

                const tbody = $('#weeklyScheduleBody');
                tbody.empty();

                // Group schedules by effectivity date
                const groupedByDate = {};
                schedules.forEach(schedule => {
                    if (!groupedByDate[schedule.effectivityDate]) {
                        groupedByDate[schedule.effectivityDate] = [];
                    }
                    groupedByDate[schedule.effectivityDate].push(schedule);
                });

                // Display schedules grouped by effectivity date
                Object.keys(groupedByDate).sort((a, b) => new Date(b) - new Date(a)).forEach(date => {
                    // Add date header row with data attribute for filtering
                    const dateHeaderRow = `
                        <tr class="date-header-row" data-date="${date}">
