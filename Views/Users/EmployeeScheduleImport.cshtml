@{
    Layout = "~/Views/Shared/_LayoutFillow.cshtml";
    ViewData["Title"] = "Import Employee Schedules";
}

<div class="col-12">
    <div class="card">
        <div class="card-header">
            <div class="row" style="width:100%;">
                <div class="col-md-6">
                    <h4 class="card-title">Import Employee Schedules</h4>
                </div>
                <div class="col-md-6 text-end">
                    <a href="/EmployeeSchedule/Index" class="btn btn-primary">
                        <i class="fas fa-arrow-left"></i> Back to List
                    </a>
                </div>
            </div>
        </div>
        <div class="card-body">

            <!-- Step Indicator -->
            <div class="import-steps mb-4">
                <div class="step active" id="step1">
                    <div class="step-number">1</div>
                    <div class="step-label">Download Template</div>
                </div>
                <div class="step-line"></div>
                <div class="step" id="step2">
                    <div class="step-number">2</div>
                    <div class="step-label">Upload File</div>
                </div>
                <div class="step-line"></div>
                <div class="step" id="step3">
                    <div class="step-number">3</div>
                    <div class="step-label">Review &amp; Import</div>
                </div>
            </div>

            <!-- Step 1: Download Template -->
            <div id="downloadSection" class="import-section">
                <div class="section-header">
                    <h5><i class="fas fa-download"></i> Step 1: Download Template</h5>
                </div>
                <div class="section-content">
                    <p class="text-muted">Download the Excel template to get started with importing employee schedules.</p>
                    <button type="button" class="btn btn-primary" id="btnDownloadTemplate">
                        <i class="fas fa-file-excel"></i> Download Excel Template
                    </button>
                </div>
            </div>

            <!-- Step 2: Upload File -->
            <div id="uploadSection" class="import-section mt-4">
                <div class="section-header">
                    <h5><i class="fas fa-upload"></i> Step 2: Upload Filled Template</h5>
                </div>
                <div class="section-content">
                    <p class="text-muted">Upload your completed Excel file. The system will validate the data before import.</p>

                    <input type="file" id="excelFile" accept=".xlsx" style="display:none;">

                    <div class="upload-area" id="uploadArea">
                        <div class="upload-placeholder">
                            <i class="fas fa-cloud-upload-alt fa-3x mb-3"></i>
                            <p class="mb-2"><strong>Click to upload</strong> or drag and drop</p>
                            <p class="text-muted small">Excel files only (.xlsx)</p>
                        </div>
                        <div class="upload-file-info" style="display:none;">
                            <i class="fas fa-file-excel fa-2x text-success"></i>
                            <span class="file-name ms-2"></span>
                            <button type="button" class="btn btn-sm btn-danger ms-2" id="btnRemoveFile">
                                <i class="fas fa-times"></i>
                            </button>
                        </div>
                    </div>

                    <button type="button" class="btn btn-success mt-3" id="btnValidateFile" style="display:none;">
                        <i class="fas fa-check-circle"></i> Validate File
                    </button>
                </div>
            </div>

            <!-- Step 3: Review & Import -->
            <div id="reviewSection" class="import-section mt-4" style="display:none;">
                <div class="section-header">
                    <h5><i class="fas fa-list-check"></i> Step 3: Review &amp; Import</h5>
                </div>
                <div class="section-content">

                    <!-- Validation Summary -->
                    <div id="validationSummary" class="mb-3"></div>

                    <!-- Validation Errors -->
                    <div id="validationErrors" style="display:none;" class="mb-3">
                        <div class="alert alert-danger">
                            <h6>
                                <i class="fas fa-times-circle"></i> Validation Errors
                                <span class="badge bg-danger ms-1" id="errorCount"></span>
                            </h6>
                            <ul id="errorList" class="mb-0 error-list"></ul>
                        </div>
                    </div>

                    <!-- Validation Warnings -->
                    <div id="validationWarnings" style="display:none;" class="mb-3">
                        <div class="alert alert-warning">
                            <h6>
                                <i class="fas fa-exclamation-triangle"></i> Warnings
                                <span class="badge bg-warning text-dark ms-1" id="warningCount"></span>
                                <small class="text-muted fw-normal ms-2">— These rows will still be imported. Please review before proceeding.</small>
                            </h6>
                            <ul id="warningList" class="mb-0 warning-list"></ul>
                        </div>
                    </div>

                    <!-- Preview Table -->
                    <div id="previewTableContainer" style="display:none;">
                        <div class="d-flex align-items-center justify-content-between mb-2">
                            <h6 class="mb-0">Data Preview:</h6>
                            <div class="preview-legend d-flex gap-3">
                                <span><span class="legend-dot legend-normal"></span> Valid</span>
                                <span><span class="legend-dot legend-warning"></span> Warning — mixed schedule types</span>
                                <span><span class="legend-dot legend-error"></span> Error — fix and re-upload</span>
                            </div>
                        </div>
                        <div class="table-responsive">
                            <table id="previewTable" class="table table-striped table-bordered">
                                <thead>
                                    <tr>
                                        <th>Row</th>
                                        <th>Employee No</th>
                                        <th>
                                            Weekday
                                            <span class="badge bg-info text-dark ms-1" title="Auto-derived from Effectivity Date">Auto</span>
                                        </th>
                                        <th>Effectivity Date</th>
                                        <th>Schedule Type</th>
                                        <th>Time-In</th>
                                        <th>Time-Out</th>
                                        <th>Render Hrs</th>
                                        <th>Break (min)</th>
                                        <th>Rest Day?</th>
                                    </tr>
                                </thead>
                                <tbody id="previewTableBody"></tbody>
                            </table>
                        </div>
                    </div>

                    <!-- Action Buttons -->
                    <div class="mt-3">
                        <button type="button" class="btn btn-success" id="btnImportData" style="display:none;">
                            <i class="fas fa-file-import"></i> Import Data
                        </button>
                        <button type="button" class="btn btn-primary" id="btnStartOver">
                            <i class="fas fa-redo"></i> Start Over
                        </button>
                    </div>
                </div>
            </div>

        </div>
    </div>
</div>

@section Fillow_style
{
    <style>
        .import-steps {
            display: flex;
            justify-content: center;
            align-items: center;
            padding: 2rem 0;
        }

        .step {
            display: flex;
            flex-direction: column;
            align-items: center;
            opacity: 0.5;
        }

            .step.active, .step.completed {
                opacity: 1;
            }

        .step-number {
            width: 40px;
            height: 40px;
            border-radius: 50%;
            background-color: #e9ecef;
            color: #6c757d;
            display: flex;
            align-items: center;
            justify-content: center;
            font-weight: bold;
            margin-bottom: 0.5rem;
        }

        .step.active .step-number {
            background-color: #0d6efd;
            color: white;
        }

        .step.completed .step-number {
            background-color: #28a745;
            color: white;
        }

        .step-label {
            font-size: 0.875rem;
            text-align: center;
        }

        .step-line {
            width: 100px;
            height: 2px;
            background-color: #e9ecef;
            margin: 0 1rem;
            margin-bottom: 2rem;
        }

        .import-section {
            border: 1px solid #dee2e6;
            border-radius: 0.5rem;
            padding: 1.5rem;
        }

        .section-header {
            border-bottom: 2px solid #0d6efd;
            padding-bottom: 0.75rem;
            margin-bottom: 1.5rem;
        }

            .section-header h5 {
                margin: 0;
                color: #0d6efd;
            }

        .upload-area {
            border: 2px dashed #dee2e6;
            border-radius: 0.5rem;
            padding: 3rem;
            text-align: center;
            cursor: pointer;
            transition: all 0.3s;
        }

            .upload-area:hover, .upload-area.drag-over {
                border-color: #0d6efd;
                background-color: #e7f1ff;
            }

        .upload-placeholder {
            color: #6c757d;
        }

        .upload-file-info {
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .table-responsive {
            max-height: 420px;
            overflow-y: auto;
        }

        /* Warning row highlight */
        .preview-row-warning {
            background-color: #fff8e1 !important;
        }

            .preview-row-warning:hover {
                background-color: #fff3cd !important;
            }

            .preview-row-warning td:first-child {
                border-left: 4px solid #ffc107;
            }

        /* Weekday auto badge in preview */
        .weekday-auto {
            font-size: 0.8rem;
            color: #0d6efd;
        }

        /* Error / warning lists */
        .error-list, .warning-list {
            max-height: 220px;
            overflow-y: auto;
            padding-left: 1.25rem;
        }

            .error-list li, .warning-list li {
                margin-bottom: 0.25rem;
            }

        /* Legend */
        .preview-legend {
            font-size: 0.8rem;
            color: #6c757d;
        }

        .legend-dot {
            display: inline-block;
            width: 12px;
            height: 12px;
            border-radius: 50%;
            margin-right: 4px;
        }

        .legend-normal {
            background-color: #d4edda;
            border: 1px solid #28a745;
        }

        .legend-warning {
            background-color: #fff8e1;
            border: 1px solid #ffc107;
        }

        /* Error row highlight */
        .preview-row-error {
            background-color: #fde8e8 !important;
        }

            .preview-row-error:hover {
                background-color: #fbd0d0 !important;
            }

            .preview-row-error td:first-child {
                border-left: 4px solid #dc3545;
            }

        .legend-error {
            background-color: #fde8e8;
            border: 1px solid #dc3545;
        }
    </style>
}

@section Fillow_script
{
    <script>
        $(document).ready(function () {
            let validatedData = null;

            // ── Toastr ─────────────────────────────────────────────────────────────
            toastr.options = {
                positionClass: "toast-top-right",
                timeOut: 5000,
                closeButton: true,
                progressBar: true
            };

            // ── Download Template ──────────────────────────────────────────────────
            $('#btnDownloadTemplate').click(function () {
                const $btn = $(this);
                const originalHtml = $btn.html();
                $btn.prop('disabled', true).html('<i class="fas fa-spinner fa-spin"></i> Downloading...');

                const link = document.createElement('a');
                link.href = '/EmployeeScheduleImport/DownloadTemplate';
                link.download = '';
                document.body.appendChild(link);
                link.click();
                document.body.removeChild(link);

                setTimeout(() => {
                    $btn.prop('disabled', false).html(originalHtml);
                    markStepCompleted(1);
                    toastr.success('Template downloaded successfully');
                }, 1000);
            });

            // ── Upload Area ────────────────────────────────────────────────────────
            $('#uploadArea').on('click', function (e) {
                if ($(e.target).closest('#btnRemoveFile').length === 0) {
                    $('#excelFile').click();
                }
            });

            $('#excelFile').on('change', function () {
                if (this.files.length > 0) handleFileSelect(this.files[0]);
            });

            $('#uploadArea')
                .on('dragover', function (e) {
                    e.preventDefault(); e.stopPropagation();
                    $(this).addClass('drag-over');
                })
                .on('dragleave', function (e) {
                    e.preventDefault(); e.stopPropagation();
                    $(this).removeClass('drag-over');
                })
                .on('drop', function (e) {
                    e.preventDefault(); e.stopPropagation();
                    $(this).removeClass('drag-over');
                    const files = e.originalEvent.dataTransfer.files;
                    if (files.length > 0) handleFileSelect(files[0]);
                });

            $('#btnRemoveFile').on('click', function (e) {
                e.stopPropagation();
                e.preventDefault();
                resetFileUpload();
            });

            $('#btnValidateFile').on('click', function () {
                const file = $('#excelFile')[0].files[0];
                if (!file) { toastr.error('Please select a file first'); return; }
                validateFile(file);
            });

            // ── Import ─────────────────────────────────────────────────────────────
            $('#btnImportData').on('click', function () {
                if (!validatedData || validatedData.length === 0) {
                    toastr.error('No valid data to import');
                    return;
                }

                // Strip error rows — only send valid/warning rows to the server
                const importableData = validatedData.filter(r => !r.hasError);

                if (importableData.length === 0) {
                    toastr.error('No valid rows to import. Please fix all errors and re-upload.');
                    return;
                }

                const warningCount = importableData.filter(r => r.hasWarning).length;
                const warningNote = warningCount > 0
                    ? `<p class="text-warning mt-2"><i class="fas fa-exclamation-triangle"></i> ${warningCount} row(s) have mixed schedule type warnings. They will still be imported.</p>`
                    : '';

                Swal.fire({
                    title: 'Confirm Import',
                    html: `Are you sure you want to import <strong>${importableData.length}</strong> schedule row(s)?${warningNote}`,
                    icon: 'question',
                    showCancelButton: true,
                    confirmButtonText: 'Yes, Import',
                    cancelButtonText: 'Cancel',
                    confirmButtonColor: '#28a745',
                    cancelButtonColor: '#6c757d'
                }).then(result => {
                    if (result.isConfirmed) importData(importableData);
                });
            });

            $('#btnStartOver').on('click', function () { resetAll(); });

            // ── Helpers ────────────────────────────────────────────────────────────
            function handleFileSelect(file) {
                if (!file.name.endsWith('.xlsx')) {
                    toastr.error('Please select a valid Excel file (.xlsx)');
                    $('#excelFile').val('');
                    return;
                }
                $('.upload-placeholder').hide();
                $('.upload-file-info').show();
                $('.upload-file-info .file-name').text(file.name);
                $('#btnValidateFile').show();
                markStepCompleted(2);
            }

            function validateFile(file) {
                const $btn = $('#btnValidateFile');
                const originalHtml = $btn.html();
                $btn.prop('disabled', true).html('<i class="fas fa-spinner fa-spin"></i> Validating...');

                const formData = new FormData();
                formData.append('file', file);

                $.ajax({
                    url: '/EmployeeScheduleImport/ValidateImport',
                    type: 'POST',
                    data: formData,
                    processData: false,
                    contentType: false,
                    success: function (response) {
                        // Always store full data so error rows appear in preview
                        validatedData = response.data || [];
                        showValidationResults(response);
                        markStepCompleted(3);
                    },
                    error: function (xhr) {
                        const errorMsg = xhr.responseJSON?.message || 'Validation failed';
                        toastr.error(errorMsg);
                    },
                    complete: function () {
                        $btn.prop('disabled', false).html(originalHtml);
                    }
                });
            }

            function showValidationResults(response) {
                $('#reviewSection').show();

                const hasErrors   = response.errors   && response.errors.length   > 0;
                const hasWarnings = response.warnings && response.warnings.length > 0;
                const summaryClass = response.validRows > 0 ? 'alert-success' : 'alert-danger';

                let summaryHtml = `
                    <div class="alert ${summaryClass}">
                        <strong>Validation Results:</strong><br>
                        Total Rows Scanned: <strong>${response.totalRows}</strong><br>
                        Valid Rows: <strong>${response.validRows}</strong><br>
                        Employees to Import: <strong>${response.distinctEmployeeCount ?? 0}</strong><br>
                        ${hasErrors   ? `Rows with Errors: <strong class="text-danger">${response.errors.length}</strong><br>` : ''}
                        ${hasWarnings ? `Rows with Warnings: <strong class="text-warning">${response.warnings.length}</strong>` : ''}
                    </div>`;
                $('#validationSummary').html(summaryHtml);

                if (hasErrors) {
                    $('#errorCount').text(response.errors.length);
                    $('#errorList').html(response.errors.map(e => `<li>${e}</li>`).join(''));
                    $('#validationErrors').show();
                } else {
                    $('#validationErrors').hide();
                }

                if (hasWarnings) {
                    $('#warningCount').text(response.warnings.length);
                    $('#warningList').html(response.warnings.map(w => `<li>${w}</li>`).join(''));
                    $('#validationWarnings').show();
                } else {
                    $('#validationWarnings').hide();
                }

                if (response.validRows > 0) {
                    $('#previewTableContainer').show();
                    const tbody = $('#previewTableBody');
                    tbody.empty();

                    response.data.forEach(row => {
                        // ── Error rows — red highlight, span remaining columns with error message
                        if (row.hasError) {
                            tbody.append(`
                                <tr class="preview-row-error">
                                    <td title="${row.errorMessage}">
                                        ${row.rowNumber}
                                        <i class="fas fa-times-circle text-danger ms-1"></i>
                                    </td>
                                    <td>${row.employeeName || row.employeeNo}</td>
                                    <td colspan="8" class="text-danger small">
                                        <i class="fas fa-exclamation-circle me-1"></i>${row.errorMessage}
                                    </td>
                                </tr>
                            `);
                            return;
                        }

                        // ── Valid / warning rows ──────────────────────────────────
                        const restBadge = row.isRestDay
                            ? '<span class="badge bg-danger">YES</span>'
                            : '<span class="badge bg-success">NO</span>';

                        const rowNumCell = row.hasWarning
                            ? `<td title="Mixed schedule types on this effectivity date">
                                   ${row.rowNumber}
                                   <i class="fas fa-exclamation-triangle text-warning ms-1"></i>
                               </td>`
                            : `<td>${row.rowNumber}</td>`;

                        const rowClass = row.hasWarning ? 'preview-row-warning' : '';

                        const weekdayCell = `<td>
                            ${row.weekdayName}
                            <i class="fas fa-magic text-info ms-1" title="Auto-derived from Effectivity Date" style="font-size:0.75rem;"></i>
                        </td>`;

                        tbody.append(`
                            <tr class="${rowClass}">
                                ${rowNumCell}
                                <td>${row.employeeName || row.employeeNo}</td>
                                ${weekdayCell}
                                <td>${row.effectivityDate}</td>
                                <td>${row.scheduleTypeName || row.scheduleTypeCode}</td>
                                <td>${row.isRestDay ? '—' : formatTime12(row.timeIn)}</td>
                                <td>${row.isRestDay ? '—' : formatTime12(row.timeOut)}</td>
                                <td>${row.isRestDay ? '—' : row.totalRenderHour}</td>
                                <td>${row.isRestDay ? '—' : row.totalBreaktimeMinute}</td>
                                <td>${restBadge}</td>
                            </tr>
                        `);
                    });

                    $('#btnImportData').show();
                } else {
                    $('#previewTableContainer').hide();
                    $('#btnImportData').hide();
                }

                $('html, body').animate({ scrollTop: $('#reviewSection').offset().top - 100 }, 500);
            }

            function importData(importableData) {
                const $btn = $('#btnImportData');
                const originalHtml = $btn.html();
                $btn.prop('disabled', true).html('<i class="fas fa-spinner fa-spin"></i> Importing...');

                $.ajax({
                    url: '/EmployeeScheduleImport/ImportData',
                    type: 'POST',
                    contentType: 'application/json',
                    data: JSON.stringify(importableData),
                    success: function (response) {
                        if (response.success) {
                            Swal.fire({
                                title: 'Import Complete',
                                html: `
                                    <p>Successfully imported: <strong>${response.successCount}</strong></p>
                                    ${response.skippedCount > 0 ? `<p class="text-warning">Skipped (duplicates): <strong>${response.skippedCount}</strong></p>` : ''}
                                    ${response.failureCount > 0 ? `<p class="text-danger">Failed: <strong>${response.failureCount}</strong></p>` : ''}
                                `,
                                icon: 'success',
                                confirmButtonText: 'Go to Schedule List'
                            }).then(() => {
                                window.location.href = '/EmployeeSchedule/Index';
                            });
                        } else {
                            toastr.error(response.message);
                        }
                    },
                    error: function (xhr) {
                        const errorMsg = xhr.responseJSON?.message || 'Import failed';
                        toastr.error(errorMsg);
                    },
                    complete: function () {
                        $btn.prop('disabled', false).html(originalHtml);
                    }
                });
            }

            function resetFileUpload() {
                $('#excelFile').val('');
                $('.upload-file-info').hide();
                $('.upload-placeholder').show();
                $('#btnValidateFile').hide();
                validatedData = null;
            }

            function resetAll() {
                resetFileUpload();
                $('#reviewSection').hide();
                $('#validationSummary').empty();
                $('#validationErrors').hide();
                $('#errorList').empty();
                $('#errorCount').text('');
                $('#validationWarnings').hide();
                $('#warningList').empty();
                $('#warningCount').text('');
                $('#previewTableContainer').hide();
                $('#previewTableBody').empty();
                $('#btnImportData').hide();
                $('.step').removeClass('completed');
                setActiveStep(1);
            }

            function markStepCompleted(stepNumber) {
                $(`#step${stepNumber}`).addClass('completed');
                if (stepNumber < 3) setActiveStep(stepNumber + 1);
            }

            function setActiveStep(stepNumber) {
                $('.step').removeClass('active');
                $(`#step${stepNumber}`).addClass('active');
            }

            function formatTime12(timeStr) {
                if (!timeStr) return '—';
                // timeStr is stored as "HH:mm:ss" (24hr) from server — convert to 12hr for display
                const parts = timeStr.split(':');
                let hours = parseInt(parts[0], 10);
                const minutes = parts[1];
                const ampm = hours >= 12 ? 'PM' : 'AM';
                hours = hours % 12 || 12;
                return `${String(hours).padStart(2, '0')}:${minutes} ${ampm}`;
            }
        });
    </script>
}