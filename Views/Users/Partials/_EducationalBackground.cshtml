@model List<KEISAN_HRIS_v2.Models.Users.EducationalBackgroundInfo>

<div class="card-header">
    <div class="row" style="width:100%;">
        <div class="row" style="margin-left:0px;width:100%;">
            <div class="col-md-3">
                <div class="form-group">
                    <h5>Record Status</h5>
                    <select name="filterRecordStatus" id="filterRecordStatus" class="form-control">
                        <option value="active" selected>ACTIVE</option>
                        <option value="inactive">INACTIVE</option>
                    </select>
                </div>
            </div>
            <div class="col-md-6"></div>
            <div class="col-md-3 d-flex justify-content-end align-items-end">
                <div class="form-group">
                    <button type="button" class="btn btn-primary" id="btnAddEducationalBackground">
                        <i class="fa fa-plus"></i> New Educational Background
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="card-body">
    <div class="table-responsive">
        <table id="educationalBackgroundTable" class="display" style="min-width: 900px">
            <thead>
                <tr>
                    <th>Action</th>
                    <th>Name of School</th>
                    <th>Type</th>
                    <th>Course</th>
                    <th>Year Graduated</th>
                    <th>Units Earned</th>
                    <th>Attain</th>
                    <th>Address</th>
                    <th>Date Added</th>
                    <th>Added By</th>
                </tr>
            </thead>
        </table>
    </div>
</div>

<!-- Add Educational Background Modal -->
<div class="modal fade" id="addEducationalBackgroundModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">New Educational Background</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <form id="addEducationalBackgroundForm">
                    <input type="hidden" id="addEmployeeNoHidden" name="EmployeeNo" value="@ViewBag.EmployeeNo" />

                    <div class="row">
                        <div class="col-md-6">
                            <label class="form-label">Name of School <span class="text-danger">*</span></label>
                            <input type="text" id="addNameOfSchool" name="NameOfSchool" class="form-control" maxlength="255" required />
                            <div class="invalid-feedback">Please enter school name.</div>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Type <span class="text-danger">*</span></label>
                            <select id="addSchoolType" name="SchoolType" class="form-control" required>
                                <option value="">Select Type</option>
                                <option value="Elementary">Elementary</option>
                                <option value="High School">High School</option>
                                <option value="Senior High School">Senior High School</option>
                                <option value="Vocational">Vocational</option>
                                <option value="College">College</option>
                                <option value="Graduate Studies">Graduate Studies</option>
                            </select>
                            <div class="invalid-feedback">Please select school type.</div>
                        </div>
                    </div>

                    <div class="row mt-3">
                        <div class="col-md-6">
                            <label class="form-label">Course</label>
                            <input type="text" id="addCourse" name="Course" class="form-control" maxlength="255" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Year Graduated</label>
                            <input type="text" id="addYearGraduated" name="YearGraduated" class="form-control" maxlength="10" />
                        </div>
                    </div>

                    <div class="row mt-3">
                        <div class="col-md-6">
                            <label class="form-label">Units Earned</label>
                            <input type="number" id="addUnitsEarned" name="UnitsEarned" class="form-control" min="0" step="0.01" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Attain</label>
                            <input type="text" id="addAttain" name="Attain" class="form-control" maxlength="255" placeholder="e.g., Graduated, Undergraduate" />
                        </div>
                    </div>

                    <div class="row mt-3">
                        <div class="col-md-12">
                            <label class="form-label">School Address</label>
                            <input type="text" id="addSchoolAddress" name="SchoolAddress" class="form-control" maxlength="255" />
                        </div>
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" id="btnSaveNewEducationalBackground" class="btn btn-primary">Save</button>
            </div>
        </div>
    </div>
</div>

<!-- View/Edit Educational Background Modal -->
<div class="modal fade" id="viewEducationalBackgroundModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="viewModalTitle">View Educational Background</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <form id="viewEducationalBackgroundForm">
                    <input type="hidden" id="viewEducationalBackgroundId" name="Id" />
                    <input type="hidden" id="viewEmployeeNoHidden" name="EmployeeNo" value="@ViewBag.EmployeeNo" />

                    <div class="row">
                        <div class="col-md-6">
                            <label class="form-label">Name of School <span class="text-danger edit-required d-none">*</span></label>
                            <input type="text" id="viewNameOfSchool" name="NameOfSchool" class="form-control" maxlength="255" readonly />
                            <div class="invalid-feedback">Please enter school name.</div>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Type <span class="text-danger edit-required d-none">*</span></label>
                            <select id="viewSchoolType" name="SchoolType" class="form-control" disabled>
                                <option value="">Select Type</option>
                                <option value="Elementary">Elementary</option>
                                <option value="High School">High School</option>
                                <option value="Senior High School">Senior High School</option>
                                <option value="Vocational">Vocational</option>
                                <option value="College">College</option>
                                <option value="Graduate Studies">Graduate Studies</option>
                            </select>
                            <div class="invalid-feedback">Please select school type.</div>
                        </div>
                    </div>

                    <div class="row mt-3">
                        <div class="col-md-6">
                            <label class="form-label">Course</label>
                            <input type="text" id="viewCourse" name="Course" class="form-control" maxlength="255" readonly />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Year Graduated</label>
                            <input type="text" id="viewYearGraduated" name="YearGraduated" class="form-control" maxlength="10" readonly />
                        </div>
                    </div>

                    <div class="row mt-3">
                        <div class="col-md-6">
                            <label class="form-label">Units Earned</label>
                            <input type="number" id="viewUnitsEarned" name="UnitsEarned" class="form-control" min="0" step="0.01" readonly />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Attain</label>
                            <input type="text" id="viewAttain" name="Attain" class="form-control" maxlength="255" placeholder="e.g., Graduated, Undergraduate" readonly />
                        </div>
                    </div>

                    <div class="row mt-3">
                        <div class="col-md-12">
                            <label class="form-label">School Address</label>
                            <input type="text" id="viewSchoolAddress" name="SchoolAddress" class="form-control" maxlength="255" readonly />
                        </div>
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-primary" id="btnEditEducationalBackground">
                    <i class="fas fa-edit"></i> Edit
                </button>
                <button type="button" class="btn btn-success d-none" id="btnSaveEducationalBackground">Save</button>
            </div>
        </div>
    </div>
</div>

<style>
    .table-responsive {
        border-radius: 0.375rem;
    }

    #educationalBackgroundTable_wrapper .dataTables_length, #educationalBackgroundTable_wrapper .dataTables_filter {
        margin-bottom: 1rem;
    }

    #educationalBackgroundTable_wrapper .dataTables_info, #educationalBackgroundTable_wrapper .dataTables_paginate {
        margin-top: 1rem;
    }

    #educationalBackgroundTable .btn-sm {
        padding: 0.25rem 0.5rem;
        font-size: 0.875rem;
    }

    .modal-content {
        border-radius: 0.5rem;
        box-shadow: 0 0.5rem 1rem rgba(0, 0, 0, 0.15);
    }

    .form-control:focus, .form-select:focus {
        border-color: #0d6efd;
        box-shadow: 0 0 0 0.2rem rgba(13, 110, 253, 0.25);
    }

    .invalid-feedback {
        display: none;
    }

    .form-control.is-invalid {
        border-color: #dc3545;
    }

        .form-control.is-invalid ~ .invalid-feedback {
            display: block;
        }

    .text-danger {
        color: #dc3545 !important;
    }

    .form-control[readonly] {
        background-color: #f8f9fa;
        border-color: #dee2e6;
    }

    select[disabled] {
        background-color: #f8f9fa;
        border-color: #dee2e6;
    }

    .edit-mode .form-control[readonly] {
        background-color: #ffffff;
        border-color: #ced4da;
    }

    .edit-mode select[disabled] {
        background-color: #ffffff;
        border-color: #ced4da;
    }

    .swal2-popup {
        border-radius: 15px !important;
        padding: 2rem !important;
    }

    .swal2-icon.swal2-error {
        border-color: #f27474 !important;
        color: #f27474 !important;
    }

        .swal2-icon.swal2-error .swal2-x-mark {
            display: none !important;
        }

        .swal2-icon.swal2-error::before {
            content: "\f2ed" !important;
            font-family: "Font Awesome 5 Free" !important;
            font-weight: 900 !important;
            font-size: 2.5rem !important;
            color: #f27474 !important;
            display: block !important;
        }

    .swal2-title {
        font-size: 1.875rem !important;
        font-weight: 600 !important;
        color: #545454 !important;
        margin: 1rem 0 0.5rem 0 !important;
    }

    .swal2-html-container {
        font-size: 1rem !important;
        color: #737373 !important;
        margin: 0 0 2rem 0 !important;
    }

    .swal2-actions {
        gap: 0.5rem !important;
    }

    .swal2-confirm {
        background-color: #7c3aed !important;
        border-color: #7c3aed !important;
        color: white !important;
        font-weight: 500 !important;
        padding: 0.75rem 2rem !important;
        border-radius: 8px !important;
        font-size: 0.875rem !important;
    }

    .swal2-cancel {
        background-color: #6b7280 !important;
        border-color: #6b7280 !important;
        color: white !important;
        font-weight: 500 !important;
        padding: 0.75rem 2rem !important;
        border-radius: 8px !important;
        font-size: 0.875rem !important;
    }

    .swal2-confirm:hover {
        background-color: #6d28d9 !important;
        border-color: #6d28d9 !important;
    }

    .swal2-cancel:hover {
        background-color: #4b5563 !important;
        border-color: #4b5563 !important;
    }

    .btn-success.shadow-sm:hover {
        background-color: #1e7e34;
        border-color: #1c7430;
    }

    .table th, .table td {
        vertical-align: middle;
    }

    #educationalBackgroundTable .btn-sm i {
        font-size: 0.875rem;
    }

    #educationalBackgroundTable .d-flex.gap-1 {
        gap: 0.25rem !important;
    }

    .card-header {
        border-bottom: none !important;
    }

    #btnAddEducationalBackground {
        padding: 0.6rem 1.2rem !important;
        white-space: nowrap;
    }
</style>

<script>
    $(document).ready(function () {

        MODULE = 'FSEducationalBackgroundM';
        access = ROLE_ACCESS?.[MODULE];

        if (access != 'READWRITE' && access != 'FULL') {
            $('#btnAddEducationalBackground, #btnEditEducationalBackground').hide();
        }

        const config = {
            toastr: { positionClass: "toast-top-right", timeOut: 5000, closeButton: true, progressBar: true, preventDuplicates: true },
            endpoints: {
                list: "/EducationalBackground/GetEducationalBackgroundList",
                deleted: "/EducationalBackground/GetDeletedEducationalBackground",
                get: "/EducationalBackground/GetEducationalBackgroundById",
                save: "/EducationalBackground/SaveEducationalBackground",
                delete: "/EducationalBackground/InactiveEducationalBackground",
                restore: "/EducationalBackground/RestoreEducationalBackground"
            },
            employeeNo: '@ViewBag.EmployeeNo'
        };

        toastr.options = config.toastr;
        let isViewingDeleted = false;

        const table = $('#educationalBackgroundTable').DataTable({
            processing: true,
            serverSide: false,
            ajax: {
                url: config.endpoints.list,
                type: "GET",
                data: d => { d.employeeNo = config.employeeNo; d.isactive = isViewingDeleted ? '0' : '1'; },
                datatype: "json",
                error: () => showNotification('Error loading data. Please refresh the page.', 'error')
            },
            columns: [
                {
                    data: "id", width: "10%", orderable: false,
                    render: (data) => {
                        if (isViewingDeleted) {
                            return access === 'FULL' ? `<div class="d-flex gap-1"><button type="button" class="btn btn-sm btn-success shadow-sm restoreEducationalBackground" data-id="${data}" title="Restore"><i class="fas fa-undo"></i></button></div>` : '';
                        }
                        const viewbtn = `<button type="button" class="btn btn-sm btn-primary shadow-sm viewEducationalBackground" data-id="${data}" title="View"><i class="fas fa-eye"></i></button>`;
                        const deletebtn = access === 'FULL' ? `<button type="button" class="btn btn-sm btn-danger shadow-sm deleteEducationalBackground" data-id="${data}" title="Delete"><i class="fa fa-trash"></i></button>` : '';
                        return `<div class="d-flex gap-1">${viewbtn}${deletebtn}</div>`;
                    }
                },
                { data: "nameOfSchool", width: "16%" },
                { data: "schoolType", width: "10%" },
                { data: "course", width: "12%" },
                { data: "yearGraduated", width: "8%" },
                { data: "unitsEarned", width: "8%" },
                { data: "attain", width: "10%" },
                { data: "schoolAddress", width: "12%" },
                { data: "dtAdded", width: "8%" },
                { data: "addedByUser", width: "10%" }
            ],
            order: [[4, 'desc']],
            pageLength: 25,
            lengthMenu: [[10, 25, 50, 100, -1], [10, 25, 50, 100, "All"]],
            language: {
                processing: "Loading...",
                emptyTable: "No educational background records found",
                zeroRecords: "No matching educational background records found",
                paginate: { next: '<i class="fa fa-angle-double-right"></i>', previous: '<i class="fa fa-angle-double-left"></i>' }
            }
        });

        setInterval(() => { if (table && !$('.modal').is(':visible')) table.ajax.reload(null, false); }, 3600000);

        $('#filterRecordStatus').on('change', function () {
            isViewingDeleted = $(this).val() === 'inactive';
            table.ajax.reload(null, false);
            $('#btnAddEducationalBackground').toggle(!isViewingDeleted);
        }).select2({ selectOnClose: true, minimumResultsForSearch: Infinity });

        $('#btnAddEducationalBackground').click(() => { resetForm('add'); $('#addEducationalBackgroundModal').modal('show'); });
        $('#btnSaveNewEducationalBackground').click(() => { if (validateForm('add')) saveEducationalBackground(false); });

        $(document).on('click', '.viewEducationalBackground', function (e) {
            e.preventDefault();
            const id = $(this).data('id'), $btn = $(this);
            toggleButtonLoading($btn, true);
            $.get(config.endpoints.get, { id })
                .done(r => { if (r.success) { resetForm('view'); setViewMode(); populateViewForm(r.data); $('#viewEducationalBackgroundModal').modal('show'); } else showNotification(r.message, 'error'); })
                .fail(() => showNotification('Unable to load educational background data', 'error'))
                .always(() => toggleButtonLoading($btn, false));
        });

        $('#btnEditEducationalBackground').click(() => {
            $('#viewModalTitle').text('Edit Educational Background');
            $('#viewEducationalBackgroundModal .modal-body').addClass('edit-mode');
            $('#viewNameOfSchool, #viewCourse, #viewYearGraduated, #viewUnitsEarned, #viewSchoolAddress, #viewAttain').prop('readonly', false);
            $('#viewSchoolType').prop('disabled', false);
            $('.edit-required').removeClass('d-none');
            $('#btnEditEducationalBackground').addClass('d-none');
            $('#btnSaveEducationalBackground, #btnCancelEdit').removeClass('d-none');
            $('#viewNameOfSchool').focus();
        });

        $('#btnCancelEdit').click(() => { $.get(config.endpoints.get, { id: $('#viewEducationalBackgroundId').val() }).done(r => { if (r.success) { resetForm('view'); setViewMode(); populateViewForm(r.data); } }); });
        $('#btnSaveEducationalBackground').click(() => { if (validateForm('view')) saveEducationalBackground(true); });

        // EVENT HANDLERS - DELETE/RESTORE
        $(document).on('click', '.deleteEducationalBackground', function (e) {
            e.preventDefault();
            deleteWithReason({
                title: 'Inactive Educational Background',
                text: 'Are you sure you want to inactive this educational background record?',
                url: config.endpoints.delete,
                id: $(this).data('id'),
                button: $(this),
                table: table
            });
        });

        $(document).on('click', '.restoreEducationalBackground', function (e) {
            e.preventDefault();
            const id = $(this).data('id'), $btn = $(this);
            Swal.fire({
                title: 'Restore Record',
                text: 'Are you sure you want to restore this educational background record?',
                icon: 'question',
                showCancelButton: true,
                confirmButtonText: 'Yes, Restore',
                cancelButtonText: 'Cancel',
                confirmButtonColor: '#28a745',
                cancelButtonColor: '#6c757d',
                allowOutsideClick: false,
                allowEscapeKey: false
            }).then(result => { if (result.isConfirmed) { toggleButtonLoading($btn, true); $.post(config.endpoints.restore, { id }).done(r => { if (r.success) { table.ajax.reload(null, false); showNotification(r.message, 'success'); } else showNotification(r.message, 'error'); }).fail(() => showNotification('Unable to restore educational background. Please try again.', 'error')).always(() => toggleButtonLoading($btn, false)); } });
        });

        $('#addEducationalBackgroundModal, #viewEducationalBackgroundModal').on('hidden.bs.modal', function() { resetForm($(this).attr('id').includes('add') ? 'add' : 'view'); if ($(this).attr('id').includes('view')) setViewMode(); });

        $('#addEducationalBackgroundForm, #viewEducationalBackgroundForm').on('keypress', function(e) { if (e.which === 13) { e.preventDefault(); $(this).attr('id').includes('add') ? $('#btnSaveNewEducationalBackground').click() : $('#viewEducationalBackgroundModal .modal-body').hasClass('edit-mode') && $('#btnSaveEducationalBackground').click(); } });

        $('#addNameOfSchool, #viewNameOfSchool, #addSchoolType, #viewSchoolType').on('input change', function() { $(this).removeClass('is-invalid'); });

        function saveEducationalBackground(isEdit) {
            const prefix = isEdit ? 'view' : 'add';
            const formData = {
                ...(isEdit && { Id: parseInt($(`#${prefix}EducationalBackgroundId`).val()) }),
                EmployeeNo: $(`#${prefix}EmployeeNoHidden`).val(),
                NameOfSchool: $(`#${prefix}NameOfSchool`).val(),
                SchoolType: $(`#${prefix}SchoolType`).val(),
                Course: $(`#${prefix}Course`).val() || '',
                YearGraduated: $(`#${prefix}YearGraduated`).val() || '',
                UnitsEarned: parseFloat($(`#${prefix}UnitsEarned`).val()) || 0,
                SchoolAddress: $(`#${prefix}SchoolAddress`).val() || '',
                Attain: $(`#${prefix}Attain`).val() || '',
                IsActive: true
            };
            const $saveBtn = isEdit ? $('#btnSaveEducationalBackground') : $('#btnSaveNewEducationalBackground');
            toggleButtonLoading($saveBtn, true, 'Saving...');
            $.ajax({
                url: config.endpoints.save,
                type: 'POST',
                contentType: 'application/json',
                data: JSON.stringify(formData),
                success: r => { if (r.success) { isEdit && setViewMode(); $(`#${isEdit ? 'view' : 'add'}EducationalBackgroundModal`).modal('hide'); table.ajax.reload(null, false); showNotification(r.message, 'success'); } else showNotification(r.message, 'error'); },
                error: () => showNotification('Unable to save educational background. Please try again.', 'error'),
                complete: () => toggleButtonLoading($saveBtn, false)
            });
        }

        function populateViewForm(data) {
            $('#viewEducationalBackgroundId').val(data.id);
            $('#viewNameOfSchool').val(data.nameOfSchool);
            $('#viewSchoolType').val(data.schoolType);
            $('#viewCourse').val(data.course || '');
            $('#viewYearGraduated').val(data.yearGraduated || '');
            $('#viewUnitsEarned').val(data.unitsEarned || 0);
            $('#viewSchoolAddress').val(data.schoolAddress || '');
            $('#viewAttain').val(data.attain || '');
        }

        function resetForm(prefix) {
            $(`#${prefix}EducationalBackgroundForm`)[0].reset();
            $(`#${prefix}EducationalBackgroundForm .form-control, #${prefix}EducationalBackgroundForm .form-select`).removeClass('is-invalid');
            $(`#btnSave${prefix === 'view' ? 'EducationalBackground' : 'NewEducationalBackground'}`).prop('disabled', false).html('Save');
        }

        function setViewMode() {
            $('#viewModalTitle').text('View Educational Background');
            $('#viewEducationalBackgroundModal .modal-body').removeClass('edit-mode');
            $('#viewNameOfSchool, #viewCourse, #viewYearGraduated, #viewUnitsEarned, #viewSchoolAddress, #viewAttain').prop('readonly', true);
            $('#viewSchoolType').prop('disabled', true);
            $('.edit-required').addClass('d-none');
            $('#btnEditEducationalBackground').removeClass('d-none');
            $('#btnSaveEducationalBackground, #btnCancelEdit').addClass('d-none');
            $('#viewEducationalBackgroundForm .form-control, #viewEducationalBackgroundForm .form-select').removeClass('is-invalid');
        }

        function validateForm(prefix) {
            let isValid = true;
            ['NameOfSchool', 'SchoolType'].forEach(field => {
                if (!$(`#${prefix}${field}`).val()) { $(`#${prefix}${field}`).addClass('is-invalid'); isValid = false; }
            });
            return isValid;
        }

        function toggleButtonLoading($btn, loading, text = '') {
            const iconMap = { 'viewEducationalBackground': '<i class="fas fa-eye"></i>', 'deleteEducationalBackground': '<i class="fa fa-trash"></i>', 'restoreEducationalBackground': '<i class="fas fa-undo"></i>' };
            if (loading) {
                $btn.data('original-html', $btn.html()).prop('disabled', true).html((text ? '<i class="fas fa-spinner fa-spin"></i> ' : '<i class="fas fa-spinner fa-spin"></i>') + text);
            } else {
                const btnClass = Object.keys(iconMap).find(cls => $btn.hasClass(cls));
                $btn.prop('disabled', false).html($btn.data('original-html') || iconMap[btnClass] || 'Save').removeData('original-html');
            }
        }

        function showNotification(message, type) {
            const types = { success: 'Success', error: 'Error', warning: 'Warning', info: 'Information' };
            toastr[type](message, types[type] || 'Notification');
        }
    });
</script>
