@model List<KEISAN_HRIS_v2.Models.Users.AttachmentsInfo>

<div class="card-header">
    <div class="row" style="width:100%;">
        <div class="row" style="margin-left:0px;width:100%;">
            <div class="col-md-3">
                <div class="form-group">
                    <h5>Record Status</h5>
                    <select name="filterRecordStatus" id="filterRecordStatus" class="form-control">
                        <option value="active" selected>ACTIVE</option>
                        <option value="inactive">INACTIVE</option>
                    </select>
                </div>
            </div>
            <div class="col-md-6"></div>
            <div class="col-md-3 d-flex justify-content-end align-items-end">
                <div class="form-group">
                    <button type="button" class="btn btn-primary" id="btnAddAttachment">
                        <i class="fa fa-plus"></i> New Attachment
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="card-body">
    <div class="table-responsive">
        <table id="attachmentsTable" class="display" style="min-width: 900px">
            <thead>
                <tr>
                    <th>Action</th>
                    <th>Description</th>
                    <th>Type</th>
                    <th>File</th>
                    <th>Attachment</th>
                    <th>Date Uploaded</th>
                    <th>Added By</th>
                </tr>
            </thead>
        </table>
    </div>
</div>

<!-- Add Attachment Modal -->
<div class="modal fade" id="addAttachmentModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">New Attachment</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <form id="addAttachmentForm">
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label class="form-label">Description <span class="text-danger">*</span></label>
                            <input type="text" id="addAttachmentDescription" name="AttachmentDescription" class="form-control" maxlength="255" required />
                            <div class="invalid-feedback">Please enter description.</div>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label">Attachment Type <span class="text-danger">*</span></label>
                            <select id="addAttachmentTypeCode" name="AttachmentTypeCode" class="form-select" style="width:100%" required>
                                <option value="">-- Select Type --</option>
                            </select>
                            <div class="invalid-feedback">Please select attachment type.</div>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-12 mb-3">
                            <label class="form-label">Upload File <span class="text-danger">*</span></label>
                            <input type="file" id="addAttachment" name="attachment" class="form-control" accept=".pdf,.jpg,.jpeg,.png,.doc,.docx" required />
                            <small class="text-muted">Allowed formats: PDF, JPG, PNG, DOC, DOCX (Max: 5MB)</small>
                            <div class="invalid-feedback">Please select a file to upload.</div>
                        </div>
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" id="btnSaveNewAttachment" class="btn btn-primary">Save</button>
            </div>
        </div>
    </div>
</div>

<!-- View/Edit Attachment Modal -->
<div class="modal fade" id="viewAttachmentModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="viewModalTitle">View Attachment</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <form id="viewAttachmentForm">
                    <input type="hidden" id="viewAttachmentId" name="Id" />

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label class="form-label">Description <span class="text-danger edit-required d-none">*</span></label>
                            <input type="text" id="viewAttachmentDescription" name="AttachmentDescription" class="form-control" maxlength="255" readonly />
                            <div class="invalid-feedback">Please enter description.</div>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label">Attachment Type <span class="text-danger edit-required d-none">*</span></label>
                            <select id="viewAttachmentTypeCode" name="AttachmentTypeCode" class="form-select" style="width:100%" disabled>
                                <option value="">-- Select Type --</option>
                            </select>
                            <div class="invalid-feedback">Please select attachment type.</div>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-12 mb-3">
                            <label class="form-label">Current File</label>
                            <div id="currentAttachments" class="mb-2"></div>
                        </div>
                    </div>

                    <div class="row d-none" id="viewFileUploadRow">
                        <div class="col-md-12 mb-3">
                            <label class="form-label">Replace File (Optional)</label>
                            <input type="file" id="viewAttachment" name="attachment" class="form-control" accept=".pdf,.jpg,.jpeg,.png,.doc,.docx" />
                            <small class="text-muted">Allowed formats: PDF, JPG, PNG, DOC, DOCX (Max: 5MB)</small>
                        </div>
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-primary" id="btnEditAttachment">
                    <i class="fas fa-edit"></i> Edit
                </button>
                <button type="button" class="btn btn-success d-none" id="btnSaveAttachment">Save</button>
                <button type="button" class="btn btn-danger d-none" id="btnCancelEdit">Cancel</button>
            </div>
        </div>
    </div>
</div>

<!-- Attachment View Modal -->
<div class="modal fade" id="attachmentListModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">View Attachments</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <div id="attachmentList"></div>
            </div>
        </div>
    </div>
</div>

