<script>
    $(document).ready(function () {

        MODULE = 'FSAttachmentsM';
         access = ROLE_ACCESS?.[MODULE];

        if (access != 'READWRITE' && access != 'FULL') {
            $('#btnAddAttachment, #btnEditAttachment').hide();
        }

        const config = {
            toastr: { positionClass: "toast-top-right", timeOut: 5000, closeButton: true, progressBar: true, preventDuplicates: true },
            endpoints: {
                list: "/Attachments/GetAttachmentsList",
                get: "/Attachments/GetAttachmentById",
                types: "/Attachments/GetAttachmentTypes",
                employeeAttachments: "/Attachments/GetEmployeeAttachments",
                add: "/Attachments/AddAttachment",
                update: "/Attachments/UpdateAttachment",
                delete: "/Attachments/InactiveAttachment",
                restore: "/Attachments/RestoreAttachment"
            },
            employeeNo: '@ViewBag.EmployeeNo'
        };

        toastr.options = config.toastr;
        let isViewingDeleted = false;

        // INITIALIZATION
        initializeSelect2();
        $('#filterRecordStatus').select2({ selectOnClose: true, minimumResultsForSearch: Infinity });
        $('#filterRecordStatus').on('change', function () {
            isViewingDeleted = $(this).val() === 'inactive';
            updateTableView();
        });

        // DATATABLE CONFIGURATION
        const table = $('#attachmentsTable').DataTable({
            processing: true,
            serverSide: false,
            ajax: {
                url: config.endpoints.list,
                type: "GET",
                data: d => ({ employeeNo: config.employeeNo, status: isViewingDeleted ? 'inactive' : 'active' }),
                error: () => showNotification('Error loading data. Please refresh the page.', 'error')
            },
            columns: [
                {
                    data: "id", width: "12%", orderable: false,
                    render: (data, type, row) => {
                        if (isViewingDeleted) {
                            return access === 'FULL' ? `<div class="d-flex gap-1"><button type="button" class="btn btn-sm btn-success shadow-sm restoreAttachment" data-id="${data}" title="Restore"><i class="fas fa-undo"></i></button></div>` : '';
                        }
                        const viewbtn = `<button type="button" class="btn btn-sm btn-primary shadow-sm viewAttachment" data-id="${data}" title="View"><i class="fas fa-eye"></i></button>`;
                        const deletebtn = access === 'FULL' ? `<button type="button" class="btn btn-sm btn-danger shadow-sm deleteAttachment" data-id="${data}" title="Delete"><i class="fa fa-trash"></i></button>` : '';
                        return `<div class="d-flex gap-1">${viewbtn}${deletebtn}</div>`;
                    }
                },
                { data: "attachmentDescription", width: "20%" },
                { data: "attachmentTypeName", width: "15%" },
                {
                    data: "attachmentPath", width: "15%",
                    render: (data) => {
                        const fileName = data.split('/').pop();
                        return `<span class="text-muted small truncate" title="${fileName}">${fileName}</span>`;
                    }
                },
                {
                    data: null, width: "10%", orderable: false,
                    render: (data, type, row) => `<button class="btn btn-sm btn-outline-primary viewAttachmentList" data-employee="${row.employeeNo}" title="View Attachments"><i class="fas fa-paperclip"></i></button>`
                },
                { data: "dtAdded", width: "12%" },
                { data: "addedByUser", width: "15%" }
            ],
            order: [[5, 'desc']],
            pageLength: 25,
            lengthMenu: [[10, 25, 50, 100, -1], [10, 25, 50, 100, "All"]],
            language: {
                processing: "Loading...",
                emptyTable: "No attachment records found",
                zeroRecords: "No matching attachment records found",
                paginate: { next: '<i class="fa fa-angle-double-right"></i>', previous: '<i class="fa fa-angle-double-left"></i>' }
            }
        });

        setInterval(() => { if (table && !$('.modal').is(':visible')) table.ajax.reload(null, false); }, 3600000);

        // BUTTON CLICK HANDLERS
        $('#btnAddAttachment').click(() => {
            resetAddForm();
            loadAttachmentTypes('#addAttachmentTypeCode');
            $('#addAttachmentModal').modal('show');
        });

        $('#btnSaveNewAttachment').click(() => {
            if (!validateForm('#addAttachmentForm', ['addAttachmentDescription', 'addAttachmentTypeCode', 'addAttachment'])) return;

            const formData = new FormData();
            formData.append('employeeNo', config.employeeNo);
            formData.append('attachmentDescription', $('#addAttachmentDescription').val().trim());
            formData.append('attachmentTypeCode', $('#addAttachmentTypeCode').val());

            const file = $('#addAttachment')[0].files[0];
            if (file) {
                if (file.size > 5 * 1024 * 1024) {
                    showNotification('File size exceeds 5MB limit', 'error');
                    return;
                }
                formData.append('attachment', file);
            }

            saveRequest(config.endpoints.add, formData, '#btnSaveNewAttachment', true);
        });

        $(document).on('click', '.viewAttachment', function (e) {
            e.preventDefault();
            const id = $(this).data('id'), $btn = $(this);
            toggleButtonLoading($btn, true);

            $.get(config.endpoints.get, { id })
                .done(r => {
                    if (r.success) {
                        resetViewForm();
                        setViewMode();
                        loadAttachmentTypes('#viewAttachmentTypeCode');
                        populateViewForm(r.data);
                        loadCurrentAttachments(r.data.employeeNo);
                        $('#viewAttachmentModal').modal('show');
                    } else showNotification(r.message, 'error');
                })
                .fail(() => showNotification('Unable to load attachment data', 'error'))
                .always(() => toggleButtonLoading($btn, false));
        });

        $('#btnEditAttachment').click(() => {
            setEditMode();
            $('#viewAttachmentDescription').focus();
        });

        $('#btnCancelEdit').click(() => {
            $.get(config.endpoints.get, { id: $('#viewAttachmentId').val() })
                .done(r => { if (r.success) { populateViewForm(r.data); setViewMode(); clearValidation('#viewAttachmentForm'); } });
        });

        $('#btnSaveAttachment').click(() => {
            if (!validateForm('#viewAttachmentForm', ['viewAttachmentDescription', 'viewAttachmentTypeCode'])) return;

            const formData = new FormData();
            formData.append('id', $('#viewAttachmentId').val());
            formData.append('employeeNo', config.employeeNo);
            formData.append('attachmentDescription', $('#viewAttachmentDescription').val().trim());
            formData.append('attachmentTypeCode', $('#viewAttachmentTypeCode').val());

            const file = $('#viewAttachment')[0].files[0];
            if (file) {
                if (file.size > 5 * 1024 * 1024) {
                    showNotification('File size exceeds 5MB limit', 'error');
                    return;
                }
                formData.append('attachment', file);
            }

            saveRequest(config.endpoints.update, formData, '#btnSaveAttachment', false);
        });

        // EVENT HANDLERS - DELETE/RESTORE
        $(document).on('click', '.deleteAttachment', function (e) {
            e.preventDefault();
            deleteWithReason({
                title: 'Inactive Attachment',
                text: 'Are you sure you want to inactive this attachment record?',
                url: config.endpoints.delete,
                id: $(this).data('id'),
                button: $(this),
                table: table 
            });
        });

        $(document).on('click', '.restoreAttachment', function (e) {
            e.preventDefault();
            const id = $(this).data('id'), $btn = $(this);
            Swal.fire({
                title: 'Restore Record',
                text: 'Are you sure you want to restore this attachment record?',
                icon: 'question',
                showCancelButton: true,
                confirmButtonText: 'Yes, Restore',
                cancelButtonText: 'Cancel',
                confirmButtonColor: '#28a745',
                cancelButtonColor: '#6c757d',
                allowOutsideClick: false,
                allowEscapeKey: false
            }).then(result => {
                if (result.isConfirmed) {
                    toggleButtonLoading($btn, true);
                    $.post(config.endpoints.restore, { id })
                        .done(r => {
                            if (r.success) { table.ajax.reload(null, false); showNotification(r.message, 'success'); }
                            else showNotification(r.message, 'error');
                        })
                        .fail(() => showNotification('Unable to restore attachment. Please try again.', 'error'))
                        .always(() => toggleButtonLoading($btn, false));
                }
            });
        });

        // EVENT HANDLERS - ATTACHMENTS
        $(document).on('click', '.viewAttachmentList', function(e) {
            e.preventDefault();
            const employeeNo = $(this).data('employee');
            loadAttachmentsList(employeeNo);
            $('#attachmentListModal').modal('show');
        });

        // MODAL EVENTS
        $('#addAttachmentModal, #viewAttachmentModal').on('hidden.bs.modal', function () {
            resetAddForm();
            if ($(this).attr('id').includes('view')) setViewMode();
        });

        // FORM INPUT HANDLERS
        $('#addAttachmentDescription, #viewAttachmentDescription, #addAttachmentTypeCode, #viewAttachmentTypeCode, #addAttachment').on('input change', function () {
            $(this).removeClass('is-invalid');
        });

        // HELPER FUNCTIONS
        function initializeSelect2() {
            $('#addAttachmentTypeCode').select2({
                placeholder: "Select Attachment Type",
                allowClear: true,
                dropdownParent: $('#addAttachmentModal'),
                minimumResultsForSearch: Infinity
            });

            $('#viewAttachmentTypeCode').select2({
                placeholder: "Select Attachment Type",
                allowClear: true,
                dropdownParent: $('#viewAttachmentModal'),
                minimumResultsForSearch: Infinity
            });
        }

        function loadAttachmentTypes(selector) {
            $.get(config.endpoints.types, data => {
                const $select = $(selector);
                $select.empty().append('<option value="">-- Select Type --</option>');
                data.forEach(item => $select.append(`<option value="${item.attachmentTypeCode}">${item.attachmentTypeName}</option>`));
            });
        }

        function populateViewForm(data) {
            $('#viewAttachmentId').val(data.id);
            $('#viewAttachmentDescription').val(data.attachmentDescription);
            $('#viewAttachmentTypeCode').val(data.attachmentTypeCode).trigger('change');
        }

        function loadCurrentAttachments(employeeNo) {
            $.get(config.endpoints.employeeAttachments, { employeeNo }, data => {
                const container = $('#currentAttachments');
                container.empty();
                if (data && data.length > 0) {
                    data.forEach(attachment => {
                        const fileName = attachment.attachmentPath.split('/').pop();
                        container.append(`
                            <div class="attachment-item">
                                <i class="fas fa-file"></i>
                                <a href="${attachment.attachmentPath}" target="_blank">${fileName}</a>
                                <small class="text-muted ms-auto">${new Date(attachment.dtAdded).toLocaleDateString()}</small>
                            </div>
                        `);
                    });
                } else {
                    container.append('<small class="text-muted">No attachments found</small>');
                }
            });
        }

        function loadAttachmentsList(employeeNo) {
            $.get(config.endpoints.employeeAttachments, { employeeNo }, data => {
                const container = $('#attachmentList');
                container.empty();
                if (data && data.length > 0) {
                    data.forEach(attachment => {
                        const fileName = attachment.attachmentPath.split('/').pop();
                        container.append(`
                            <div class="attachment-item mb-3">
                                <i class="fas fa-file-alt fa-2x me-3"></i>
                                <div class="flex-grow-1">
                                    <h6 class="mb-1"><a href="${attachment.attachmentPath}" target="_blank" class="text-decoration-none">${fileName}</a></h6>
                                    <small class="text-muted">Added: ${new Date(attachment.dtAdded).toLocaleDateString()}</small>
                                </div>
                                <a href="${attachment.attachmentPath}" target="_blank" class="btn btn-sm btn-outline-primary ms-2"><i class="fas fa-download"></i> View</a>
                            </div>
                        `);
                    });
                } else {
                    container.append('<p class="text-muted text-center">No attachments found for this employee.</p>');
                }
            });
        }

        function resetAddForm() {
            $('#addAttachmentForm')[0].reset();
            $('#addAttachmentTypeCode').val(null).trigger('change');
            clearValidation('#addAttachmentForm');
            $('#btnSaveNewAttachment').prop('disabled', false).html('Save');
        }

        function resetViewForm() {
            $('#viewAttachmentForm')[0].reset();
            $('#viewAttachmentTypeCode').val(null).trigger('change');
            $('#currentAttachments').empty();
            clearValidation('#viewAttachmentForm');
            $('#btnSaveAttachment').prop('disabled', false).html('Save');
            $('#viewFileUploadRow').addClass('d-none');
        }

        function setViewMode() {
            $('#viewModalTitle').text('View Attachment');
            $('#viewAttachmentModal .modal-body').removeClass('edit-mode');
            $('#viewAttachmentDescription').prop('readonly', true);
            $('#viewAttachmentTypeCode').prop('disabled', true);
            $('#viewFileUploadRow').addClass('d-none');
            $('.edit-required').addClass('d-none');
            $('#btnEditAttachment').removeClass('d-none');
            $('#btnSaveAttachment, #btnCancelEdit').addClass('d-none');
            clearValidation('#viewAttachmentForm');
        }

        function setEditMode() {
            $('#viewModalTitle').text('Edit Attachment');
            $('#viewAttachmentModal .modal-body').addClass('edit-mode');
            $('#viewAttachmentDescription').prop('readonly', false);
            $('#viewAttachmentTypeCode').prop('disabled', false);
            $('#viewFileUploadRow').removeClass('d-none');
            $('.edit-required').removeClass('d-none');
            $('#btnEditAttachment').addClass('d-none');
            $('#btnSaveAttachment, #btnCancelEdit').removeClass('d-none');
        }

        function validateForm(formSelector, fields) {
            clearValidation(formSelector);
            let isValid = true;

            fields.forEach(field => {
                const $field = $(`#${field}`);
                if (field === 'addAttachment') {
                    if (!$field[0].files || !$field[0].files[0]) {
                        $field.addClass('is-invalid');
                        isValid = false;
                    }
                } else {
                    if (!$field.val()) {
                        $field.addClass('is-invalid');
                        isValid = false;
                    }
                }
            });

            return isValid;
        }

        function clearValidation(formSelector) {
            $(`${formSelector} .form-control, ${formSelector} .form-select`).removeClass('is-invalid');
        }

        function updateTableView() {
            table.ajax.reload(null, false);
            $('#btnAddAttachment').toggle(!isViewingDeleted);
        }

        function saveRequest(url, data, buttonSelector, closeModal) {
            const $btn = $(buttonSelector);
            toggleButtonLoading($btn, true, 'Saving...');

            $.ajax({
                url,
                type: 'POST',
                data,
                processData: false,
                contentType: false,
                success: response => {
                    if (response.success) {
                        if (closeModal) $('#addAttachmentModal').modal('hide');
                        else setViewMode();
                        table.ajax.reload(null, false);
                        showNotification(response.message, 'success');
                    } else {
                        showNotification(response.message, 'error');
                    }
                },
                error: () => showNotification('Unable to save. Please try again.', 'error'),
                complete: () => toggleButtonLoading($btn, false)
            });
        }

        function toggleButtonLoading($btn, loading, text = '') {
            const iconMap = {
                'viewAttachment': '<i class="fas fa-eye"></i>',
                'deleteAttachment': '<i class="fa fa-trash"></i>',
                'restoreAttachment': '<i class="fas fa-undo"></i>'
            };

            if (loading) {
                $btn.data('original-html', $btn.html())
                    .prop('disabled', true)
                    .html((text ? '<i class="fas fa-spinner fa-spin"></i> ' : '<i class="fas fa-spinner fa-spin"></i>') + text);
            } else {
                const btnClass = Object.keys(iconMap).find(cls => $btn.hasClass(cls));
                $btn.prop('disabled', false)
                    .html($btn.data('original-html') || iconMap[btnClass] || 'Save')
                    .removeData('original-html');
            }
        }

        function showNotification(message, type) {
            const types = { success: 'Success', error: 'Error', warning: 'Warning', info: 'Information' };
            toastr[type](message, types[type] || 'Notification');
        }
    });
</script>