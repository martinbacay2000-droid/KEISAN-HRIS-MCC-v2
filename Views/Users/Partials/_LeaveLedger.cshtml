@model KEISAN_HRIS_v2.Models.Users.userLeaveLedger

<div class="row">
    <div class="card-header">
        <div class="row" style="width:100%;">
            <div class="row" style="margin-left:0px;width:100%;">
                <div class="col-md-3">
                    <div class="form-group">
                        <h5>Record Status</h5>
                        <select name="filterRecordStatus" id="filterRecordStatus" class="form-control">
                            <option value="active" selected>ACTIVE</option>
                            <option value="inactive">INACTIVE</option>
                        </select>
                    </div>
                </div>
                <div class="col-md-9"></div>
            </div>
        </div>
    </div>

    <div class="card-body">
        <div class="table-responsive">
            <table id="leaveLedger" class="display" style="min-width: 900px">
                <thead>
                    <tr>
                        <th>Action</th>
                        <th>Leave Name</th>
                        <th>Activity</th>
                        <th>Beginning Balance</th>
                        <th>Accrual</th>
                        <th>Used Credits</th>
                        <th>Available Balance</th>
                        <th>Date Added</th>
                        <th>Expiry Date</th>
                    </tr>
                </thead>
            </table>
        </div>
    </div>
</div>

<style>
    .table-responsive {
        border-radius: 0.375rem;
    }

    #leaveLedger_wrapper .dataTables_length,
    #leaveLedger_wrapper .dataTables_filter {
        margin-bottom: 1rem;
    }

    #leaveLedger_wrapper .dataTables_info,
    #leaveLedger_wrapper .dataTables_paginate {
        margin-top: 1rem;
    }

    #leaveLedger .btn-sm {
        padding: 0.25rem 0.5rem;
        font-size: 0.875rem;
    }

    .card-header {
        border-bottom: none !important;
    }

    .swal2-popup {
        border-radius: 15px !important;
        padding: 2rem !important;
    }

    .swal2-icon.swal2-error {
        border-color: #f27474 !important;
        color: #f27474 !important;
    }

        .swal2-icon.swal2-error .swal2-x-mark {
            display: none !important;
        }

        .swal2-icon.swal2-error::before {
            content: "\f2ed" !important;
            font-family: "Font Awesome 5 Free" !important;
            font-weight: 900 !important;
            font-size: 2.5rem !important;
            color: #f27474 !important;
            display: block !important;
        }

    .swal2-title {
        font-size: 1.875rem !important;
        font-weight: 600 !important;
        color: #545454 !important;
        margin: 1rem 0 0.5rem 0 !important;
    }

    .swal2-html-container {
        font-size: 1rem !important;
        color: #737373 !important;
        margin: 0 0 2rem 0 !important;
    }

    .swal2-actions {
        gap: 0.5rem !important;
    }

    .swal2-confirm {
        background-color: #7c3aed !important;
        border-color: #7c3aed !important;
        color: white !important;
        font-weight: 500 !important;
        padding: 0.75rem 2rem !important;
        border-radius: 8px !important;
        font-size: 0.875rem !important;
    }

    .swal2-cancel {
        background-color: #6b7280 !important;
        border-color: #6b7280 !important;
        color: white !important;
        font-weight: 500 !important;
        padding: 0.75rem 2rem !important;
        border-radius: 8px !important;
        font-size: 0.875rem !important;
    }

    .swal2-confirm:hover {
        background-color: #6d28d9 !important;
        border-color: #6d28d9 !important;
    }

    .swal2-cancel:hover {
        background-color: #4b5563 !important;
        border-color: #4b5563 !important;
    }

    .btn-success.shadow-sm:hover {
        background-color: #1e7e34;
        border-color: #1c7430;
    }
</style>

<script>
    $(document).ready(function () {
        MODULE = 'FSleaveLedgerM';
        access = ROLE_ACCESS?.[MODULE];

        // CONFIGURATION
        const config = {
            toastr: {
                positionClass: "toast-top-right",
                timeOut: 5000,
                closeButton: true,
                progressBar: true,
                preventDuplicates: true
            },
            endpoints: {
                list: "/LeaveLedger/GetLeaveLedgerList",
                delete: "/LeaveLedger/SoftDeleteLeave",
                restore: "/LeaveLedger/RestoreLeave"
            },
            employeeNo: '@Model.employeeNo'
        };

        toastr.options = config.toastr;
        let isViewingDeleted = false;

        //datepicker
        $('.bt-datepicker').datepicker({
            format: 'yyyy/mm/dd',
            autoclose: true
        });

        disabled_enable_input(true);
        initializeSelect2();
        set_Select2_values();

        // Initialize Select2 for filter
        $('#filterRecordStatus').select2({
            selectOnClose: true,
            minimumResultsForSearch: Infinity
        });

        // DATATABLE INITIALIZATION
        var table = $('#leaveLedger').DataTable({
            destroy: true,
            processing: true,
            serverSide: false,
            ajax: {
                url: config.endpoints.list,
                type: "GET",
                datatype: "json",
                data: function (d) {
                    d.employeeNo = config.employeeNo;
                    d.status = isViewingDeleted ? 'inactive' : 'active';
                },
                dataSrc: "data",
                error: function(xhr, error, code) {
                    console.log('Error loading data:', error);
                    showNotification('Error loading data. Please refresh the page.', 'error');
                }
            },
            columns: [
                {
                    data: "id",
                    width: "8%",
                    orderable: false,
                    render: function(data, type, row) {
                        let deletebtn = '';
                        let restorebtn = '';

                        // Only show delete/restore for CTO leave type
                        if (row.leaveCode === 'CTO') {
                            if (isViewingDeleted) {
                                if (access === 'FULL') {
                                    restorebtn = `
                                    <button class="btn btn-sm btn-success shadow-sm restoreLeave" data-id="${data}" title="Restore">
                                        <i class="fas fa-undo"></i>
                                    </button>`;
                                }
                            } else {
                                if (access === 'FULL') {
                                    deletebtn = `
                                    <button class="btn btn-sm btn-danger shadow-sm deleteLeave" data-id="${data}" title="Delete">
                                        <i class="fa fa-trash"></i>
                                    </button>`;
                                }
                            }
                        }

                        return `<div class="d-flex gap-1">${restorebtn}${deletebtn}</div>`;
                    }
                },
                {
                    data: "leaveName",
                    width: "15%"
                },
                {
                    data: "statusName",
                    width: "12%"
                },
                {
                    data: "beginningBalance",
                    width: "12%",
                    render: data => parseFloat(data || 0).toFixed(2),
                    className: "text-end"
                },
                {
                    data: "accrual",
                    width: "10%",
                    render: data => parseFloat(data || 0).toFixed(2),
                    className: "text-end"
                },
                {
                    data: "usedCredits",
                    width: "12%",
                    render: data => parseFloat(data || 0).toFixed(2),
                    className: "text-end"
                },
                {
                    data: "availableBalance",
                    width: "13%",
                    render: data => parseFloat(data || 0).toFixed(2),
                    className: "text-end"
                },
                {
                    data: "dtAdded",
                    width: "12%"
                },
                // ADD THIS:
                {
                    data: "dtDeleted",
                    width: "12%",
                    render: function(data, type, row) {
                        // Only show expiry for OFFSET CREDIT EARNED CTO records
                        if (row.leaveCode !== 'CTO' || row.statusName !== 'OFFSET CREDIT EARNED') {
                            return '<span class="text-muted">—</span>';
                        }

                        if (!data) return '<span class="text-muted">—</span>';

                        const expiry = new Date(data);
                        const today = new Date();
                        const diffDays = Math.ceil((expiry - today) / (1000 * 60 * 60 * 24));

                        const formatted = expiry.toLocaleDateString('en-US', {
                            month: '2-digit', day: '2-digit', year: 'numeric'
                        });

                        if (diffDays <= 0) {
                            // Already expired (shouldn't show in active, but just in case)
                            return `<span class="badge bg-danger">Expired</span>`;
                        } else if (diffDays <= 30) {
                            return `
                                <span class="text-danger fw-bold">
                                    <i class="fas fa-exclamation-triangle me-1"></i>${formatted}
                                    <br><small class="badge bg-warning text-dark">Expires in ${diffDays} day(s)</small>
                                </span>`;
                        } else {
                            return `<span>${formatted}</span>`;
                        }
                    }
                }
            ],
            order: [[1, 'asc']],
            pageLength: 25,
            lengthMenu: [[10, 25, 50, 100, -1], [10, 25, 50, 100, "All"]],
            language: {
                processing: "Loading...",
                emptyTable: "No leave ledger records found",
                zeroRecords: "No matching leave ledger records found",
                paginate: {
                    next: '<i class="fa fa-angle-double-right" aria-hidden="true"></i>',
                    previous: '<i class="fa fa-angle-double-left" aria-hidden="true"></i>'
                }
            }
        });

        // EVENT HANDLERS - FILTERS
        $('#filterRecordStatus').on('change', function () {
            isViewingDeleted = $(this).val() === 'inactive';
            table.ajax.reload();
        });

        // EVENT HANDLERS - DELETE
        $(document).on('click', '.deleteLeave', function(e) {
            e.preventDefault();
            deleteWithReason({
                title: 'Inactive CTO Leave',
                text: 'Are you sure you want to inactive this CTO leave record?',
                url: config.endpoints.delete,
                id: $(this).data('id'),
                button: $(this),
                table: table,
                toggleLoading: toggleButtonLoading,
                onSuccess: response => showNotification(response.message, 'success'),
                onError: response => showNotification(response.message || 'Unable to delete. Please try again.', 'error')
            });
        });

        // EVENT HANDLERS - RESTORE
        $(document).on('click', '.restoreLeave', function(e) {
            e.preventDefault();
            const id = $(this).data('id');
            const $btn = $(this);

            Swal.fire({
                title: 'Restore Record',
                text: 'Are you sure you want to restore this leave record?',
                icon: 'question',
                showCancelButton: true,
                confirmButtonText: 'Yes, Restore',
                cancelButtonText: 'Cancel',
                confirmButtonColor: '#28a745'
            }).then(result => {
                if (result.isConfirmed) {
                    toggleButtonLoading($btn, true);
                    $.post(config.endpoints.restore, { id })
                        .done(response => {
                            if (response.success) {
                                table.ajax.reload(null, false);
                                showNotification(response.message, 'success');
                            } else {
                                showNotification(response.message, 'error');
                            }
                        })
                        .fail(() => showNotification('Unable to restore. Please try again.', 'error'))
                        .always(() => toggleButtonLoading($btn, false));
                }
            });
        });

        // EXISTING FUNCTIONALITY
        $('#updateSaveBtn').on('click', function() {
            const $btn = $(this);
            if ($btn.text().trim() === 'Edit') {
                $btn.text('Save');
                $btn.removeClass('btn-primary').addClass('btn-success');
                disabled_enable_input(false);
            } else {
                $btn.text('Edit');
                $btn.prop('disabled', false);
                $btn.removeClass('btn-success').addClass('btn-primary');
                disabled_enable_input(true);
            }
        });

        // HELPER FUNCTIONS
        function toggleButtonLoading($btn, loading, text = '') {
            if (loading) {
                if (!$btn.data('original-html')) $btn.data('original-html', $btn.html());
                const icon = text ? '<i class="fas fa-spinner fa-spin"></i> ' : '<i class="fas fa-spinner fa-spin"></i>';
                $btn.prop('disabled', true).html(icon + text);
            } else {
                const originalHtml = $btn.data('original-html') || $btn.html();
                $btn.prop('disabled', false).html(originalHtml);
                $btn.removeData('original-html');
            }
        }

        function showNotification(message, type) {
            const types = { success: 'Success', error: 'Error', warning: 'Warning', info: 'Information' };
            toastr[type](message, types[type] || 'Notification');
        }
    });

    function initializeSelect2(){

    }

    function set_Select2_values(){

    }
</script>