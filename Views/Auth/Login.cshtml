@{
    // Layout = "~/Views/Shared/_Layout.cshtml";
    Layout = "~/Views/Shared/_LayoutFillowAuth.cshtml";
}
<!-- Toastr CSS -->
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/toastr.min.css">


<div class="fix-wrapper">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-lg-5 col-md-6">
                <div class="card mb-0 h-auto">
                    <div class="card-body">
                        <div class="text-center mb-2">
                            <a href="@Url.Action("Index", "Fillow")"><img class="logo-auth" src="~/Fillow/images/your_logo_1.png" alt=""></a>
                        </div>
                        <br>
                        <h4 class="text-center mb-4">KEISAN HRIS AND PAYROLL </h4>
                        <form action="@Url.Action("Index", "Fillow")">
                            @* <div class="form-group mb-4">
                                <select id="Database" class="form-control input-sm selectSearch">
                                    <option value="" selected>Select a Company</option>
                                </select>
                                <p class="userpassinfo" style="text-align:center">Select a company before entering username and password</p>
                            </div> *@
                            <div class="form-group mb-4">
                                <label class="form-label" for="username">Usercode</label>
                                <input type="text" class="form-control" placeholder="Enter usercode" id="Username">
                                <div class="invalid-feedback">Username is required.</div>
                            </div>
                            <div class="mb-sm-4 mb-3 position-relative">
                                <label class="form-label" for="dlab-password">Password</label>
                                <input type="password" class="form-control" placeholder="Enter password" id="Password">
                                <div class="invalid-feedback">Password is required.</div>
                                @*  <span class="show-pass eye">
                                    <i class="fa fa-eye-slash" id="togglePassword"></i>
                                    <i class="fa fa-eye"></i>
                                </span> *@
                            </div>
                            <div class="form-row d-flex flex-wrap justify-content-between mb-2">
                                @* <div class="form-group mb-sm-4 mb-1">
                                    <div class="form-check custom-checkbox ms-1">
                                        <input type="checkbox" class="form-check-input" id="basic_checkbox_1">
                                        <label class="form-check-label" for="basic_checkbox_1">Remember my preference</label>
                                    </div>
                                </div> *@
                                <div class="form-group ms-2">
                                    @* <a href="@Url.Action("ForgotPassword","Fillow")">Forgot Password?</a> *@
                                    <a href="#" class="" id="forgot_pass_btn">
                                        <span style="font-size: small; text-align: center; ">Forgot Password?</span>
                                    </a>
                                </div>

                            </div>
                            <br />
                            <div class="text-center">
                                <button type="button" id="btnLogin" class="btn btn-primary btn-block">Sign In</button>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>


    <div id="modalForgotPass" class="modal fade" role="dialog">
        <div class="modal-dialog modal-m">
            <div class="modal-content">
                <form class="form" id="modalNewRequestForm" method="post" action="" autocomplete="off">
                    <div class="modal-body" id="modal-body">
                        <div class="row" style="display: flex; padding: 21px; padding-top: 0px;">
                            <div class="col-sm row1">
                                <div class="row">
                                    <div class="col-xs-12 col-sm-12 col-md-12 col-lg-12">
                                        <div class="form-group">
                                            <h4 class="control-label" style="padding-left: 5px; width: 100%; text-align: center;">Your new password will be sent in this email.</h4>
                                            <br />
                                            <h5 class="control-label" id="email_label" style="padding-left: 5px; width: 100%; text-align: center;color:crimson ">no email found in the system, please contact your HR / Dept Head</h5>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="modal-footer">
                        <a href="#" class="btn btn-success btn-block" id="submitResetBtn">
                            <span style="font-size: small; text-align: center; ">Reset Password</span>
                        </a>
                    </div>
                </form>
            </div>
        </div>
    </div>

</div>


@Html.Hidden("RedirectTo", Url.Action("Index", "Home"))

<script src="~/fillow/js/jquery.min.js"></script>
<script src="~/fillow/js/jquery-1.10.2.js"></script>
<script src="~/fillow/js/jquery-3.7.1.min.js"></script>
<script src="~/fillow/js/jquery-ui.min.js"></script>
<script src="~/fillow/js/jquery-ui.js"></script>
<script src="~/Fillow/vendor/global/global.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

<script>
    $(document).ready(function () {

        $("#btnLogin").click(function () {
            const fields = {
                username: $("#Username"),
                password: $("#Password"),
            };

            let isValid = true;

            // $.each(fields, function (key, field) {
            //     if ($.trim(field.val()) === '') {
            //         field.addClass('is-invalid');
            //         isValid = false;
            //     } else {
            //         field.removeClass('is-invalid');
            //     }
            // });

            if (isValid) {
                OnBegin()
                Login(fields.username.val(), fields.password.val());
            }
        });

        $('#forgot_pass_btn').click(function () {

             Swal.fire({
                title: 'Processing...',
                text: 'Please wait...',
                allowOutsideClick: false,
                allowEscapeKey: false,
                didOpen: () => {
                    Swal.showLoading();
                }
            });

            let employeeNo = $('#Username').val();

            $.ajax({
                url: '/Auth/GetEmployeeEmail',
                type: 'POST',
                data: { employeeNo: employeeNo },
                success: function (response) {
                     Swal.close();
                    $('#email_label').text(response.emailAddress || '');
                    $('#modalForgotPass').modal('show');
                },
                error: function () {
                    console.log("Failed to retrieve email", "error");
                }
            });

        });

       $('#submitResetBtn').click(function () {

        let employeeNo = $('#Username').val();
        let emailAddress = $('#email_label').text();


        Swal.fire({
            title: 'Processing...',
            text: 'Please wait...',
            allowOutsideClick: false,
            allowEscapeKey: false,
            didOpen: () => {
                Swal.showLoading();
            }
        });

        $.ajax({
            url: '/Auth/SendResetPassword',
            type: 'POST',
            data: { employeeNo: employeeNo, emailAddress: emailAddress },
            success: function (response) {
                Swal.close();
                    Swal.fire({
                        icon: 'success',
                        title: 'Success!',
                        text: response.message || 'Password Successfully Reset.',
                        confirmButtonText: 'OK'
                    }).then(() => {
                        $('#modalForgotPass').modal('hide');
                    });
            },
            error: function () {
                Swal.fire({
                    icon: 'error',
                    title: 'Server Error!',
                    text: 'Failed to process request.'
                });
            }
        });

    });

    })

    document.addEventListener("keydown", function (event) {
        if (event.key === "Enter") {
            document.getElementById("btnLogin").click();
        }
    });
</script>