@{
    Layout = "~/Views/Shared/_LayoutFillow.cshtml";
    ViewData["Title"] = "Employee Master List";

    // Access flag passed from controller
    bool canViewSalary = ViewBag.CanViewSalary ?? false;
}

<div class="col-12">
    <div class="card">
        <div class="card-header">
            <div class="row" style="width:100%;">
                <h4 class="card-title">Employee Master List</h4>
                <br> <br> <br>

                <div class="row" style="margin-left:0px;width:100%;">
                    <div class="col-md-3">
                        <div class="form-group">
                            <h5>Company</h5>
                            <select name="filterCompany" id="filterCompany" class="form-control"></select>
                        </div>
                    </div>
                    <div class="col-md-3">
                        <div class="form-group">
                            <h5>Department</h5>
                            <select name="filterDepartment" id="filterDepartment" class="form-control"></select>
                        </div>
                    </div>
                    <div class="col-md-3">
                        <div class="form-group">
                            <h5>Rank</h5>
                            <select name="filterRank" id="filterRank" class="form-control"></select>
                        </div>
                    </div>
                </div>

                <div class="row align-items-end mt-2" style="margin-left:0px;width:100%;">
                    <div class="col-md-3">
                        <div class="form-group">
                            <h5>Position</h5>
                            <select name="filterPosition" id="filterPosition" class="form-control"></select>
                        </div>
                    </div>
                    <div class="col-md-3">
                        <div class="form-group">
                            <h5>Employment Status</h5>
                            <select name="filterEmploymentStatus" id="filterEmploymentStatus" class="form-control"></select>
                        </div>
                    </div>
                    <div class="col-md-3">
                        <div class="form-group">
                            <h5>Gender</h5>
                            <select name="gender" id="filterGender" class="form-control">
                                <option value="ALL" selected>ALL</option>
                                <option value="Male">MALE</option>
                                <option value="Female">FEMALE</option>
                            </select>
                        </div>
                    </div>
                    <div class="col-md-3"></div>
                    <div class="col-md-12 d-flex justify-content-end" style="margin-top:15px;gap:10px;">
                        <div class="form-group">
                            <button type="button" class="btn btn-warning" id="btnExportToExcel">
                                <i class="fas fa-file-excel"></i> Export to Excel
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="card-body">
            <div class="table-responsive">
                <table id="EmployeeTable" class="display" style="min-width: 1500px">
                    <thead id="employeeList">
                        <tr>
                            <th>Employee No</th>
                            <th>Employee Name</th>
                            <th>Position</th>
                            <th>Rank</th>
                            <th>Department</th>
                            <th>Birthday</th>
                            <th>Age</th>
                            <th>Gender</th>
                            <th>Date Hired</th>
                            <th>Length of Service</th>
                            <th>SSS Number</th>
                            <th>PHIC Number</th>
                            <th>HDMF Number</th>
                            <th>TIN Number</th>
                            <th class="col-basic-monthly-pay">
                                Basic Monthly Pay
                                @if (!canViewSalary)
                                {
                                    <span class="badge badge-primary" style="font-size:10px;font-weight:400;">(Hidden)</span>
                                }
                            </th>
                            <th>Company</th>
                            <th>Status</th>
                        </tr>
                    </thead>
                </table>
            </div>
        </div>
    </div>
</div>

@section Fillow_style
{
}

@section Fillow_script
{
    <script>
        $(document).ready(function () {

            // Access flag from controller
            const canViewSalary = @Json.Serialize(canViewSalary);

            // Datepicker
            $('.bt-datepicker').datepicker({
                format       : 'yyyy-mm-dd',
                autoclose    : true,
                todayHighlight: true
            });

            let EmployeeTable;

            // ── Initialize DataTable ─────────────────────────────────────────────
            function initDataTable() {

                if ($.fn.DataTable.isDataTable('#EmployeeTable')) {
                    EmployeeTable.clear().destroy();
                }

                EmployeeTable = $('#EmployeeTable').DataTable({

                    pageLength: 10,
                    lengthMenu: [
                        [10, 25, 50, -1],
                        [10, 25, 50, "All"]
                    ],

                    ajax: {
                        url     : '/EmployeeMasterList/GetReportList',
                        type    : 'GET',
                        dataType: 'json',
                        dataSrc : function (json) {
                            return json.data || [];
                        },
                        data: function (d) {
                            d.company          = $('#filterCompany').val()          || "ALL";
                            d.department       = $('#filterDepartment').val()       || "ALL";
                            d.rank             = $('#filterRank').val()             || "ALL";
                            d.position         = $('#filterPosition').val()         || "ALL";
                            d.employmentstatus = $('#filterEmploymentStatus').val() || "ALL";
                            d.gender           = $('#filterGender').val()           || "ALL";
                        },
                        error: function (xhr, error, thrown) {
                            console.error("AJAX Error:", xhr.status, error, xhr.responseText);
                        }
                    },

                    columns: [
                        { data: "employeeNo",       defaultContent: "" },
                        { data: "employeeName",     defaultContent: "" },
                        { data: "positionName",     defaultContent: "" },
                        { data: "rankName",         defaultContent: "" },
                        { data: "department",       defaultContent: "" },
                        { data: "dateOfBirth",      defaultContent: "" },
                        { data: "age",              defaultContent: "" },
                        { data: "gender",           defaultContent: "" },
                        { data: "dateHired",        defaultContent: "" },
                        { data: "lengthOfService",  defaultContent: "" },
                        { data: "sssNo",            defaultContent: "" },
                        { data: "philhealthNo",     defaultContent: "" },
                        { data: "hdmfNo",           defaultContent: "" },
                        { data: "tinNo",            defaultContent: "" },
                        {
                            data          : "basicMonthlyPay",
                            defaultContent: "",
                            visible       : true,          // Always show the column
                            render        : function (data, type, row) {
                                if (!canViewSalary) return '<span style="color:#aaa;letter-spacing:2px;">****</span>';
                                if (data === null || data === undefined || data === '' || typeof data === 'object') return '';
                                var numValue = parseFloat(data);
                                if (isNaN(numValue)) return '';
                                return numValue.toLocaleString('en-US', {
                                    minimumFractionDigits: 2,
                                    maximumFractionDigits: 2
                                });
                            }
                        },
                        { data: "company", defaultContent: "" },
                        { data: "status",  defaultContent: "" }
                    ],

                    language: {
                        paginate: {
                            next    : '<i class="fa fa-angle-double-right" aria-hidden="true"></i>',
                            previous: '<i class="fa fa-angle-double-left" aria-hidden="true"></i>'
                        }
                    },

                    dom: 'Blfrtip',
                    buttons: [
                        {
                            extend      : 'excelHtml5',
                            text        : '<i class="fa fa-file-excel-o"></i> Excel',
                            className   : 'btn btn-success',
                            exportOptions: {
                                columns: canViewSalary
                                    ? ':visible'
                                    : ':visible:not(.col-basic-monthly-pay)'
                            }
                        },
                        {
                            extend      : 'pdfHtml5',
                            text        : '<i class="fa fa-file-pdf-o"></i> PDF',
                            className   : 'btn btn-danger',
                            orientation : 'landscape',
                            pageSize    : 'A4',
                            exportOptions: {
                                columns: canViewSalary
                                    ? ':visible'
                                    : ':visible:not(.col-basic-monthly-pay)'
                            }
                        }
                    ]
                });
            }

            // ── Initialize filters and table ─────────────────────────────────────
            initializeFilterSelect2();
            initDataTable();

            // ── Reload table on filter change ────────────────────────────────────
            $('#filterCompany, #filterDepartment, #filterRank, #filterGender, #filterEmploymentStatus, #filterPosition')
                .on('change.select2', function () {
                    EmployeeTable.ajax.reload(null, true);
                });

            // ── Delete employee handler ──────────────────────────────────────────
            $(document).on("click", ".deleteEmployee", function (e) {
                e.preventDefault();
                var employeeNo = $(this).data("employeeno");
                var $btn       = $(this);

                Swal.fire({
                    title            : 'Oops...',
                    text             : 'Are you sure you want to delete this Employee?',
                    icon             : 'error',
                    showCancelButton : true,
                    confirmButtonText: 'OK',
                    cancelButtonText : 'Cancel',
                    reverseButtons   : false,
                    allowOutsideClick: false,
                    allowEscapeKey   : false,
                    customClass: {
                        popup        : 'swal-custom-popup',
                        title        : 'swal-custom-title',
                        htmlContainer: 'swal-custom-text',
                        confirmButton: 'swal-custom-confirm',
                        cancelButton : 'swal-custom-cancel'
                    }
                }).then((result) => {
                    if (result.isConfirmed) {
                        $btn.prop('disabled', true).html('<i class="fas fa-spinner fa-spin"></i>');

                        $.ajax({
                            url     : '/Users/DeleteUser',
                            type    : 'POST',
                            data    : { employeeNo: employeeNo },
                            dataType: 'json',
                            success : function (response) {
                                if (response.success) {
                                    EmployeeTable.ajax.reload(null, false);
                                    showNotification(response.message, 'success');
                                } else {
                                    showNotification(response.message, 'error');
                                }
                            },
                            error   : function (xhr, status, error) {
                                console.error('Error deleting employee:', error);
                                showNotification('Unable to delete employee. Please try again.', 'error');
                            },
                            complete: function () {
                                $btn.prop('disabled', false).html('<i class="fa fa-trash"></i>');
                            }
                        });
                    }
                });
            });

            // ── Export to Excel handler ──────────────────────────────────────────
            $(document).on('click', '#btnExportToExcel', function () {
                const $btn  = $(this);
                const table = $('#EmployeeTable').DataTable();

                if (!table) {
                    alert('Table not initialized. Please wait for the page to load completely.');
                    return;
                }

                if (table.rows({ search: 'applied' }).count() === 0) {
                    Swal.fire({
                        icon             : 'warning',
                        title            : 'No Data',
                        text             : 'No data available to export',
                        confirmButtonText: 'OK'
                    });
                    return;
                }

                const currentPageData = table.rows({ page: 'current' }).data().toArray();
                if (currentPageData.length === 0) {
                    Swal.fire({
                        icon             : 'warning',
                        title            : 'No Data',
                        text             : 'No data on current page to export',
                        confirmButtonText: 'OK'
                    });
                    return;
                }

                const pageInfo = table.page.info();
                const params   = new URLSearchParams({
                    company         : $('#filterCompany').val()          || 'ALL',
                    department      : $('#filterDepartment').val()       || 'ALL',
                    rank            : $('#filterRank').val()             || 'ALL',
                    position        : $('#filterPosition').val()         || 'ALL',
                    employmentstatus: $('#filterEmploymentStatus').val() || 'ALL',
                    gender          : $('#filterGender').val()           || 'ALL',
                    offset          : pageInfo.start,
                    limit           : pageInfo.length
                });

                const originalHtml = $btn.html();
                $btn.prop('disabled', true).html('<i class="fas fa-spinner fa-spin"></i> Exporting...');

                fetch(`/EmployeeMasterListExport/ExportToExcel?${params.toString()}`, {
                    method : 'GET',
                    headers: { 'Accept': 'application/vnd.openxmlformats-officedocument.spreadsheetml.sheet' }
                })
                .then(response => {
                    if (!response.ok) {
                        return response.text().then(text => {
                            throw new Error(`Server error (${response.status}): ${text}`);
                        });
                    }
                    return response.blob();
                })
                .then(blob => {
                    const blobUrl = window.URL.createObjectURL(blob);
                    const link    = document.createElement('a');
                    link.href     = blobUrl;
                    link.download = `EmployeeMasterList_${new Date().getTime()}.xlsx`;
                    document.body.appendChild(link);
                    link.click();
                    document.body.removeChild(link);
                    window.URL.revokeObjectURL(blobUrl);

                    $btn.prop('disabled', false).html(originalHtml);

                    Swal.fire({
                        icon             : 'success',
                        title            : 'Export Successful',
                        text             : 'Employee Master List has been exported successfully',
                        confirmButtonText: 'OK',
                        timer            : 2000
                    });
                })
                .catch(error => {
                    $btn.prop('disabled', false).html(originalHtml);
                    Swal.fire({
                        icon             : 'error',
                        title            : 'Export Failed',
                        text             : 'An error occurred during export. Please try again.',
                        confirmButtonText: 'OK'
                    });
                    console.error('Export error:', error);
                });
            });

        }); // end document.ready

        // ── Filter Select2 Initialization ────────────────────────────────────────
        function initializeFilterSelect2() {

            $('.month-picker').datepicker({
                format     : "MM",
                minViewMode: 1,
                startView  : 1,
                autoclose  : true
            }).on('show', function () {
                $('.datepicker-years').hide();
                $('.datepicker-switch').css('visibility', 'hidden');
            }).val(function () {
                const monthNames = [
                    "January", "February", "March",     "April",   "May",      "June",
                    "July",    "August",   "September", "October", "November", "December"
                ];
                return monthNames[new Date().getMonth()];
            });

            $('.year-picker').datepicker({
                format     : 'yyyy',
                minViewMode: 2,
                autoclose  : true
            }).val(new Date().getFullYear());

            // Company / Branch
            $('#filterCompany').select2({
                placeholder: "Select Company/Branch",
                allowClear : true,
                ajax: {
                    url          : '/Setup/GetEmployeeBranch',
                    dataType     : 'json',
                    delay        : 250,
                    processResults: function (data) {
                        var results = $.map(data, function (item) {
                            return { id: item.branchCode, text: item.branchName };
                        });
                        results.unshift({ id: 'ALL', text: 'All Company/Branch' });
                        return { results: results };
                    }
                }
            });

            // Department
            $('#filterDepartment').select2({
                placeholder: "Select Employee Department",
                allowClear : true,
                ajax: {
                    url          : '/Setup/GetEmployeeDepartment',
                    dataType     : 'json',
                    delay        : 250,
                    processResults: function (data) {
                        var results = $.map(data, function (item) {
                            return { id: item.departmentCode, text: item.departmentName };
                        });
                        results.unshift({ id: 'ALL', text: 'All Departments' });
                        return { results: results };
                    }
                }
            });

            // Position
            $('#filterPosition').select2({
                placeholder: "Select Employee Position",
                allowClear : true,
                ajax: {
                    url          : '/Setup/GetEmployeePositions',
                    dataType     : 'json',
                    delay        : 250,
                    processResults: function (data) {
                        var results = $.map(data, function (item) {
                            return { id: item.positionCode, text: item.positionName };
                        });
                        results.unshift({ id: 'ALL', text: 'All Position' });
                        return { results: results };
                    }
                }
            });

            // Rank
            $('#filterRank').select2({
                placeholder: "Select Employee Rank",
                allowClear : true,
                ajax: {
                    url          : '/Setup/GetEmployeeRanks',
                    dataType     : 'json',
                    delay        : 250,
                    processResults: function (data) {
                        var results = $.map(data, function (item) {
                            return { id: item.rankCode, text: item.rankName };
                        });
                        results.unshift({ id: 'ALL', text: 'All Rank' });
                        return { results: results };
                    }
                }
            });

            // Employment Status
            $('#filterEmploymentStatus').select2({
                placeholder: "Select Employment Status",
                allowClear : true,
                ajax: {
                    url          : '/Setup/GetEmploymentStatuses',   
                    dataType     : 'json',
                    delay        : 250,
                    processResults: function (data) {
                        var results = $.map(data, function (item) {
                            return { id: item.employmentStatusCode,   
                                     text: item.employmentStatusName }; 
                        });
                        results.unshift({ id: 'ALL', text: 'All Employment Status' });
                        return { results: results };
                    }
                }
            });
        }
    </script>
}