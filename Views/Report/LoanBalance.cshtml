@{
    Layout = "~/Views/Shared/_LayoutFillow.cshtml";
    ViewData["Title"] = "Loan Balance Report";
}

<div class="col-12">
    <div class="card">
        <div class="card-header">
            <div class="row" style="width:100%;">
                <h4 class="card-title">Loan Balance Report</h4>
                <br> <br> <br>

                <div class="row" style="margin-left:0px;width:100%;">
                    <div class="col-md-3">
                        <div class="form-group">
                            <h5>Company</h5>
                            <select name="branch" id="filterBranch" class="form-control"></select>
                        </div>
                    </div>
                    <div class="col-md-3">
                        <div class="form-group">
                            <h5>Department</h5>
                            <select name="department" id="filterDepartment" class="form-control"></select>
                        </div>
                    </div>
                    <div class="col-md-3">
                        <div class="form-group">
                            <h5>Loan Type</h5>
                            <select name="loan" id="filterLoan" class="form-control"></select>
                        </div>
                    </div>
                    <div class="col-md-3">
                        <div class="form-group">
                            <h5>Loan Status</h5>
                            <select name="loanStatus" id="filterLoanStatus" class="form-control">
                                <option value="Ongoing" selected>Ongoing</option>
                                <option value="Completed">Completed</option>
                                <option value="ALL">All</option>
                            </select>
                        </div>
                    </div>
                </div>
                <div class="row mt-2" style="margin-left:0px;width:100%;">
                    <div class="col-md-12 d-flex justify-content-end">
                        <button type="button" class="btn btn-warning" id="btnExportToExcel">
                            <i class="fas fa-file-excel"></i> Export to Excel
                        </button>
                    </div>
                </div>
            </div>
        </div>

        <div class="card-body">
            <div class="row">
                <div class="table-responsive">
                    <table id="requestTable" class="display" style="min-width: 845px">
                        <thead>
                            <tr>
                                <th>Company</th>
                                <th>Department</th>
                                <th>Employee No</th>
                                <th>Full Name</th>
                                <th>Loan Type</th>
                                <th>Date Granted</th>
                                <th>Deduction Start Date</th>
                                <th>Deduction Schedule</th>
                                <th>Principal Amount</th>
                                <th>Monthly Amortization</th>
                                <th>Outstanding Balance</th>
                                <th>Status</th>
                                <th>Remarks</th>
                            </tr>
                        </thead>
                        <tfoot>
                            <tr>
                                <th></th>
                                <th></th>
                                <th></th>
                                <th></th>
                                <th></th>
                                <th></th>
                                <th></th>
                                <th></th>
                                <th></th>
                                <th></th>
                                <th></th>
                                <th></th>
                                <th></th>
                            </tr>
                        </tfoot>
                    </table>
                </div>
            </div>

        </div>
    </div>
</div>
@section Fillow_style
{
    <style>

    </style>

}

@section Fillow_script
{
    <script>
        $(document).ready(function () {

            initializeFilterSelect2();

            const moneyFmt = $.fn.dataTable.render.number(',', '.', 3);

            const requestTable = $('#requestTable').DataTable({
                ajax: {
                    url: "/LoanBalance/GetReportList",
                    type: "GET",
                    dataType: "json",
                    data: function (d) {
                        d.branch = $('#filterBranch').val();
                        d.department = $('#filterDepartment').val();
                        d.loancode = $('#filterLoan').val();
                        d.loanStatus = $('#filterLoanStatus').val();
                    }
                },

                columnDefs: [
                    { targets: [8, 9, 10], className: 'dt-right' }
                ],

                footerCallback: function (row, data, start, end, display) {
                    const api = this.api();

                    const parseNumber = val =>
                        typeof val === 'string'
                            ? parseFloat(val.replace(/[,₱]/g, '')) || 0
                            : typeof val === 'number' ? val : 0;

                    // Set TOTAL label explicitly on column 7
                    $(api.column(7).footer()).html('<strong>TOTAL</strong>').css('text-align', 'right');

                    // Compute and set totals for numeric columns
                    [8, 9, 10].forEach(colIdx => {
                        const total = api
                            .column(colIdx, { page: 'all' })
                            .data()
                            .reduce((a, b) => parseNumber(a) + parseNumber(b), 0);

                        $(api.column(colIdx).footer())
                            .html('<strong>' + moneyFmt.display(total) + '</strong>')
                            .css('text-align', 'right');
                    });
                },

                columns: [
                    { data: "branchName" },
                    { data: "departmentName" },
                    { data: "employeeNo" },
                    { data: "fullName" },
                    { data: "loanName" },
                    { data: "dateGranted" },
                    { data: "deductionStartDate" },
                    { data: "deductionSchedule" },
                    { data: "principalAmount" },
                    { data: "amortizationAmount" },
                    { data: "loanBalance" },
                    { data: "loanStatus" },
                    {
                        data: "remarks",
                        render: data => data ? `<span title="${data}" style="display:inline-block;max-width:150px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;">${data}</span>` : ''
                    }
                ],
                language: {
                    paginate: {
                        next: '<i class="fa fa-angle-double-right" aria-hidden="true"></i>',
                        previous: '<i class="fa fa-angle-double-left" aria-hidden="true"></i>'
                    }
                }
            });

            //apply filter when user chose a param
            $('#filterBranch, #filterDepartment, #filterLoan, #filterLoanStatus').on('change', function () {
                requestTable.ajax.reload(null, true);
            });

            // EVENT HANDLER - EXPORT TO EXCEL (CURRENT PAGE ONLY)
            $('#btnExportToExcel').click(function() {
                const $btn = $(this);

                // Validate data availability
                if (requestTable.rows({ search: 'applied' }).count() === 0) {
                    Swal.fire({
                        icon: 'warning',
                        title: 'No Data',
                        text: 'No data available to export',
                        confirmButtonText: 'OK'
                    });
                    return;
                }

                const currentPageData = requestTable.rows({ page: 'current' }).data().toArray();
                if (currentPageData.length === 0) {
                    Swal.fire({
                        icon: 'warning',
                        title: 'No Data',
                        text: 'No data on current page to export',
                        confirmButtonText: 'OK'
                    });
                    return;
                }

                // Get pagination and filter info
                const pageInfo = requestTable.page.info();
                const params = new URLSearchParams({
                    branch: $('#filterBranch').val() || 'ALL',
                    department: $('#filterDepartment').val() || 'ALL',
                    loancode: $('#filterLoan').val() || 'ALL',
                    loanStatus: $('#filterLoanStatus').val() || 'Ongoing',
                    offset: pageInfo.start,
                    limit: pageInfo.length
                });

                // Show loading state
                const originalHtml = $btn.html();
                $btn.prop('disabled', true).html('<i class="fas fa-spinner fa-spin"></i> Exporting...');

                const url = `/LoanBalanceExport/ExportToExcel?${params.toString()}`;

                fetch(url, {
                    method: 'GET',
                    headers: {
                        'Accept': 'application/vnd.openxmlformats-officedocument.spreadsheetml.sheet'
                    }
                })
                .then(response => {
                    if (!response.ok) {
                        return response.text().then(text => {
                            throw new Error(`Server error (${response.status}): ${text}`);
                        });
                    }
                    return response.blob();
                })
                .then(blob => {
                    const url = window.URL.createObjectURL(blob);
                    const link = document.createElement('a');
                    link.href = url;
                    link.download = `LoanBalanceReport_${new Date().getTime()}.xlsx`;
                    document.body.appendChild(link);
                    link.click();
                    document.body.removeChild(link);
                    window.URL.revokeObjectURL(url);

                    // Reset button
                    $btn.prop('disabled', false).html(originalHtml);
                })
                .catch(error => {
                    // Reset button
                    $btn.prop('disabled', false).html(originalHtml);

                    // Show error notification
                    Swal.fire({
                        icon: 'error',
                        title: 'Export Failed',
                        text: 'An error occurred during export. Please try again.',
                        confirmButtonText: 'OK'
                    });
                });
            });

        });

        function initializeFilterSelect2(){

            // loan status
            $('#filterLoanStatus').select2({
                minimumResultsForSearch: Infinity,
                allowClear: false
            });

            // branch
            $('#filterBranch').select2({
                placeholder: "Select Company",
                allowClear: true,
                ajax: {
                    url: '/Setup/GetEmployeeBranch',
                    dataType: 'json',
                    delay: 250,
                    processResults: function (data) {
                        // Add "All" option manually
                        var allOption = {
                            id: 'ALL',
                            text: 'All Companies'
                        };

                        var results = $.map(data, function (item) {
                            return {
                                id: item.branchCode,
                                text: item.branchName
                            };
                        });

                        // Put "All" on top
                        results.unshift(allOption);

                        return {
                            results: results
                        };
                    }
                }
            });

             // department
             $('#filterDepartment').select2({
                placeholder: "Select Department",
                allowClear: true,
                ajax: {
                    url: '/Setup/GetEmployeeDepartment',
                    dataType: 'json',
                    delay: 250,
                    processResults: function (data) {
                        // Map your results as usual
                        var results = $.map(data, function (item) {
                            return {
                                id: item.departmentCode,
                                text: item.departmentName
                            };
                        });

                        // Add the "All" option at the top
                        results.unshift({
                            id: 'ALL',
                            text: 'All Departments'
                        });

                        return {
                            results: results
                        };
                    }
                }
            });

             // department
             $('#filterLoan').select2({
                placeholder: "Select Loan Type",
                allowClear: true,
                ajax: {
                    url: '/Setup/GetLoanList',
                    dataType: 'json',
                    delay: 250,
                    processResults: function (data) {
                        // Map your results as usual
                        var results = $.map(data, function (item) {
                            return {
                                id: item.loanCode,
                                text: item.loanName
                            };
                        });

                        // Add the "All" option at the top
                        results.unshift({
                            id: 'ALL',
                            text: 'All Loan Types'
                        });

                        return {
                            results: results
                        };
                    }
                }
            });

            // EVENT HANDLER - PRINT PDF
            $(document).on('click', '.print13thMonth', function(e) {
                e.preventDefault();

                const employeeNo = $(this).data('employeeno');
                const dateYear = $(this).data('dateyear');

                var parameter = employeeNo + "_" + dateYear;
                var url = "http://15.235.183.108:90//home/ThirteenMonth?" + "&the13thmonth=" + encodeURIComponent(parameter);
                window.open(url, '_blank');
            });

        }

    </script>
}