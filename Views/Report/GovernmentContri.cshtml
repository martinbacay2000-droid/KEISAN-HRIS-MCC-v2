﻿@{
Layout = "~/Views/Shared/_LayoutFillow.cshtml";
ViewData["Title"] = "Government Contribution";
}

<div class="col-12">
    <div class="card">
        <div class="card-header">

            <div class="row" style="width:100%;">
                <h4 class="card-title">Government Report</h4>
                <br> <br> <br>

                <div class="row" style="margin-left:0px;width:100%;">
                    <div class="col-md-3">
                        <div class="form-group">
                            <h5>Select Report</h5>
                            <select name="filterReportName" id="filterReportName" class="form-control">
                                <option value="SSSreport" selected>SSS Report</option>
                                <option value="PHIreport">Philhealth Report</option>
                                <option value="PIFreport">Pagibig Report</option>
                                <option value="TAXreport">Tax Report</option>
                            </select>
                        </div>
                    </div>
                    <div class="col-md-3">
                        <div class="form-group">
                            <h5>Branch</h5>
                            <select name="branch" id="filterBranch" class="form-control"></select>
                        </div>
                    </div>

                </div>

                <div class="row align-items-end mt-2" style="margin-left:0px;width:100%;">
                    <div class="col-md-3">
                        <label>Date Month</label>
                        <div class="input-hasicon">
                            <input name="dateMonth" id="dateMonth" class="form-control formInput month-picker ">
                            <div class="icon"><i class="far fa-calendar"></i></div>
                        </div>
                    </div>

                    <div class="col-md-3">
                        <label>Year</label>
                        <div class="input-hasicon">
                            <input name="dateYear" id="dateYear" class="form-control formInput year-picker ">
                            <div class="icon"><i class="far fa-calendar"></i></div>
                        </div>
                    </div>
                    <div class="col-md-3">
                        <div class="form-group">
                            <h5>Department</h5>
                            <select name="department" id="filterDepartment" class="form-control"></select>
                        </div>
                    </div>

                    <div class="col-md-3">
                    </div>
                    <div class="col-md-12 d-flex justify-content-end" style="margin-top:15px;gap:10px;">
                        <div class="form-group">
                            <button type="button" class="btn btn-warning" id="btnExportToExcel">
                                <i class="fas fa-file-excel"></i> Export to Excel
                            </button>
                        </div>
                        <div class="form-group" id="btnRecordORWrapper" style="display:none;">
                            <button type="button" class="btn btn-info" id="btnRecordOR">
                                <i class="fas fa-receipt"></i> Record OR#
                            </button>
                        </div>
                        @* <div class="form-group">
                            <button type="button" class="btn btn-warning" id="btnNewRequest">
                                Print Report
                            </button>
                        </div> *@
                    </div>
                </div>


            </div>


        </div>
        <div class="card-body">
            <div class="table-responsive">
                <table id="ContributionTable" class="display" style="min-width: 845px">
                    <thead id="sssList">
                        <tr>
                            <th>Employee No</th>
                            <th>Employee Name</th>
                            <th>SSS Number</th>
                            <th>Total Pay</th>
                            <th>Contribution Employee</th>
                            <th>Contribution Employer</th>
                            <th>EC</th>
                            <th>Total Contribution</th>
                        </tr>
                    </thead>
                    <tfoot>
                        <tr></tr>
                    </tfoot>
                </table>
            </div>
        </div>




    </div>
</div>
<!-- PhilHealth OR# Modal -->
<div class="modal fade" id="philhealthORModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-sm modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header py-2">
                <h6 class="modal-title">
                    <i class="fas fa-receipt me-1"></i> Record OR#
                </h6>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <p class="mb-2 small text-muted" id="orBatchLabel"></p>

                <div class="mb-3">
                    <label class="form-label fw-semibold" for="orNumberInput">
                        OR# <span class="text-danger">*</span>
                    </label>
                    <input type="text"
                           id="orNumberInput"
                           class="form-control form-control-sm"
                           placeholder="e.g. PI67254527"
                           maxlength="255">
                    <div class="invalid-feedback">Please enter the OR#.</div>
                </div>

                <div class="mb-2">
                    <label class="form-label fw-semibold" for="orDateOfPayment">
                        Date of Payment <span class="text-danger">*</span>
                    </label>
                    <input type="text"
                           id="orDateOfPayment"
                           class="form-control form-control-sm"
                           placeholder="yyyy/mm/dd"
                           autocomplete="off">
                    <div class="invalid-feedback">Please enter the date of payment.</div>
                </div>
            </div>
            <div class="modal-footer py-2">
                <button type="button" class="btn btn-sm btn-danger" data-bs-dismiss="modal">
                    Cancel
                </button>
                <button type="button" class="btn btn-sm btn-primary" id="btnSaveOR">
                    <i class="fas fa-save me-1"></i> Save
                </button>
            </div>
        </div>
    </div>
</div>
@section Fillow_style
{


}

@section Fillow_script
{


    <script>
        $(document).ready(function () {
            //datepicker
        $('.bt-datepicker').datepicker({
            format: 'yyyy/mm/dd',
            autoclose: true,
            todayHighlight: true    // Highlight today's date
        });

        let ContributionTable;

        const moneyFmt = $.fn.dataTable.render.number(',', '.', 2);

        // Define columns for each report
                const reportColumns = {
            "SSSreport": [
                { title: "Employee No", data: "employeeNo" },
                { title: "Employee Name", data: "employeeName" },
                { title: "Department", data: "departmentCode" },
                { title: "Total Pay", data: "totalPay", render: moneyFmt, className: "dt-right" },
                { title: "SSS Employee", data: "deductionSSSemployee", render: moneyFmt, className: "dt-right" },
                { title: "SSS Employer", data: "deductionSSSemployer", render: moneyFmt, className: "dt-right" },
                { title: "SSS EC", data: "deductionSSSec", render: moneyFmt, className: "dt-right" },
                { title: "SSS Total", data: "deductionSSSTotal", render: moneyFmt, className: "dt-right" },
                { title: "SSS Loan", data: "sssLoan", render: moneyFmt, className: "dt-right" },
                { title: "SSS Calamity Loan", data: "sssCalamity", render: moneyFmt, className: "dt-right" }
            ],

            "PHIreport": [
                { title: "Employee No", data: "employeeNo" },
                { title: "Employee Name", data: "employeeName" },
                { title: "Department", data: "departmentCode" },
                { title: "Total Pay", data: "totalPay", render: moneyFmt, className: "dt-right" },
               // { title: "Rounded", data: "round", render: moneyFmt, className: "dt-right" },
                { title: "PhilHealth Employee", data: "deductionPHIemployee", render: moneyFmt, className: "dt-right" },
                { title: "PhilHealth Employer", data: "deductionPHIemployer", render: moneyFmt, className: "dt-right" },
                { title: "PhilHealth Total", data: "deductionPHITotal", render: moneyFmt, className: "dt-right" },
                { title: "Date of Birth", data: "dateOfBirth" }
            ],

            "PIFreport": [
                { title: "Employee No", data: "employeeNo" },
                { title: "Employee Name", data: "employeeName" },
                { title: "Department", data: "departmentCode" },
                { title: "Pag-IBIG Employee", data: "deductionPIFemployee", render: moneyFmt, className: "dt-right" },
                { title: "Pag-IBIG Employer", data: "deductionPIFemployer", render: moneyFmt, className: "dt-right" },
                { title: "Pag-IBIG Total", data: "deductionPIFTotal", render: moneyFmt, className: "dt-right" },
                { title: "Date of Birth", data: "dateOfBirth" },
                { title: "HDMF Loan", data: "hdmfLoan", render: moneyFmt, className: "dt-right" }
            ],

            "TAXreport": [
                { title: "Employee No", data: "employeeNo" },
                { title: "Employee Name", data: "employeeName" },
                { title: "Department", data: "departmentCode" },
                { title: "TIN Number", data: "tinNo" },
                { title: "Mandatories", data: "totalMandatory", render: moneyFmt, className: "dt-right" },
                { title: "Net Taxable", data: "taxableIncome", render: moneyFmt, className: "dt-right" },
                { title: "Tax Withheld", data: "withHeldTax", render: moneyFmt, className: "dt-right" },
                { title: "Birthday", data: "dateOfBirth" }
            ]
        };



        function initDataTable(reportType) {
            if ($.fn.DataTable.isDataTable('#ContributionTable')) {
                // ContributionTable.destroy();
                // $('#ContributionTable').empty(); // clear table to rebuild thead
                 ContributionTable.clear().destroy();
            }

            // 🔹 ALWAYS rebuild thead + tfoot
            const columns = reportColumns[reportType];

            let thead = '<thead><tr>';
            let tfoot = '<tfoot><tr>';

            columns.forEach(col => {
                thead += `<th>${col.title}</th>`;
                tfoot += `<th></th>`;
            });

            thead += '</tr></thead>';
            tfoot += '</tr></tfoot>';

            $('#ContributionTable')
                .empty()
                .append(thead)
                .append(tfoot);

            // 🔹 Reinitialize DataTable
            ContributionTable = $('#ContributionTable').DataTable({
                 responsive: false,

                pageLength: -1, // default rows
                lengthMenu: [
                    [10, 25, 50, -1],
                    [10, 25, 50, "All"]
                ],

                ajax: {
                    url: '/GovernmentContri/GetReportList',
                    type: 'GET',
                    dataType: 'json',
                    data: function(d) {
                        d.status = $('#filterReportName').val();
                        d.branch = $('#filterBranch').val() ? $('#filterBranch').val() : "ALL";
                        d.department = $('#filterDepartment').val();
                        d.dateMonth = $('#dateMonth').val();
                        d.dateYear = $('#dateYear').val();
                    }
                },
                columns: reportColumns[reportType],

                footerCallback: function (row, data, start, end, display) {
                    const api = this.api();

                    // Label
                    $(api.column(0).footer()).html('<b>TOTAL</b>');

                    // Loop numeric columns only
                    api.columns('.dt-right', { page: 'current' }).every(function () {
                        const total = this
                            .data()
                            .reduce((sum, val) => {
                                const num = typeof val === 'string'
                                    ? parseFloat(val.replace(/,/g, ''))
                                    : val;
                                return sum + (num || 0);
                            }, 0);

                        $(this.footer()).html(
                            $.fn.dataTable.render.number(',', '.', 2).display(total)
                        );
                    });
                },

                language: {
                    paginate: {
                        next: '<i class="fa fa-angle-double-right" aria-hidden="true"></i>',
                        previous: '<i class="fa fa-angle-double-left" aria-hidden="true"></i>'
                    }
                },
                dom: 'Blfrtip', // Needed to show buttons
                buttons: [
                    {
                        extend: 'excelHtml5',
                        text: '<i class="fa fa-file-excel-o"></i> Excel',
                        className: 'btn btn-success',
                        exportOptions: {
                            columns: ':visible' // Export only visible columns
                        }
                    },
                    {
                        extend: 'pdfHtml5',
                        text: '<i class="fa fa-file-pdf-o"></i> PDF',
                        className: 'btn btn-danger',
                        orientation: 'landscape', // or 'portrait'
                        pageSize: 'A4',
                        exportOptions: {
                            columns: ':visible'
                        }
                    }
                ]
            });
        }


        initializeFilterSelect2();
        const selectedReport = $('#filterReportName').val();
        $('#filterReportName').on('change', function() {
            const selectedReport = $(this).val();
            initDataTable(selectedReport);
        });
        initDataTable(selectedReport);
        // On filter change
        $('#filterBranch, #filterDepartment, #dateMonth, #dateYear').on('change', function() {
            ContributionTable.ajax.reload(null, true);
        });

        // Initialize with default report
        initDataTable($('#filterReportName').val());

        // ── PhilHealth OR# button visibility ────────────────────────────────────
        function toggleORButton() {
            if ($('#filterReportName').val() === 'PHIreport') {
                $('#btnRecordORWrapper').show();
            } else {
                $('#btnRecordORWrapper').hide();
            }
        }
        toggleORButton();

        $('#filterReportName').on('change', function () {
            toggleORButton();
        });

        // ── Open OR# modal ───────────────────────────────────────────────────────
        $(document).on('click', '#btnRecordOR', function () {
            const branch    = $('#filterBranch').val();
            const dateMonth = $('#dateMonth').val();
            const dateYear  = $('#dateYear').val();

            if (!branch || branch === 'ALL' || branch === '') {
                Swal.fire({
                    icon: 'warning',
                    title: 'Branch Required',
                    text: 'Please select a specific branch before recording an OR#.',
                    confirmButtonText: 'OK'
                });
                return;
            }

            if (!dateMonth || !dateYear) {
                Swal.fire({
                    icon: 'warning',
                    title: 'Date Required',
                    text: 'Please select a Month and Year before recording an OR#.',
                    confirmButtonText: 'OK'
                });
                return;
            }

            const selectedBranchText = $('#filterBranch').select2('data')[0]?.text || branch;
            $('#orBatchLabel').text(`Branch: ${selectedBranchText} | ${dateMonth} ${dateYear}`);

            // Pre-load existing OR# if any
            $.get('/GovernmentContri/GetPhilhealthOR', {
                branch:    branch,
                dateMonth: dateMonth,
                dateYear:  dateYear
            }).done(function (res) {
                $('#orNumberInput').val(res.orNumber || '').removeClass('is-invalid');
                $('#orDateOfPayment').val(res.dateOfPayment || '').removeClass('is-invalid');
            }).fail(function () {
                $('#orNumberInput').val('').removeClass('is-invalid');
                $('#orDateOfPayment').val('').removeClass('is-invalid');
            });

            // Initialize date picker on OR date field
            $('#orDateOfPayment').datepicker({
                format: 'yyyy/mm/dd',
                autoclose: true,
                todayHighlight: true
            });

            $('#philhealthORModal').modal('show');
        });

        // ── Save OR# ─────────────────────────────────────────────────────────────
        $(document).on('click', '#btnSaveOR', function () {
            const orNumber      = $('#orNumberInput').val().trim();
            const dateOfPayment = $('#orDateOfPayment').val().trim();
            let valid = true;

            if (!orNumber) {
                $('#orNumberInput').addClass('is-invalid');
                valid = false;
            } else {
                $('#orNumberInput').removeClass('is-invalid');
            }

            if (!dateOfPayment) {
                $('#orDateOfPayment').addClass('is-invalid');
                valid = false;
            } else {
                $('#orDateOfPayment').removeClass('is-invalid');
            }

            if (!valid) return;

            const $btn         = $(this);
            const originalHtml = $btn.html();
            $btn.prop('disabled', true).html('<i class="fas fa-spinner fa-spin"></i> Saving...');

            $.ajax({
                url: '/GovernmentContri/SavePhilhealthOR',
                type: 'POST',
                data: {
                    branch:        $('#filterBranch').val(),
                    dateMonth:     $('#dateMonth').val(),
                    dateYear:      $('#dateYear').val(),
                    orNumber:      orNumber,
                    dateOfPayment: dateOfPayment
                },
                dataType: 'json',
                success: function (res) {
                    if (res.success) {
                        $('#philhealthORModal').modal('hide');
                        Swal.fire({
                            icon: 'success',
                            title: 'Saved',
                            text: res.message || 'OR# saved successfully.',
                            timer: 2000,
                            showConfirmButton: false
                        });
                    } else {
                        Swal.fire({
                            icon: 'error',
                            title: 'Error',
                            text: res.message || 'Failed to save OR#.'
                        });
                    }
                },
                error: function () {
                    Swal.fire({
                        icon: 'error',
                        title: 'Error',
                        text: 'An unexpected error occurred. Please try again.'
                    });
                },
                complete: function () {
                    $btn.prop('disabled', false).html(originalHtml);
                }
            });
        });

        // ── Clear invalid state as user types ────────────────────────────────────
        $('#orNumberInput').on('input', function () {
            if ($(this).val().trim()) $(this).removeClass('is-invalid');
        });
        $('#orDateOfPayment').on('change', function () {
            if ($(this).val().trim()) $(this).removeClass('is-invalid');
        });


                 $(document).on("click", "#btnNewRequest", function (e) {
                    var branch = $("#filterBranch").val() == "" || $("#filterBranch").val() == null ? "ALL" : $("#filterBranch").val();

                    var parameter = branch+"_"+$("#dateYear").val()+"_"+$("#dateMonth").val()+"_"+$("#filterReportName").val();
                    var url = "http://15.235.183.108:90//home/GovReport?" + "&govReports=" + encodeURIComponent(parameter);
                    window.open(url, '_blank');

                 });
                 $(document).on("click", ".deleteEmployee", function (e) {
                    e.preventDefault();
                    var employeeNo = $(this).data("employeeno");

                    var $btn = $(this);

                    console.log(employeeNo);

                    Swal.fire({
                        title: 'Oops...',
                        text: 'Are you sure you want to delete this Employee?',
                        icon: 'error',
                        showCancelButton: true,
                        confirmButtonText: 'OK',
                        cancelButtonText: 'Cancel',
                        reverseButtons: false,
                        allowOutsideClick: false,
                        allowEscapeKey: false,
                        customClass: {
                            popup: 'swal-custom-popup',
                            title: 'swal-custom-title',
                            htmlContainer: 'swal-custom-text',
                            confirmButton: 'swal-custom-confirm',
                            cancelButton: 'swal-custom-cancel'
                        }
                    }).then((result) => {
                        if (result.isConfirmed) {
                            // Disable button and show loading

                           $btn.prop('disabled', true);
                            $btn.html('<i class="fas fa-spinner fa-spin"></i>');

                            $.ajax({
                                url: '/Users/DeleteUser',
                                type: 'POST',
                                data: { employeeNo: employeeNo },
                                dataType: 'json',
                                success: function (response) {
                                    if (response.success) {
                                        $('#ContributionTable').DataTable().ajax.reload(null, false); // Keep current page
                                        showNotification(response.message, 'success');
                                    } else {
                                        showNotification(response.message, 'error');
                                    }
                                },
                                error: function (xhr, status, error) {
                                    console.log('Error deleting adjustment:', error);
                                    showNotification('Unable to delete adjustment. Please try again.', 'error');
                                },
                                complete: function () {
                                    // Re-enable button
                                    $btn.prop('disabled', false);
                                    $btn.html('<i class="fa fa-trash"></i>');
                                }
                            });


                        }
                    });

                });



        });

         function initializeFilterSelect2(){
                    $('.month-picker').datepicker({
                        format: "MM",
                        minViewMode: 1,
                        startView: 1,
                        autoclose: true
                    }).on('show', function() {


                        $('.datepicker-years').hide();
                        $('.datepicker-switch').css('visibility', 'hidden');
                    }).val(function() {
                        let today = new Date();
                        let monthNames = [
                            "January", "February", "March", "April", "May", "June",
                            "July", "August", "September", "October", "November", "December"
                        ];
                        return monthNames[today.getMonth()];
                    });
                    //  const $monthInput = $('#dateMonth');

                    // $monthInput.datepicker({
                    //     format: "MM",
                    //     minViewMode: 1,
                    //     startView: 1,
                    //     autoclose: true,
                    //     forceParse: false
                    // });


                    // $monthInput.val(new Date().toLocaleString('default', { month: 'long' }));

                    // $monthInput.on('show', function () {


                    //     setTimeout(function () {
                    //         const $picker = $('.datepicker');
                    //         const $switch = $picker.find('.datepicker-switch');


                    //         $switch
                    //             .text('ALL')
                    //             .css({
                    //                 cursor: 'pointer',
                    //                 fontWeight: 'bold'
                    //             })
                    //             .off('click.all')
                    //             .on('click.all', function (e) {
                    //                 e.preventDefault();
                    //                 e.stopImmediatePropagation();


                    //                 $monthInput.val('ALL');


                    //                 $monthInput.data('datepicker').date = null;


                    //                 $monthInput.datepicker('hide');
                    //             });


                    //         $picker.find('.datepicker-years').hide();

                    //     }, 0);
                    // });

                    $('.year-picker').datepicker({
                        format: 'yyyy',
                        minViewMode: 2,
                        autoclose: true
                    }).val(new Date().getFullYear());

                        // branch

                       $('#filterBranch').select2({
                        placeholder: "Select Branch",
                        allowClear: true,
                        ajax: {
                            url: '/Setup/GetEmployeeBranch',
                            dataType: 'json',
                            delay: 250,
                            processResults: function (data) {

                                var allOption = {
                                    id: 'ALL',
                                    text: 'All Branches'
                                };

                                var results = $.map(data, function (item) {
                                    return {
                                        id: item.branchCode,
                                        text: item.branchName
                                    };
                                });

                                results.unshift(allOption);

                                return {
                                    results: results
                                };
                            }
                        }
                    });

                     // department
                     $('#filterDepartment').select2({
                        placeholder: "Select Employee Department",
                        allowClear: true,
                        ajax: {
                            url: '/Setup/GetEmployeeDepartment',
                            dataType: 'json',
                            delay: 250,
                            processResults: function (data) {
                                // Map your results as usual
                                var results = $.map(data, function (item) {
                                    return {
                                        id: item.departmentCode,
                                        text: item.departmentName
                                    };
                                });

                                // Add the "All" option at the top
                                results.unshift({
                                    id: 'ALL',
                                    text: 'All Departments'
                                });

                                return {
                                    results: results
                                };
                            }
                        }
                    });

                    // EVENT HANDLER - EXPORT TO EXCEL
                    $(document).on('click', '#btnExportToExcel', function() {
                        const $btn = $(this);
                        const table = $('#ContributionTable').DataTable();

                        if (!table) {
                            alert('Table not initialized.');
                            return;
                        }

                        if (table.rows({ search: 'applied' }).count() === 0) {
                            Swal.fire({
                                icon: 'warning',
                                title: 'No Data',
                                text: 'No data available to export',
                                confirmButtonText: 'OK'
                            });
                            return;
                        }

                        const params = new URLSearchParams({
                            status:     $('#filterReportName').val() || 'SSSreport',
                            branch:     $('#filterBranch').val() || 'ALL',
                            department: $('#filterDepartment').val() || 'ALL',
                            dateMonth:  $('#dateMonth').val() || '',
                            dateYear:   $('#dateYear').val() || '',
                            offset: 0,
                            limit: table.page.len()
                        });

                        const originalHtml = $btn.html();
                        $btn.prop('disabled', true).html('<i class="fas fa-spinner fa-spin"></i> Exporting...');

                        // ✅ FIXED: correct controller route
                        const url = `/GovernmentContriExport/ExportToExcel?${params.toString()}`;

                        fetch(url, {
                            method: 'GET',
                            headers: {
                                'Accept': 'application/vnd.openxmlformats-officedocument.spreadsheetml.sheet'
                            }
                        })
                        .then(response => {
                            if (!response.ok) {
                                return response.text().then(text => {
                                    throw new Error(`Server error (${response.status}): ${text}`);
                                });
                            }
                            return response.blob();
                        })
                        .then(blob => {
                            const url = window.URL.createObjectURL(blob);
                            const link = document.createElement('a');
                            link.href = url;
                            const reportType = $('#filterReportName').val() || 'SSSreport';
                            const dateYear   = $('#dateYear').val() || '';
                            const dateMonth  = $('#dateMonth').val() || '';
                            link.download = `GovReport_${reportType}_${dateYear}_${dateMonth}_${new Date().getTime()}.xlsx`;
                            document.body.appendChild(link);
                            link.click();
                            document.body.removeChild(link);
                            window.URL.revokeObjectURL(url);
                            $btn.prop('disabled', false).html(originalHtml);
                        })
                        .catch(error => {
                            $btn.prop('disabled', false).html(originalHtml);
                            Swal.fire({
                                icon: 'error',
                                title: 'Export Failed',
                                text: error.message || 'An error occurred during export. Please try again.',
                                confirmButtonText: 'OK'
                            });
                        });
                    });

                }

    </script>

}