	<script>
		const sessemployeeNo = @Html.Raw(Json.Serialize(sessemployeeNo));
		const sessroleCode   = @Html.Raw(Json.Serialize(sessroleCode));
		const ROLE_ACCESS = @Html.Raw(Context.Session.GetString("ROLE_ACCESS") ?? "{}");
		let MODULE = '';
		let access = '';

		// validation
		$(document).ready(function() {

			validationinputs();

		});

				//notification toaster
				function showNotification(message, type) {
								if (type === 'success') {
									toastr.success(message, "Success");
								} else if (type === 'error') {
									toastr.error(message, "Error");
								} else if (type === 'warning') {
									toastr.warning(message, "Warning");
								} else if (type === 'info') {
									toastr.info(message, "Information");
								} else {
									toastr.info(message, "Notification");
								}
						}

		function validationinputs() {

			/* ======================================================
			   TEXT & NUMBER INPUT VALIDATION
			   ====================================================== */
			$(document)
				.off('input.validation')
				.on('input.validation', 'input', function () {

					const $input = $(this);
					const type = $input.attr('type');
					let value = $input.val();

					if ($input.hasClass('decimal-input')) {
						const decimalRegex = /[^0-9.]/g;
						let cleaned = value.replace(decimalRegex, '');

						// Only ONE decimal point allowed
						const parts = cleaned.split('.');
						if (parts.length > 2) {
							cleaned = parts[0] + '.' + parts.slice(1).join('');
						}

						if (value !== cleaned) {
							$input.val(cleaned);
						}
						return; // Skip other validations
					}

					// TEXT → letters only (except employeeNo)
					if (type === 'text' &&
						$input.attr('id') !== 'employeeNo' &&
						$input.attr('id') !== 'address' &&
						$input.attr('id') !== 'homePhoneNo' &&
						$input.attr('id') !== 'mobileNo' &&
						$input.attr('id') !== 'emergencyContactNo' &&
						$input.attr('id') !== 'zipcode' &&
						$input.attr('id') !== 'accountNo' &&
						$input.attr('id') !== 'bankCode' &&
						$input.attr('id') !== 'sssNo' &&
						$input.attr('id') !== 'philhealthNo' &&
						$input.attr('id') !== 'hdmfNo' &&
						$input.attr('id') !== 'tinNo' &&
						$input.attr('id') !== 'addAccessNo' &&
						$input.attr('id') !== 'viewAccessNo' &&
						$input.attr('id') !== 'addAdjustmentCode' &&
						$input.attr('id') !== 'viewAdjustmentCode' &&
						$input.attr('id') !== 'addAllowanceCode' &&
						$input.attr('id') !== 'viewAllowanceCode' &&
						$input.attr('id') !== 'addAttachmentTypeCode' &&
						$input.attr('id') !== 'viewAttachmentTypeCode' &&
						$input.attr('id') !== 'addBankCode' &&
						$input.attr('id') !== 'viewBankCode' && 
						$input.attr('id') !== 'addBranchCode' &&
						$input.attr('id') !== 'viewBranchCode' &&
						$input.attr('id') !== 'addCOECode' &&
						$input.attr('id') !== 'viewCOECode' &&
						$input.attr('id') !== 'addCommendationCode' &&
						$input.attr('id') !== 'viewCommendationCode' &&
						$input.attr('id') !== 'addDepartmentCode' &&
						$input.attr('id') !== 'viewDepartmentCode' &&
						$input.attr('id') !== 'addEmploymentStatusCode' &&
						$input.attr('id') !== 'viewEmploymentStatusCode' &&
						$input.attr('id') !== 'addLeaveCode' &&
						$input.attr('id') !== 'viewLeaveCode' &&
						$input.attr('id') !== 'addloanCode' &&
						$input.attr('id') !== 'viewloanCode' &&
						$input.attr('id') !== 'addLocationCode' &&
						$input.attr('id') !== 'viewLocationCode' &&
						$input.attr('id') !== 'addOtherDeductionCode' &&
						$input.attr('id') !== 'viewOtherDeductionCode' &&
						$input.attr('id') !== 'addPositionCode' &&
						$input.attr('id') !== 'viewPositionCode' &&
						$input.attr('id') !== 'addProjectCode' &&
						$input.attr('id') !== 'viewProjectCode' &&
						$input.attr('id') !== 'addRankCode' &&
						$input.attr('id') !== 'viewRankCode' &&
						$input.attr('id') !== 'addReason4TerminationCode' &&
						$input.attr('id') !== 'viewReason4TerminationCode' &&
						$input.attr('id') !== 'addUnitCode' &&
						$input.attr('id') !== 'viewUnitCode' &&
						$input.attr('id') !== 'addUnitCode' &&
						$input.attr('id') !== 'viewUnitCode' &&
						$input.attr('id') !== 'addUserCode' &&
						$input.attr('id') !== 'viewUserCode' &&
						$input.attr('id') !== 'taxInput' &&           
						$input.attr('id') !== 'sssInputEE' &&         
						$input.attr('id') !== 'sssInputER' &&         
						$input.attr('id') !== 'phicInputEE' &&        
						$input.attr('id') !== 'phicInputER' &&        
						$input.attr('id') !== 'hdmfInputEE' &&        
						$input.attr('id') !== 'hdmfInputER' &&     
						$input.attr('id') !== 'addAddress' &&
						$input.attr('id') !== 'addUsername' &&
						$input.attr('id') !== 'viewUsername' &&
						$input.attr('id') !== 'roleCode' &&
						$input.attr('id') !== 'roleName' &&
						$input.attr('id') !== 'addYearGraduated' &&    
						$input.attr('id') !== 'viewYearGraduated' &&
						$input.attr('id') !== 'addSection' &&
						$input.attr('id') !== 'viewSection' &&
						$input.attr('id') !== 'orNumberInput' &&
							!$input.hasClass('alphanum')) {
						const textRegex = /[^a-zA-ZÀ-ÿÑñ.'\-\s]/g;
						if (textRegex.test(value)) {
							$input.val(value.replace(textRegex, ''));
						}
					}

					// NUMBER → digits only
					if (type === 'number' &&
						$input.attr('id') !== 'addRequestedAmount' &&
						$input.attr('id') !== 'viewRequestedAmount' &&
						$input.attr('id') !== 'addRemainingBalance' &&
						$input.attr('id') !== 'changeScheduleTimeIn' &&
						$input.attr('id') !== 'changeScheduleTimeOut' &&
						$input.attr('id') !== 'viewRemainingBalance' &&
						$input.attr('id') !== 'addValue' &&
						$input.attr('id') !== 'viewValue' &&
						$input.attr('id') !== 'addPrincipalAmount' &&
						$input.attr('id') !== 'viewPrincipalAmount' &&
						$input.attr('id') !== 'addInterestAmount' &&
						$input.attr('id') !== 'viewInterestAmount' &&
						$input.attr('id') !== 'addDeductionPerCutoff' &&
						$input.attr('id') !== 'viewDeductionPerCutoff' &&
						$input.attr('id') !== 'basicMonthlyPay' &&
						$input.attr('id') !== 'dailyRate' &&
						$input.attr('id') !== 'hourlyRate' &&
						$input.attr('id') !== 'meritServicePay' &&
						$input.attr('id') !== 'basicSalary') {
						const numberRegex = /[^0-9]/g;
						if (numberRegex.test(value)) {
							$input.val(value.replace(numberRegex, ''));
						}
					}
				});


			/* ======================================================
			   DATE RANGE VALIDATION (From / To)
			   ====================================================== */

			// Disable date-to by default (if empty)
			$('.date-to').each(function () {
				if (!$(this).val()) {
					$(this).prop('disabled', true).removeData('enabled');
				}
			});

			// FROM date change
					// FROM date change
			$(document)
			.off('changeDate.dateFrom')
			.on('changeDate.dateFrom', '.date-from', function (e) {

				const $range = $(this).closest('.date-range');
				const $to = $range.find('.date-to');
				const fromDate = e.date;

				// If From is cleared
				if (!fromDate) {
					$to
						.prop('disabled', true)
						.removeData('enabled')
						.datepicker('clearDates')
						.datepicker('setStartDate', null);
					return;
				}

				// ✅ CLEAR Date To when From changes
				$to
					.datepicker('clearDates')          // <-- THIS is the key
					.prop('disabled', false)
					.data('enabled', true)
					.datepicker('setStartDate', fromDate);
			});

			// TO date change
			$(document)
				.off('changeDate.dateTo')
				.on('changeDate.dateTo', '.date-to', function () {

					const $range = $(this).closest('.date-range');
					const fromDate = $range.find('.date-from').datepicker('getDate');
					const toDate = $(this).datepicker('getDate');

					if (fromDate && toDate && toDate < fromDate) {
						showNotification('Date To cannot be earlier than Date From.', 'error');
						$(this).datepicker('setDate', fromDate);
					}
				});
		}

		 $('.bt-datepicker').datepicker({
			format: 'yyyy-mm-dd'
		//autoclose: true
		});


		  flatpickr(".timepicker", {
			enableTime: true,
			noCalendar: true,
			dateFormat: "H:i:S",  // 24-hour format
			time_24hr: true,
			 enableSeconds: true
			 // allowInput: true
		});

		// $('.timepicker').datetimepicker({
		// 	//format: 'LT'
		// 	format: 'HH:mm',
		// 	stepping: 30
		// });
		
		//fix for select 2 issue when inside the modal
		document.querySelectorAll('.modal').forEach(function (el) {
			new bootstrap.Modal(el, {
				focus: false
			});
		});

		// $('.bt-datepicker').datepicker({
		// 	format: 'yyyy-mm-dd',
		// 	autoclose: true
		// });

		//format date for datepicker
		function format_date(unformattedDate){
			if (unformattedDate) {

					var datePart = unformattedDate.split(' ')[0];

					// Split into parts
					var parts = datePart.split('/'); // ["12", "12", "2015"]

					// Create JS Date object
					var jsDate = new Date(parts[2], parts[0] - 1, parts[1]);

					// Optional: format to yyyy-mm-dd if needed
					var formattedDate = jsDate.getFullYear() + '/' +
										String(jsDate.getMonth() + 1).padStart(2, '0') + '/' +
										String(jsDate.getDate()).padStart(2, '0');

					if(formattedDate === "1900/01/01"){
						formattedDate = "";
					}
					return formattedDate;
				}
		}

		//tab in employee profile
		function loadEmployeeTabContent(tab, employeeNo) {
					$("#tabContent").html("<p>Loading...</p>");
					 $.get("/"+ tab + "/Get" + tab, { employeeNo: employeeNo }, function (result) {
						$("#tabContent").html(result);
					});
		}

		// disable / enable inputs
		function disabled_enable_input(param){

			if(param){
				$('.formInput,.formRadio').each(function () {
					$(this).prop('disabled', true).css('background', '#efefef');
				});
			}else{
				$('.formInput,.formRadio').each(function () {
					$(this).prop('disabled', false).css('background', '');
				});
			}
		}

		//show save and cancel button in forms
		function showhide_edit_save_btn($btn) {

		  if ($btn.text().trim() === 'Edit') {
			$btn.text('Save');
			$btn.removeClass('btn-primary').addClass('btn-success');
			disabled_enable_input(false);
			$('.formcancel_btn').show();

		  } else {
			hideCancelButton();
		  }

		};

		function hideCancelButton(){
			disabled_enable_input(true);
			$('.formcancel_btn').hide();
			$('.formdateSave_btn').text('Edit');
			$('.formupdateSave_btn').removeClass('btn-success').addClass('btn-primary');
		}
		
		//validate form

		function validateForm($form) {

			let isValid = true;

			$form.find('.required-field').each(function () {
				const $field = $(this);
				let value = $field.val();

				// Normalize value for arrays (multi-select2, etc.)
				if (Array.isArray(value)) {
					value = value.filter(v => v && v.trim() !== '').join(',');
				}

				if (value === null || value === undefined || value === '') {
					// Mark invalid
					$field.addClass('is-invalid')
						  .css('border', '0.0625rem solid #FC2E53');

					// Handle select2
					if ($field.hasClass('select2-hidden-accessible')) {
						$field.next('.select2').find('.select2-selection')
							  .css('border', '0.0625rem solid #FC2E53');
					}

					isValid = false;
				} else {
					// Clear invalid styles
					$field.removeClass('is-invalid')
						  .css('border', '');

					if ($field.hasClass('select2-hidden-accessible')) {
						$field.next('.select2').find('.select2-selection')
							  .css('border', '');
					}
				}
			});

			return isValid;
		}

		//clear invalid inputs
		function clearValidation($form) {
			$form.find('.form-control, .form-select, .form-radio').removeClass('is-invalid');
			$form.find('.invalid-feedback').hide();
		}

		

		function formatDateForPicker(dateStr) {
			// Replace slashes with dashes
			return dateStr ? dateStr.replace(/\//g, '-') : '';
		}

		// Reusable decline with reason function
		function declineWithReason(options) {
			var settings = $.extend({
				title: 'Decline Record',
				text: 'Are you sure you want to decline this request?',
				url: '',
				id: null,
				declinedByUser: 'CURRENT_USER',
				button: null,
				table: null,
				onSuccess: null,
				onError: null
			}, options);

			Swal.fire({
				title: settings.title,
				html: `
					<p style="margin-bottom: 15px;">${settings.text}</p>
					<div style="text-align: left;">
						<label for="declineReason" style="display: block; margin-bottom: 5px; font-weight: 500;">
							Reason for Declining: <span style="color: #dc3545;">*</span>
						</label>
						<textarea
							id="declineReason"
							class="swal2-input"
							placeholder="Please provide a reason for declining"
							style="width: 100%; height: 80px; resize: vertical; padding: 10px; border: 1px solid #ced4da; border-radius: 4px;"
							maxlength="500"
						></textarea>
						<small style="color: #6c757d; display: block; margin-top: 5px;">Maximum 500 characters</small>
					</div>
				`,
				icon: 'warning',
				showCancelButton: true,
				confirmButtonText: 'Yes, Decline',
				cancelButtonText: 'Cancel',
				confirmButtonColor: '#dc3545',
				cancelButtonColor: '#6c757d',
				reverseButtons: false,
				allowOutsideClick: false,
				allowEscapeKey: false,
				preConfirm: () => {
					const reason = document.getElementById('declineReason').value.trim();
					if (!reason) {
						Swal.showValidationMessage('Please provide a reason for declining');
						return false;
					}
					if (reason.length < 5) {
						Swal.showValidationMessage('Reason must be at least 5 characters');
						return false;
					}
					return reason;
				},
				didOpen: () => {
					document.getElementById('declineReason').focus();
				}
			}).then((result) => {
				if (result.isConfirmed) {
					var reason = result.value;
					var $btn = settings.button;

					if ($btn) {
						$btn.prop('disabled', true);
						$btn.html('<i class="fas fa-spinner fa-spin"></i>');
					}

					$.post(settings.url, {
						id: settings.id,
						declinedByUser: settings.declinedByUser,
						reason: reason
					}, function (response) {
						if (response.success) {
							if (settings.table) {
								settings.table.ajax.reload(null, false);
							}
							showNotification(response.message, 'success');
							if (settings.onSuccess) settings.onSuccess(response);
						} else {
							showNotification(response.message, 'error');
							if (settings.onError) settings.onError(response);
						}
					}).fail(function(xhr, status, error) {
						console.log('Error declining:', error);
						showNotification('Unable to decline. Please try again.', 'error');
						if (settings.onError) settings.onError(error);
					}).always(function() {
						if ($btn) {
							$btn.prop('disabled', false);
							$btn.html('<i class="fa fa-times"></i>');
						}
					});
				}
			});
		}

